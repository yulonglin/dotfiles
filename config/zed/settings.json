// Zed editor settings — an overlay on Zed's defaults, not a Cursor port.
// Deployed via: ./deploy.sh --zed (symlinked to ~/.config/zed/settings.json)
//
// Rule: a line exists here only if it changes a Zed 1.17.2 default. Redundant
// lines were removed on 2026-09-03 after a key-by-key diff against upstream
// assets/settings/default.json for that tag. Community rates below are from
// 87 public zed/settings.json files on GitHub, same day.
// To see every default: "zed: open default settings" in the command palette.
{
  // === Keymap & editing ===
  "base_keymap": "VSCode",
  "autosave": "on_focus_change", // 31% of community configs set this
  "remove_trailing_whitespace_on_save": false,
  "soft_wrap": "editor_width",
  "wrap_guides": [100],
  "use_smartcase_search": true,

  // === Theme & fonts ===
  // theme is a whole-object field: keep all three keys, do not partially override
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "High Contrast One Dark"
  },
  "icon_theme": "Material Icon Theme",
  "buffer_font_family": "Menlo",
  "buffer_font_size": 16,

  // === Display ===
  "minimap": { "show": "auto" },
  "indent_guides": { "coloring": "indent_aware" },
  "inlay_hints": { "enabled": true },
  "diagnostics": { "inline": { "enabled": true } }, // native errorlens
  "tabs": {
    "show_diagnostics": "errors",
    "git_status": true,
    "file_icons": true
  },
  "toolbar": { "breadcrumbs": false },

  // === Panels (Zed default is right for all of these) ===
  "project_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left", "button": false },
  "agent": {
    "dock": "right",
    "default_model": { "provider": "anthropic", "model": "claude-sonnet-4-6-latest" }
  },

  // === Search: include gitignored files ===
  // Two separate keys. `search` governs project search (cmd-shift-f);
  // `file_finder` governs cmd-p, whose default "smart" only looks at ignored
  // files when the worktree itself is gitignored.
  "search": { "include_ignored": true },
  "file_finder": { "include_ignored": "all" },

  // === File scanning (Zed's 11 defaults + project-specific) ===
  "file_scan_exclusions": [
    "**/.git", "**/.svn", "**/.hg", "**/.jj", "**/.sl", "**/.repo", "**/CVS",
    "**/.DS_Store", "**/Thumbs.db", "**/.classpath", "**/.settings",
    "**/.cache", "**/.venv", "**/node_modules", "**/__pycache__", "**/*.pyc",
    "**/prompt_history",
    // Hide secrets from cmd-p: default file_scan_inclusions is [".env*"], which
    // force-indexes them, and file_finder "all" then surfaces them.
    // Deliberately NOT "**/.env*" — that also matches .envrc (direnv config).
    "**/.env",
    "**/.env.*"
  ],

  // === Privacy ===
  "redact_private_values": true,
  "telemetry": { "diagnostics": false, "metrics": false }, // 53% of community
  "edit_predictions": {
    // Zed's default list plus **/secrets* — this key REPLACES the default, so
    // the defaults are restated here rather than lost.
    "disabled_globs": [
      "**/.env*", "**/*.pem", "**/*.key", "**/*.cert", "**/*.crt",
      "**/.dev.vars", "**/secrets.yml", "**/.zed/settings.json",
      "/**/zed/settings.json", "/**/zed/keymap.json",
      "**/secrets*"
    ]
  },

  // === Git ===
  "git": {
    "inline_blame": { "delay_ms": 600, "show_commit_summary": true, "min_column": 40 }
  },

  // === Terminal ===
  "terminal": {
    "option_as_meta": true,
    "font_family": "Menlo",
    "font_size": 14
  },

  // === Extensions ===
  "auto_install_extensions": {
    "one-dark-pro": true,
    "ruff": true,
    "biome": true,
    "toml": true,
    "dockerfile": true,
    "git-firefly": true,
    "rainbow-csv": true,
    "just": true,
    "xml": true,
    "latex": true,
    "mermaid": true,
    "markdownlint": true,
    "env": true,
    // ActivityWatch editor watcher (sachk/aw-watcher-zed): file, project, language
    // into bucket aw-watcher-zed; raises project attribution in attention-analyser.
    "activitywatch": true
  },

  // === Language servers ===
  "lsp": {
    // Biome (extension above) only runs in projects that ship a biome.json.
    // It is NOT set as a global formatter: put that in the project's
    // .zed/settings.json per https://biomejs.dev/reference/zed
    "biome": { "settings": { "require_config_file": true } }
  },

  // === Language overrides (only non-default keys) ===
  "languages": {
    "Python": {
      "preferred_line_length": 100,
      "soft_wrap": "bounded",
      // ty, pyright, basedpyright and pylsp are all built in. Only ONE type
      // checker can run: two both publish diagnostics for the same lines.
      // Zed's default is basedpyright; swap "ty" and "!basedpyright" to revert.
      "language_servers": ["ty", "ruff", "!basedpyright", "!pyright", "!pylsp"]
    },
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "formatter": "language_server" // default "auto" would prefer prettier when a project has it
    },
    "TSX": {
      "tab_size": 2,
      "format_on_save": "on"
    },
    "JavaScript": {
      "tab_size": 2,
      "format_on_save": "on"
    },
    "JSON": { "tab_size": 2 },
    "JSONC": { "tab_size": 2 },
    "YAML": { "tab_size": 2 },
    "Markdown": { "show_edit_predictions": false },
    "Rust": { "preferred_line_length": 100 }
  },

  // === File type associations ===
  "file_types": {
    "XML": ["*.strings", "*.plist"]
  },

  // === MCP ===
  "context_servers": {
    "mcp-server-markitdown": {
      "enabled": true,
      "remote": false,
      "settings": { "package_version": "latest" }
    }
  },

  // === SSH connections ===
  // Machine state Zed rewrites itself when you connect from the UI. Keep last.
  "ssh_connections": [
    {
      "host": "hn",
      "args": [],
      "projects": [
        {
