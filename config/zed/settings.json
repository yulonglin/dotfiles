// Zed editor settings — feature parity with Cursor config
// Deployed via: ./deploy.sh --zed (symlinked to ~/.config/zed/settings.json)
//
// Only non-default settings are listed. For all defaults, run:
//   zed: open default settings (from command palette)
{
  // === Privacy & Security ===
  "cli_default_open_behavior": "existing_window",
  "context_servers": {
    "mcp-server-markitdown": {
      "enabled": true,
      "remote": false,
      "settings": {
        "package_version": "latest"
      }
    }
  },
  "project_panel": {
    "hide_gitignore": false,
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "redact_private_values": true,

  // === Theme & Appearance ===
  "theme": {
    "mode": "system",
    "dark": "High Contrast One Dark",
    "light": "One Light"
  },
  "icon_theme": "Material Icon Theme",
  "ui_font_size": 16,
  "buffer_font_family": "Menlo",
  "buffer_font_size": 16,

  // === Editor Behavior (non-default only) ===
  "base_keymap": "VSCode",
  "autosave": "on_focus_change",
  "format_on_save": "off", // globally off; enabled per-language for TS/JS/Rust
  "remove_trailing_whitespace_on_save": false,
  "multi_cursor_modifier": "alt", // alt-click adds a cursor; cmd-click = go to definition (Cursor parity)
  "soft_wrap": "editor_width",

  // === Display (non-default only) ===
  "minimap": {
    "show": "auto"
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "inlay_hints": {
    "enabled": true
  },
  "tabs": {
    "show_diagnostics": "errors"
  },
  // Native replacement for the errorlens extension (Zed default is false)
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  // show_wrap_guides is true by default but the guide list is empty,
  // so nothing is drawn until a column is named here
  "wrap_guides": [100],
  "toolbar": {
    "breadcrumbs": false
  },

  // === Search (CRITICAL: include gitignored files) ===
  // Two separate keys. `search` governs project search (cmd-shift-f);
  // `file_finder` governs the command-palette file finder (cmd-p).
  // file_finder default is "smart", which only looks at ignored files when the
  // worktree itself is gitignored — hence cmd-p missing tmp/ and .remember/.
  // "all" = use all gitignored files. file_scan_exclusions below still applies,
  // so .venv/node_modules/__pycache__ stay out of results.
  "search": {
    "include_ignored": true
  },
  "file_finder": {
    "include_ignored": "all"
  },
  "use_smartcase_search": true,

  // === File Scanning (extends defaults with project-specific exclusions) ===
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.classpath",
    "**/.settings",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.cache",
    "**/.venv",
    "**/node_modules",
    "**/__pycache__",
    "**/*.pyc",
    "**/prompt_history",
    // Hides secret files from cmd-p. Zed's default file_scan_inclusions is
    // [".env*"], which force-indexes them even though they are gitignored,
    // and file_finder.include_ignored: "all" then surfaces them.
    // Deliberately NOT "**/.env*" — that glob also matches .envrc, which is
    // direnv config you edit by hand and want to keep reachable.
    "**/.env",
    "**/.env.*"
  ],

  // === Git (inline blame = built-in GitLens) ===
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 600,
      "show_commit_summary": true,
      "min_column": 40
    }
  },

  // === Edit Predictions (Zeta — Zed's native AI completion) ===
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [
      "**/.env*",
      "**/secrets*"
    ]
  },

  // === AI / Agent ===
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-6-latest"
    }
  },

  // === Telemetry (disabled) ===
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  // === Terminal (non-default only) ===
  "terminal": {
    "option_as_meta": true,
    "font_family": "Menlo",
    "font_size": 14,
    "detect_venv": {
      "on": {
        "directories": [".venv", "venv", ".env", "env"],
        "activate_script": "default"
      }
    }
  },

  // === Panels (non-default only) ===
  "outline_panel": {
    "dock": "right"
  },
  "notification_panel": {
    "button": false
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },

  // === Auto-install Extensions ===
  "auto_install_extensions": {
    "one-dark-pro": true,
    "ruff": true,
    "toml": true,
    "dockerfile": true,
    "git-firefly": true,
    "rainbow-csv": true,
    "just": true,
    "html": true,
    "xml": true,
    "latex": true,
    "mermaid": true,
    "markdownlint": true,
    "env": true
  },

  // === Language Overrides ===
  "languages": {
    "Python": {
      "tab_size": 4,
      "format_on_save": "off",
      "preferred_line_length": 100,
      "soft_wrap": "bounded",
      "use_on_type_format": true,
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      // ty, pyright, basedpyright and pylsp are all BUILT INTO Zed — no extension needed.
      // Only ONE type checker can run at a time: two both publish diagnostics for the
      // same lines, which is why Zed's own default disables all but one.
      // To flip back to Zed's default, swap "ty" and "!basedpyright".
      "language_servers": ["ty", "ruff", "!basedpyright", "!pyright", "!pylsp"]
    },
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "JavaScript": {
      "tab_size": 2,
      "format_on_save": "on"
    },
    "JSON": {
      "tab_size": 2
    },
    "JSONC": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    },
    "Markdown": {
      "soft_wrap": "editor_width",
      "show_edit_predictions": false
    },
    "Rust": {
      "tab_size": 4,
      "format_on_save": "on",
      "formatter": "language_server",
      "preferred_line_length": 100
    }
  },

  // === File Type Associations ===
  "file_types": {
    "JSONC": ["**/.zed/**/*.json", "tsconfig.json", "tsconfig.*.json"],
    "XML": ["*.strings", "*.plist"]
  },

  // === SSH Connections ===
  // Zed reads hosts from ~/.ssh/config (managed by gist sync).
