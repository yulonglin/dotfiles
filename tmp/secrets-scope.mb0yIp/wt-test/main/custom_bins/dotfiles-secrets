#!/usr/bin/env bash
# shellcheck shell=bash
# Access the private dotfiles secrets store.
# Usage:
#   dotfiles-secrets keys
#   dotfiles-secrets dotenv
#   dotfiles-secrets shell KEY1 [KEY2 ...]
#   dotfiles-secrets shell --all
#   dotfiles-secrets paths
#   dotfiles-secrets fix-perms
#   dotfiles-secrets set KEY [VALUE] [--note DESC]
#   dotfiles-secrets rm [--yes] KEY
#   dotfiles-secrets list-full
#   dotfiles-secrets write-telegram-env SECRET_NAME STATE_DIR
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
DOT_DIR="${DOT_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
# shellcheck source=/dev/null
source "$DOT_DIR/scripts/helpers/dotfiles_secrets.sh"

BACKEND=$(dotfiles_secrets_backend)
BWS_TOKEN_FILE=$(dotfiles_secrets_bws_token_file)

if [[ "$BACKEND" == "bws" && -z "${BWS_ACCESS_TOKEN:-}" ]]; then
    [[ -f "$BWS_TOKEN_FILE" ]] || { echo "No BWS_ACCESS_TOKEN and $BWS_TOKEN_FILE not found. Run: secrets init" >&2; exit 1; }
    BWS_ACCESS_TOKEN=$(< "$BWS_TOKEN_FILE")
    export BWS_ACCESS_TOKEN
fi
KEY_PATTERN='API.?KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL'
SECRETS_CACHE=""
BWS_META_CACHE=""  # Tab-separated: env_name\tbws_key\tnote\tuuid
BWS_RAW_CACHE=""   # Tab-separated: bws_key\tbase64(value)\tnote\tuuid

# ─── in-memory secret loading (no on-disk cache) ─────────────────────────────
# Secrets resolve live from the backend on every invocation. The previous
# design cached a parsed dotenv under ~/.cache/dotfiles-secrets/, which was
# wrong twice over: it wrote resolved secret VALUES to disk in plaintext, and
# it masked BWS key ambiguity for as long as the cache predated a newly added
# key — so the failure surfaced later, cold, in whatever process refreshed
# first. Live reads now list each accessible BWS project concurrently; measured
# startup is about 0.5 s instead of 20–37 s for the unfiltered endpoint.
#
# Within one invocation the backend is hit at most once (SECRETS_LOADED);
# that in-memory reuse is the only caching that remains.
SECRETS_LOADED=false

die() {
    echo "Error: $*" >&2
    exit 1
}

normalize_value() {
    local value="$1"
    value="${value%$'\r'}"

    if [[ "$value" =~ ^\"(.*)\"$ ]]; then
        value="${BASH_REMATCH[1]}"
        # Process \\ first via sentinel to prevent \\n being misread as \n
        local sentinel=$'\x01'
        value="${value//\\\\/$sentinel}"
        value="${value//\\n/$'\n'}"
        value="${value//\\r/$'\r'}"
        value="${value//\\t/$'\t'}"
        value="${value//\\\"/\"}"
        value="${value//$sentinel/\\}"
    elif [[ "$value" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
        value="${value//\\\'/\'}"
        value="${value//\\\\/\\}"
    fi

    printf '%s' "$value"
}

# ─── bws backend ─────────────────────────────────────────────────────────────

require_bws() {
    command -v bws >/dev/null 2>&1 || die "bws not found. Run: install.sh or cargo install bws"
    if [[ -z "${BWS_ACCESS_TOKEN:-}" ]]; then
        [[ -f "$BWS_TOKEN_FILE" ]] || die "No BWS_ACCESS_TOKEN and $BWS_TOKEN_FILE not found. Run: secrets init"
        BWS_ACCESS_TOKEN=$(cat "$BWS_TOKEN_FILE")
        export BWS_ACCESS_TOKEN
    fi
}

# True for backends that supply BWS-style metadata (env_name/bws_key/note/uuid),
# which is what the ambiguity-resolution paths key off. The test fixture backend
# supplies the same shape, so gating on the literal string "bws" would make the
# suite silently skip the very code it exists to exercise.
backend_has_meta() {
    [[ "$BACKEND" == "bws" || "$BACKEND" == "fixture" ]]
}

bws_secret_list_json() {
    "$DOT_DIR/scripts/helpers/bws_secret_list.py"
}

load_secrets_bws() {
    [[ -n "$SECRETS_CACHE" ]] && return 0
    require_bws
    local json bws_stderr d
    # Sandboxed Claude Code sessions set TMPDIR to a read-only path
    # (/run/user/<uid>), so fall back rather than dying before bws even runs.
    bws_stderr=""
    for d in "${TMPDIR:-/tmp}" /tmp/claude /tmp; do
        bws_stderr=$(mktemp "$d/bws_stderr.XXXXXX" 2>/dev/null) && break
        bws_stderr=""
    done
    [[ -n "$bws_stderr" ]] || die "mktemp failed in every tmp dir (TMPDIR=${TMPDIR:-unset})"
    json=$(bws_secret_list_json 2>"$bws_stderr") || {
        local err
        err=$(cat "$bws_stderr")
        rm -f "$bws_stderr"
        die "bws secret list failed: $err"
    }
    rm -f "$bws_stderr"
    local parsed
    parsed=$(printf '%s\n' "$json" | DOTFILES_DECLARED_ENV_MAP="$(global_scope_declared_map)" python3 -c '
import json, os, sys, re

data = json.load(sys.stdin)
if not isinstance(data, list):
    print(f"Unexpected bws output: expected JSON array, got {type(data).__name__}", file=sys.stderr)
    sys.exit(1)

seen = {}
dotenv_lines = []
meta_lines = []

# First-active declared key per env name ("name<TAB>key" lines) — the key a
# bare-name resolution would use. A name is deduplicated for this machine only
# if that key still exists among the live duplicates; a stale mapping must not
# silence the warning, because resolution with it dies.
declared = {}
for line in os.environ.get("DOTFILES_DECLARED_ENV_MAP", "").split("\n"):
    if "\t" in line:
        n, k = line.split("\t", 1)
        declared[n] = k

keys_by_name = {}
for s in data:
    if "key" in s:
        k = s["key"]
        n = k.split(" - ", 1)[0].strip() if " - " in k else k
        keys_by_name.setdefault(n, set()).add(k)

for s in data:
    if "key" not in s or "value" not in s:
        print(f"Unexpected bws secret format: missing key/value in {list(s.keys())}", file=sys.stderr)
        sys.exit(1)

    bws_key = s["key"]
    note = (s.get("note") or "").strip().replace("\t", " ").replace("\n", " ")

    # Convention: "ENV_VAR_NAME - description" → env var is part before " - "
    env_name = bws_key.split(" - ", 1)[0].strip() if " - " in bws_key else bws_key

    # Validate env_name is a valid shell identifier
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", env_name):
        desc = bws_key.split(" - ", 1)[1].strip() if " - " in bws_key else ""
        print(f"WARNING: BWS key {bws_key!r} → env name {env_name!r} is not a valid shell identifier. "
              f"Rename to ENV_VAR_NAME - description format.", file=sys.stderr)
        continue

    if env_name in seen:
        dk = declared.get(env_name)
        if dk is None:
            print(f"WARNING: duplicate env name {env_name!r} from BWS keys {seen[env_name]!r} and {bws_key!r}. "
                  f"Declare which one this machine uses: secrets-use {env_name}", file=sys.stderr)
        elif dk not in keys_by_name.get(env_name, ()):
            print(f"WARNING: duplicate env name {env_name!r} — the machine conf maps it to {dk!r}, "
                  f"which is not a live BWS key. Re-pick: secrets-use {env_name}", file=sys.stderr)
    seen[env_name] = bws_key

    v = s["value"]
    if any(c in v for c in (" ", "\n", "\r", "\t", "\"", "'\''", "#", "$", "`", "\\", "=")):
        v = "\"" + v.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t") + "\""
    dotenv_lines.append(f"{env_name}={v}")
    sid = s.get("id", "")
    meta_lines.append(f"{env_name}\t{bws_key}\t{note}\t{sid}")

raw_lines = []
for s in data:
    if "key" not in s or "value" not in s:
        continue
    bws_key = s["key"]
    env_name = bws_key.split(" - ", 1)[0].strip() if " - " in bws_key else bws_key
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", env_name):
        continue
    note = (s.get("note") or "").strip().replace("\t", " ").replace("\n", " ")
    # Raw TSV: bws_key \t b64(value) \t note \t uuid. b64 avoids tab/newline in values.
    import base64
    b64 = base64.b64encode(s["value"].encode("utf-8")).decode("ascii")
    sid = s.get("id", "")
    raw_lines.append(f"{bws_key}\t{b64}\t{note}\t{sid}")

# Output: dotenv block, then META_SEPARATOR, then metadata block, then RAW block
print("\n".join(dotenv_lines))
print("__BWS_META__")
print("\n".join(meta_lines))
print("__BWS_RAW__")
print("\n".join(raw_lines))
') || die "Failed to parse bws output (is the bws CLI version compatible?)"

    SECRETS_CACHE="${parsed%%__BWS_META__*}"
    SECRETS_CACHE="${SECRETS_CACHE%$'\n'}"
    local rest="${parsed#*__BWS_META__}"
    rest="${rest#$'\n'}"
    BWS_META_CACHE="${rest%%__BWS_RAW__*}"
    BWS_META_CACHE="${BWS_META_CACHE%$'\n'}"
    BWS_RAW_CACHE="${rest#*__BWS_RAW__}"
    BWS_RAW_CACHE="${BWS_RAW_CACHE#$'\n'}"
}

# ─── backend dispatch ────────────────────────────────────────────────────────

# Test-only backend. Reads the same three blocks the BWS loader produces from
# a fixture directory, so the suite can exercise resolution without a network
# call or a real secret.
#
# Selected ONLY by an explicit DOTFILES_SECRETS_BACKEND=fixture, and it dies
# rather than falling back when the fixture dir is missing or empty. The old
# suite injected fixtures by pointing DOTFILES_SECRETS_CACHE_DIR at a temp
# dir, where an empty value silently meant "use the real cache" — a test could
# then read live secrets and print one in a failure diagnostic. An unset var
# must be a hard error here, never a fall-through.
load_secrets_fixture() {
    local dir="${DOTFILES_SECRETS_FIXTURE_DIR:-}"
    [[ -n "$dir" ]] \
        || die "DOTFILES_SECRETS_BACKEND=fixture requires DOTFILES_SECRETS_FIXTURE_DIR (refusing to fall back to a live backend)"
    [[ -d "$dir" ]] \
        || die "fixture directory does not exist: $dir"
    [[ -f "$dir/secrets" && -f "$dir/meta" && -f "$dir/raw" ]] \
        || die "fixture directory $dir must contain: secrets, meta, raw"
    SECRETS_CACHE=$(cat "$dir/secrets")
    BWS_META_CACHE=$(cat "$dir/meta")
    BWS_RAW_CACHE=$(cat "$dir/raw")
}

load_secrets_from_backend() {
    case "$BACKEND" in
        bws)     load_secrets_bws ;;
        fixture) load_secrets_fixture ;;
        none)    die "No secrets backend available. Run: secrets init" ;;
        *)       die "Unknown backend: $BACKEND. Set DOTFILES_SECRETS_BACKEND to 'bws'" ;;
    esac
}

# Resolves live from the backend, once per process. No disk cache: see the
# in-memory loading note near the top of this file.
load_secrets() {
    [[ "$SECRETS_LOADED" == true ]] && return 0
    load_secrets_from_backend
    SECRETS_LOADED=true
}

content_has_key() {
    local content="$1"
    local key="$2"

    [[ -n "$content" ]] || return 1

    printf '%s\n' "$content" | awk -v key="$key" '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        {
            line = $0
            sub(/\r$/, "", line)
            sub(/^[[:space:]]*export[[:space:]]+/, "", line)
            if (line ~ ("^" key "=")) {
                found = 1
                exit
            }
        }
        END { exit(found ? 0 : 1) }
    '
}

get_value_from_content() {
    local content="$1"
    local key="$2"
    local raw_value

    raw_value=$(printf '%s\n' "$content" | awk -v key="$key" '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        {
            line = $0
            sub(/\r$/, "", line)
            sub(/^[[:space:]]*export[[:space:]]+/, "", line)
            if (line ~ ("^" key "=")) {
                print substr(line, length(key) + 2)
                exit
            }
        }
    ')

    normalize_value "$raw_value"
}

# --- global-scope disambiguation -------------------------------------------
# One BWS secret per account/collaborator means an env name like OPENAI_API_KEY
# legitimately maps to several BWS keys, and that count grows every time a new
# account is added. Per-repo callers never hit this: setup-envrc writes the
# exact "ENV - description" key into .envrc. The GLOBAL scope (hooks, wrappers,
# anything resolving by bare env name) has no such pin, so it declares one here.
#
# Format, one per line, in $DOT_DIR/config/secrets-global.conf:
#     ENV_NAME = <exact BWS key>
#
# An env name may appear on SEVERAL lines. They form an ordered preference
# list, most-preferred first, and a leading "!" on the value marks that key
# blocked (rate-limited, out of credits, revoked). Resolution returns the first
# key that is NOT blocked:
#     ANTHROPIC_API_KEY = !ANTHROPIC_API_KEY - personal
#     ANTHROPIC_API_KEY = ANTHROPIC_API_KEY - mats
# Here the first entry is blocked, so the second resolves. Comments are
# whole-line only ("#" must start the line) — an inline trailing comment
# would be read as part of the key.
# A single line is still a complete declaration, so files written before
# preference lists existed keep working unchanged.
#
# A retired " [global]" suffix on the NAME field may still appear in a conf
# written before the exposure marker was deleted. Every parser here strips it
# so those lines keep resolving; nothing writes one any more.
#
# Nothing here ever changes on its own. A 401 on the active key does NOT
# promote the next one — failover is a human action (`secrets-use ENV --next`),
# because auto-switching would silently start spending from an account the
# user did not choose.
#
# The file is gitignored (BWS key labels name real accounts and collaborators,
# and this repo is public); config/secrets-global.conf.example is the tracked
# template. Only consulted when an env name is actually ambiguous, so adding a
# new account key requires no edit unless it should become the global default.
#
# The conf resolves against the MAIN checkout, never a worktree copy. DOT_DIR
# points at whichever tree this script was invoked from, and the conf is
# gitignored — so a worktree never has one. Without this indirection a
# worktree-invoked binary would find no declaration and hard-error on every
# ambiguous name, and `setup-envrc` run from a worktree bakes that binary's
# absolute path into the repo's .envrc. Both break "single per-machine
# authority for every scope". git-common-dir maps any worktree back to the
# main checkout; it degrades to DOT_DIR outside a git tree.
dotfiles_main_checkout() {
    local common
    common=$(git -C "$DOT_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
        || { printf '%s\n' "$DOT_DIR"; return; }
    [[ -n "$common" ]] || { printf '%s\n' "$DOT_DIR"; return; }
    printf '%s\n' "$(dirname "$common")"
}

GLOBAL_SCOPE_CONF="${DOTFILES_SECRETS_GLOBAL_CONF:-$(dotfiles_main_checkout)/config/secrets-global.conf}"

BWS_EXACT_KEY=""   # set by bws_resolve_env_name

# Best-effort mode: only for bulk requests (`shell --all`) where the caller
# named nothing specific, so skipping an undeclared-ambiguous name is honest.
# A caller that NAMED a key always gets the loud path — silence there is a lie.
SECRETS_BEST_EFFORT=false

# Every declared line for one env name, in file order, as "state<TAB>key"
# where state is "active" or "blocked". This is the single parser for the conf
# format — secrets-use reads it rather than re-implementing the grammar.
global_scope_entries() {
    local env_name="$1"
    [[ -f "$GLOBAL_SCOPE_CONF" ]] || return 0
    # Values contain " - " and ":" but never "=", so split on the FIRST "=".
    awk -v want="$env_name" '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        index($0, "=") == 0 { next }
        {
            name = substr($0, 1, index($0, "=") - 1)
            val  = substr($0, index($0, "=") + 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
            sub(/[[:space:]]*\[global\]$/, "", name)
            if (name != want || val == "") next
            state = "active"
            if (substr(val, 1, 1) == "!") {
                state = "blocked"
                val = substr(val, 2)
                gsub(/^[[:space:]]+/, "", val)
            }
            if (val != "") print state "\t" val
        }
    ' "$GLOBAL_SCOPE_CONF"
}

# The first ACTIVE declared key per env name, as "name<TAB>key" — exactly the
# key global_scope_key would hand a bare-name resolution. Used to keep the
# duplicate-env-name warning quiet for names whose dedup is settled, while
# still firing for undeclared collisions AND for stale declarations (the
# mapped key was renamed or deleted in BWS — resolution would die, so the
# warning must not stay quiet). Blocked-only names stay OUT: they no longer
# resolve, so their duplicates are back to needing a decision.
global_scope_declared_map() {
    [[ -f "$GLOBAL_SCOPE_CONF" ]] || return 0
    awk '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        index($0, "=") == 0 { next }
        {
            name = substr($0, 1, index($0, "=") - 1)
            val  = substr($0, index($0, "=") + 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
            # Tabs are the map delimiter; a tab inside a value would bleed
            # into the key on the python side. No real BWS key has one.
            gsub(/\t/, " ", val)
            sub(/[[:space:]]*\[global\]$/, "", name)
            if (name == "" || val == "" || substr(val, 1, 1) == "!") next
            if (!seen[name]++) print name "\t" val
        }
    ' "$GLOBAL_SCOPE_CONF"
}

# The key an ambiguous env name resolves to: first line that is not blocked.
# Empty when nothing is declared, or when every declared key is blocked — the
# caller treats both as "undeclared" and dies, which is right: a fully blocked
# list means the user must pick, not that we should guess.
global_scope_key() {
    global_scope_entries "$1" \
        | awk -F'\t' '$1 == "active" { print $2; exit }'
}

# --- R4: settle the machine default at key-add time --------------------------
# Adding a second BWS key under an existing env name makes that name ambiguous,
# which turns every bare-env-name resolution into a hard error until this
# machine chooses. Make the choice BEFORE the remote key exists: if the process
# is interrupted after the upsert, a durable duplicate would otherwise be left
# behind with nothing declared, breaking every follow-mode repo at once.
#
# The automatic half is deliberately status-quo-preserving — it pins the key
# that was already resolving, so an add can never silently re-point billing.
# Switching to the new key is then one confirmed step (offer_new_key_as_default).
MACHINE_DEFAULT_JUST_PINNED=""

preserve_machine_default_before_add() {
    local new_key="$1" env_name existing count
    env_name="${new_key%% - *}"
    MACHINE_DEFAULT_JUST_PINNED=""

    backend_has_meta || return 0
    command -v secrets-use >/dev/null 2>&1 || return 0

    load_secrets
    # Keys already under this env name, excluding the one being written — a
    # plain update of an existing key must not trigger any of this.
    existing=$(printf '%s\n' "$BWS_META_CACHE" \
        | awk -F'\t' -v e="$env_name" -v self="$new_key" \
              '$1 == e && $2 != self { print $2 }')
    count=$(printf '%s' "$existing" | grep -c . || true)

    # 0 existing: still unique, nothing to settle.
    # >1 existing: already ambiguous — either declared (fine) or already failing
    # loud, which is not this add's doing.
    [[ "$count" -eq 1 ]] || return 0

    # Already declared means the machine has chosen; adding is harmless.
    [[ -n "$(global_scope_key "$env_name")" ]] && return 0

    echo "dotfiles-secrets: adding this key makes '$env_name' ambiguous." >&2
    echo "  Pinning this machine to the key that already resolves, so nothing breaks:" >&2
    if secrets-use "$env_name" "$existing" >&2; then
        MACHINE_DEFAULT_JUST_PINNED="$existing"
    else
        echo "  WARNING: could not write the machine default. '$env_name' will" >&2
        echo "  hard-error until you run: secrets-use $env_name" >&2
    fi
}

offer_new_key_as_default() {
    local new_key="$1" env_name answer
    env_name="${new_key%% - *}"

    [[ -n "$MACHINE_DEFAULT_JUST_PINNED" ]] || return 0
    command -v secrets-use >/dev/null 2>&1 || return 0

    if [[ ! -t 0 ]]; then
        echo "  This machine still uses '$MACHINE_DEFAULT_JUST_PINNED'." >&2
        echo "  To switch:  secrets-use $env_name $new_key" >&2
        return 0
    fi

    printf "  Make '%s' this machine's active %s instead? [y/N]: " "$new_key" "$env_name" >&2
    read -r answer || return 0
    case "$answer" in
        [Yy]*) secrets-use "$env_name" "$new_key" >&2 || true ;;
        *)     echo "  Keeping '$MACHINE_DEFAULT_JUST_PINNED'. Switch later: secrets-use $env_name $new_key" >&2 ;;
    esac
}

bws_env_name_count() {
    printf '%s\n' "$BWS_META_CACHE" \
        | awk -F'\t' -v e="$1" '$1 == e { n++ } END { print n+0 }'
}

bws_keys_for_env_name() {
    printf '%s\n' "$BWS_META_CACHE" \
        | awk -F'\t' -v e="$1" '$1 == e { print $2 }'
}

bws_value_for_key() {
    local b64
    b64=$(printf '%s\n' "$BWS_RAW_CACHE" \
        | awk -F'\t' -v k="$1" '$1 == k { print $2; exit }')
    [[ -n "$b64" ]] || die "Secret not found: $1 (the BWS record may have been removed)"
    printf '%s' "$b64" | base64 -d
}

# Sets BWS_EXACT_KEY to the exact BWS key a bare env name should resolve to.
# Empty means the name is unambiguous and the caller should use its normal
# dotenv path. Ambiguous with no declared default DIES — never returns empty,
# because a caller that treated "resolved nothing" as success is precisely how
# a missing key became 349 silent auto-mode denials.
#
# Must be called as a plain command, never inside $(...): die's exit would only
# kill the subshell and hand the caller an empty string, re-creating that bug.
bws_resolve_env_name() {
    local env_name="$1" count mapped
    BWS_EXACT_KEY=""
    { backend_has_meta && [[ -n "$BWS_META_CACHE" ]]; } || return 0

    count=$(bws_env_name_count "$env_name")
    (( count > 1 )) || return 0

    mapped=$(global_scope_key "$env_name")
    if [[ -z "$mapped" ]]; then
        # Distinguish "never declared" from "declared but every key is blocked":
        # the second is a user who ran out of `--next` and needs to unblock one,
        # and telling them to "declare a default" would be actively misleading.
        local declared blocked_list=""
        declared=$(global_scope_entries "$env_name")
        if [[ -n "$declared" ]]; then
            blocked_list=$(printf '%s\n' "$declared" | awk -F'\t' '$1 == "blocked" { print "  " $2 }')
        fi
        if [[ "$SECRETS_BEST_EFFORT" == true ]]; then
            if [[ -n "$blocked_list" ]]; then
                echo "dotfiles-secrets: skipping '$env_name' — every declared key is blocked in $GLOBAL_SCOPE_CONF" >&2
            else
                echo "dotfiles-secrets: skipping ambiguous env name '$env_name' ($count BWS keys, none declared in $GLOBAL_SCOPE_CONF)" >&2
            fi
            return 1
        fi
        if [[ -n "$blocked_list" ]]; then
            die "$(printf '%s\n' \
                "Every declared key for '$env_name' is blocked, in" \
                "  $GLOBAL_SCOPE_CONF" \
                "Blocked:" \
                "$blocked_list" \
                "Unblock one with:" \
                "  secrets-use $env_name --activate '<key>'")"
        fi
        die "$(printf '%s\n' \
            "Ambiguous env name '$env_name': $count BWS secrets share it." \
            "Declare which one the global scope uses, in" \
            "  $GLOBAL_SCOPE_CONF" \
            "as:" \
            "  $env_name = <one of the keys below>" \
            "or run:  secrets-use $env_name" \
            "Candidates:" \
            "$(bws_keys_for_env_name "$env_name" | sed 's/^/  /')")"
    fi
    # A typo in the map must fail here rather than fall through to a lookup
    # that would quietly resolve to something else.
    bws_keys_for_env_name "$env_name" \
        | grep -qxF -- "$mapped" \
        || die "$(printf '%s\n' \
            "$GLOBAL_SCOPE_CONF maps '$env_name' to" \
            "  $mapped" \
            "which is not one of its BWS keys:" \
            "$(bws_keys_for_env_name "$env_name" | sed 's/^/  /')")"
    BWS_EXACT_KEY="$mapped"
}

list_sensitive_keys() {
    load_secrets
    local keys
    keys=$(printf '%s\n' "$SECRETS_CACHE" \
        | sed -n 's/^[[:space:]]*\([A-Za-z_][A-Za-z0-9_-]*\)=.*/\1/p')
    if ! backend_has_meta; then
        keys=$(printf '%s\n' "$keys" | grep -iE "$KEY_PATTERN")
    fi
    printf '%s\n' "$keys" | sort -u || true
}

print_shell_exports() {
    local key
    local selected_keys=("$@")

    load_secrets

    for key in "${selected_keys[@]}"; do
        # An ambiguous env name resolves via config/secrets-global.conf, or dies.
        # This used to warn and `continue`, which left the function exiting 0
        # with empty stdout — indistinguishable from success to every caller.
        if ! bws_resolve_env_name "$key"; then
            continue          # best-effort mode only; otherwise this died
        fi
        # Assign, then check, then print — never print the substitution inline.
        # `die` inside $(...) kills only the subshell, so a stale-cache miss or a
        # bad base64 would leave printf emitting `export KEY=''`. That line is
        # NON-EMPTY, so every caller's "did I get output?" guard passes and the
        # command runs with the key set to the empty string: the same fail-open
        # this whole change exists to remove, just one layer down.
        local resolved
        if [[ -n "$BWS_EXACT_KEY" ]]; then
            resolved=$(bws_value_for_key "$BWS_EXACT_KEY") \
                || die "Could not read the value for '$BWS_EXACT_KEY' (the BWS record may have been removed)"
            [[ -n "$resolved" ]] \
                || die "Refusing to export an empty value for '$key' (BWS key '$BWS_EXACT_KEY')"
            printf 'export %s=%q\n' "$key" "$resolved"
            continue
        fi
        content_has_key "$SECRETS_CACHE" "$key" \
            || die "$key not found in encrypted secrets"
        resolved=$(get_value_from_content "$SECRETS_CACHE" "$key") \
            || die "Could not read the value for '$key' from the encrypted store"
        [[ -n "$resolved" ]] || die "Refusing to export an empty value for '$key'"
        printf 'export %s=%q\n' "$key" "$resolved"
    done
}

print_shell_bindings() {
    local binding env_key secret_key resolved b64 uuid
    local selected_bindings=("$@")

    load_secrets

    for binding in "${selected_bindings[@]}"; do
        if [[ "$binding" == *=* ]]; then
            env_key="${binding%%=*}"
            secret_key="${binding#*=}"
        else
            env_key="$binding"
            secret_key="$binding"
        fi
        [[ "$env_key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] \
            || die "Invalid environment variable name: $env_key"
        [[ -n "$secret_key" ]] || die "Empty secret binding for $env_key"

        resolved=""
        if backend_has_meta && [[ "$secret_key" == bws-id:* ]]; then
            uuid="${secret_key#bws-id:}"
            b64=$(printf '%s\n' "$BWS_RAW_CACHE" \
                | awk -F'\t' -v id="$uuid" '$4 == id { print $2; exit }')
            [[ -n "$b64" ]] || die "Secret not found by UUID: $uuid (the BWS record may have been removed)"
            resolved=$(printf '%s' "$b64" | base64 -d) \
                || die "Could not decode the value for UUID '$uuid'"
        elif backend_has_meta && { [[ "$secret_key" == *" - "* ]] || [[ "$secret_key" == *[[:space:]]* ]]; }; then
            resolved=$(bws_value_for_key "$secret_key") \
                || die "Could not read the value for '$secret_key' (the BWS record may have been removed)"
        else
            bws_resolve_env_name "$secret_key"
            if [[ -n "$BWS_EXACT_KEY" ]]; then
                resolved=$(bws_value_for_key "$BWS_EXACT_KEY") \
                    || die "Could not read the value for '$BWS_EXACT_KEY' (the BWS record may have been removed)"
            else
                content_has_key "$SECRETS_CACHE" "$secret_key" \
                    || die "$secret_key not found in encrypted secrets"
                resolved=$(get_value_from_content "$SECRETS_CACHE" "$secret_key") \
                    || die "Could not read the value for '$secret_key' from the encrypted store"
            fi
        fi
        [[ -n "$resolved" ]] || die "Refusing to export an empty value for '$env_key'"
        printf 'export %s=%q\n' "$env_key" "$resolved"
    done
}

write_telegram_env() {
    local secret_name="$1"
    local state_dir="$2"
    local env_file tmp_file token desired_content

    load_secrets

    # Under BWS, accept either an exact "ENV - description" key (resolved via
    # raw cache) or a plain env_name (only if exactly one BWS record matches).
    # Refuse ambiguous plain env_names so we never write the wrong tenant's
    # token to the plugin's .env.
    if backend_has_meta; then
        local tg_b64=""
        if [[ "$secret_name" == *" - "* ]]; then
            tg_b64=$(printf '%s\n' "$BWS_RAW_CACHE" | awk -F'\t' -v k="$secret_name" '$1 == k { print $2; exit }')
            [[ -n "$tg_b64" ]] || die "$secret_name not found in BWS"
            token=$(printf '%s' "$tg_b64" | base64 -d)
        else
            # Ambiguous names resolve via config/secrets-global.conf, or die.
            bws_resolve_env_name "$secret_name"
            if [[ -n "$BWS_EXACT_KEY" ]]; then
                token=$(bws_value_for_key "$BWS_EXACT_KEY")
            else
                content_has_key "$SECRETS_CACHE" "$secret_name" || die "$secret_name not found in encrypted secrets"
                token=$(get_value_from_content "$SECRETS_CACHE" "$secret_name")
            fi
        fi
    else
        content_has_key "$SECRETS_CACHE" "$secret_name" || die "$secret_name not found in encrypted secrets"
        token=$(get_value_from_content "$SECRETS_CACHE" "$secret_name")
    fi
    env_file="$state_dir/.env"
    tmp_file="${env_file}.tmp.$$"
    desired_content=$(printf 'TELEGRAM_BOT_TOKEN=%s\n' "$token")

    mkdir -p "$state_dir"
    telegram_state_harden_permissions "$state_dir"

    if [[ -f "$env_file" ]] && [[ "$(cat "$env_file")"$'\n' == "$desired_content" ]]; then
        chmod 600 "$env_file"
        printf '%s\n' "$env_file"
        return 0
    fi

    printf '%s' "$desired_content" > "$tmp_file"
    chmod 600 "$tmp_file"
    mv "$tmp_file" "$env_file"
    telegram_state_harden_permissions "$state_dir"
    printf '%s\n' "$env_file"
}

# ─── bws write helpers ──────────────────────────────────────────────────────

bws_project_id() {
    require_bws
    bws --color no project list 2>/dev/null | python3 -c '
import json, sys
data = json.load(sys.stdin)
if not data:
    print("No BWS projects found", file=sys.stderr)
    sys.exit(1)
print(data[0]["id"])
' || die "Failed to get BWS project ID"
}

bws_find_secrets() {
    # Returns all matching records as TSV: sid\tkey\tnote (one line per match).
    # If exact_key is non-empty, matches by exact bws_key. Otherwise matches
    # by env_name (portion before " - "). Exits 0 with empty output if none
    # found — callers must count lines to detect absence.
    local target_env="$1" exact_key="${2:-}"
    require_bws
    bws_secret_list_json | python3 -c '
import json, sys
env_name = sys.argv[1]
exact_key = sys.argv[2] if len(sys.argv) > 2 else ""
data = json.load(sys.stdin)
for s in data:
    key = s["key"]
    if exact_key:
        if key != exact_key:
            continue
    else:
        en = key.split(" - ", 1)[0].strip() if " - " in key else key
        if en != env_name:
            continue
    note = (s.get("note") or "").strip()
    sid = s["id"]
    print(f"{sid}\t{key}\t{note}")
' "$target_env" "$exact_key"
}

bws_list_full() {
    require_bws
    bws_secret_list_json | python3 -c '
import json, sys, re
data = json.load(sys.stdin)
for s in data:
    key = s["key"]
    env_name = key.split(" - ", 1)[0].strip() if " - " in key else key
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", env_name):
        continue
    note = (s.get("note") or "").strip().replace("\t", " ")
    val = s["value"]
    preview = val[:20] + "..." if len(val) > 20 else val
    sid = s["id"]
    print(f"{sid}\t{env_name}\t{key}\t{preview}\t{note}")
' || die "Failed to list BWS secrets"
}

bws_upsert() {
    # Create or update a BWS secret. When desc is given, target the EXACT
    # "env_name - desc" key so adding a described variant never overwrites a
    # sibling secret with the same env_name. When desc is empty, require
    # unambiguous env_name (refuses to pick a duplicate silently).
    local env_name="$1" value="$2" desc="${3:-}"
    local matches count secret_id project_id bws_key target_label
    if [[ -n "$desc" ]]; then
        bws_key="$env_name - $desc"
        matches=$(bws_find_secrets "$env_name" "$bws_key")
        target_label="$bws_key"
    else
        matches=$(bws_find_secrets "$env_name")
        target_label="$env_name"
    fi
    count=0
    [[ -n "$matches" ]] && count=$(printf '%s\n' "$matches" | grep -c .)
    if [[ "$count" -gt 1 ]]; then
        die "Ambiguous: multiple BWS secrets match env name '$env_name'. Pass --note DESC to target the exact key."
    fi
    if [[ "$count" -eq 1 ]]; then
        secret_id=$(printf '%s' "$matches" | head -n1 | cut -f1)
        bws secret edit --value "$value" "$secret_id" >/dev/null || die "bws secret edit failed"
        echo "Updated: $target_label"
    else
        project_id=$(bws_project_id)
        [[ -n "$desc" ]] || bws_key="$env_name"
        bws secret create "$bws_key" "$value" "$project_id" >/dev/null || die "bws secret create failed"
        echo "Created: $bws_key"
    fi
}

bws_delete_by_env() {
    # Refuses to delete when multiple BWS secrets share the env name, to avoid
    # silently dropping the wrong account/tenant variant.
    local env_name="$1"
    local matches count secret_id
    matches=$(bws_find_secrets "$env_name")
    count=0
    [[ -n "$matches" ]] && count=$(printf '%s\n' "$matches" | grep -c .)
    if [[ "$count" -eq 0 ]]; then
        die "$env_name not found in BWS"
    fi
    if [[ "$count" -gt 1 ]]; then
        die "Ambiguous: multiple BWS secrets match env name '$env_name'. Delete via the BWS UI or a more specific helper."
    fi
    secret_id=$(printf '%s' "$matches" | head -n1 | cut -f1)
    bws secret delete "$secret_id" >/dev/null || die "bws secret delete failed"
    echo "Deleted: $env_name"
}

case "${1:-}" in
    # ── deprecated cache commands ───────────────────────────────────────────
    # There is no cache any more (secrets resolve live), but these stay as
    # no-ops: `.envrc` files generated before the change still shell out to
    # cache-path, and the secret editor / envrc wiring called cache-clear after a
    # mutation. Removing them outright would turn a stale caller into an error
    # for no benefit — there is simply nothing left to invalidate.
    cache-clear)
        ;;
    cache-refresh)
        # Still useful as a connectivity check: it forces a live fetch and
        # exits non-zero if the backend is unreachable.
        load_secrets_from_backend
        echo "Secrets resolve live from $BACKEND; there is no cache to refresh."
        ;;
    cache-path)
        # Prints nothing: callers guard on a non-empty result before using it
        # in `watch_file`.
        ;;
    scope-entries)
        # "active|blocked <TAB> bws_key", in preference order, for one env name.
        # Reads only the conf, so it costs nothing and works with BWS offline —
        # secrets-use uses it instead of parsing the format a second time.
        shift
        [[ $# -eq 1 ]] || die "Usage: dotfiles-secrets scope-entries ENV_NAME"
        global_scope_entries "$1"
        ;;
    scope-conf-path)
        printf '%s\n' "$GLOBAL_SCOPE_CONF"
        ;;
    keys)
        list_sensitive_keys
        ;;
    keys-meta)
        # Tab-separated: env_name\tbws_key\tnote\tuuid
        load_secrets
        if backend_has_meta && [[ -n "$BWS_META_CACHE" ]]; then
            printf '%s\n' "$BWS_META_CACHE"
        else
            while IFS= read -r key; do
                [[ -n "$key" ]] && printf '%s\t%s\t\n' "$key" "$key"
            done < <(list_sensitive_keys)
        fi
        ;;
    bws-dump)
        # Tab-separated: bws_key\tb64_value\tnote\tuuid
        # Used by setup-envrc preview to look up values by BWS key.
        backend_has_meta || die "'bws-dump' needs a backend with a key table (current: $BACKEND)"
        load_secrets
        printf '%s\n' "$BWS_RAW_CACHE"
        ;;
    get-value)
        # Look up a secret by BWS key and print raw value.
        # Used by generated .envrc files: export K="$(dotfiles-secrets get-value 'BWS_KEY')"
        shift
        [[ $# -eq 1 ]] || die "Usage: dotfiles-secrets get-value BWS_KEY"
        gv_target="$1"
        load_secrets
        if backend_has_meta; then
            # UUID-based lookup: bws-id:<uuid> → look up by field 4 of raw cache.
            if [[ "$gv_target" == bws-id:* ]]; then
                gv_uuid="${gv_target#bws-id:}"
                gv_b64=$(printf '%s\n' "$BWS_RAW_CACHE" | awk -F'\t' -v id="$gv_uuid" '$4 == id { print $2; exit }')
                [[ -n "$gv_b64" ]] || die "Secret not found by UUID: $gv_uuid (the BWS record may have been removed)"
                printf '%s' "$gv_b64" | base64 -d
                exit 0
            fi
            # Lookup by exact bws_key match in raw cache.
            gv_b64=$(printf '%s\n' "$BWS_RAW_CACHE" | awk -F'\t' -v k="$gv_target" '$1 == k { print $2; exit }')
            if [[ -z "$gv_b64" ]]; then
                # Env-name fallback: lets callers pass "HF_TOKEN" when the BWS
                # key is exactly "HF_TOKEN" with no description. An ambiguous
                # name resolves via config/secrets-global.conf, or dies — we
                # never silently return an arbitrary duplicate.
                bws_resolve_env_name "$gv_target"
                if [[ -n "$BWS_EXACT_KEY" ]]; then
                    gv_b64=$(printf '%s\n' "$BWS_RAW_CACHE" | awk -F'\t' -v k="$BWS_EXACT_KEY" '$1 == k { print $2; exit }')
                fi
                gv_env_count=$(bws_env_name_count "$gv_target")
                if [[ -z "$gv_b64" && "$gv_env_count" -eq 1 ]]; then
                    gv_bws_key=$(printf '%s\n' "$BWS_META_CACHE" | awk -F'\t' -v e="$gv_target" '$1 == e { print $2; exit }')
                    gv_b64=$(printf '%s\n' "$BWS_RAW_CACHE" | awk -F'\t' -v k="$gv_bws_key" '$1 == k { print $2; exit }')
                fi
            fi
            [[ -n "$gv_b64" ]] || die "Secret not found: $gv_target"
            printf '%s' "$gv_b64" | base64 -d
        else
            content_has_key "$SECRETS_CACHE" "$gv_target" || die "Secret not found: $gv_target"
            get_value_from_content "$SECRETS_CACHE" "$gv_target"
        fi
        ;;
    dotenv)
        load_secrets
        printf '%s\n' "$SECRETS_CACHE"
        ;;
    shell-bindings)
        shift
        [[ $# -gt 0 ]] || die "Usage: dotfiles-secrets shell-bindings [ENV=]SECRET [...]"
        print_shell_bindings "$@"
        ;;
    shell)
        shift
        if [[ "${1:-}" == "--all" ]]; then
            SECRETS_BEST_EFFORT=true   # bulk request: skip+warn, don't abort
            selected_keys=()
            while IFS= read -r key; do
                [[ -n "$key" ]] && selected_keys+=("$key")
            done < <(list_sensitive_keys)
        else
            [[ $# -gt 0 ]] || die "Usage: dotfiles-secrets shell [--all|KEY ...]"
            selected_keys=("$@")
        fi
        print_shell_exports "${selected_keys[@]}"
        ;;
    paths)
        printf 'DOTFILES_SECRETS_BACKEND=%s\n' "$BACKEND"
        printf 'DOTFILES_SECRETS_DIR=%s\n' "$(dotfiles_secrets_dir)"
        if [[ "$BACKEND" == "bws" ]]; then
            printf 'BWS_TOKEN_FILE=%s\n' "$BWS_TOKEN_FILE"
        fi
        ;;
    fix-perms)
        dotfiles_secrets_harden_permissions
        ;;
    write-telegram-env)
        shift
        [[ $# -eq 2 ]] || die "Usage: dotfiles-secrets write-telegram-env SECRET_NAME STATE_DIR"
        write_telegram_env "$1" "$2"
        ;;
    set)
        shift
        [[ "$BACKEND" == "bws" ]] || die "'set' requires bws backend (current: $BACKEND)."
        set_key="" set_value="" set_desc=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --note|--desc) set_desc="$2"; shift 2 ;;
                *)
                    if [[ -z "$set_key" ]]; then set_key="$1"
                    elif [[ -z "$set_value" ]]; then set_value="$1"
                    else die "Unexpected arg: $1"
                    fi
                    shift ;;
            esac
        done
        [[ -n "$set_key" ]] || die "Usage: dotfiles-secrets set KEY [VALUE] [--note DESC]"
        if [[ -z "$set_value" ]]; then
            printf 'Value for %s: ' "$set_key" >&2
            # read exits nonzero on EOF without a trailing newline (piped secret
            # files rarely end in one) — `|| true` keeps set -e from aborting
            # before the emptiness check below runs.
            IFS= read -rs set_value || true
            echo "" >&2
        fi
        [[ -n "$set_value" ]] || die "Empty value"
        # Settle the machine default BEFORE the remote key exists (R4).
        preserve_machine_default_before_add "$set_key"
        bws_upsert "$set_key" "$set_value" "$set_desc"
        offer_new_key_as_default "$set_key"
        ;;
    rm)
        shift
        [[ "$BACKEND" == "bws" ]] || die "'rm' requires bws backend (current: $BACKEND)."
        rm_yes=false
        rm_key=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --yes|-y) rm_yes=true; shift ;;
                *) rm_key="$1"; shift ;;
            esac
        done
        [[ -n "$rm_key" ]] || die "Usage: dotfiles-secrets rm [--yes] KEY"
        if ! $rm_yes; then
            printf 'Delete %s? (y/N) ' "$rm_key" >&2
            read -r rm_confirm
            [[ "$rm_confirm" == [yY]* ]] || { echo "Cancelled."; exit 0; }
        fi
        bws_delete_by_env "$rm_key"
        ;;
    list-full)
        [[ "$BACKEND" == "bws" ]] || die "'list-full' requires bws backend"
        bws_list_full
        ;;
    *)
        cat >&2 <<EOF
Usage:
  dotfiles-secrets keys              List env var names
  dotfiles-secrets keys-meta         List env_name, bws_key, note (tab-separated)
  dotfiles-secrets bws-dump          Dump bws_key, b64(value), note (TSV, BWS only)
  dotfiles-secrets get-value BWS_KEY Print the raw value for a secret (by bws_key)
  dotfiles-secrets dotenv            Dump all secrets as dotenv
  dotfiles-secrets shell KEY [...]   Print shell export statements
  dotfiles-secrets shell-bindings [ENV=]SECRET [...]  Resolve mixed bindings in one fetch
  dotfiles-secrets shell --all       Export all secrets
  dotfiles-secrets set KEY [VAL] [--note DESC]   Create or update a BWS secret
  dotfiles-secrets rm [--yes] KEY    Delete a BWS secret
  dotfiles-secrets list-full         List BWS secrets with IDs (for tooling)
  dotfiles-secrets paths             Show backend config paths
  dotfiles-secrets fix-perms         Fix file permissions
  dotfiles-secrets write-telegram-env SECRET_NAME STATE_DIR
  dotfiles-secrets scope-entries ENV Show conf preference order + blocked state
  dotfiles-secrets cache-clear       Deprecated no-op (no cache exists)
  dotfiles-secrets cache-refresh     Deprecated; forces a live fetch as a reachability check
  dotfiles-secrets cache-path        Deprecated no-op (prints nothing)

  Backend: $BACKEND (auto: bws if token exists)
  No cache: secrets resolve live on every call (~0.5s). Which key an ambiguous
  env name resolves to is declared in $GLOBAL_SCOPE_CONF — edit it via secrets-use.
  BWS key convention: "ENV_VAR_NAME - description" → env var is part before " - "
EOF
        exit 1
        ;;
esac
