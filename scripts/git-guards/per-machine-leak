#!/usr/bin/env bash
# per-machine-leak REPO_PATH < blob: run per-machine-leak.py on a Python that
# has tomllib. Exit codes are the checker's (0 safe, 1 unsafe); 3 means no
# runtime was found, and callers treat every non-zero exit as unsafe, so this
# fails closed.
#
# uv first, as the repo's other uv scripts run: `uv run --script` honours the
# script's requires-python >=3.11 whatever python3 the machine has. Without uv,
# the first python3 / python3.1x on PATH that is >= 3.11. The system python3 is
# not guaranteed to be (config/systemd-user/model-router-cooldown.service), and
# under an old one the TOML check would reject every clean Codex config.
#
# bash, not zsh: both callers (config/git-hooks/pre-commit, dotfiles-sync) are
# bash, and a launcher on a fail-closed path must not need a second shell.
set -u
py="${BASH_SOURCE[0]%/*}/per-machine-leak.py"

if command -v uv >/dev/null 2>&1; then
    exec uv run --quiet --script "$py" "$@"
fi

seen=()
for cand in python3 python3.14 python3.13 python3.12 python3.11; do
    command -v "$cand" >/dev/null 2>&1 || continue
    if "$cand" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
        exec "$cand" "$py" "$@"
    fi
    seen+=("$cand $("$cand" -c 'import sys; print(sys.version.split()[0])' 2>/dev/null || echo '?')")
done

found="${seen[*]:-none}"
echo "no runtime for the per-machine leak check: needs uv, or python3 >= 3.11 (found: ${found// python/, python}); failing closed"
exit 3
