#!/usr/bin/env zsh
# obs-start: start OBS Studio in the background, minimised to the Dock, on the Focusmate
# profile and scene collection, with the virtual camera on.
#
# `obs` on PATH is Homebrew's wrapper, which runs OBS in the foreground tied to
# the terminal; this detaches through LaunchServices instead. clear-mac-apps
# minimises OBS too (config/app-lifecycle.yaml), never quits it, so the
# virtual camera keeps feeding Focusmate.
#
# Usage: obs-start [--show] [--no-vcam] [--profile NAME] [--collection NAME] [--dry-run]

emulate -L zsh
setopt no_unset pipe_fail

profile=Focusmate
collection=Focusmate
show=false
vcam=true
dry_run=false

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  ok()   { print -P "%F{green}$1%f" }
  warn() { print -P "%F{yellow}$1%f" >&2 }
  err()  { print -P "%F{red}$1%f" >&2 }
else
  ok()   { print -r -- "$1" }
  warn() { print -r -- "$1" >&2 }
  err()  { print -r -- "$1" >&2 }
fi

usage() {
  cat <<'EOF'
obs-start: start OBS Studio minimised to the Dock, on the Focusmate profile and scene, with the virtual camera on.

Usage: obs-start [options]
  --show             Bring the OBS window to the front instead of minimising it
  --no-vcam          Do not start the virtual camera
  --profile NAME     OBS profile to use (default: Focusmate)
  --collection NAME  OBS scene collection to use (default: Focusmate)
  -n, --dry-run      Print the launch command without running it
  -h, --help         Show this help

If OBS is already running, it is left as it is (OBS ignores launch arguments
then); --show brings it to the front. Minimise it again with Cmd+M or clear-mac-apps.
Profile and scene are synced from dotfiles: deploy.sh --obs / sync-obs.
EOF
}

while (( $# )); do
  case $1 in
    --show) show=true ;;
    --no-vcam) vcam=false ;;
    --profile) [[ -n ${2:-} ]] || { err "--profile needs a name"; exit 64 }; profile=$2; shift ;;
    --collection) [[ -n ${2:-} ]] || { err "--collection needs a name"; exit 64 }; collection=$2; shift ;;
    -n|--dry-run) dry_run=true ;;
    -h|--help) usage; exit 0 ;;
    *) err "obs-start: unknown option: $1"; usage >&2; exit 64 ;;
  esac
  shift
done

[[ $OSTYPE == darwin* ]] || { err "obs-start: macOS only"; exit 69 }
[[ -d /Applications/OBS.app ]] || { err "obs-start: /Applications/OBS.app not found (brew install --cask obs)"; exit 69 }

obs_dir="$HOME/Library/Application Support/obs-studio/basic"
[[ -f "$obs_dir/profiles/$profile/basic.ini" ]] \
  || warn "warning: no OBS profile '$profile' yet; OBS will fall back to its last one (run: deploy.sh --obs)"
if [[ ! -f "$obs_dir/scenes/$collection.json" ]]; then
  if $vcam; then
    # OBS would fall back to its last scene and put THAT on the virtual camera,
    # which may be a full-screen capture nobody meant to share.
    err "obs-start: no OBS scene collection '$collection'; refusing to start the virtual camera on another scene (run: deploy.sh --obs, or pass --no-vcam)"
    exit 78
  fi
  warn "warning: no OBS scene collection '$collection' yet; OBS will fall back to its last one (run: deploy.sh --obs)"
fi

open_cmd=(open -a OBS)
$show || open_cmd+=(-g)   # keep it in the background; not -j, a hidden app's minimised windows stay off the Dock
open_cmd+=(--args --profile "$profile" --collection "$collection" --disable-missing-files-check)
$vcam && open_cmd+=(--startvirtualcam)

if pgrep -qx OBS 2>/dev/null; then
  if $show; then
    $dry_run && { print -r -- "open -a OBS"; exit 0 }
    open -a OBS || { err "obs-start: could not bring OBS to front (open exit $?)"; exit 1 }
    ok "OBS already running: brought to front"
  else
    ok "OBS already running: left as it is (launch arguments only apply to a fresh start)"
  fi
  exit 0
fi

if $dry_run; then
  print -r -- "${(j: :)${(q-)open_cmd[@]}}"
  exit 0
fi

"${open_cmd[@]}" || { err "obs-start: launching OBS failed (open exit $?)"; exit 1 }

if ! $show; then
  # Minimise OBS's windows to the Dock once its main window exists, the same
  # AXMinimized route as clear-mac-apps' minimise_app. Detached so the shell
  # returns at once; needs the Accessibility permission clear-mac-apps uses.
  {
    for _ in {1..40}; do
      osascript -e 'tell application "System Events" to tell (first process whose name is "OBS")
        if (count of windows) = 0 then error "no window yet"
        repeat with w in windows
          set value of attribute "AXMinimized" of w to true
        end repeat
      end tell' >/dev/null 2>&1 && break
      sleep 0.5
    done
  } &!
fi

ok "OBS started: profile $profile, scene collection $collection, virtual camera $($vcam && print on || print off), $($show && print shown || print minimised)"
