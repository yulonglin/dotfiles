#!/usr/bin/env bash
# fx — convert an amount to USD, showing the high / low / latest conversion
# over the trailing 3 months of ECB daily reference rates.
# Data: api.frankfurter.app (free, no key). Rates update once per weekday.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: fx [-q] [--fresh] AMOUNT CURRENCY

Convert AMOUNT of CURRENCY to USD over the trailing 3 months of ECB
daily reference rates (high / low / latest).

  -q        print only the highest USD amount (for piping)
  --fresh   bypass the daily cache and refetch
  -h        show this help

Examples:
  fx 100 EUR
  fx -q 2500 sgd
EOF
}

quiet=0 fresh=0
args=()
for a in "$@"; do
  case "$a" in
    -q) quiet=1 ;;
    --fresh) fresh=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) printf 'fx: unknown option %s\n' "$a" >&2; usage >&2; exit 2 ;;
    *) args+=("$a") ;;
  esac
done
[[ ${#args[@]} -eq 2 ]] || { usage >&2; exit 2; }
amount=${args[0]}
cur=$(printf '%s' "${args[1]}" | tr '[:lower:]' '[:upper:]')

[[ $amount =~ ^[0-9]+([.][0-9]+)?$ ]] || {
  printf "fx: amount must be a number, got '%s'\n" "$amount" >&2; exit 2
}

if [[ $cur == USD ]]; then
  if (( quiet )); then printf '%s\n' "$amount"; else printf '%s USD is already USD\n' "$amount"; fi
  exit 0
fi

today=$(date +%F)
# GNU date first, BSD (macOS) fallback
if ! start=$(date -d '3 months ago' +%F 2>/dev/null); then
  start=$(date -v-3m +%F)
fi

cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/fx
mkdir -p "$cache_dir"
cache="$cache_dir/$cur-$today.json"

if (( fresh )) || [[ ! -s $cache ]]; then
  tmp="$cache.tmp.$$"
  if curl -fsS --max-time 15 \
      "https://api.frankfurter.app/${start}..${today}?from=${cur}&to=USD" -o "$tmp"; then
    mv "$tmp" "$cache"
    # prune this currency's stale cache entries
    find "$cache_dir" -name "$cur-*.json" ! -name "${cache##*/}" -delete 2>/dev/null || true
  else
    rm -f "$tmp"
    # fall back to the newest cached series for this currency, if any
    shopt -s nullglob
    old=("$cache_dir/$cur-"*.json)
    shopt -u nullglob
    if (( ${#old[@]} )); then
      cache=${old[-1]}
      printf 'fx: fetch failed; using cached rates (%s)\n' "${cache##*/}" >&2
    else
      printf 'fx: could not fetch rates for %s (unknown currency, or network down)\n' "$cur" >&2
      exit 1
    fi
  fi
fi

jq -r --arg amt "$amount" --argjson quiet "$quiet" '
  def money: (. * 100 | round) as $c
    | "\($c / 100 | floor).\($c % 100 | tostring | if length == 1 then "0" + . else . end)";
  (.rates | to_entries | map({date: .key, rate: .value.USD})) as $r
  | ($r | max_by(.rate)) as $hi
  | ($r | min_by(.rate)) as $lo
  | ($r | max_by(.date)) as $now
  | ($amt | tonumber) as $a
  | if $quiet == 1 then ($a * $hi.rate | money)
    else
      "\($amt) \(.base) -> USD over the past 3 months:",
      "  high    \($a * $hi.rate | money) USD  (\($hi.rate) on \($hi.date))",
      "  low     \($a * $lo.rate | money) USD  (\($lo.rate) on \($lo.date))",
      "  latest  \($a * $now.rate | money) USD  (\($now.rate) on \($now.date))"
    end
' "$cache"
