#!/usr/bin/env bash
# dotfiles-sync: commit, rebase and push a checkout so every machine converges.
#
# Installed as a daily job by scripts/cleanup/setup_dotfiles_sync.sh (launchd on
# macOS, cron on Linux), and runnable by hand. For each repo, in order:
#
#   0. preflight: the effective pre-commit hook (core.hooksPath, else the
#      repo's hooks dir) must be executable and resolve to this checkout's
#      config/git-hooks/pre-commit. Otherwise the repo is failed before anything
#      is staged: the hold-back below only works when that hook rejects, and on
#      a machine without it (hn, 2026-10-04: core.hooksPath=.git/hooks, empty)
#      the gateway token and Codex trust tables would be committed and pushed.
#   1. fetch the branch's upstream
#   2. commit the dirty tree as "sync: <host> <utc>" -- THROUGH the pre-commit
#      hook, never --no-verify, so the settings.json key guard and gitleaks stay
#      live. Before that, each staged hold-back path whose staged blob carries a
#      known per-machine leak (gateway URL, trust table, ssh_connections) is
#      unstaged by the script itself, so holding back does not depend on the
#      hook alone. If the hook rejects and any hold-back path is staged, those paths
#      are unstaged and the commit retried once; each is then offered to the
#      hook on its own, and only the ones it still rejects are held back.
#      Each one is a file whose
#      working copy can carry a per-machine diff that a guard exists to keep
#      out of the public repo: claude/settings.json (gateway env),
#      codex/config.toml (Codex's [projects."<path>"] trust tables) and
#      config/zed/settings.json (Zed's ssh_connections hosts). The Zed file is
#      only a fallback: where the zed-ssh clean filter is configured it strips
#      the block before git stores it, the hook never rejects, and it ships.
#   3. rebase onto the upstream. A conflict is aborted, never resolved here.
#      Zed's ssh_connections exists only in the working copy, so it is saved
#      to the state dir first and put back afterwards if the rebase dropped it.
#   4. push. Never --force. First every outgoing commit is screened: if any
#      one of them stores a hold-back blob that scripts/git-guards/per-machine-leak
#      rejects, nothing is pushed and the repo fails. History is not rewritten.
#
# Every outcome lands in $DOTFILES_SYNC_STATE_DIR/<repo>.json, which the
# nudge_dotfiles_sync.sh session-start hook reads, because a log file nobody
# opens is not a notification. A failure also raises a macOS notification.
#
# Exit codes: 0 every repo synced, 1 at least one repo failed, 2 usage error.
set -uo pipefail

# Scheduled jobs inherit a minimal PATH: launchd has no /opt/homebrew/bin, cron
# has no ~/.local/bin. gitleaks lives in one of these; without it the pre-commit
# hook falls back to a weaker grep.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:$PATH"

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    _dir="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$_dir/$SCRIPT_PATH"
done
DOT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"

STATE_DIR="${DOTFILES_SYNC_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-sync}"
NOTIFY="${DOTFILES_SYNC_NOTIFY:-1}"
# Paths (space-separated) held back from the sync commit when the pre-commit
# hook rejects it. Paths here never contain spaces.
HOLD_BACK="${DOTFILES_SYNC_HOLD_BACK:-claude/settings.json codex/config.toml config/zed/settings.json}"
read -r -a HOLD_BACK_PATHS <<<"$HOLD_BACK"
# The hook every synced repo must run before the sync may commit.
REQUIRED_HOOK="${DOTFILES_SYNC_REQUIRED_HOOK:-$DOT_DIR/config/git-hooks/pre-commit}"
# Decides whether a protected file's blob is safe to publish; shared with the hook.
LEAK_CHECK="$DOT_DIR/scripts/git-guards/per-machine-leak"
DRY_RUN=0
PRUNE=0
STALE_DAYS="${DOTFILES_SYNC_STALE_DAYS:-14}"
LOCK_DIR=""

usage() {
    cat <<EOF
Usage: dotfiles-sync [--dry-run] [--prune] [--help] [REPO ...]

Commit, rebase and push each REPO (default: this dotfiles checkout, plus
~/code/dotfiles-personal when it exists, or \$DOTFILES_SYNC_REPOS, colon-separated).

  --dry-run   Fetch and report what would be committed, rebased and pushed.
  --prune     Instead of syncing: remove each REPO's Claude worktrees
              (<repo>/.claude/worktrees/*) whose branch has no commits beyond
              the checked-out branch, delete those branches with \`branch -d\`,
              and \`remote prune\`. Never --force, never -D: dirty, locked,
              tmux-attached and unmerged worktrees are kept and reported, and
              an unmerged one older than \$DOTFILES_SYNC_STALE_DAYS is listed
              as stale for the session-start nudge.
  --help      This text.

Environment:
  DOTFILES_SYNC_STATE_DIR   Where <repo>.json outcome files go
                            (default \$XDG_STATE_HOME/dotfiles-sync).
  DOTFILES_SYNC_NOTIFY=0    Suppress the macOS notification on failure.
  DOTFILES_SYNC_HOLD_BACK   Space-separated paths unstaged and retried without
                            when the pre-commit hook rejects (default
                            "claude/settings.json codex/config.toml
                            config/zed/settings.json").
  DOTFILES_SYNC_REQUIRED_HOOK
                            The pre-commit hook each repo's effective hooks dir
                            must resolve to, or the repo is not synced (default
                            this checkout's config/git-hooks/pre-commit).
  DOTFILES_SYNC_STALE_DAYS  Age (last commit) after which an unmerged worktree
                            is reported as stale by --prune (default 14).
EOF
}

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

run_with_timeout() {
    local secs="$1"; shift
    if command -v timeout >/dev/null 2>&1; then timeout "$secs" "$@"
    elif command -v gtimeout >/dev/null 2>&1; then gtimeout "$secs" "$@"
    else "$@"
    fi
}

notify() {
    [[ "$NOTIFY" == "1" ]] || return 0
    [[ "$(uname -s)" == "Darwin" ]] || return 0
    osascript -e "display notification \"$1\" with title \"dotfiles-sync\"" >/dev/null 2>&1 || true
}

# write_state NAME STATUS MESSAGE PULLED PUSHED HELD
write_state() {
    mkdir -p "$STATE_DIR"
    python3 - "$STATE_DIR/$1.json" "$@" <<'PY'
import json, sys, datetime, socket
out, name, status, message, pulled, pushed, held = sys.argv[1:8]
json.dump({
    "repo": name, "status": status, "message": message,
    "pulled": int(pulled), "pushed": int(pushed), "held_back": held,
    "host": socket.gethostname().split(".")[0],
    "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
}, open(out, "w"), indent=2)
PY
}

# stage_dirty: tracked modifications and deletions, then untracked files that
# are regular files or symlinks. Not `git add -A`: inside the Claude sandbox on
# Linux, denied paths show up as phantom character devices that -A would stage.
stage_dirty() {
    git add -u -- . || return 1
    local f
    while IFS= read -r -d '' f; do
        [[ -f "$f" || -L "$f" ]] && git add -- "$f"
    done < <(git ls-files --others --exclude-standard -z)
    return 0
}

# staged_hold_back: the hold-back paths currently staged, space-separated in
# HOLD_BACK order; empty when none are. A single string because the state file's
# held_back field, and the nudge hook that reads it, take one.
staged_hold_back() {
    local staged p out=()
    staged="$(git diff --cached --name-only)"
    for p in "${HOLD_BACK_PATHS[@]}"; do
        grep -qxF -- "$p" <<<"$staged" && out+=("$p")
    done
    printf '%s' "${out[*]:-}"
}

# order_hold_back "PATHS": the hold-back paths named in PATHS, de-duplicated and
# in HOLD_BACK order.
order_hold_back() {
    local p out=()
    for p in "${HOLD_BACK_PATHS[@]}"; do
        [[ " $1 " == *" $p "* ]] && out+=("$p")
    done
    printf '%s' "${out[*]:-}"
}

# blob_leak OBJECT PATH: succeeds when blob OBJECT, stored at PATH, carries a
# per-machine value. The decision is scripts/git-guards/per-machine-leak, the
# checker the pre-commit hook also calls, so a hold-back path stays out of the
# public repo even if the hook never runs. Any checker failure, a missing
# checker included, counts as a leak: this fails closed. Blobs are what git
# stores, after the clean filter, so a Zed file the zed-ssh filter stripped
# passes.
blob_leak() {
    ! git cat-file blob "$1" 2>/dev/null | "$LEAK_CHECK" "$2" >/dev/null 2>&1
}

# staged_leak PATH: blob_leak on the staged copy of PATH; fails when none is staged.
staged_leak() {
    git cat-file -e ":$1" 2>/dev/null || return 1
    blob_leak ":$1" "$1"
}

# outgoing_leak UPSTREAM: "<short sha> <path>" for the first commit in
# UPSTREAM..HEAD (every outgoing commit, not just the tip, so a value a later
# commit removed still counts) whose hold-back blob differs from UPSTREAM's and
# leaks; empty when none does. A blob identical to UPSTREAM's is already public.
outgoing_leak() {
    local up="$1" c p blob
    for c in $(git rev-list "$up..HEAD"); do
        for p in "${HOLD_BACK_PATHS[@]}"; do
            blob="$(git rev-parse -q --verify "$c:$p" 2>/dev/null)" || continue
            [[ "$blob" == "$(git rev-parse -q --verify "$up:$p" 2>/dev/null)" ]] && continue
            if blob_leak "$blob" "$p"; then
                printf '%s %s' "$(git rev-parse --short "$c")" "$p"
                return 0
            fi
        done
    done
}

# screen_hold_back: unstage each staged hold-back path whose staged blob leaks,
# and print those paths space-separated.
screen_hold_back() {
    local p out=() staged
    read -r -a staged <<<"$(staged_hold_back)"
    for p in "${staged[@]}"; do
        if staged_leak "$p"; then
            git reset -q -- "$p"
            out+=("$p")
        fi
    done
    printf '%s' "${out[*]:-}"
}

# hook_problem: why this repo's effective pre-commit hook is not REQUIRED_HOOK,
# or nothing when it is. The effective hooks dir is core.hooksPath (relative to
# the top level, as git resolves it), else the common git dir's hooks/.
hook_problem() {
    local dir hook
    dir="$(git config --path core.hooksPath 2>/dev/null || true)"
    if [[ -z "$dir" ]]; then
        dir="$(git rev-parse --git-common-dir)/hooks"
    elif [[ "$dir" != /* ]]; then
        dir="$(git rev-parse --show-toplevel)/$dir"
    fi
    hook="$dir/pre-commit"
    if [[ ! -e "$hook" ]]; then
        printf 'no pre-commit hook at %s' "$hook"
    elif [[ ! -x "$hook" ]]; then
        printf '%s is not executable' "$hook"
    elif ! python3 -c 'import os, sys; sys.exit(os.path.realpath(sys.argv[1]) != os.path.realpath(sys.argv[2]))' "$hook" "$REQUIRED_HOOK"; then
        printf '%s is not %s' "$hook" "$REQUIRED_HOOK"
    fi
}

# Zed's ssh_connections lives only in the working copy: the zed-ssh clean filter
# strips it from every blob, so git sees the file as clean and a rebase that
# brings in a Zed settings change rewrites it without the block. zed_save copies
# the member to the state dir before the rebase and zed_restore appends it back
# afterwards if the file now lacks it. A block still present is never touched,
# and on any doubt the file is left as it is and the saved copy stays.
ZED_SETTINGS="config/zed/settings.json"
ZED_FILTER="$DOT_DIR/scripts/git-filters/zed-strip-ssh-connections"
ZED_SAVED=""
ZED_NOTE=""

zed_save() {
    # zed_save NAME -> sets ZED_SAVED to the saved member's path, or ""
    ZED_SAVED=""
    [[ -f "$ZED_SETTINGS" && -x "$ZED_FILTER" ]] || return 0
    mkdir -p "$STATE_DIR"
    local backup="$STATE_DIR/$1.zed-ssh-connections.json" tmp rc=0
    tmp="$(mktemp "$STATE_DIR/.zed-extract.XXXXXX")" || return 0
    "$ZED_FILTER" --extract <"$ZED_SETTINGS" >"$tmp" 2>/dev/null || rc=$?
    case "$rc" in
        0) mv -f "$tmp" "$backup" && ZED_SAVED="$backup" ;;
        1) rm -f "$tmp" ;;
        *)
            rm -f "$tmp"
            cp -p "$ZED_SETTINGS" "$STATE_DIR/$1.zed-settings.backup.json"
            log "$1: WARNING: could not read ssh_connections from $ZED_SETTINGS; whole file copied to $STATE_DIR/$1.zed-settings.backup.json"
            ;;
    esac
    return 0
}

zed_restore() {
    # zed_restore NAME: after a rebase, put ZED_SAVED back if the key is gone
    [[ -n "$ZED_SAVED" ]] || return 0
    local tmp rc=0
    if [[ -f "$ZED_SETTINGS" ]] && tmp="$(mktemp "$STATE_DIR/.zed-restore.XXXXXX")"; then
        "$ZED_FILTER" --restore "$ZED_SAVED" <"$ZED_SETTINGS" >"$tmp" 2>/dev/null || rc=$?
    else
        rc=2
    fi
    case "$rc" in
        0)
            # Write through the existing file so its mode and inode are kept.
            cat "$tmp" >"$ZED_SETTINGS"
            log "$1: restored Zed ssh_connections after the rebase"
            ;;
        1) : ;;  # still present after the rebase: never overwritten
        *)
            ZED_NOTE="Zed ssh_connections not restored; saved at $ZED_SAVED"
            log "$1: WARNING: $ZED_NOTE"
            ;;
    esac
    rm -f "${tmp:-}"
    return 0
}

fail_repo() {
    # fail_repo NAME MESSAGE PULLED PUSHED HELD
    log "$1: FAILED: $2"
    write_state "$1" failed "$2" "${3:-0}" "${4:-0}" "${5:-}"
    notify "$1: $2"
    return 1
}

sync_repo() {
    local repo="$1" name
    name="$(basename "$repo")"
    if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        log "$name: not a git checkout, skipped"
        return 0
    fi
    cd "$repo" || return 1
    ZED_SAVED="" ZED_NOTE=""

    local git_dir s
    git_dir="$(git rev-parse --git-dir)"
    for s in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply BISECT_LOG index.lock; do
        [[ -e "$git_dir/$s" ]] && { fail_repo "$name" "$s present: an operation is in progress, skipped"; return 1; }
    done

    # ── 0. preflight: the guard hook must be the one that runs ──────────────
    local hook_err
    hook_err="$(hook_problem)"
    if [[ -n "$hook_err" ]]; then
        hook_err="pre-commit guard hook missing ($hook_err); nothing committed. Fix: ./deploy.sh --git-hooks"
        # A repo-local core.hooksPath outranks the global one deploy.sh sets.
        git config --local --get core.hooksPath >/dev/null 2>&1 \
            && hook_err="$hook_err, then git -C $repo config --unset core.hooksPath"
        if (( DRY_RUN )); then log "$name: would refuse: $hook_err"; return 1; fi
        fail_repo "$name" "$hook_err"; return 1
    fi

    local branch remote upstream
    branch="$(git symbolic-ref --short -q HEAD)" || { fail_repo "$name" "detached HEAD, skipped"; return 1; }
    remote="$(git config "branch.$branch.remote" 2>/dev/null || true)"
    remote="${remote:-origin}"
    upstream="refs/remotes/$remote/$branch"

    if ! run_with_timeout 120 git fetch --quiet "$remote" 2>/dev/null; then
        fail_repo "$name" "fetch from $remote failed (offline?)"; return 1
    fi
    git rev-parse -q --verify "$upstream" >/dev/null || { fail_repo "$name" "no $remote/$branch to sync with"; return 1; }

    # ── 1. commit ────────────────────────────────────────────────────────────
    local held="" screened="" dirty_after=0 committed=0 msg
    msg="sync: $(hostname -s 2>/dev/null || hostname) $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
        if (( DRY_RUN )); then
            log "$name: would commit:"; git status --short | sed 's/^/    /'
        else
            stage_dirty
            screened="$(screen_hold_back)"
            [[ -n "$screened" ]] && log "$name: holding back $screened (staged copy carries a per-machine value)"
            if git diff --cached --quiet; then
                log "$name: dirty tree but nothing stageable"
            elif git commit --quiet -m "$msg" >/dev/null 2>"$STATE_DIR/$name.commit.err"; then
                committed=1
            elif held="$(staged_hold_back)" && [[ -n "$held" ]]; then
                # The hook said no, and does not say which file it objected to.
                # Unstage every per-machine file, commit the rest, then offer
                # each held file to the hook on its own: only the ones it still
                # rejects stay held. Without that second pass a permanently dirty
                # codex/config.toml would starve every settings.json edit.
                local -a held_paths
                local p still_held=()
                read -r -a held_paths <<<"$held"
                git reset -q -- "${held_paths[@]}"
                if ! git diff --cached --quiet; then
                    if git commit --quiet -m "$msg" >/dev/null 2>"$STATE_DIR/$name.commit.err"; then
                        committed=1
                    else
                        git reset -q
                        fail_repo "$name" "pre-commit rejected the sync commit: $(tail -1 "$STATE_DIR/$name.commit.err" 2>/dev/null)"; return 1
                    fi
                fi
                for p in "${held_paths[@]}"; do
                    git add -- "$p"
                    if (( committed )) && git commit --quiet --amend --no-edit >/dev/null 2>&1; then
                        :
                    elif (( ! committed )) && git commit --quiet -m "$msg" >/dev/null 2>&1; then
                        committed=1
                    else
                        git reset -q -- "$p"
                        still_held+=("$p")
                    fi
                done
                held="${still_held[*]:-}"
                if [[ -z "$held" ]]; then
                    : # every file passed on its own; nothing is held
                elif (( committed )); then
                    log "$name: committed without $held (pre-commit rejected it)"
                else
                    log "$name: only $held was dirty and the pre-commit hook rejected it; held back"
                fi
            else
                git reset -q
                fail_repo "$name" "pre-commit rejected the sync commit: $(tail -1 "$STATE_DIR/$name.commit.err" 2>/dev/null)"; return 1
            fi
            rm -f "$STATE_DIR/$name.commit.err"
            held="$(order_hold_back "$screened $held")"
            (( committed )) && log "$name: committed '$msg'"
        fi
    fi
    [[ -n "$(git status --porcelain --untracked-files=no)" ]] && dirty_after=1

    # ── 2. rebase ────────────────────────────────────────────────────────────
    local behind ahead pulled=0
    behind="$(git rev-list --count "HEAD..$upstream")"
    ahead="$(git rev-list --count "$upstream..HEAD")"
    if (( behind > 0 )); then
        if (( DRY_RUN )); then
            log "$name: would rebase $ahead local commit(s) onto $behind from $remote/$branch"
        else
            local -a rb=(git rebase --quiet)
            # A held-back file leaves the tree dirty; autostash carries it over
            # and, if re-applying conflicts, keeps it in the stash rather than
            # dropping it.
            (( dirty_after )) && rb+=(--autostash)
            zed_save "$name"
            if ! "${rb[@]}" "$upstream" >/dev/null 2>"$STATE_DIR/$name.rebase.err"; then
                git rebase --abort >/dev/null 2>&1 || true
                zed_restore "$name"
                fail_repo "$name" "rebase onto $remote/$branch conflicted; aborted, tree untouched ($ahead local vs $behind remote commits)" 0 0 "$held"
                return 1
            fi
            rm -f "$STATE_DIR/$name.rebase.err"
            zed_restore "$name"
            pulled="$behind"
            log "$name: rebased onto $remote/$branch (+$behind)"
        fi
    fi

    # ── 3. push ──────────────────────────────────────────────────────────────
    ahead="$(git rev-list --count "$upstream..HEAD")"
    local pushed=0 leak
    if (( ahead > 0 )); then
        # The commit step guards only the commit it makes. Commits already ahead
        # of the upstream (made with --no-verify, or on a machine with no hook)
        # are screened here, every one of them, before anything leaves. History
        # is never rewritten automatically.
        leak="$(outgoing_leak "$upstream")"
        if [[ -n "$leak" ]]; then
            leak="outgoing commit ${leak% *} carries per-machine content in ${leak#* }; nothing pushed. Remove it from local history by hand (git rebase -i $remote/$branch), then rerun"
            if (( DRY_RUN )); then log "$name: would refuse: $leak"; return 1; fi
            fail_repo "$name" "$leak" "$pulled" 0 "$held"; return 1
        fi
        if (( DRY_RUN )); then
            log "$name: would push $ahead commit(s) to $remote/$branch"
        elif run_with_timeout 120 git push --quiet "$remote" "HEAD:refs/heads/$branch" 2>"$STATE_DIR/$name.push.err"; then
            pushed="$ahead"
            rm -f "$STATE_DIR/$name.push.err"
            log "$name: pushed $ahead commit(s)"
        else
            fail_repo "$name" "push to $remote/$branch failed: $(tail -1 "$STATE_DIR/$name.push.err" 2>/dev/null)" "$pulled" 0 "$held"
            return 1
        fi
    fi

    (( DRY_RUN )) && return 0
    local summary="in sync"
    (( pulled > 0 || pushed > 0 )) && summary="pulled $pulled, pushed $pushed"
    [[ -n "$held" ]] && summary="$summary; $held held back (per-machine content or rejected by pre-commit)"
    [[ -n "$ZED_NOTE" ]] && summary="$summary; $ZED_NOTE"
    log "$name: $summary"
    write_state "$name" ok "$summary" "$pulled" "$pushed" "$held"
    return 0
}

# write_prune_state NAME STATUS REMOVED KEPT STALE  (lists are newline-separated)
write_prune_state() {
    mkdir -p "$STATE_DIR"
    python3 - "$STATE_DIR/$1.prune.json" "$@" <<'PY'
import json, sys, datetime, socket
out, name, status, removed, kept, stale = sys.argv[1:7]
split = lambda s: [l for l in s.split("\n") if l]
json.dump({
    "repo": name, "status": status,
    "removed": split(removed), "kept": split(kept), "stale": split(stale),
    "host": socket.gethostname().split(".")[0],
    "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
}, open(out, "w"), indent=2)
PY
}

# prune_repo REPO: the weekly housekeeping cwclean does by hand, minus anything
# that needs judgment. Only worktrees under <repo>/.claude/worktrees are
# considered; a worktree is removed only when it is clean, unlocked, has no live
# tmux session, and its branch has zero commits beyond the checked-out branch.
# Deletion is `git worktree remove` (no --force) and `git branch -d` (no -D),
# so git itself refuses anything the checks missed.
prune_repo() {
    local repo="$1" name
    name="$(basename "$repo")"
    git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { log "$name: not a git checkout, skipped"; return 0; }
    cd "$repo" || return 1
    local base remote
    base="$(git symbolic-ref --short -q HEAD)" || { log "$name: detached HEAD, prune skipped"; return 0; }
    remote="$(git config "branch.$base.remote" 2>/dev/null || true)"; remote="${remote:-origin}"
    local wt_root
    wt_root="$(cd -P . && pwd)/.claude/worktrees"

    (( DRY_RUN )) || git worktree prune
    (( DRY_RUN )) || run_with_timeout 120 git remote prune "$remote" >/dev/null 2>&1 || true

    local removed="" kept="" stale="" failed=0 now
    now="$(date +%s)"
    local path="" branch="" locked=0 wt_branches=""
    # Parse `worktree list --porcelain`; a blank line ends each block.
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            "worktree "*) path="${line#worktree }"; branch=""; locked=0 ;;
            "branch refs/heads/"*) branch="${line#branch refs/heads/}" ;;
            locked*) locked=1 ;;
            "")
                [[ -n "$path" && "$path" == "$wt_root/"* ]] || { path=""; continue; }
                local wname reason="" ahead age
                wname="$(basename "$path")"
                [[ -n "$branch" ]] && wt_branches+="$branch"$'\n'
                if (( locked )); then reason="locked"
                elif [[ -z "$branch" ]]; then reason="detached HEAD"
                elif [[ "$branch" == "$base" ]]; then reason="checked-out branch"
                elif command -v tmux >/dev/null 2>&1 && tmux has-session -t "=worktree-$wname" 2>/dev/null; then reason="tmux session alive"
                elif [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]]; then reason="dirty"
                else
                    ahead="$(git rev-list --count "$base..$branch")"
                    if (( ahead == 0 )); then
                        if (( DRY_RUN )); then
                            log "$name: would remove $wname ($branch, merged)"; removed+="$wname"$'\n'
                        elif git worktree remove "$path" >/dev/null 2>&1 && git branch -d "$branch" >/dev/null 2>&1; then
                            log "$name: removed $wname and deleted $branch (merged)"; removed+="$wname"$'\n'
                        else
                            reason="git refused removal"; failed=1
                        fi
                    else
                        age=$(( (now - $(git log -1 --format=%ct "$branch")) / 86400 ))
                        reason="$ahead unmerged commit(s), last commit ${age}d ago"
                        (( age >= STALE_DAYS )) && stale+="$wname ($reason)"$'\n'
                    fi
                fi
                [[ -n "$reason" ]] && { kept+="$wname: $reason"$'\n'; log "$name: kept $wname ($reason)"; }
                path=""
                ;;
        esac
    done < <(git worktree list --porcelain; echo)

    # Branches with no worktree and nothing beyond the base branch: -d refuses
    # anything unmerged, so this cannot lose a commit.
    local b
    for b in $(git for-each-ref --format='%(refname:short)' refs/heads); do
        [[ "$b" == "$base" ]] && continue
        grep -qxF "$b" <<<"$wt_branches" && continue
        (( $(git rev-list --count "$base..$b") == 0 )) || continue
        if (( DRY_RUN )); then log "$name: would delete branch $b (merged)"; removed+="branch $b"$'\n'
        elif git branch -d "$b" >/dev/null 2>&1; then log "$name: deleted branch $b (merged)"; removed+="branch $b"$'\n'
        fi
    done

    local n_rm n_kept n_stale
    n_rm=$(grep -c . <<<"$removed" || true); n_kept=$(grep -c . <<<"$kept" || true); n_stale=$(grep -c . <<<"$stale" || true)
    log "$name: prune done: removed $n_rm, kept $n_kept, stale $n_stale"
    (( DRY_RUN )) && return 0
    write_prune_state "$name" "$( (( failed )) && echo failed || echo ok)" "$removed" "$kept" "$stale"
    return "$failed"
}

main() {
    local -a repos=()
    while (( $# )); do
        case "$1" in
            --dry-run) DRY_RUN=1 ;;
            --prune) PRUNE=1 ;;
            -h|--help) usage; return 0 ;;
            --) shift; repos+=("$@"); break ;;
            -*) echo "dotfiles-sync: unknown option $1" >&2; usage >&2; return 2 ;;
            *) repos+=("$1") ;;
        esac
        shift
    done
    if (( ${#repos[@]} == 0 )); then
        if [[ -n "${DOTFILES_SYNC_REPOS:-}" ]]; then
            IFS=: read -r -a repos <<<"$DOTFILES_SYNC_REPOS"
        else
            repos=("$DOT_DIR")
            [[ -d "$HOME/code/dotfiles-personal/.git" ]] && repos+=("$HOME/code/dotfiles-personal")
        fi
    fi

    mkdir -p "$STATE_DIR"
    # One run at a time: a 08:00 run still waiting on a slow push must not race
    # a manual one. The lock dir carries the pid so a stale lock is detectable.
    # The sync and the prune share this lock. After a sleep, launchd fires every
    # missed calendar job at once, so Sunday's prune lands on the same instant
    # as the daily sync and would lose the race (measured: two Sundays in a row
    # it logged "another dotfiles-sync is running; exiting" and never pruned).
    # So wait for a live holder, up to DOTFILES_SYNC_LOCK_WAIT seconds, instead
    # of giving up; a dead holder's lock is reclaimed at once.
    LOCK_DIR="$STATE_DIR/lock.d"
    local waited=0 lock_wait="${DOTFILES_SYNC_LOCK_WAIT:-900}"
    until mkdir "$LOCK_DIR" 2>/dev/null; do
        local pid; pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
        if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
            rm -rf "$LOCK_DIR"; continue
        fi
        if (( waited >= lock_wait )); then
            log "another dotfiles-sync (pid $pid) still running after ${waited}s; giving up"; return 1
        fi
        (( waited == 0 )) && log "another dotfiles-sync (pid $pid) is running; waiting up to ${lock_wait}s"
        sleep 5; waited=$(( waited + 5 ))
    done
    echo $$ >"$LOCK_DIR/pid"
    trap 'rm -rf "$LOCK_DIR"' EXIT

    local rc=0 r
    for r in "${repos[@]}"; do
        if (( PRUNE )); then prune_repo "$r" || rc=1
        else sync_repo "$r" || rc=1
        fi
    done
    return "$rc"
}

main "$@"
