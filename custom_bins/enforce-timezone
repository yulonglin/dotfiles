#!/usr/bin/env zsh
# Bedtime timezone enforcement daemon
# Detects and reverts timezone bypass attempts (manual TZ change, NTP disable, auto-TZ disable)
# Runs as root via LaunchDaemon every 2 min + on /etc/localtime changes
# NOTE: No errexit/pipefail — daemon must never crash, always exit 0
# Using set -u to catch variable typos (safe — doesn't cause crashes, just errors on undefined vars)
#
# Travel: when locationd sets the same new TZ on SIGHTINGS_TO_ACCEPT separate
# runs within SIGHTING_WINDOW, it is accepted as real travel. To switch ahead of
# a flight, pause it, then set the destination TZ by hand:
#   sudo enforce-timezone --pause [HOURS]   (default and maximum PAUSE_MAX_HOURS)
# The first run after the pause ends adopts whatever TZ is set then and resumes
# every check, auto-timezone included, so a wrong guess is corrected by locationd
# through the travel path above. `sudo enforce-timezone --resume` ends it early.
#
# Commands are called by bare name: launchd gives daemons PATH=/usr/bin:/bin:/usr/sbin:/sbin
# and sudo uses secure_path, so only tests/test_enforce_timezone.zsh puts stubs first.
set -u

STATE_DIR="${ENFORCE_TZ_STATE_DIR:-/var/db}"
CACHE_FILE="$STATE_DIR/enforce-timezone.last"
RESTART_FILE="$STATE_DIR/enforce-timezone.restarts"
CONSISTENT_FILE="$STATE_DIR/enforce-timezone.consistent"
PAUSE_FILE="$STATE_DIR/enforce-timezone.paused-until"
PAUSE_MAX_HOURS=48
RATE_LIMIT=5
RATE_WINDOW=600  # 10 minutes in seconds
SIGHTINGS_TO_ACCEPT=3
SIGHTING_WINDOW=1800  # a sighting older than this no longer counts toward travel
TAG="enforce-timezone"

log() { logger -t "$TAG" "$1"; }

# ─── Resolve current timezone robustly ───────────────────────────────────────
get_current_tz() {
    local tz
    tz=$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')
    if [[ -z "$tz" ]]; then
        tz=$(systemsetup -gettimezone 2>/dev/null | sed 's/.*: //')
    fi
    echo "$tz"
}

now=$(date +%s)

# End a pause: adopt the TZ set now as last known-good and start counting afresh.
end_pause() {
    local tz
    tz=$(get_current_tz)
    [[ -n "$tz" ]] && echo "$tz" > "$CACHE_FILE"
    rm -f "$PAUSE_FILE" "$RESTART_FILE" "$CONSISTENT_FILE"
    log "Pause ended ($1); enforcing again with ${tz:-<unknown>} as the timezone."
}

# ─── Status: print current state for debugging ──────────────────────────────
if [[ "${1:-}" == "--status" ]]; then
    paused_until=$(cat "$PAUSE_FILE" 2>/dev/null)
    echo "Paused:      $([[ -n "$paused_until" ]] && date -r "$paused_until" 2>/dev/null || echo 'no')"
    echo "Cache TZ:    $(cat "$CACHE_FILE" 2>/dev/null || echo '<none>')"
    echo "Current TZ:  $(get_current_tz)"
    echo "Restarts:    $(wc -l < "$RESTART_FILE" 2>/dev/null || echo 0)"
    echo "Sightings:   $(cat "$CONSISTENT_FILE" 2>/dev/null || echo '<none>') (tz:count:last-seen)"
    echo "Auto-TZ:     $(defaults read /Library/Preferences/com.apple.timezone.auto Active 2>/dev/null || echo '?')"
    echo "NTP:         $(systemsetup -getusingnetworktime 2>/dev/null | sed 's/.*: //' || echo '?')"
    exit 0
fi

# ─── Travel: update cache to accept current timezone ─────────────────────────
if [[ "${1:-}" == "--set-timezone" ]]; then
    current_tz=$(get_current_tz)
    if [[ -z "$current_tz" ]]; then
        echo "Error: Could not determine current timezone" >&2
        exit 1
    fi
    echo "$current_tz" > "$CACHE_FILE"
    rm -f "$RESTART_FILE" "$CONSISTENT_FILE"
    log "Cache updated to $current_tz (travel/manual override)"
    exit 0
fi

# ─── Pause: switch ahead of a flight; re-arms by itself ──────────────────────
if [[ "${1:-}" == "--pause" ]]; then
    hours="${2:-$PAUSE_MAX_HOURS}"
    if ! [[ "$hours" =~ ^[0-9]+$ ]] || (( hours < 1 || hours > PAUSE_MAX_HOURS )); then
        echo "Error: --pause takes 1-$PAUSE_MAX_HOURS hours, not '$hours'" >&2
        exit 1
    fi
    until_ts=$(( now + hours * 3600 ))
    echo "$until_ts" > "$PAUSE_FILE"
    log "Paused for ${hours}h, until $until_ts."
    echo "Paused until $(date -r "$until_ts"). Set the destination timezone by hand now."
    exit 0
fi

if [[ "${1:-}" == "--resume" ]]; then
    [[ -f "$PAUSE_FILE" ]] && end_pause "resumed by hand"
    exit 0
fi

# ─── While paused, check nothing; the first run past the deadline re-arms ───
if [[ -f "$PAUSE_FILE" ]]; then
    paused_until=$(cat "$PAUSE_FILE" 2>/dev/null)
    if [[ "$paused_until" =~ ^[0-9]+$ ]] && (( now < paused_until )); then
        exit 0
    fi
    end_pause "deadline passed"
fi

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Returns 0 if under limit, 1 if over. Appends a timestamp on success.
check_rate_limit() {
    if [[ ! -f "$RESTART_FILE" ]]; then
        echo "$now" > "$RESTART_FILE"
        return 0
    fi

    # Count recent restarts within window, prune old entries
    local count=0 ts
    local -a new_entries=()
    while IFS= read -r ts; do
        # Skip malformed lines
        [[ "$ts" =~ ^[0-9]+$ ]] || continue
        if (( now - ts < RATE_WINDOW )); then
            count=$((count + 1))
            new_entries+=("$ts")
        fi
    done < "$RESTART_FILE"

    if (( count >= RATE_LIMIT )); then
        log "Rate limit hit ($count restarts in ${RATE_WINDOW}s). Skipping restart. Run: sudo enforce-timezone --set-timezone"
        return 1
    fi

    new_entries+=("$now")
    printf '%s\n' "${new_entries[@]}" > "$RESTART_FILE"
    return 0
}

# ─── Checks ──────────────────────────────────────────────────────────────────
CHANGED=0

# Check 1: Auto-timezone enabled
auto_tz=$(defaults read /Library/Preferences/com.apple.timezone.auto Active 2>/dev/null || echo "0")
if [[ "$auto_tz" != "1" ]]; then
    log "Bypass detected: auto-timezone was disabled. Re-enabling."
    defaults write /Library/Preferences/com.apple.timezone.auto Active -bool true
    killall locationd 2>/dev/null || true
    CHANGED=1
fi

# Check 2: NTP enabled
ntp_status=$(systemsetup -getusingnetworktime 2>/dev/null || echo "")
if [[ "$ntp_status" == *"Off"* ]]; then
    log "Bypass detected: NTP was disabled. Re-enabling."
    systemsetup -setusingnetworktime on 2>/dev/null || true
    CHANGED=1
fi

# Check 3: Timezone delta
current_tz=$(get_current_tz)
if [[ -z "$current_tz" ]]; then
    log "Failed to determine current timezone. Skipping."
    exit 0
fi

# Initialize cache if missing (don't exit early — still run post-check actions)
if [[ ! -f "$CACHE_FILE" ]]; then
    echo "$current_tz" > "$CACHE_FILE"
    cached_tz="$current_tz"
else
    cached_tz=$(cat "$CACHE_FILE" 2>/dev/null || echo "")
fi

if [[ -n "$cached_tz" && "$current_tz" != "$cached_tz" ]]; then
    # Count separate runs that see the same new TZ (travel auto-accept). The
    # count survives the clean runs in between — every revert rewrites
    # /etc/localtime, which wakes this daemon again to a clean run — and expires
    # only once the last sighting is older than SIGHTING_WINDOW.
    sighting=("${(@s.:.)$(cat "$CONSISTENT_FILE" 2>/dev/null)}")
    seen_tz="${sighting[1]:-}" seen_count="${sighting[2]:-0}" seen_at="${sighting[3]:-0}"
    [[ "$seen_count" =~ ^[0-9]+$ && "$seen_at" =~ ^[0-9]+$ ]] || { seen_count=0; seen_at=0; }

    if [[ "$current_tz" == "$seen_tz" ]] && (( now - seen_at < SIGHTING_WINDOW )); then
        seen_count=$((seen_count + 1))
    else
        seen_count=1
    fi
    echo "${current_tz}:${seen_count}:${now}" > "$CONSISTENT_FILE"

    if (( seen_count >= SIGHTINGS_TO_ACCEPT )); then
        # locationd keeps setting the same new TZ — this is real travel, not a bypass
        log "Auto-accepting timezone $current_tz (seen on $seen_count runs)."
        echo "$current_tz" > "$CACHE_FILE"
        rm -f "$RESTART_FILE" "$CONSISTENT_FILE"
        # No revert, no restart — accept the new timezone
    else
        log "Timezone changed from $cached_tz to $current_tz. Reverting to $cached_tz."
        systemsetup -settimezone "$cached_tz" 2>/dev/null || true
        CHANGED=1
        # DON'T update cache — leave as last known-good value
    fi
fi

# ─── Post-check actions ─────────────────────────────────────────────────────
if (( CHANGED == 0 )); then
    # Clean run — refresh the cache only. The restart and sighting counters
    # expire on their own windows; clearing them here let every revert's own
    # follow-up run reset them, so travel was never accepted and the rate
    # limit never engaged.
    echo "$current_tz" > "$CACHE_FILE"
else
    # Something was changed — check rate limit once, then restart services
    if check_rate_limit; then
        killall locationd 2>/dev/null || true
        killall timed 2>/dev/null || true
    fi
fi

exit 0
