#!/usr/bin/env python3
"""Monthly review of what the Claude Code setup costs in context and what is stale.

`run` measures, writes a report, and changes nothing else. It reads the dotfiles
repo, the enabled plugin caches, the session transcripts, the remember handoffs
and the auto-memory indexes, and writes exactly three things:

    <state>/<YYYY-MM-DD>/summary.json   machine-readable; the SessionStart nudge reads it
    <state>/<YYYY-MM-DD>/report.md      the human report
    <vault>/<YYYY-MM-DD>.md             a copy of report.md (vault-deliverables.md)

It never deletes, moves or edits a skill, rule, memory or transcript. Acting on
the report is the `context-review` skill's job, after the user decides.

Measurement logic is promoted from artifacts/context-ledger/{inventory,usage}.py
and keeps that README's three traps handled:

  * Enabled != installed. Only plugins in `enabledPlugins` are counted, read
    from the plugin cache path that installed_plugins.json names.
  * Renames hide usage. Aliases come from `git log -M` renames under
    claude/skills and claude/agents, plus the static map below for renames git
    cannot show.
  * Frontmatter is YAML. `description: >-` folded over several lines is parsed
    as a block scalar, not truncated by a line regex.

Two changes from usage.py, both toward precision: usage is counted from parsed
transcript lines (a Skill/Agent tool_use, or a user message that IS a slash
command), not from any occurrence of the string, so a transcript that merely
quotes another transcript does not count; and each call is counted once by its
tool_use id or message uuid, because a forked or resumed session copies its
parent's history into a new file.

Token counts are characters / 4, an approximation (+/-15%), labelled as such.

Exit codes: 0 ok; 1 error, or `status`/`ack` with no run to read; 2 bad usage;
3 the report was written but the vault copy failed.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import socket
import subprocess
import sys
from collections import defaultdict
from concurrent.futures import ProcessPoolExecutor
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

SCHEMA = 1
STALE_HANDOFF_DAYS = 14
LEARNINGS_MAX_DAYS = 14
NEW_COMPONENT_DAYS = 30
WINDOWS = (30, 90)
# Claude Code's published soft target per memory file (code.claude.com/docs/en/memory,
# cited in PR #296 when the byte ceiling was dropped).
LINE_TARGET = 200

# Renames git cannot show: plugin-qualified names and moves into or out of a
# plugin. Carried over from artifacts/context-ledger/usage.py.
STATIC_ALIASES = {
    "interview-me": ["grilling", "grill-me"],
    "house-plots": ["pastelplot", "anthropic-style"],
    "spec-artifact": ["writing-spec"],
    "externalise-handover": ["handoff", "workflow:externalise-handover"],
    "remember": ["remember:remember"],
    "writing-plans": ["superpowers:writing-plans"],
}

GENERATED_MARKER = "generated by model-router-wire"


# --------------------------------------------------------------------------- paths


def env_path(var: str, default: Path) -> Path:
    v = os.environ.get(var)
    return Path(v).expanduser() if v else default


def default_state_dir() -> Path:
    xdg = os.environ.get("XDG_STATE_HOME")
    base = Path(xdg) if xdg else Path.home() / ".local/state"
    return env_path("CONTEXT_REVIEW_STATE_DIR", base / "context-review")


def tok(n_chars: int) -> int:
    return round(n_chars / 4)


# --------------------------------------------------------------------- frontmatter


def _fold(lines: list[str], style: str) -> str:
    """Join a YAML block scalar's lines: `|` keeps newlines, `>` folds to spaces."""
    while lines and not lines[-1].strip():
        lines.pop()
    if style == "|":
        indent = min((len(ln) - len(ln.lstrip()) for ln in lines if ln.strip()), default=0)
        return "\n".join(ln[indent:] for ln in lines)
    out, para = [], []
    for ln in lines:
        if ln.strip():
            para.append(ln.strip())
        else:
            out.append(" ".join(para))
            para = []
    out.append(" ".join(para))
    return "\n".join(p for p in out if p)


def parse_frontmatter(text: str) -> dict[str, str]:
    """Top-level scalar keys of a YAML frontmatter block, stdlib only.

    Handles the shapes skills actually use: plain values (including plain
    scalars continued on indented lines), single- and double-quoted values, and
    `>`/`|` block scalars with chomping indicators. Nested values (lists, maps)
    are returned as their flattened text, which is fine because only `name`,
    `description` and `disable-model-invocation` are read. Checked against
    PyYAML over every real component in the pilot.
    """
    if not text.startswith("---"):
        return {}
    lines = text.splitlines()
    end = next((i for i in range(1, len(lines)) if lines[i].rstrip() == "---"), None)
    if end is None:
        return {}
    out: dict[str, str] = {}
    i = 1
    while i < end:
        m = re.match(r"^([A-Za-z0-9_-]+):(?:[ \t]+(.*))?$", lines[i])
        i += 1
        if not m:
            continue
        key, val = m.group(1), (m.group(2) or "").rstrip()
        cont = []
        while i < end and (lines[i][:1] in (" ", "\t") or not lines[i].strip()):
            cont.append(lines[i])
            i += 1
        head = val.split(" #")[0].strip()
        if re.fullmatch(r"[>|][+-]?\d*[+-]?", head):
            out[key] = _fold(cont, head[0])
        elif val.startswith('"'):
            joined = " ".join([val] + [c.strip() for c in cont if c.strip()])
            m2 = re.match(r'^"((?:[^"\\]|\\.)*)"', joined)
            raw = m2.group(1) if m2 else joined.strip('"')
            try:
                out[key] = json.loads(f'"{raw}"')
            except ValueError:
                out[key] = raw
        elif val.startswith("'"):
            joined = " ".join([val] + [c.strip() for c in cont if c.strip()])
            m2 = re.match(r"^'((?:[^']|'')*)'", joined)
            out[key] = (m2.group(1) if m2 else joined.strip("'")).replace("''", "'")
        else:
            parts = [val] + [c.strip() for c in cont if c.strip()]
            out[key] = re.sub(r"\s+#.*$", "", " ".join(p for p in parts if p))
    return out


# ---------------------------------------------------------------------- components


def git_history(repo: Path) -> tuple[dict[str, str], dict[str, set[str]]]:
    """Add dates per component path, and rename aliases, from one `git log` pass.

    A rename carries the original add date forward, so `git mv` does not make
    an old skill look new. Returns ({path: YYYY-MM-DD}, {new_id: {old_ids}}).
    """
    try:
        r = subprocess.run(
            ["git", "-C", str(repo), "log", "--reverse", "-M", "--name-status",
             "--format=%x00%as", "--", "claude/skills", "claude/agents", ".claude/skills"],
            capture_output=True, text=True, timeout=120, check=True)
    except (OSError, subprocess.SubprocessError):
        return {}, {}
    added: dict[str, str] = {}
    aliases: dict[str, set[str]] = defaultdict(set)
    day = ""
    for line in r.stdout.splitlines():
        if line.startswith("\x00"):
            day = line[1:].strip()
            continue
        parts = line.split("\t")
        if not parts or not parts[0]:
            continue
        st = parts[0]
        if st == "A" and len(parts) >= 2:
            added[parts[1]] = day
        elif st.startswith("R") and len(parts) >= 3:
            old, new = parts[1], parts[2]
            added[new] = added.get(old, day)
            a, b = component_id(old), component_id(new)
            if a and b and a != b:
                aliases[b].add(a)
    return added, aliases


def component_id(path: str) -> str | None:
    m = re.match(r"^\.?claude/skills/([^/]+)/SKILL\.md$", path)
    if m and not m.group(1).startswith("."):
        return m.group(1)
    m = re.match(r"^\.?claude/agents/([^/]+)\.md$", path)
    return m.group(1) if m else None


def read_component(path: Path, kind: str, source: str, plugin: str) -> dict | None:
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return None
    fm = parse_frontmatter(text)
    dir_name = path.parent.name if path.name == "SKILL.md" else path.stem
    name = fm.get("name") or dir_name
    desc = " ".join(fm.get("description", "").split())
    user_invoked = str(fm.get("disable-model-invocation", "")).lower() == "true"
    return {
        "name": name, "dir_name": dir_name, "kind": kind, "source": source,
        "plugin": plugin, "path": str(path), "user_invoked": user_invoked,
        "generated": GENERATED_MARKER in text,
        "desc_chars": len(desc),
        # The always-loaded line is roughly "- name: description". A
        # user-invoked skill's description is not in the model's listing.
        "desc_tokens": 0 if user_invoked else tok(len(f"- {name}: {desc}")),
        "body_tokens": tok(len(text)),
        "description": desc,
    }


def plugin_roots(claude_home: Path) -> list[tuple[str, str, Path]]:
    """(plugin, marketplace, root) for every ENABLED plugin with a cache on disk."""
    try:
        settings = json.loads((claude_home / "settings.json").read_text())
    except (OSError, ValueError):
        return []
    enabled = sorted(k for k, v in (settings.get("enabledPlugins") or {}).items() if v)
    try:
        installed = json.loads(
            (claude_home / "plugins/installed_plugins.json").read_text()).get("plugins", {})
    except (OSError, ValueError, AttributeError):
        installed = {}
    out = []
    for entry in enabled:
        if "@" not in entry:
            continue
        plug, mkt = entry.split("@", 1)
        root = None
        for rec in installed.get(entry) or []:
            if rec.get("scope") == "user" and rec.get("installPath"):
                root = Path(rec["installPath"])
                break
        if root is None or not root.is_dir():
            pdir = claude_home / "plugins/cache" / mkt / plug
            versions = [v for v in pdir.iterdir() if v.is_dir()] if pdir.is_dir() else []
            if not versions:
                continue
            root = max(versions, key=lambda v: v.stat().st_mtime)
        out.append((plug, mkt, root))
    return out


def inventory(repo: Path, claude_home: Path) -> list[dict]:
    rows: list[dict] = []
    for p in sorted((repo / "claude/skills").glob("*/SKILL.md")):
        rows.append(read_component(p, "skill", "dotfiles", "dotfiles"))
    for p in sorted((repo / ".claude/skills").glob("*/SKILL.md")):
        rows.append(read_component(p, "skill", "dotfiles-project", "dotfiles"))
    for p in sorted((repo / "claude/agents").glob("*.md")):
        rows.append(read_component(p, "agent", "dotfiles", "dotfiles"))
    for plug, mkt, root in plugin_roots(claude_home):
        for p in sorted(root.rglob("skills/*/SKILL.md")):
            rows.append(read_component(p, "skill", mkt, plug))
        for p in sorted(root.rglob("agents/*.md")):
            rows.append(read_component(p, "agent", mkt, plug))
        for p in sorted(root.rglob("commands/*.md")):
            rows.append(read_component(p, "command", mkt, plug))
    seen, out = set(), []
    for r in rows:
        if r is None:
            continue
        key = (r["source"], r["plugin"], r["kind"], r["name"])
        if key not in seen:
            seen.add(key)
            out.append(r)
    return out


# --------------------------------------------------------------------------- usage

# A slash command is saved as a user message that OPENS with its envelope, in
# either order (both seen in real transcripts, 2026-11-03: name first 306 times,
# message first 78): `<command-name>/x</command-name>\n<command-message>x...` or
# `<command-message>x</command-message>\n<command-name>/x</command-name>`.
# Anchored at the start so command text quoted later (a teammate message, a
# pasted transcript) is not an invocation.
_SLASH = re.compile(
    r"^\s*(?:<command-message>[^<]*</command-message>\s*)?<command-name>/?([^<\s]+)\s*</command-name>")


def scan_transcript(path: str) -> list[tuple[str, str, str, str]]:
    """(pool, name, iso_ts, dedupe_key) for every invocation in one JSONL file.

    pool is "skill" (Skill tool or SlashCommand tool), "agent" (Agent/Task
    tool) or "cmd" (a user message that is a slash command).
    """
    events = []
    try:
        fh = open(path, "rb")
    except OSError:
        return events
    with fh:
        for n, line in enumerate(fh):
            if (b'"Skill"' not in line and b'"subagent_type"' not in line
                    and b"<command-name>" not in line and b'"SlashCommand"' not in line):
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if not isinstance(d, dict):
                continue
            ts = str(d.get("timestamp") or "")
            msg = d.get("message") if isinstance(d.get("message"), dict) else {}
            content = msg.get("content")
            kind = d.get("type")
            if kind == "assistant" and isinstance(content, list):
                for b in content:
                    if not isinstance(b, dict) or b.get("type") != "tool_use":
                        continue
                    inp = b.get("input") if isinstance(b.get("input"), dict) else {}
                    key = str(b.get("id") or f"{path}:{n}")
                    name = b.get("name")
                    if name == "Skill":
                        s = inp.get("skill") or inp.get("command")
                        if isinstance(s, str) and s:
                            events.append(("skill", s.strip().lstrip("/"), ts, key))
                    elif name == "SlashCommand":
                        s = inp.get("command")
                        if isinstance(s, str) and s.strip():
                            events.append(("skill", s.split()[0].lstrip("/"), ts, key))
                    elif name in ("Agent", "Task"):
                        s = inp.get("subagent_type")
                        if isinstance(s, str) and s:
                            events.append(("agent", s, ts, key))
            elif kind == "user" and not d.get("isMeta"):
                text = content
                if isinstance(content, list):
                    text = next((b.get("text") for b in content if isinstance(b, dict)
                                 and b.get("type") == "text"), None)
                if isinstance(text, str):
                    m = _SLASH.match(text)
                    if m:
                        key = str(d.get("uuid") or f"{path}:{n}")
                        events.append(("cmd", m.group(1), ts, key))
    return events


def transcript_files(projects: Path, cutoff: date) -> list[str]:
    """JSONL files that can hold a line on or after `cutoff`.

    A file's mtime is its last write, so a file last written before the cutoff
    holds nothing in the window. Symlinked directories are not followed, so a
    project aliased under two names is read once.
    """
    floor = datetime.combine(cutoff, datetime.min.time()).timestamp() - 86400
    out = []
    for dirpath, _dirs, files in os.walk(projects):
        for f in files:
            if f.endswith(".jsonl"):
                p = os.path.join(dirpath, f)
                try:
                    if os.lstat(p).st_mtime >= floor:
                        out.append(p)
                except OSError:
                    pass
    return out


def usage(projects: Path, today: date, workers: int | None = None) -> dict:
    """Deduplicated invocation events in the longest window, per pool and name."""
    start = today - timedelta(days=max(WINDOWS))
    files = transcript_files(projects, start)
    seen: set[str] = set()
    dupes = 0
    events: dict[tuple[str, str], list[str]] = defaultdict(list)
    lo, hi = start.isoformat(), (today + timedelta(days=1)).isoformat()
    workers = workers or min(8, os.cpu_count() or 1)
    if workers > 1 and len(files) > 20:
        with ProcessPoolExecutor(max_workers=workers) as ex:
            results = ex.map(scan_transcript, files, chunksize=16)
            batches = list(results)
    else:
        batches = [scan_transcript(f) for f in files]
    for batch in batches:
        for pool, name, ts, key in batch:
            if not (lo <= ts[:10] < hi):
                continue
            k = f"{pool}|{key}"
            if k in seen:
                dupes += 1
                continue
            seen.add(k)
            events[(pool, name)].append(ts[:10])
    return {"events": events, "files": len(files), "duplicates_removed": dupes}


def attach_usage(rows: list[dict], u: dict, aliases: dict[str, set[str]], today: date) -> None:
    events = u["events"]
    by_pool: dict[str, dict[str, list[str]]] = defaultdict(dict)
    for (pool, name), days in events.items():
        by_pool[pool][name] = days
    cut = {w: (today - timedelta(days=w)).isoformat() for w in WINDOWS}
    # Skills that moved from a plugin into dotfiles keep the plugin prefix in old
    # transcripts (`research:spec-interview-research`, `workflow:done`). A
    # namespaced name whose prefix is NOT a currently loaded plugin is credited
    # to the dotfiles component of the same bare name; one whose prefix is a
    # loaded plugin belongs to that plugin.
    live_plugins = {r["plugin"] for r in rows if r["plugin"] != "dotfiles"}

    def retired_bare(name: str) -> str | None:
        prefix, sep, bare = name.partition(":")
        if sep and "/" not in prefix and prefix not in live_plugins:
            return bare
        return None

    for r in rows:
        keys = {r["name"], r["dir_name"]}
        for k in list(keys):
            keys |= aliases.get(k, set())
            keys |= set(STATIC_ALIASES.get(k, []))
        if r["plugin"] != "dotfiles":
            keys |= {f"{r['plugin']}:{k}" for k in list(keys)}
        pools = ["agent"] if r["kind"] == "agent" else ["skill", "cmd"]
        days: list[str] = []
        for pool in pools:
            for name, ds in by_pool[pool].items():
                bare = name.rsplit(":", 1)[-1] if "/" in name.split(":", 1)[0] else name
                retired = retired_bare(name) if r["plugin"] == "dotfiles" else None
                if name in keys or bare in keys or (retired and retired in keys):
                    days.extend(ds)
        for w in WINDOWS:
            r[f"uses_{w}d"] = sum(1 for d in days if d >= cut[w])
        r["last_used"] = max(days) if days else None


# ---------------------------------------------------------------- other measurements


def always_on_files(repo: Path) -> list[Path]:
    """The always-loaded global tier: claude/rules/*.md + claude/CLAUDE.md +
    claude/output-styles/*.md. Same globs as the always_on_files() helper that
    tests/test_memory_tier_budget.py carried until PR #296 removed its ceiling.
    Globbed, never listed, so a new rule file is counted the moment it exists."""
    files = sorted((repo / "claude/rules").glob("*.md"))
    files.append(repo / "claude/CLAUDE.md")
    files += sorted((repo / "claude/output-styles").glob("*.md"))
    return [f for f in files if f.is_file()]


def file_stat(path: Path, repo: Path) -> dict:
    data = path.read_bytes()
    return {"path": str(path.relative_to(repo)), "bytes": len(data),
            "tokens_approx": tok(len(data.decode("utf-8", "replace"))),
            "lines": data.count(b"\n")}


def learnings(path: Path, today: date) -> dict:
    out = {"file": path.name, "path": str(path), "section": False, "entries": 0,
           "oldest": None, "undated": 0, "past_two_weeks": []}
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return out
    m = re.search(r"^## Learnings[^\n]*\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    if not m:
        return out
    out["section"] = True
    dates = []
    for line in m.group(1).splitlines():
        if not re.match(r"^\s*[-*] ", line):
            continue
        out["entries"] += 1
        ds = re.findall(r"\b(\d{4}-\d{2}-\d{2})\b", line)
        if not ds:
            out["undated"] += 1
            continue
        try:
            d = date.fromisoformat(ds[-1])
        except ValueError:
            out["undated"] += 1
            continue
        dates.append(d)
        age = (today - d).days
        if age > LEARNINGS_MAX_DAYS:
            out["past_two_weeks"].append({"entry": line.strip()[:160], "date": d.isoformat(),
                                          "age_days": age})
    out["oldest"] = min(dates).isoformat() if dates else None
    return out


def _real_dirs(root: Path) -> list[Path]:
    seen, out = set(), []
    if not root.is_dir():
        return out
    for p in sorted(root.iterdir()):
        try:
            rp = p.resolve()
        except OSError:
            continue
        if p.is_dir() and rp not in seen:
            seen.add(rp)
            out.append(p)
    return out


def handoffs(remember: Path, projects: Path, today: date) -> list[dict]:
    rows = []
    for d in _real_dirs(remember):
        f = d / "remember.md"
        if not f.is_file():
            continue
        mtime = date.fromtimestamp(f.stat().st_mtime)
        age = (today - mtime).days
        # Last session in the same project: a stale handoff for a project nobody
        # has opened since is history, not a fault, so the reader needs both.
        last = None
        pdir = projects / d.name
        if pdir.is_dir():
            mt = [p.stat().st_mtime for p in pdir.glob("*.jsonl")]
            last = date.fromtimestamp(max(mt)).isoformat() if mt else None
        rows.append({"project": d.name, "path": str(f), "updated": mtime.isoformat(),
                     "age_days": age, "stale": age > STALE_HANDOFF_DAYS,
                     "last_session": last,
                     "sessions_since": bool(last and last > mtime.isoformat())})
    return rows


def memories(projects: Path) -> list[dict]:
    rows = []
    for d in _real_dirs(projects):
        f = d / "memory/MEMORY.md"
        if not f.is_file():
            continue
        text = f.read_text(errors="replace")
        rows.append({"project": d.name, "path": str(f),
                     "entries": sum(1 for ln in text.splitlines() if re.match(r"^\s*[-*] ", ln)),
                     "bytes": len(text.encode()), "lines": text.count("\n")})
    return rows


def store_size(projects: Path) -> dict:
    total = files = 0
    for dirpath, _dirs, fs in os.walk(projects):
        for f in fs:
            try:
                total += os.lstat(os.path.join(dirpath, f)).st_size
                files += 1
            except OSError:
                pass
    return {"bytes": total, "files": files}


# --------------------------------------------------------------------------- run


def previous_summary(state: Path, today: date) -> dict | None:
    if not state.is_dir():
        return None
    for d in sorted((p for p in state.iterdir() if p.is_dir()), reverse=True):
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", d.name) and d.name < today.isoformat():
            try:
                return json.loads((d / "summary.json").read_text())
            except (OSError, ValueError):
                continue
    return None


def latest_run(state: Path) -> Path | None:
    if not state.is_dir():
        return None
    for d in sorted((p for p in state.iterdir() if p.is_dir()), reverse=True):
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", d.name) and (d / "summary.json").is_file():
            return d
    return None


def delta(cur: int | None, prev: dict | None, *path: str) -> int | None:
    if prev is None or cur is None:
        return None
    v = prev
    for p in path:
        if not isinstance(v, dict) or p not in v:
            return None
        v = v[p]
    return cur - v if isinstance(v, int) else None


def collect(args: argparse.Namespace) -> dict:
    repo, claude_home, today = args.repo, args.claude_home, args.today
    projects = claude_home / "projects"
    prev = previous_summary(args.state_dir, today)

    tier = [file_stat(f, repo) for f in always_on_files(repo)]
    tier_bytes = sum(f["bytes"] for f in tier)
    repo_md = file_stat(repo / "CLAUDE.md", repo) if (repo / "CLAUDE.md").is_file() else None

    added, aliases = git_history(repo)
    rows = inventory(repo, claude_home)
    u = usage(projects, today, args.workers)
    attach_usage(rows, u, aliases, today)
    new_cut = (today - timedelta(days=NEW_COMPONENT_DAYS)).isoformat()
    for r in rows:
        r["added"] = None
        if r["plugin"] == "dotfiles":
            try:
                rel = str(Path(r["path"]).relative_to(repo))
            except ValueError:
                rel = ""
            r["added"] = added.get(rel)
        # Plugin components have no add date, so they are never exempted.
        r["new"] = bool(r["added"] and r["added"] > new_cut)
        del r["description"]

    unused = [r for r in rows if r["uses_90d"] == 0 and not r["new"]]
    unused.sort(key=lambda r: (-r["desc_tokens"], r["name"]))
    desc_total = sum(r["desc_tokens"] for r in rows)

    ho = handoffs(args.remember_dir, projects, today)
    learn = [learnings(repo / "claude/CLAUDE.md", today), learnings(repo / "CLAUDE.md", today)]
    learn[0]["file"], learn[1]["file"] = "claude/CLAUDE.md", "CLAUDE.md"
    mem = memories(projects)
    store = store_size(projects)

    s = {
        "schema": SCHEMA,
        "date": today.isoformat(),
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "repo": str(repo),
        "host": socket.gethostname(),
        "previous": prev.get("date") if prev else None,
        "token_note": "tokens are characters / 4, an approximation (+/-15%)",
        "always_on": {"bytes": tier_bytes, "tokens_approx": sum(f["tokens_approx"] for f in tier),
                      "files": tier, "delta_bytes": delta(tier_bytes, prev, "always_on", "bytes"),
                      "over_line_target": [f["path"] for f in tier if f["lines"] > LINE_TARGET]},
        "repo_claude_md": dict(repo_md or {}, delta_bytes=delta(
            repo_md["bytes"] if repo_md else None, prev, "repo_claude_md", "bytes")),
        "components": {
            "count": len(rows),
            "desc_tokens_total": desc_total,
            "delta_desc_tokens": delta(desc_total, prev, "components", "desc_tokens_total"),
            "transcript_files_scanned": u["files"],
            "duplicates_removed": u["duplicates_removed"],
            "rows": sorted(rows, key=lambda r: (r["kind"], r["plugin"], r["name"])),
        },
        "unused_90d": [{"name": r["name"], "kind": r["kind"], "plugin": r["plugin"],
                        "desc_tokens": r["desc_tokens"], "added": r["added"],
                        "generated": r["generated"], "user_invoked": r["user_invoked"],
                        "path": r["path"]} for r in unused],
        "new_components": sorted(r["name"] for r in rows if r["new"]),
        "handoffs": ho,
        "learnings": learn,
        "memory": mem,
        "transcripts": dict(store, delta_bytes=delta(store["bytes"], prev, "transcripts", "bytes")),
    }
    stale_learn = sum(len(x["past_two_weeks"]) for x in learn)
    s["nudge"] = {
        "unused": len(unused),
        "always_on_delta_bytes": s["always_on"]["delta_bytes"],
        "stale_handoffs": sum(1 for h in ho if h["stale"]),
        "stale_learnings": stale_learn,
    }
    s["headline"] = headline(s)
    return s


# ------------------------------------------------------------------------ report


def fmt_delta(d: int | None, unit: str = " B") -> str:
    if d is None:
        return "no baseline"
    return f"{d:+,}{unit}"


def human_bytes(n: int) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024 or unit == "TB":
            return f"{n:,.0f} {unit}" if unit == "B" else f"{n:,.1f} {unit}"
        n /= 1024
    return str(n)


def headline(s: dict) -> list[str]:
    a, c, n = s["always_on"], s["components"], s["nudge"]
    since = f" since {s['previous']}" if s["previous"] else " (first run)"
    lines = [
        f"Always-on tier: {a['bytes']:,} B (~{a['tokens_approx']:,} tok, chars/4), "
        f"{fmt_delta(a['delta_bytes'])}{since}; repo CLAUDE.md "
        f"{s['repo_claude_md'].get('bytes', 0):,} B ({fmt_delta(s['repo_claude_md'].get('delta_bytes'))}).",
        f"Descriptions: {c['count']} enabled skills/agents/commands cost ~{c['desc_tokens_total']:,} tok "
        f"({fmt_delta(c['delta_desc_tokens'], ' tok')}); {n['unused']} have zero uses in 90 days "
        f"on {s['host']} ({len(s['new_components'])} added in the last 30 days are exempt).",
        f"Stale: {n['stale_handoffs']} of {len(s['handoffs'])} remember.md handoffs older than "
        f"{STALE_HANDOFF_DAYS} days; {n['stale_learnings']} Learnings entries past the two-week rule.",
        f"Auto-memory: {sum(m['entries'] for m in s['memory'])} entries across {len(s['memory'])} "
        f"projects; transcripts {human_bytes(s['transcripts']['bytes'])} in "
        f"{s['transcripts']['files']:,} files ({fmt_delta(s['transcripts']['delta_bytes'])}, never pruned).",
    ]
    look = []
    top = [u for u in s["unused_90d"] if u["desc_tokens"] > 0][:3]
    if top:
        look.append("unused " + ", ".join(f"`{u['name']}` (~{u['desc_tokens']} tok)" for u in top))
    if a["over_line_target"]:
        look.append(f"{len(a['over_line_target'])} always-on file(s) past {LINE_TARGET} lines")
    if a["delta_bytes"] and a["delta_bytes"] > 0:
        look.append("always-on growth")
    if look:
        lines.append("Look at: " + "; ".join(look) + ".")
    return lines


def md_cell(v) -> str:
    return str(v).replace("|", "\\|").replace("\n", " ")


def table(head: list[str], rows: list[list]) -> list[str]:
    out = ["| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
    out += ["| " + " | ".join(md_cell(x) for x in r) + " |" for r in rows]
    return out


def render(s: dict) -> str:
    L = [f"# Context review {s['date']}", ""]
    L += [f"- {ln}" for ln in s["headline"]]
    L += ["", f"Repo `{s['repo']}`. Previous run: {s['previous'] or 'none'}. "
          f"{s['token_note'].capitalize()}. This report is read-only: nothing was changed. "
          "Act on it with `/context-review`.", ""]

    a = s["always_on"]
    L += ["## Always-on tier", "",
          f"{a['bytes']:,} B, ~{a['tokens_approx']:,} tok, {fmt_delta(a['delta_bytes'])}. "
          f"Files past the {LINE_TARGET}-line soft target are marked.", ""]
    L += table(["File", "Bytes", "~Tok", "Lines"],
               [[f"`{f['path']}`", f"{f['bytes']:,}", f"{f['tokens_approx']:,}",
                 f"{f['lines']}{' (over)' if f['lines'] > LINE_TARGET else ''}"]
                for f in sorted(a["files"], key=lambda f: -f["bytes"])])
    rm = s["repo_claude_md"]
    if rm.get("bytes") is not None:
        L += ["", f"Repo `CLAUDE.md` (loaded in this repo only): {rm['bytes']:,} B, "
              f"~{rm['tokens_approx']:,} tok, {rm['lines']} lines, {fmt_delta(rm.get('delta_bytes'))}."]

    c = s["components"]
    L += ["", "## Unused skills, agents and commands (zero uses in 90 days)", "",
          f"Counted from {c['transcript_files_scanned']:,} transcript files; "
          f"{c['duplicates_removed']:,} copied calls (forks, resumes) counted once. "
          f"Transcripts are per machine: these counts cover `{s['host']}` only, so a component "
          "used mainly on another machine reads as unused here. "
          "Components added to this repo in the last 30 days are exempt; plugin components "
          "have no add date and are never exempt. A generated agent is changed in "
          "`config/model-router.toml`, a plugin component by disabling its plugin.", ""]
    L += table(["Name", "Kind", "Plugin", "~Desc tok", "Added", "Note"],
               [[f"`{u['name']}`", u["kind"], u["plugin"], u["desc_tokens"], u["added"] or "-",
                 ", ".join(x for x, on in (("generated", u["generated"]),
                                           ("user-invoked", u["user_invoked"])) if on) or ""]
                for u in s["unused_90d"]] or [["none", "", "", "", "", ""]])
    if s["new_components"]:
        L += ["", "Exempt as new: " + ", ".join(f"`{n}`" for n in s["new_components"]) + "."]

    L += ["", "## All components by description cost", ""]
    L += table(["Name", "Kind", "Plugin", "~Desc tok", "Uses 30d", "Uses 90d", "Last used"],
               [[f"`{r['name']}`", r["kind"], r["plugin"], r["desc_tokens"], r["uses_30d"],
                 r["uses_90d"], r["last_used"] or "-"]
                for r in sorted(c["rows"], key=lambda r: (-r["desc_tokens"], r["name"]))])

    L += ["", "## Remember handoffs", "",
          f"Stale means `remember.md` is older than {STALE_HANDOFF_DAYS} days. "
          "\"Sessions since\" says whether the project was opened after the handoff was written.", ""]
    L += table(["Project", "Updated", "Age (d)", "Stale", "Last session", "Sessions since"],
               [[f"`{h['project']}`", h["updated"], h["age_days"], "yes" if h["stale"] else "no",
                 h["last_session"] or "-", "yes" if h["sessions_since"] else "no"]
                for h in sorted(s["handoffs"], key=lambda h: -h["age_days"])]
               or [["none", "", "", "", "", ""]])

    L += ["", "## Learnings sections", ""]
    L += table(["File", "Entries", "Oldest", "Past two weeks", "Undated"],
               [[f"`{x['file']}`", x["entries"] if x["section"] else "no section",
                 x["oldest"] or "-", len(x["past_two_weeks"]), x["undated"]]
                for x in s["learnings"]])
    for x in s["learnings"]:
        for e in x["past_two_weeks"]:
            L.append(f"- `{x['file']}` ({e['age_days']} d): {e['entry']}")

    L += ["", "## Auto-memory indexes", ""]
    L += table(["Project", "Entries", "Lines", "Bytes"],
               [[f"`{m['project']}`", m["entries"], m["lines"], f"{m['bytes']:,}"]
                for m in sorted(s["memory"], key=lambda m: -m["entries"])]
               or [["none", "", "", ""]])

    t = s["transcripts"]
    L += ["", "## Transcript store", "",
          f"`~/.claude/projects`: {human_bytes(t['bytes'])} in {t['files']:,} files, "
          f"{fmt_delta(t['delta_bytes'])}. Reported only: retention is deliberate "
          "(`cleanupPeriodDays` is 999999), so nothing here is ever pruned.", ""]
    return "\n".join(L)


# ----------------------------------------------------------------------- commands


def write_atomic(path: Path, text: str) -> None:
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def cmd_run(args: argparse.Namespace) -> int:
    s = collect(args)
    out = args.state_dir / s["date"]
    out.mkdir(parents=True, exist_ok=True)
    report = render(s)
    write_atomic(out / "report.md", report)
    code = 0
    if args.no_vault:
        s["vault_copy"] = {"status": "disabled", "path": None}
    else:
        dest = args.vault_dir / f"{s['date']}.md"
        try:
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(out / "report.md", dest)
            s["vault_copy"] = {"status": "ok", "path": str(dest)}
        except OSError as e:
            s["vault_copy"] = {"status": f"error: {e}", "path": str(dest)}
            print(f"context-review: vault copy failed: {e}", file=sys.stderr)
            code = 3
    write_atomic(out / "summary.json", json.dumps(s, indent=1) + "\n")
    print("\n".join(s["headline"]))
    print(f"report: {out / 'report.md'}")
    if s["vault_copy"]["path"]:
        print(f"vault:  {s['vault_copy']['path']} ({s['vault_copy']['status']})")
    return code


def ack_state(run: Path, summary: dict) -> dict | None:
    try:
        a = json.loads((run / "acknowledged.json").read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(a, dict) or str(a.get("acked_at", "")) < str(summary.get("generated_at", "")):
        return None
    return a


def cmd_status(args: argparse.Namespace) -> int:
    run = latest_run(args.state_dir)
    if run is None:
        print(f"context-review: no run under {args.state_dir}; run `context-review run`")
        return 1
    s = json.loads((run / "summary.json").read_text())
    age = (args.today - date.fromisoformat(s["date"])).days
    ack = ack_state(run, s)
    print(f"Last run: {s['date']} ({age} days ago); "
          f"{'acknowledged ' + ack['acked_at'] if ack else 'not yet reviewed'}.")
    print("\n".join(s.get("headline", [])))
    print(f"report: {run / 'report.md'}")
    vc = s.get("vault_copy") or {}
    if vc.get("path"):
        print(f"vault:  {vc['path']} ({vc.get('status')})")
    return 0


def cmd_ack(args: argparse.Namespace) -> int:
    run = (args.state_dir / args.date) if args.date else latest_run(args.state_dir)
    if run is None or not (run / "summary.json").is_file():
        print("context-review: no run to acknowledge", file=sys.stderr)
        return 1
    rec = {"acked_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
           "note": args.note or ""}
    write_atomic(run / "acknowledged.json", json.dumps(rec, indent=1) + "\n")
    print(f"acknowledged {run.name}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="context-review",
        description="Measure what the Claude Code setup costs in context and what is stale. "
                    "Read-only except for its own report files.",
        epilog="Every root is a flag or an env var, so tests never touch the real home. "
               "Exit codes: 0 ok, 1 error or nothing to read, 2 usage, 3 vault copy failed.")
    p.add_argument("--repo", type=Path,
                   default=env_path("CONTEXT_REVIEW_REPO", Path(__file__).resolve().parent.parent),
                   help="dotfiles repo root [CONTEXT_REVIEW_REPO; default: this script's repo]")
    p.add_argument("--claude-home", type=Path,
                   default=env_path("CONTEXT_REVIEW_CLAUDE_HOME", Path.home() / ".claude"),
                   help="Claude config dir holding settings.json, plugins/ and projects/ "
                        "[CONTEXT_REVIEW_CLAUDE_HOME; default ~/.claude]")
    p.add_argument("--remember-dir", type=Path,
                   default=env_path("CONTEXT_REVIEW_REMEMBER_DIR", Path.home() / ".remember"),
                   help="remember handoff root [CONTEXT_REVIEW_REMEMBER_DIR; default ~/.remember]")
    p.add_argument("--state-dir", type=Path, default=default_state_dir(),
                   help="where runs are written [CONTEXT_REVIEW_STATE_DIR; "
                        "default $XDG_STATE_HOME/context-review]")
    p.add_argument("--vault-dir", type=Path,
                   default=env_path("CONTEXT_REVIEW_VAULT_DIR",
                                    Path.home() / "vault/tooling/dotfiles/context-review"),
                   help="vault folder for the report copy [CONTEXT_REVIEW_VAULT_DIR]")
    p.add_argument("--today", type=date.fromisoformat,
                   default=date.fromisoformat(os.environ["CONTEXT_REVIEW_TODAY"])
                   if os.environ.get("CONTEXT_REVIEW_TODAY") else date.today(),
                   help="override today's date, YYYY-MM-DD [CONTEXT_REVIEW_TODAY]")
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run", help="measure and write summary.json + report.md (+ vault copy)")
    r.add_argument("--no-vault", action="store_true", help="skip the vault copy")
    r.add_argument("--workers", type=int, default=None,
                   help="transcript scan processes (default min(8, cpus))")
    r.set_defaults(func=cmd_run)
    st = sub.add_parser("status", help="print the last run's date, review state and summary")
    st.set_defaults(func=cmd_status)
    a = sub.add_parser("ack", help="mark a run as reviewed, which silences the SessionStart nudge")
    a.add_argument("--date", help="run date to acknowledge (default: the latest run)")
    a.add_argument("--note", help="one line on what was decided")
    a.set_defaults(func=cmd_ack)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        print(f"context-review: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
