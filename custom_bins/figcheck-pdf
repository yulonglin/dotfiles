#!/usr/bin/env python3
"""Fail if text in a rendered PDF page overlaps or runs off the page.

    figcheck-pdf figure.pdf              # page 1, non-zero exit on any problem
    figcheck-pdf paper.pdf --page 3      # one page of a built paper
    figcheck-pdf paper.pdf --all         # every page
    figcheck-pdf figure.pdf --warn       # report but exit 0

The matplotlib `figcheck` works on the live Figure; this is the sibling for
anything that only exists as a PDF: TikZ figures, a compiled paper, a plot
from another tool. It asks MuPDF for every text line's bounding box and reports
pairs that intersect by more than a tolerance, plus lines that extend past the
page box (a clipped label).

Extraction goes through `mutool convert -F stext -O mediabox-clip=no`, because
MuPDF's default structured text discards text that falls outside the page box:
the label that ran furthest off the page was the one the bounds check never saw.
mutool ignores an unknown -O option silently, so each run first measures its own
mutool on a generated probe page and refuses to report at all (exit 2, `--warn`
included) when off-page text does not survive. A gate that cannot be checked is
not reported as clean.

Limits: only text is checked, and only against the page box. Boxes, arrows and a
label sitting on a line are invisible here, and so is text hidden by a clip path
in the content stream or covered by a later fill — that text stays in the stream,
so it is neither reported as clipped nor kept out of the overlap check. This
replaces eyeballing for text collisions only; still look at the rendered PNG for
arrow anchoring (house-plots references/visual-layout-quality.md).
"""

from __future__ import annotations

import argparse
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET  # mutool output is generated locally; no untrusted XML
from pathlib import Path
from typing import NoReturn

TOL_PT = 0.8  # ignore hairline touches between neighbouring lines
STEXT_OPTIONS = "mediabox-clip=no"  # keep the text that falls outside the page box


def die(message: str) -> NoReturn:
    print(f"figcheck-pdf: {message}", file=sys.stderr)
    raise SystemExit(2)


def minimal_pdf(items: list[tuple[str, float, float]], size: float = 12,
                box: tuple[float, float, float, float] = (0, 0, 200, 200)) -> bytes:
    """A one-page PDF of Helvetica lines at (x, y) — the fixture the probe measures."""
    stream = "".join(f"BT /F1 {size} Tf {x} {y} Td ({text}) Tj ET\n" for text, x, y in items).encode()
    objects = [
        b"<< /Type /Catalog /Pages 2 0 R >>",
        b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
        f"<< /Type /Page /Parent 2 0 R /MediaBox [{' '.join(str(v) for v in box)}]"
        f" /Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>".encode(),
        b"<< /Length " + str(len(stream)).encode() + b" >>\nstream\n" + stream + b"endstream",
        b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
    ]
    out, offsets = bytearray(b"%PDF-1.4\n"), []
    for number, body in enumerate(objects, 1):
        offsets.append(len(out))
        out += f"{number} 0 obj\n".encode() + body + b"\nendobj\n"
    startxref = len(out)
    out += f"xref\n0 {len(objects) + 1}\n".encode() + b"0000000000 65535 f \n"
    out += b"".join(f"{off:010d} 00000 n \n".encode() for off in offsets)
    out += f"trailer\n<< /Size {len(objects) + 1} /Root 1 0 R >>\nstartxref\n{startxref}\n%%EOF\n".encode()
    return bytes(out)


def page_count(pdf: str) -> int:
    out = subprocess.run(["mutool", "info", pdf], capture_output=True, text=True, check=True).stdout
    for line in out.splitlines():
        if line.startswith("Pages:"):
            return int(line.split()[1])
    raise SystemExit(f"figcheck-pdf: could not read page count of {pdf}")


def text_lines(pdf: str, page: int) -> tuple[float, float, list[tuple[str, float, float, float, float]]]:
    with tempfile.TemporaryDirectory() as scratch:
        stext = Path(scratch) / "page.xml"  # mutool convert has no stdout target
        subprocess.run(
            ["mutool", "convert", "-F", "stext", "-O", STEXT_OPTIONS, "-o", str(stext), pdf, str(page)],
            capture_output=True, text=True, check=True,
        )
        root = ET.fromstring(stext.read_text())
    pg = root.find(".//page")
    width, height = float(pg.get("width")), float(pg.get("height"))
    lines = []
    for ln in root.iter("line"):
        text = "".join(ch.get("c", "") for ch in ln.iter("char")).strip()
        if not text:
            continue
        x0, y0, x1, y1 = (float(v) for v in ln.get("bbox").split())
        lines.append((text, x0, y0, x1, y1))
    return width, height, lines


def require_off_page_text() -> None:
    """Prove this mutool keeps off-page text, since an unrecognised -O option is a silent no-op."""
    with tempfile.TemporaryDirectory() as scratch:
        probe = Path(scratch) / "probe.pdf"
        probe.write_bytes(minimal_pdf([("off the page", 220, 100)]))
        width, _height, lines = text_lines(str(probe), 1)
    if not any(x1 > width + TOL_PT for _t, _x0, _y0, x1, _y1 in lines):
        die("this mutool drops text lying outside the page box, so a clipped label would be "
            "reported clean. Not checking. Upgrade mutool to a build whose stext accepts "
            "-O mediabox-clip=no.")


def check_page(pdf: str, page: int) -> int:
    width, height, lines = text_lines(pdf, page)
    problems = 0
    for i, (t, ax0, ay0, ax1, ay1) in enumerate(lines):
        if ax0 < -TOL_PT or ay0 < -TOL_PT or ax1 > width + TOL_PT or ay1 > height + TOL_PT:
            print(f"p{page} CLIPPED  '{t}'  bbox=({ax0:.1f},{ay0:.1f},{ax1:.1f},{ay1:.1f}) page={width:.0f}x{height:.0f}")
            problems += 1
        for u, bx0, by0, bx1, by1 in lines[i + 1:]:
            ox = min(ax1, bx1) - max(ax0, bx0)
            oy = min(ay1, by1) - max(ay0, by0)
            if ox > TOL_PT and oy > TOL_PT:
                print(f"p{page} OVERLAP  '{t}'  x  '{u}'  ({ox:.1f}pt x {oy:.1f}pt)")
                problems += 1
    print(f"p{page}: {len(lines)} text lines, {problems} problems")
    return problems


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("pdf")
    ap.add_argument("--page", type=int, help="page to check (default 1)")
    ap.add_argument("--all", action="store_true", help="check every page")
    ap.add_argument("--warn", "-w", action="store_true", help="report problems but exit 0")
    args = ap.parse_args()
    if args.all and args.page is not None:
        ap.error("--page and --all are mutually exclusive")
    count = page_count(args.pdf)
    if args.all:
        pages = range(1, count + 1)
    else:
        # mutool clamps a request past the end, so an unchecked page number would
        # otherwise certify whichever page it landed on.
        page = 1 if args.page is None else args.page
        if not 1 <= page <= count:
            ap.error(f"--page {page} is out of range: {args.pdf} has {count} page(s)")
        pages = [page]
    require_off_page_text()
    total = sum(check_page(args.pdf, p) for p in pages)
    return 0 if (total == 0 or args.warn) else 1


if __name__ == "__main__":
    raise SystemExit(main())
