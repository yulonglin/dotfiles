#!/usr/bin/env bash
# shellcheck shell=bash
# secrets — the one secrets command on PATH.
#
# A thin router over three long-lived implementations, none of which it
# reimplements:
#   custom_bins/dotfiles-secrets   the engine (resolution, BWS I/O). Its path is
#                                  a permanent contract with every generated
#                                  .envrc on this machine, so it is never moved.
#   custom_bins/setup-envrc        repo wiring (.envrc bindings, the fzf picker)
#   custom_bins/secrets-use        which BWS key an ambiguous env name resolves to
#
# Bare `secrets` is a first-class entry point, not an error: it prints a status
# header, then offers a gum menu only when the terminal can carry one.
#
# See specs/2026-09-01-secrets-consolidation.md for the contract.

set -euo pipefail

PROG=${0##*/}
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
DOT_DIR="${DOT_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# Absolute, never bare names: `secrets run` is meant to be callable from a
# systemd unit, whose PATH does not include custom_bins.
ENGINE="$DOT_DIR/custom_bins/dotfiles-secrets"
ENVRC_IMPL="$DOT_DIR/custom_bins/setup-envrc"
USE_IMPL="$DOT_DIR/custom_bins/secrets-use"

# shellcheck source=/dev/null
source "$DOT_DIR/scripts/helpers/dotfiles_secrets.sh"

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage: secrets [SUBCOMMAND] [ARGS...]

  secrets                       Status header; a menu too, at an interactive terminal
  secrets init                  Set up this machine's BWS access token
  secrets edit [KEY [VAL] [--note DESC]]
                                Add, change or delete a secret (fzf TUI with no args)
  secrets ls [ENV]              List env names, their active BWS key and blocked siblings
  secrets get ENV               Print one value to stdout
  secrets use ENV [key|--next|--activate KEY|--list]
                                Choose which BWS key an ambiguous env name resolves to
  secrets envrc [KEY...|--all|--list|--clean|--plaintext|--telegram-secret NAME]
                                Wire this repo's .envrc (direnv, resolved live)
  secrets run KEY... -- CMD     Run CMD with only those keys in its environment
  secrets doctor                Show backend paths and repair file permissions

`secrets get` prints a secret; `secrets run` uses one without printing it.
Prefer `run` in anything whose output is logged or pasted.

`secrets envrc --plaintext` materializes real values into .env, at rest.
By norm — not enforced in code — that is for DAEMON repos only: a container or
a systemd unit with no shell session for direnv to hook. Anything with a shell
uses plain `secrets envrc`, which resolves live and leaves no secret on disk.

Exit codes: 0 ok, 1 runtime failure, 2 usage error.
EOF
}

run_usage() {
    cat <<'EOF'
Usage: secrets run KEY1 [KEY2 ...] -- command [args...]
       secrets run --all -- command [args...]

Exports only the named secrets into a subshell and runs the command there.
The caller's own environment is never touched. If a key cannot be resolved,
the command does not run.
EOF
}

# ─── secrets run ─────────────────────────────────────────────────────────────
# Ported from the `with-secrets` zsh function (config/zshrc.sh). A binary, not a
# function, so a systemd unit can call it; semantically identical except that a
# shell function or alias can no longer be the command after `--`, which no
# caller in this repo does.
cmd_run() {
    local keys=() saw_separator=false

    if [[ $# -eq 0 ]]; then
        run_usage >&2
        exit 2
    fi

    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "--" ]]; then saw_separator=true; shift; break; fi
        keys+=("$1"); shift
    done

    [[ "$saw_separator" == true ]] || { run_usage >&2; exit 2; }
    [[ ${#keys[@]} -gt 0 ]] || die "provide at least one key, or --all, before --"
    [[ $# -gt 0 ]] || die "provide a command after --"

    (
        # Capture-then-eval, not `source <(...)`: process substitution hides the
        # producer's exit status, so a helper that failed to resolve a named key
        # would leave the command below running silently keyless.
        local exports
        if [[ "${keys[0]}" == "--all" ]]; then
            exports=$("$ENGINE" shell --all) || exit 1
        else
            exports=$("$ENGINE" shell "${keys[@]}") || exit 1
        fi
        eval "$exports"
        "$@"
    )
}

# ─── secrets ls ──────────────────────────────────────────────────────────────
# One listing where there used to be four (`dotfiles-secrets keys`, `keys-meta`,
# `list-full`, `secrets-use --list`): every env name, its active BWS key, and
# the siblings that are blocked or merely unchosen.
_LS_META=""
ls_load_meta() {
    [[ -n "$_LS_META" ]] && return 0
    _LS_META=$("$ENGINE" keys-meta 2>/dev/null) \
        || die "could not list keys (is the BWS token present? try: $PROG doctor)"
    [[ -n "$_LS_META" ]] || die "no keys returned by the backend"
}

ls_keys_for_env() {
    ls_load_meta
    printf '%s\n' "$_LS_META" | awk -F'\t' -v want="$1" '$1 == want { print $2 }'
}

ls_env_names() {
    ls_load_meta
    printf '%s\n' "$_LS_META" | awk -F'\t' 'NF { print $1 }' | sort -u
}

ls_ambiguous_env_names() {
    ls_load_meta
    printf '%s\n' "$_LS_META" | awk -F'\t' 'NF { n[$1]++ } END { for (k in n) if (n[k] > 1) print k }' | sort
}

ls_show_env() {
    local env_name="$1" state value candidate declared="" any=false

    printf '%s\n' "$env_name"
    while IFS=$'\t' read -r state value; do
        [[ -n "$value" ]] || continue
        any=true
        declared+="$value"$'\n'
        if [[ "$state" == "active" ]]; then
            printf '  * %s\n' "$value"
        else
            printf '  ! %s (blocked)\n' "$value"
        fi
    done < <("$ENGINE" scope-entries "$env_name" 2>/dev/null || true)

    # Candidates the conf says nothing about: real BWS keys under this name that
    # are neither active nor blocked.
    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue
        if printf '%s' "$declared" | grep -Fxq "$candidate"; then continue; fi
        printf '    %s\n' "$candidate"
    done < <(ls_keys_for_env "$env_name")

    if [[ "$any" == false ]] && [[ "$(ls_keys_for_env "$env_name" | wc -l | tr -d ' ')" -gt 1 ]]; then
        printf '  (undeclared — resolution hard-errors until a key is chosen: %s use %s)\n' "$PROG" "$env_name"
    fi
}

cmd_ls() {
    [[ $# -le 1 ]] || die "usage: $PROG ls [ENV_NAME]"

    if [[ $# -eq 1 ]]; then
        ls_load_meta
        ls_keys_for_env "$1" | grep -q . || die "no key uses env name '$1'"
        ls_show_env "$1"
        return 0
    fi

    local name
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        ls_show_env "$name"
    done < <(ls_env_names)
    printf '\n* active   ! blocked   (unmarked: a sibling the conf has not ranked)\n'
    printf 'conf: %s\n' "$("$ENGINE" scope-conf-path 2>/dev/null || echo '(unknown)')"
}

# ─── secrets doctor ──────────────────────────────────────────────────────────
# The only subcommand that WRITES permission changes. Bare `secrets` checks.
cmd_doctor() {
    "$ENGINE" paths
    dotfiles_secrets_harden_permissions
    project_secret_harden_permissions "$PWD"
    printf 'Hardened permissions under %s and %s\n' "$(dotfiles_secrets_dir)" "$PWD"
}

# ─── secrets init ────────────────────────────────────────────────────────────
# Machine setup only: BWS token, connectivity test, permission hardening.
# Project setup is `secrets envrc` — a different question, so there is no
# "bws or project?" menu here.
cmd_init() {
    [[ $# -eq 0 ]] || die "usage: $PROG init  (project wiring is: $PROG envrc)"

    if ! command -v bws >/dev/null 2>&1; then
        printf 'Error: bws CLI not found — install it first:\n' >&2
        printf '  ./install.sh --minimal --core     # includes bws\n' >&2
        exit 1
    fi

    local token_path token_dir answer access_token bws_output count
    token_path=$(dotfiles_secrets_bws_token_file)
    token_dir=$(dirname "$token_path")

    printf 'BWS token file: %s\n' "$token_path"

    if [[ -f "$token_path" ]]; then
        printf 'BWS token already exists.\n'
        printf 'Overwrite? [y/N] '
        read -r answer
        [[ "$answer" =~ ^[Yy]$ ]] || exit 0
    fi

    printf '\nPaste your BWS access token (from Bitwarden Secrets Manager):\n'
    printf '(machine account token, starts with 0., leave empty to skip)\n'
    read -rs access_token
    printf '\n'

    if [[ -z "$access_token" ]]; then
        printf 'Skipped\n'
        exit 0
    fi

    mkdir -p "$token_dir"
    chmod 700 "$token_dir"

    printf 'Testing bws connectivity...\n'
    if bws_output=$(BWS_ACCESS_TOKEN="$access_token" bws secret list 2>/dev/null); then
        count=$(printf '%s' "$bws_output" | \
            python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo "?")
        printf 'Success — %s secret(s) accessible\n' "$count"
        # umask before the write: the token must never exist world-readable,
        # not even for the instant before chmod lands.
        ( umask 077; printf '%s\n' "$access_token" > "$token_path" )
        chmod 600 "$token_path"
        printf 'Token saved to %s\n' "$token_path"
    else
        printf 'Error: bws secret list failed — token NOT saved\n' >&2
        printf 'Check your token and try again\n' >&2
        unset access_token
        exit 1
    fi

    unset access_token
    dotfiles_secrets_harden_permissions

    printf '\nBackend: %s\n' "$(dotfiles_secrets_backend)"
    printf 'Next: %s ls   /   %s envrc\n' "$PROG" "$PROG"
}

# ─── secrets edit ────────────────────────────────────────────────────────────
edit_fzf_loop() {
    local mutated=false
    local listing items line _id env_name bws_key preview note
    local selection action chosen chosen_env new_key new_desc new_value confirm

    while true; do
        items=()
        listing=$("$ENGINE" list-full 2>/dev/null) || die "failed to list secrets"

        while IFS=$'\t' read -r _id env_name bws_key preview note; do
            [[ -n "$_id" ]] || continue
            line="$env_name"
            if [[ "$bws_key" != "$env_name" ]]; then
                line+=$'\t'"(bws: $bws_key)"
            else
                line+=$'\t'
            fi
            line+=$'\t'"$preview"
            [[ -n "$note" ]] && line+=$'\t'"# $note"
            items+=("$line")
        done <<< "$listing"

        if [[ ${#items[@]} -eq 0 ]]; then
            printf 'No secrets found. Use Ctrl-A to add one.\n'
            items=("")
        fi

        selection=$(printf '%s\n' "${items[@]}" | fzf \
            --prompt="secrets> " \
            --header="Enter: edit value | Ctrl-A: add | Ctrl-X: delete | Esc: done" \
            --expect=ctrl-a,ctrl-x \
            --delimiter=$'\t' \
            --no-multi \
            --ansi) || break

        action=$(head -1 <<< "$selection")
        chosen=$(sed -n '2p' <<< "$selection")
        chosen_env="${chosen%%$'\t'*}"

        case "$action" in
            ctrl-a)
                printf 'Key (ENV_VAR_NAME): ' >/dev/tty
                read -r new_key </dev/tty
                [[ -n "$new_key" ]] || continue
                printf 'Description (optional, appended as "KEY - desc"): ' >/dev/tty
                read -r new_desc </dev/tty
                printf 'Value: ' >/dev/tty
                read -rs new_value </dev/tty
                printf '\n' >/dev/tty
                [[ -n "$new_value" ]] || { printf 'Empty value, skipping.\n'; continue; }
                if [[ -n "$new_desc" ]]; then
                    "$ENGINE" set "$new_key" "$new_value" --note "$new_desc"
                else
                    "$ENGINE" set "$new_key" "$new_value"
                fi
                mutated=true
                ;;
            ctrl-x)
                [[ -n "$chosen_env" ]] || continue
                printf 'Delete %s? (y/N) ' "$chosen_env" >/dev/tty
                read -r confirm </dev/tty
                if [[ "$confirm" == [yY]* ]]; then
                    "$ENGINE" rm --yes "$chosen_env"
                    mutated=true
                fi
                ;;
            *)  # Enter: edit value
                [[ -n "$chosen_env" ]] || continue
                printf 'New value for %s: ' "$chosen_env" >/dev/tty
                read -rs new_value </dev/tty
                printf '\n' >/dev/tty
                [[ -n "$new_value" ]] || { printf 'Empty value, skipping.\n'; continue; }
                "$ENGINE" set "$chosen_env" "$new_value"
                mutated=true
                ;;
        esac
    done

    if $mutated; then
        # Secrets resolve live from BWS on every call, so there is nothing to
        # invalidate. A shell that already exported the old value keeps it until
        # direnv re-evaluates.
        printf "Done. Run 'direnv reload' in a project to re-export the new value.\n"
    fi
}

cmd_edit() {
    local backend
    backend=$(dotfiles_secrets_backend)
    case "$backend" in
        bws)
            if [[ $# -ge 1 ]]; then
                "$ENGINE" set "$@"
                return
            fi
            command -v fzf >/dev/null 2>&1 \
                || die "fzf required for the interactive editor. Use: $PROG edit KEY [VALUE]"
            edit_fzf_loop
            ;;
        *)
            die "no secrets backend. Run: $PROG init"
            ;;
    esac
}

# ─── secrets envrc --plaintext ───────────────────────────────────────────────
# Materialize real values into .env, for a repo whose runtime never goes through
# direnv (a container, a systemd unit). Everything else uses plain `envrc`.
plaintext_repo_root() { git rev-parse --show-toplevel 2>/dev/null || pwd; }

# Bindings this repo's .envrc already declares, in the formats setup-envrc
# writes. Same cascade as its own reader, newest format first.
plaintext_current_bindings() {
    local envrc="$1"
    [[ -f "$envrc" ]] || return 0

    if grep -q '^# setup-envrc binding:' "$envrc"; then
        sed -n 's/^# setup-envrc binding:[[:space:]]*//p' "$envrc" | sed '/^$/d'
        return 0
    fi
    if grep -q '^# setup-envrc exports:' "$envrc"; then
        sed -n 's/^# setup-envrc exports:[[:space:]]*//p' "$envrc" | tr ' ' '\n' | sed '/^$/d'
        return 0
    fi
    if grep -q '^# setup-envrc:' "$envrc"; then
        sed -n 's/^# setup-envrc:[[:space:]]*//p' "$envrc" | tr ' ' '\n' | sed '/^$/d'
        return 0
    fi
    sed -n 's/^export[[:space:]]\{1,\}\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$envrc"
}

# `.envrc` in .gitignore does NOT cover `.env`, so this is its own check.
plaintext_env_is_gitignored() {
    local gitignore="$1"
    [[ -f "$gitignore" ]] || return 1
    grep -Eq '^/?(\*\*/)?\.env\*?$' "$gitignore"
}

cmd_envrc_plaintext() {
    local repo_root envrc gitignore target exports names name value bindings=()

    repo_root=$(plaintext_repo_root)
    envrc="$repo_root/.envrc"
    gitignore="$repo_root/.gitignore"
    target="$repo_root/.env"

    if ! plaintext_env_is_gitignored "$gitignore"; then
        printf '%s: refusing to write %s — .env is not covered by %s\n' "$PROG" "$target" "$gitignore" >&2
        printf 'This command writes real secret values to disk. Add this line first:\n' >&2
        printf '\n  .env\n\n' >&2
        exit 1
    fi

    # One resolution path for all three modes: ask the engine for export lines,
    # then read names and values back out of them.
    if [[ "${1:-}" == "--all" ]]; then
        [[ $# -eq 1 ]] || die "--plaintext --all takes no further keys"
        exports=$("$ENGINE" shell --all) || exit 1
    elif [[ $# -gt 0 ]]; then
        exports=$("$ENGINE" shell-bindings "$@") || exit 1
    else
        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            bindings+=("$name")
        done < <(plaintext_current_bindings "$envrc")
        [[ ${#bindings[@]} -gt 0 ]] \
            || die "nothing to write: no keys given and $envrc declares no bindings"
        exports=$("$ENGINE" shell-bindings "${bindings[@]}") || exit 1
    fi

    names=$(printf '%s\n' "$exports" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p')
    [[ -n "$names" ]] || die "the backend resolved no keys"

    # A .env line cannot carry a newline — docker's env_file has no continuation
    # or quoting rule, so a multi-line value would silently truncate.
    while IFS= read -r name; do
        value=$(eval "$exports"; printf '%s' "${!name}")
        case "$value" in
            *$'\n'*) die "$name has a multi-line value, which .env cannot represent" ;;
        esac
    done <<< "$names"

    (
        umask 077
        {
            # shellcheck disable=SC2016  # backticks are literal text in the header
            printf '# Generated by `%s envrc --plaintext` at %s\n' "$PROG" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            printf '# STATIC VALUES, NOT LIVE BINDINGS. Rotating a secret in BWS does not\n'
            printf '# update this file — re-run the command above to pick up a new value.\n'
            # shellcheck disable=SC2016  # backticks are literal text in the header
            printf '# For anything with a shell session, use `%s envrc` (direnv) instead:\n' "$PROG"
            printf '# it resolves live and leaves no secret at rest.\n'
            eval "$exports"
            while IFS= read -r name; do
                printf '%s=%s\n' "$name" "${!name}"
            done <<< "$names"
        } > "$target"
    )
    chmod 600 "$target"

    printf 'Wrote %s (mode 600, %s key(s))\n' "$target" "$(printf '%s\n' "$names" | wc -l | tr -d ' ')"
    printf 'Values are static. Re-run after any rotation.\n'
}

cmd_envrc() {
    local arg rest=() seen=false

    # --plaintext is intercepted here; setup-envrc dies on flags it does not
    # know. Every other flag passes through verbatim.
    for arg in "$@"; do
        if [[ "$seen" == false && "$arg" == "--plaintext" ]]; then seen=true; continue; fi
        rest+=("$arg")
    done

    if [[ "$seen" == true ]]; then
        cmd_envrc_plaintext ${rest[@]+"${rest[@]}"}
    else
        "$ENVRC_IMPL" "$@"
    fi
}

# ─── bare `secrets`: status header, then a menu only if the terminal allows ───
print_status() {
    local backend ambiguous perms bindings

    backend=$(dotfiles_secrets_backend)
    printf 'secrets — backend: %s\n' "$backend"
    printf '  token file: %s\n' "$(dotfiles_secrets_bws_token_file)"
    printf '\n'

    bindings=$("$ENVRC_IMPL" --list 2>/dev/null || true)
    if [[ -n "$bindings" ]]; then
        printf '%s\n' "$bindings"
    else
        printf 'Current .envrc bindings: (could not read this repo)\n'
    fi
    printf '\n'

    if [[ "$backend" == "bws" ]]; then
        ambiguous=$(ls_ambiguous_env_names 2>/dev/null || true)
        if [[ -n "$ambiguous" ]]; then
            printf 'Env names with more than one BWS key:\n'
            while IFS= read -r name; do
                [[ -n "$name" ]] || continue
                printf '  %-28s -> %s\n' "$name" \
                    "$("$ENGINE" scope-entries "$name" 2>/dev/null \
                        | awk -F'\t' '$1 == "active" { print $2; exit }' \
                        || true)"
            done <<< "$ambiguous"
            printf '  (blank means undeclared; choose with: %s use ENV)\n' "$PROG"
        else
            printf 'Ambiguous env names: none\n'
        fi
    else
        printf 'Ambiguous env names: (unavailable — no backend)\n'
    fi
    printf '\n'

    # Read-only. `secrets doctor` is the one command that applies these.
    perms=$( { dotfiles_secrets_permission_issues; project_secret_permission_issues "$PWD"; } 2>/dev/null || true )
    if [[ -n "$perms" ]]; then
        printf 'Permissions that %s doctor would fix:\n' "$PROG"
        printf '%s\n' "$perms" | sed 's/^/  /'
    else
        printf 'Permissions: ok\n'
    fi
}

# Mirrors custom_bins/app-picker's TUI gate, with one deliberate addition:
# app-picker checks stdin only, because piping can only break keyboard input to
# its own checkbox list. This menu dispatches into MUTATING subcommands, so it
# also requires stdout to be a terminal — that is what makes `secrets | cat`
# and any hook, script or CI caller safe to run unconditionally.
bare_secrets() {
    print_status

    if [[ "${NON_INTERACTIVE:-false}" == "true" ]] \
       || ! [[ -t 0 ]] || ! [[ -t 1 ]] || ! command -v gum >/dev/null 2>&1; then
        return 0
    fi

    local choice=""
    # gum returns nonzero on Esc; cancelling after reading the status is
    # "I looked, I'm done", not an error.
    choice=$(gum choose --header "What next?" -- \
        "Edit keys" "Wire this repo" "Run with secrets" "Init BWS") || return 0
    [[ -n "$choice" ]] || return 0

    case "$choice" in
        "Edit keys")        cmd_edit ;;
        "Wire this repo")   cmd_envrc ;;
        "Run with secrets") run_usage ;;   # no command known yet: inform, exit 0
        "Init BWS")         cmd_init ;;
    esac
}

# ─── dispatch ────────────────────────────────────────────────────────────────
main() {
    case "${1:-}" in
        "")            bare_secrets ;;
        -h|--help|help) usage ;;
        init)          shift; cmd_init "$@" ;;
        edit)          shift; cmd_edit "$@" ;;
        ls)            shift; cmd_ls "$@" ;;
        get)           shift
                       [[ $# -eq 1 ]] || { printf 'Usage: %s get ENV_NAME\n' "$PROG" >&2; exit 2; }
                       "$ENGINE" get-value "$1" ;;
        use)           shift; "$USE_IMPL" "$@" ;;
        envrc)         shift; cmd_envrc "$@" ;;
        run)           shift; cmd_run "$@" ;;
        doctor)        shift; [[ $# -eq 0 ]] || die "doctor takes no arguments"; cmd_doctor ;;
        -*)            printf '%s: unknown option %s\n' "$PROG" "$1" >&2; usage >&2; exit 2 ;;
        *)             printf '%s: unknown subcommand %s\n' "$PROG" "$1" >&2; usage >&2; exit 2 ;;
    esac
}

main "$@"
