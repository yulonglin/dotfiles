#!/usr/bin/env bash
# secrets-use — flip which BWS key an env name resolves to, machine-wide.
#
# Several BWS secrets legitimately share one env name (one per account or
# collaborator). config/secrets-global.conf is the single per-machine authority
# for which of them is active; this is the tool that edits it. Every scope that
# resolves a bare env name follows it: Claude Code hooks, wrappers,
# `secrets run`, and follow-mode .envrc bindings.
#
#   secrets-use                          interactive picker
#   secrets-use --list                   show every ambiguous env name + state
#   secrets-use ENV_NAME                 pick a key for ENV_NAME interactively
#   secrets-use ENV_NAME <key-or-desc>   make that key active
#   secrets-use ENV_NAME --next          block the active key, promote the next
#   secrets-use ENV_NAME --activate <k>  unblock a key (reverses --next)
#   secrets-use ENV_NAME --list          show state for one env name
#
# SEMANTICS
# Setting a key PROMOTES it to the front of that env name's preference list and
# keeps the previous entries below it as fallbacks — that is what makes --next
# useful later. It never reorders or rewrites any OTHER env name's lines, and it
# preserves comments and blank lines verbatim.
#
# --next only marks the active key blocked ("!" prefix); it does not reorder.
# So `--next` followed by `--activate <that key>` restores the file byte for
# byte. Nothing here ever switches keys automatically: failing over would
# silently start spending from an account you did not choose.
#
# A conf written before the "[global]" name marker was retired may still carry
# it. Readers strip it, and the first write of that name drops it for good.

set -euo pipefail

PROG=${0##*/}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

command -v dotfiles-secrets >/dev/null 2>&1 \
    || die "dotfiles-secrets not found on PATH"

CONF=$(dotfiles-secrets scope-conf-path) \
    || die "could not determine the global-scope conf path"
[[ -n "$CONF" ]] || die "dotfiles-secrets returned an empty conf path"

# --- BWS key inventory -------------------------------------------------------
# One line per secret: env_name<TAB>bws_key<TAB>note<TAB>uuid
META=""
load_meta() {
    [[ -n "$META" ]] && return 0
    META=$(dotfiles-secrets keys-meta 2>/dev/null) \
        || die "could not list BWS keys (is the BWS token present?)"
    [[ -n "$META" ]] || die "no BWS keys returned by 'dotfiles-secrets keys-meta'"
}

# Every BWS key registered under an env name, in inventory order.
keys_for_env() {
    load_meta
    printf '%s\n' "$META" | awk -F'\t' -v want="$1" '$1 == want { print $2 }'
}

# Env names with more than one BWS key — the only ones the conf governs.
ambiguous_env_names() {
    load_meta
    printf '%s\n' "$META" | awk -F'\t' '{ n[$1]++ } END { for (k in n) if (n[k] > 1) print k }' | sort
}

env_name_exists() {
    load_meta
    printf '%s\n' "$META" | awk -F'\t' -v want="$1" '$1 == want { found = 1 } END { exit !found }'
}

# --- conf state --------------------------------------------------------------
# state<TAB>value per declared entry, in file order. Parsed by dotfiles-secrets
# so there is exactly one implementation of the format.
entries_for() { dotfiles-secrets scope-entries "$1" 2>/dev/null || true; }

active_key_for() { entries_for "$1" | awk -F'\t' '$1 == "active" { print $2; exit }'; }

# Resolve a user-supplied query to exactly one BWS key for this env name.
# Accepts the full key, or any unambiguous substring of it (the description).
resolve_key() {
    local env_name="$1" query="$2" matches count
    while IFS= read -r k; do
        [[ "$k" == "$query" ]] && { printf '%s\n' "$k"; return 0; }
    done < <(keys_for_env "$env_name")

    matches=$(keys_for_env "$env_name" | grep -F -- "$query" || true)
    count=$(printf '%s' "$matches" | grep -c . || true)
    case "$count" in
        1) printf '%s\n' "$matches" ;;
        0) die "no BWS key for '$env_name' matches '$query'. Candidates:
$(keys_for_env "$env_name" | sed 's/^/  /')" ;;
        *) die "'$query' matches $count keys for '$env_name' — be more specific:
$(printf '%s\n' "$matches" | sed 's/^/  /')" ;;
    esac
}

# --- conf locking ------------------------------------------------------------
# Every mutation is read-decide-rewrite, and rewrite_env_lines replaces the file
# wholesale via mv. Two concurrent writers (a deploy running while the user
# switches accounts) would otherwise let one snapshot the file before the
# other's change and rename that stale snapshot back over it — losing the
# decision sentinel, which is the record that must not be lost.
#
# mkdir, not flock: flock is util-linux and absent from a stock macOS, and this
# repo deploys to both. mkdir is atomic on every filesystem we target.
CONF_LOCK="${CONF}.lock"
CONF_LOCK_HELD=false

release_conf_lock() {
    [[ "$CONF_LOCK_HELD" == true ]] || return 0
    rmdir "$CONF_LOCK" 2>/dev/null || true
    CONF_LOCK_HELD=false
}

# Idempotent within a process, so a command that delegates to another holds one
# lock across the whole decision rather than deadlocking on itself.
acquire_conf_lock() {
    [[ "$CONF_LOCK_HELD" == true ]] && return 0
    local waited=0
    mkdir -p "$(dirname "$CONF")"
    # Only contention justifies waiting. An unwritable parent fails the same
    # mkdir, and spinning on it reports "another secrets-use is running" for what
    # is really a permissions problem — seen for real under the sandbox, where
    # config/ is denied. Test the cause directly rather than inferring it from
    # the lock's absence after a failed mkdir: the holder may simply have
    # released in between, and that inference would turn a normal race into a
    # confident, wrong permissions error.
    [[ -w "$(dirname "$CONF")" ]] || die "cannot create $CONF_LOCK
$(dirname "$CONF") is not writable — a permissions problem, not a busy lock."
    while ! mkdir "$CONF_LOCK" 2>/dev/null; do
        waited=$((waited + 1))
        # Bounded: a lock orphaned by a killed writer must not wedge every
        # future edit with no way to tell what happened.
        if [[ "$waited" -gt 100 ]]; then
            die "timed out waiting for $CONF_LOCK
Another secrets-use may be running. If none is, remove the directory and retry."
        fi
        sleep 0.1
    done
    CONF_LOCK_HELD=true
    trap release_conf_lock EXIT
    trap 'release_conf_lock; exit 130' INT
    trap 'release_conf_lock; exit 143' TERM
}

# --- conf writing ------------------------------------------------------------
# Rewrites ONLY the declaration lines of one env name, in place, preserving
# every other line (including comments) byte for byte. Values are supplied on
# stdin, one per line, already carrying any "!" blocked prefix.
#
# The i-th supplied value overwrites the i-th existing declaration line for this
# env name, so surrounding structure is kept. Extra values are appended after
# the last one (or at end of file when the name was never declared).
#
# A legacy "[global]" suffix on the name field is matched but never re-emitted,
# so the first write of a name that still carries one cleans it up.
rewrite_env_lines() {
    local env_name="$1" values="$2" tmp
    acquire_conf_lock
    tmp="${CONF}.tmp.$$"

    mkdir -p "$(dirname "$CONF")"
    [[ -f "$CONF" ]] || : > "$CONF"

    ( umask 077
      awk -v want="$env_name" -v vals="$values" '
        BEGIN {
            n = split(vals, v, "\n")
            # split() leaves a trailing empty element when vals ends in \n
            while (n > 0 && v[n] == "") n--
            used = 0
        }
        function decl_name(line,   name) {
            if (line ~ /^[[:space:]]*#/ || line ~ /^[[:space:]]*$/) return ""
            if (index(line, "=") == 0) return ""
            name = substr(line, 1, index(line, "=") - 1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
            sub(/[[:space:]]*\[global\]$/, "", name)
            return name
        }
        {
            if (decl_name($0) == want) {
                lastidx = NR
                used++
                if (used <= n) print want " = " v[used]
                # surplus existing lines are dropped (value list shrank)
                next
            }
            print
        }
        END {
            for (i = used + 1; i <= n; i++) print want " = " v[i]
        }
      ' "$CONF" > "$tmp"
    ) || { rm -f "$tmp"; die "failed to rewrite $CONF"; }

    # Test-only seam. The read-decide-rewrite window is a few milliseconds wide,
    # so a concurrency test that just forks two writers and hopes they collide
    # detects a missing lock about 1 time in 40 — measured, not guessed. This
    # widens the window on demand so tests/test_secrets_use.sh can force one
    # specific interleaving every run. Never set outside the test suite.
    [[ -n "${SECRETS_USE_TEST_PRE_MV_DELAY:-}" ]] && sleep "$SECRETS_USE_TEST_PRE_MV_DELAY"

    mv "$tmp" "$CONF"
    chmod 600 "$CONF" 2>/dev/null || true
}

# --- reporting ---------------------------------------------------------------
show_env() {
    local env_name="$1" state value marker any=false
    printf '%s\n' "$env_name"
    while IFS=$'\t' read -r state value; do
        [[ -n "$value" ]] || continue
        any=true
        if [[ "$state" == "active" ]]; then marker="  * "; else marker="  ! "; fi
        printf '%s%s%s\n' "$marker" "$value" \
            "$([[ "$state" == blocked ]] && printf ' (blocked)')"
    done < <(entries_for "$env_name")
    if [[ "$any" == false ]]; then
        printf '  (undeclared — resolution hard-errors until a key is chosen)\n'
        keys_for_env "$env_name" | sed 's/^/    candidate: /'
    fi
}

cmd_list() {
    local name shown=false
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        shown=true
        show_env "$name"
        printf '\n'
    done < <(ambiguous_env_names)
    [[ "$shown" == true ]] || printf 'No env name maps to more than one BWS key.\n'
    printf 'conf: %s\n' "$CONF"
}

# --- operations --------------------------------------------------------------
report_change() {
    printf '%s: %s -> %s\n' "$1" "${2:-<undeclared>}" "${3:-<none>}"
    printf 'Takes effect on the next direnv load or hook invocation.\n'
    printf 'Already-running processes keep the old key until restarted.\n'
}

cmd_set() {
    local env_name="$1" query="$2" key old values=""
    key=$(resolve_key "$env_name" "$query")
    # The lock covers the conf reads below, not resolve_key: the whole command is
    # read-decide-rewrite, so locking only the write lets two processes snapshot
    # the same old order and land an outcome equal to neither serial ordering --
    # silently discarding one account choice. resolve_key stays outside it
    # because it only queries the BWS inventory, and holding a lock across a
    # network call would block every other writer for its duration.
    acquire_conf_lock
    old=$(active_key_for "$env_name")

    if [[ "$old" == "$key" ]]; then
        printf '%s: already active -> %s\n' "$env_name" "$key"
        return 0
    fi

    # Promote the chosen key to the front, unblocked; keep the rest below it in
    # their existing order and state, minus any stale copy of the chosen key.
    values="$key"
    local state value
    while IFS=$'\t' read -r state value; do
        [[ -n "$value" ]] || continue
        [[ "$value" == "$key" ]] && continue
        if [[ "$state" == "blocked" ]]; then
            values+=$'\n'"!$value"
        else
            values+=$'\n'"$value"
        fi
    done < <(entries_for "$env_name")

    rewrite_env_lines "$env_name" "$values"
    report_change "$env_name" "$old" "$key"
}

cmd_next() {
    local env_name="$1" old new values="" state value found=false
    acquire_conf_lock   # read-decide-rewrite — see cmd_set
    old=$(active_key_for "$env_name")
    [[ -n "$old" ]] || die "'$env_name' has no active key to block. Set one first: $PROG $env_name <key>"

    # Mark the active key blocked. Order is untouched, so --activate reverses
    # this byte for byte.
    while IFS=$'\t' read -r state value; do
        [[ -n "$value" ]] || continue
        if [[ "$found" == false && "$value" == "$old" ]]; then
            found=true
            value="!$value"
        elif [[ "$state" == "blocked" ]]; then
            value="!$value"
        fi
        [[ -n "$values" ]] && values+=$'\n'
        values+="$value"
    done < <(entries_for "$env_name")

    rewrite_env_lines "$env_name" "$values"

    new=$(active_key_for "$env_name")
    if [[ -z "$new" ]]; then
        printf '%s: %s is now blocked and NO active key remains.\n' "$env_name" "$old" >&2
        printf 'Resolution will hard-error until you add or unblock one:\n' >&2
        printf '  %s %s --activate %s\n' "$PROG" "$env_name" "$old" >&2
        show_env "$env_name" >&2
        exit 1
    fi
    report_change "$env_name" "$old" "$new"
}

cmd_activate() {
    local env_name="$1" query="$2" key old values="" state value
    key=$(resolve_key "$env_name" "$query")
    acquire_conf_lock   # read-decide-rewrite — see cmd_set
    old=$(active_key_for "$env_name")

    while IFS=$'\t' read -r state value; do
        [[ -n "$value" ]] || continue
        if [[ "$state" == "blocked" && "$value" != "$key" ]]; then
            value="!$value"
        fi
        [[ -n "$values" ]] && values+=$'\n'
        values+="$value"
    done < <(entries_for "$env_name")

    [[ -n "$values" ]] || die "'$env_name' has no declared keys to unblock"

    rewrite_env_lines "$env_name" "$values"
    report_change "$env_name" "$old" "$(active_key_for "$env_name")"
}

# --- interactive -------------------------------------------------------------
have_fzf() { command -v fzf >/dev/null 2>&1; }

pick_env_name() {
    ambiguous_env_names | fzf --prompt='env name> ' --height=40% --reverse \
        --preview="$0 {} --list" --preview-window=right:60%
}

pick_key_for() {
    keys_for_env "$1" | fzf --prompt="$1 key> " --height=40% --reverse
}

# --- argument handling -------------------------------------------------------
# Prints the header comment. The upper bound tracks the line before `set -euo`.
usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; }

main() {
    case "${1:-}" in
        -h|--help)
            usage; exit 0 ;;
        --list|"")
            # Bare invocation falls back to --list when fzf is unavailable.
            if [[ "${1:-}" == "--list" ]] || ! have_fzf; then
                cmd_list; exit 0
            fi
            local name key
            name=$(pick_env_name) || exit 0
            [[ -n "$name" ]] || exit 0
            key=$(pick_key_for "$name") || exit 0
            [[ -n "$key" ]] || exit 0
            cmd_set "$name" "$key"; exit 0 ;;
        -*)
            die "unknown option '$1' (expected an env name first). Try: $PROG --help" ;;
    esac

    local env_name="$1"; shift

    env_name_exists "$env_name" \
        || die "no BWS key uses env name '$env_name'. See: dotfiles-secrets keys-meta"

    case "${1:-}" in
        "")
            if have_fzf; then
                local key
                key=$(pick_key_for "$env_name") || exit 0
                [[ -n "$key" ]] || exit 0
                cmd_set "$env_name" "$key"
            else
                show_env "$env_name"
            fi ;;
        --list)     show_env "$env_name" ;;
        --next)     cmd_next "$env_name" ;;
        --activate)
            [[ -n "${2:-}" ]] || die "--activate needs a key. Try: $PROG $env_name --list"
            cmd_activate "$env_name" "$2" ;;
        -*)         die "unknown option '$1'. Try: $PROG --help" ;;
        *)          cmd_set "$env_name" "$1" ;;
    esac
}

main "$@"
