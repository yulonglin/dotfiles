 border-radius:0 7px 7px 0;padding:.6rem .8rem;margin:.5rem 0;font-size:.88rem}}
.cmt .q{{color:var(--soft);font-style:italic;margin-bottom:.3rem}}
.cmt .where{{font-size:.75rem;color:var(--soft);text-transform:uppercase;letter-spacing:.04em}}
