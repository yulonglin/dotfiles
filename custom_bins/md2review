mark.note{{background:var(--mark);border-bottom:2px solid var(--accent);cursor:pointer;border-radius:2px}}
#pop{{position:absolute;z-index:50;display:none;background:var(--panel);border:1px solid var(--rule);
 border-radius:8px;box-shadow:0 6px 22px rgba(0,0,0,.16);padding:.6rem;width:20rem}}
#pop textarea{{width:100%;min-height:4.5rem;border:1px solid var(--rule);border-radius:5px;
 background:var(--bg);color:var(--ink);padding:.4rem;font:inherit;font-size:.86rem;resize:vertical}}
