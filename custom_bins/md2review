 padding:.6rem 1rem;display:flex;gap:.6rem;align-items:center;justify-content:center;flex-wrap:wrap;z-index:40}}
#bar .count{{color:var(--soft);font-size:.87rem}}
#bar .count.warn{{color:var(--bad);font-weight:650}}
