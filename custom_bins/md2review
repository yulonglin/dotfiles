@media (max-width:56rem){{
  .shell.has-toc{{display:block}}
  .toc{{position:static;max-height:none;border-right:0;border-bottom:1px solid var(--rule);
   padding:0 0 .8rem;margin-bottom:1.4rem}}
  .toc a{{display:inline-block;margin:.15rem .3rem .15rem 0;border-left:0}}
  .toc a.lvl3{{padding-left:.45rem}}
}}
</style>
{shell_open}
{toc}
<div class="doc">
{body}
<h2 id="your-comments">Your comments</h2>
<div id="list"></div>
</div>
</div>

<div id="pop">
  <textarea id="txt" placeholder="What do you think?"></textarea>
  <div class="row">
    <button class="btn ghost danger" id="delete">Delete</button>
    <button class="btn ghost" id="cancel">Cancel</button>
    <button class="btn" id="save">Save</button>
  </div>
</div>

<div id="bar">
  <span class="count" id="count">No comments yet</span>
  <button class="btn" id="copy">Copy all</button>
  <button class="btn ghost" id="download">Download .md</button>
  <button class="btn ghost" id="clear">Clear all</button>
  <span id="toast"></span>
</div>

<script>
const KEY = {key};
const DIRTY = KEY + "-dirty";
let comments = [];
try {{ comments = JSON.parse(localStorage.getItem(KEY) || "[]"); }} catch (e) {{ comments = []; }}
let dirty = false;
try {{ dirty = localStorage.getItem(DIRTY) === "1"; }} catch (e) {{}}
let nextId = comments.reduce((m, c) => Math.max(m, c.id || 0), 0) + 1;
comments.forEach((c) => {{ if (!c.id) c.id = nextId++; }});

const pop = document.getElementById("pop");
const txt = document.getElementById("txt");
let pending = null, editingId = null;

window.addEventListener("beforeunload", (e) => {{
  if (!dirty || !comments.length) return;
  e.preventDefault(); e.returnValue = ""; return "";
}});

function sectionOf(node) {{
  while (node && node.nodeType === 3) node = node.parentNode;
  while (node && node !== document.body) {{
    let p = node.previousElementSibling;
    while (p) {{
      if (/^H[1-3]$/.test(p.tagName)) return p.textContent.trim();
      p = p.previousElementSibling;
    }}
    node = node.parentNode;
  }}
  return "document";
}}

document.addEventListener("click", (ev) => {{
  const m = ev.target.closest && ev.target.closest("mark.note");
  if (!m || pop.contains(ev.target)) return;
  const c = comments.find((x) => x.id === Number(m.dataset.cid));
  if (!c) return;
  ev.preventDefault();
  editingId = c.id; pending = null; txt.value = c.note;
  const r = m.getBoundingClientRect();
  pop.classList.add("editing"); pop.style.display = "block";
  pop.style.top = (window.scrollY + r.bottom + 8) + "px";
  pop.style.left = Math.max(8, Math.min(window.scrollX + r.left,
    window.scrollX + document.documentElement.clientWidth - pop.offsetWidth - 12)) + "px";
  txt.focus();
}});

document.addEventListener("mouseup", (ev) => {{
  if (pop.contains(ev.target)) return;
  if (ev.target.closest && ev.target.closest("mark.note")) return;
  const sel = window.getSelection();
  const text = sel ? sel.toString().trim() : "";
  if (!text) {{ pop.style.display = "none"; return; }}
  const rect = sel.getRangeAt(0).getBoundingClientRect();
  editingId = null; pop.classList.remove("editing");
  pending = {{ quote: text, where: sectionOf(sel.anchorNode), range: sel.getRangeAt(0).cloneRange() }};
  pop.style.display = "block";
  pop.style.top = (window.scrollY + rect.bottom + 8) + "px";
  pop.style.left = Math.max(8, Math.min(window.scrollX + rect.left,
    window.scrollX + document.documentElement.clientWidth - pop.offsetWidth - 12)) + "px";
  txt.value = ""; txt.focus();
}});

function closePop() {{ pop.style.display = "none"; pending = null; editingId = null; pop.classList.remove("editing"); }}
function markDirty() {{ dirty = true; try {{ localStorage.setItem(DIRTY, "1"); }} catch (e) {{}} }}
function markClean() {{ dirty = false; try {{ localStorage.setItem(DIRTY, "0"); }} catch (e) {{}} }}
function persist() {{ try {{ localStorage.setItem(KEY, JSON.stringify(comments)); }} catch (e) {{}} }}

document.getElementById("cancel").onclick = closePop;
document.getElementById("delete").onclick = () => {{
  if (editingId === null) {{ closePop(); return; }}
  comments = comments.filter((c) => c.id !== editingId);
  const m = document.querySelector('mark.note[data-cid="' + editingId + '"]');
  if (m) m.replaceWith(document.createTextNode(m.textContent));
  markDirty(); persist(); render(); closePop();
}};
document.getElementById("save").onclick = () => {{
  const note = txt.value.trim();
  if (!note) {{ closePop(); return; }}
  if (editingId !== null) {{
    const c = comments.find((x) => x.id === editingId);
    if (c) c.note = note;
    const m = document.querySelector('mark.note[data-cid="' + editingId + '"]');
    if (m) m.title = note;
  }} else if (pending) {{
    const id = nextId++;
    try {{
      const m = document.createElement("mark");
      m.className = "note"; m.title = note; m.dataset.cid = String(id);
      pending.range.surroundContents(m);
    }} catch (e) {{ }}
    comments.push({{ id: id, where: pending.where, quote: pending.quote, note: note }});
  }}
  markDirty(); persist(); render(); closePop();
  window.getSelection().removeAllRanges();
}};

function render() {{
  const list = document.getElementById("list");
  const count = document.getElementById("count");
  list.innerHTML = "";
  if (!comments.length) {{
    count.textContent = "No comments yet"; count.className = "count";
    list.innerHTML = '<p style="color:var(--soft)">Select any text above to comment.</p>';
    return;
  }}
  count.textContent = comments.length + (comments.length === 1 ? " comment" : " comments")
    + (dirty ? " — not yet exported" : " — exported");
  count.className = "count" + (dirty ? " warn" : "");
  comments.forEach((c) => {{
    const d = document.createElement("div"); d.className = "cmt";
    const w = document.createElement("div"); w.className = "where"; w.textContent = c.where;
    const q = document.createElement("div"); q.className = "q"; q.textContent = '"' + c.quote + '"';
    const n = document.createElement("div"); n.textContent = c.note;
    const a = document.createElement("button"); a.className = "btn ghost tiny"; a.textContent = "edit";
    a.onclick = () => {{
      const m = document.querySelector('mark.note[data-cid="' + c.id + '"]');
      if (m) {{ m.scrollIntoView({{ block: "center" }}); m.click(); }}
      else {{ editingId = c.id; txt.value = c.note; pop.classList.add("editing");
              pop.style.display = "block"; pop.style.top = (window.scrollY + 120) + "px";
              pop.style.left = "1rem"; txt.focus(); }}
    }};
    d.append(w, q, n, a); list.appendChild(d);
  }});
}}

function markdown() {{
  return comments.map((c) =>
    "- **" + c.where + "** — " + c.note + "\\n  > " + c.quote.replace(/\\n/g, "\\n  > ")
  ).join("\\n");
}}
function exportText() {{ return "# Comments — " + document.title + "\\n\\n" + markdown() + "\\n"; }}

document.getElementById("copy").onclick = async () => {{
  const toast = document.getElementById("toast");
  if (!comments.length) {{ toast.innerHTML = '<span class="ok">nothing to copy</span>';
    setTimeout(() => toast.innerHTML = "", 1600); return; }}
  try {{ await navigator.clipboard.writeText(exportText()); }}
  catch (e) {{
    const ta = document.createElement("textarea");
    ta.value = exportText(); document.body.appendChild(ta); ta.select();
    try {{ document.execCommand("copy"); }} catch (e2) {{}}
    ta.remove();
  }}
  markClean(); render();
  toast.innerHTML = '<span class="ok">copied ' + comments.length + '</span>';
  setTimeout(() => toast.innerHTML = "", 1800);
}};

document.getElementById("download").onclick = () => {{
  if (!comments.length) return;
  const url = URL.createObjectURL(new Blob([exportText()], {{ type: "text/markdown" }}));
  const a = document.createElement("a");
  a.href = url; a.download = "comments.md";
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url); markClean(); render();
}};

document.getElementById("clear").onclick = () => {{
  if (!comments.length) return;
  if (dirty && !window.confirm("These " + comments.length +
      " comments have not been copied or downloaded yet. Delete anyway?")) return;
  comments = []; markClean(); persist(); render();
  document.querySelectorAll("mark.note").forEach((m) => m.replaceWith(document.createTextNode(m.textContent)));
}};

const tocLinks = Array.from(document.querySelectorAll(".toc a"));
const targets = tocLinks
  .map((a) => ({{ a, el: document.getElementById(a.getAttribute("href").slice(1)) }}))
  .filter((t) => t.el);
if ("IntersectionObserver" in window && targets.length) {{
  const io = new IntersectionObserver((entries) => {{
    entries.forEach((e) => {{
      if (!e.isIntersecting) return;
      const hit = targets.find((t) => t.el === e.target);
      if (!hit) return;
      tocLinks.forEach((a) => a.classList.remove("on"));
      hit.a.classList.add("on");
    }});
  }}, {{ rootMargin: "-12% 0px -75% 0px" }});
  targets.forEach((t) => io.observe(t.el));
}}

render();
</script>
"""


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("source", type=Path, help="Markdown file to wrap")
    ap.add_argument("-o", "--output", type=Path, help="output HTML (default: <source>.review.html)")
    ap.add_argument("--title", help="page title (default: first H1, else the filename stem)")
    ap.add_argument("--no-toc", action="store_true", help="omit the table of contents")
    ap.add_argument(
        "--key",
        help="localStorage key for comments (default: derived from the filename, so "
        "republishing the same document keeps its comments)",
    )
    args = ap.parse_args(argv)

    if not args.source.is_file():
        ap.error(f"no such file: {args.source}")
    text = args.source.read_text(encoding="utf-8")

    title = args.title
    if not title:
        m = re.search(r"^#\s+(.+)$", text, re.MULTILINE)
        title = m.group(1).strip() if m else args.source.stem

    out = args.output or args.source.with_suffix(".review.html")
    key = args.key or f"review-{slugify(args.source.stem)}"
    out.write_text(
        build(text, title=title, with_toc=not args.no_toc, key=key), encoding="utf-8"
    )
    print(out)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
