def format_failure_counts(counts):
    backends = ", ".join(f"{name} {counts['by_backend'][name]}" for name in BACKENDS)
    categories = ", ".join(
        f"{name} {count}" for name, count in sorted(counts["by_category"].items())
    )
    line = f"{counts['total']} ({backends})"
    return f"{line}; categories {categories}" if categories else line


def print_approval_failures(failures, coverage):
    structured = failures["structured"]
    legacy = failures["legacy_unattributed"]
    actions = structured["actions"]
    if not failures["coverage"]["available"]:
        print("Approval backend failures: the approval log is unavailable")
        print(
            "Coverage: approval failure accounting is the "
            f"{coverage['approval_classifier_failures']}"
        )
        return
    print(
        "Approval backend failures (structured): "
        f"{format_failure_counts(structured['backend_failures'])}"
    )
    print(
        "Approval classifier failure-path attempts (structured): "
        f"{actions['observed']} observed, {actions['recovered']} recovered by fallback, "
        f"{actions['unresolved']} unresolved, "
        f"{actions['incomplete']} with no fallback outcome retained"
    )
    print(
        "Approval backend failures (legacy, unattributed): "
        f"{format_failure_counts(legacy['backend_failures'])}"
    )
    for label, section in (("structured", structured), ("legacy", legacy)):
        fallback = section["fallback"]
        print(
            f"Approval fallback ({label}): {fallback['succeeded']} succeeded, "
            f"{fallback['failed']} failed, {fallback['skipped_no_budget']} skipped for no budget"
        )
    print(f"Coverage: approval failure accounting is the {coverage['approval_classifier_failures']}")


def print_native_failures(failures):
    print(f"Native auto-mode failures: {failures['total']} across {failures['sessions']} sessions")
    categories = ", ".join(
        f"{name} {count}" for name, count in failures["by_category"].items()
    )
    print(f"  Categories: {categories or 'none recorded'}")
    for label, key in (
        ("classifier model", "by_model"),
        ("session model", "by_session_model"),
        ("CLI version", "by_cli_version"),
        ("tool", "by_tool"),
        ("cwd", "by_cwd"),
    ):
        print(f"Native failures by {label}:")
        for name, count in failures[key].items():
            print(f"  {name}: {count}")
    exposure = failures["exposure"]
    outside = exposure["failures_outside_denominator"]
    if outside["total"]:
        tools = ", ".join(f"{name} {n}" for name, n in outside["by_tool"].items())
        print(
            f"Failures outside the denominator: {outside['total']} ({tools}) — "
            "counted in the total, excluded from every rate"
        )
    print("Native failures by day (in-denominator failures / classifier-bound calls, CLI versions):")
    days = sorted(set(failures["by_day"]) | set(exposure["classifier_bound_calls_by_day"]))
    for day in days:
        calls = sum(exposure["classifier_bound_calls_by_day"].get(day, {}).values())
        rate = exposure["failures_per_100_bound_calls_by_day"].get(day)
        rate_text = f", {rate:g} per 100 calls" if rate is not None else ""
        versions = ", ".join(sorted(exposure["cli_versions_by_day"].get(day, {})))
        print(
            f"  {day}: {failures['by_day'].get(day, 0)} / {calls}{rate_text}"
            f"{'; ' + versions if versions else ''}"
        )
    print("Native failures by day and session model (failures / bound calls):")
    for day, models in exposure["by_day_and_session_model"].items():
        cells = ", ".join(
            f"{model} {cell['failures']}/{cell['bound_calls']}" for model, cell in models.items()
        )
        print(f"  {day}: {cells}")
    hours = failures["by_hour"]
    if hours:
        peak = min(hours, key=lambda hour: (-hours[hour], hour))
        print(f"Peak UTC hour: {peak} ({hours[peak]})")
    else:
        print("Peak UTC hour: none recorded")
    coverage = failures["coverage"]
    print(
        f"Native coverage: {coverage['scanned_files']} scanned files, "
        f"{coverage['unreadable_files']} unreadable; "
        f"{coverage['malformed_rows']} malformed rows; "
        f"{coverage['raw_matching_observations']} matching observations, "
        f"{coverage['duplicate_observations']} duplicates, "
        f"{coverage['invalid_timestamp_observations']} invalid timestamps, "
        f"{coverage['missing_id_observations']} missing IDs (entire selected scan)"
    )


