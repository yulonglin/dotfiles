#!/usr/bin/env python3
"""Audit Claude Code plugin/skill/agent/MCP usage from session transcripts.

Scans all session JSONL files to find which components are actually used,
then compares against what's installed/configured.

Usage:
    claude-usage-audit                 # Full report
    claude-usage-audit --json          # Machine-readable output
    claude-usage-audit --days 7        # Only last 7 days
    claude-usage-audit --project dotfiles  # Filter by project name substring
"""

import argparse
import fcntl
import json
import math
import os
import re
import sys
import time
from collections import Counter, defaultdict
from datetime import datetime, timezone
from pathlib import Path

PROJECTS_DIR = Path.home() / ".claude" / "projects"
PLUGINS_FILE = Path.home() / ".claude" / "plugins" / "installed_plugins.json"
PROFILES_FILE = Path.home() / ".claude" / "templates" / "contexts" / "profiles.yaml"
APPROVAL_LOG = Path.home() / ".cache" / "claude" / "approval-classifier.log"
QUOTA_CACHE_NAME = "claude-statusline-usage.json"
QUOTA_CACHE_TTL_SECONDS = 300
QUOTA_HISTORY = Path.home() / ".claude" / "usage-data" / "quota-history.jsonl"
TOKEN_FIELDS = (
    "input_tokens",
    "output_tokens",
    "cache_read_input_tokens",
    "cache_creation_input_tokens",
)
# The one definition of every limit the report states, so the JSON and the human
# report cannot drift apart. Both renderers read these through the report data.
REPORT_COVERAGE = {
    # Native tool-result failures and the custom hook log are separate sources.
    "native_auto_mode_classifier": (
        "persisted unavailability failures only; "
        "successful calls, retries, tokens and goal state unobserved"
    ),
    "approval_classifier": (
        "direct API USAGE log only; CLI subscription fallback is unobserved"
    ),
    "approval_classifier_failures": (
        "custom PermissionRequest hook only; legacy log lines are unattributed to an action"
    ),
    "project_filter_scope": (
        "--project filters transcript usage and native failures only; approval and quota are host-wide"
    ),
    "quota_history": (
        "sampled only when --model-usage runs, without account attribution; "
        "samples may interleave accounts and no identity is recorded"
    ),
    "non_persisted_calls": "absent",
}
REPORT_NOTES = ("tokens are not subscription quota",)


def parse_args():
    p = argparse.ArgumentParser(description="Audit Claude Code component usage")
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument("--days", type=int, default=0, help="Only scan last N days (0=all)")
    p.add_argument("--project", type=str, default="", help="Filter by project name substring")
    p.add_argument("--verbose", "-v", action="store_true", help="Show per-project breakdown")
    p.add_argument(
        "--model-usage",
        action="store_true",
        help="Report persisted model tokens and sampled subscription quota",
    )
    return p.parse_args()


def get_installed_plugins():
    """Parse installed_plugins.json to get all installed plugin names."""
    if not PLUGINS_FILE.exists():
        return {}
    with open(PLUGINS_FILE) as f:
        data = json.load(f)
    plugins = {}
    for name, installs in data.get("plugins", {}).items():
        # name format: "pluginName@marketplace"
        short = name.split("@")[0]
        plugins[short] = {
            "full_name": name,
            "install_count": len(installs),
        }
    return plugins


def get_profiles():
    """Parse profiles.yaml for base + profile plugin lists."""
    if not PROFILES_FILE.exists():
        return {}, {}
    try:
        import yaml
        with open(PROFILES_FILE) as f:
            data = yaml.safe_load(f)
        return data.get("base", []), data.get("profiles", {})
    except ImportError:
        # Fallback: simple regex parse
        base = []
        profiles = {}
        with open(PROFILES_FILE) as f:
            text = f.read()
        # Extract base list
        base_match = re.search(r"^base:\s*\n((?:\s+-\s+\S+\n)+)", text, re.MULTILINE)
        if base_match:
            base = re.findall(r"-\s+(\S+)", base_match.group(1))
        # Extract profile enables
        for m in re.finditer(
            r"^\s{2}(\w[\w-]*):\s*\n(?:\s+comment:.*\n)?\s+enable:\s*\n?((?:\s+-\s+\S+\n)*|\[.*\])",
            text,
            re.MULTILINE,
        ):
            name = m.group(1)
            enables_text = m.group(2)
            if enables_text.strip().startswith("["):
                enables = re.findall(r"[\w-]+", enables_text)
            else:
                enables = re.findall(r"-\s+([\w-]+)", enables_text)
            profiles[name] = {"enable": enables}
        return base, profiles


def parse_timestamp(value):
    if not isinstance(value, str) or not value:
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.utcoffset() is None:
        # Reject ambiguous timestamps instead of assuming the host timezone.
        return None
    return parsed.timestamp()


def format_timestamp(epoch):
    dt = datetime.fromtimestamp(epoch, timezone.utc)
    timespec = "seconds" if dt.microsecond == 0 else "microseconds"
    return dt.isoformat(timespec=timespec).replace("+00:00", "Z")


def canonical_timestamp(value):
    epoch = parse_timestamp(value)
    return format_timestamp(epoch) if epoch is not None else None


def numeric_tokens(usage):
    if not isinstance(usage, dict):
        return None
    tokens = {}
    present = False
    for field in TOKEN_FIELDS:
        value = usage.get(field, 0)
        if field in usage:
            present = True
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            return None
        tokens[field] = value
    return tokens if present else None


def summarize_usage_records(records):
    totals = {field: 0 for field in TOKEN_FIELDS}
    for record in records:
        for field in TOKEN_FIELDS:
            totals[field] += record["tokens"][field]
    totals["total_tokens"] = sum(totals.values())
    input_side = (
        totals["input_tokens"]
        + totals["cache_read_input_tokens"]
        + totals["cache_creation_input_tokens"]
    )
    summary = {
        "requests": len(records),
        "tokens": totals,
        "cache_read_fraction": (
            totals["cache_read_input_tokens"] / input_side if input_side else 0.0
        ),
    }
    return summary


def aggregate_usage_records(records, coverage):
    summary = summarize_usage_records(records)
    by_model = defaultdict(list)
    by_day = defaultdict(list)
    for record in records:
        by_model[record["model"]].append(record)
        by_day[record["timestamp"][:10]].append(record)
    summary["by_model"] = {
        key: summarize_usage_records(group) for key, group in sorted(by_model.items())
    }
    summary["by_day"] = {
        key: summarize_usage_records(group) for key, group in sorted(by_day.items())
    }
    summary["coverage"] = coverage
    return summary


def transcript_paths(projects_dir, project_filter=""):
    """Session files to scan, skipping the subtrees of non-matching projects entirely."""
    if not project_filter:
        return sorted(projects_dir.rglob("*.jsonl"))
    try:
        entries = list(projects_dir.iterdir())
    except OSError:
        # An unreadable root yields nothing, as the unfiltered glob has always done.
        return []
    selected = [
        entry
        for entry in entries
        if entry.is_dir() and project_filter.lower() in entry.name.lower()
    ]
    return sorted(path for entry in selected for path in entry.rglob("*.jsonl"))


# The classifier token is whatever served the classifier call, not the conversation
# model, and it is not always an Anthropic catalogue ID: retained rows carry
# `claude-opus-5[1m]` on Claude-model sessions and `astra` on a session routed to a
# foreign model (both observed 2026-09-08), so any bounded identifier is accepted.
NATIVE_FAILURE_RE = re.compile(
    r"([A-Za-z0-9][A-Za-z0-9._-]{0,120}(?:\[1m\])?) is temporarily unavailable "
    r"\(([^()\r\n]+)\), so auto mode cannot determine the safety of "
    r"([^\r\n]+?) right now\."
)
# The reasons the CLI documents (errors reference, 2026-09-09): a 429, a 529, a 5xx.
NATIVE_REASON_CATEGORIES = {
    "rate-limited": "rate_limit",
    "overloaded": "overloaded",
    "server-error": "server_error",
}
NATIVE_TEXT_CAP = 200
# Tool calls that reach the auto-mode classifier in auto mode (permission-modes
# docs, 2026-09-09: reads and working-directory edits skip it; shell, Monitor and
# Agent spawns do not, and "the classifier also reviews each message Claude sends
# to another agent with SendMessage"). Counted per day as the exposure a failure
# count is read against — an approximation, since allow rules and cached verdicts
# skip it too.
#
# A failure whose tool is NOT in this set (an Edit to a protected path, an MCP
# tool) is real but has no denominator here, so it is counted separately rather
# than divided by a denominator that never contained it. Reported by the council
# review of 2026-09-10, which found 107 such failures being divided by a
# denominator built from a different tool set.
CLASSIFIER_BOUND_TOOLS = frozenset({
    "Bash", "PowerShell", "Monitor", "Agent", "Task", "SendMessage",
})
# Every row of a Claude Code transcript is stamped with these; copied onto each
# failure record so it can be sliced by where and on what CLI it happened.
NATIVE_ROW_ATTRIBUTES = ("cwd", "version", "gitBranch", "sessionId")
NATIVE_FAILURE_LIMITS = (
    "selected JSONL files only; supported typed unavailability prefix only; "
    "by_model is the bounded classifier token in that prefix (not always an Anthropic "
    "catalogue ID), never the conversation model; any token that completes the full "
    "template counts, model-shaped or not; "
    "session_model is the newest assistant model seen earlier in the same file, "
    "so it is absent when the failure precedes any assistant row; "
    "cwd, cli_version, branch and session_id are copied from the failing row as the "
    "CLI stamped them; "
    "coverage counters span the entire selected scan, not just the period; "
    "scanned_files counts opened files; unreadable_files counts failed opens or read failures "
    "(opened files with read failures appear in both counts; readable prefixes are retained); "
    "malformed_rows counts JSON decode failures; invalid timestamp and missing ID "
    "observations can overlap; duplicates count repeated nonempty string IDs regardless "
    "of timestamp usability; "
    "one failure per nonempty string tool_use_id globally, earliest valid timestamp "
    "before cutoff, ties by model then category; missing IDs excluded, no UUID fallback; "
    "earliest/latest and buckets describe counted in-period failures in UTC; "
    "rate-limited, overloaded and server-error map to their own categories, other "
    "reasons map to other with the reason text retained; "
    "exposure counts assistant tool_use blocks for classifier-bound tools "
    "(Bash, PowerShell, Monitor, Agent, Task, SendMessage) once per tool_use id, whether "
    "or not the call was classified: allow rules, cached verdicts and non-auto modes are "
    "unobserved, so it is an upper bound on classifier calls, not a count of them; "
    "every rate divides only failures whose tool is in that set, and failures on any other "
    "tool are reported under exposure.failures_outside_denominator instead of being divided "
    "by a denominator that never contained them; "
    "a day whose bound calls are a partial day (the scan's newest day, or one bounded by "
    "--days) yields a rate over that part only and is not comparable with a whole day; "
    "no snapshot text files; absent roots and unreadable directories may be omitted by discovery; "
    "missing evidence is not evidence of no failures; no "
    "hidden HTTP attempts or complete historical coverage; "
    "CLI wording changes require a parser update; "
    "failures are not proof of goal changes or identical-command retry causation; "
    + REPORT_COVERAGE["native_auto_mode_classifier"]
)


def native_failure_observations(entry):
    """Yield (tool_use_id, classifier model, category, reason, tool) per failing block."""
    if entry.get("type") != "user":
        return
    message = entry.get("message")
    if not isinstance(message, dict) or message.get("role") != "user":
        return
    content = message.get("content")
    if not isinstance(content, list):
        return
    for block in content:
        if (
            not isinstance(block, dict)
            or block.get("type") != "tool_result"
            or block.get("is_error") is not True
            or not isinstance(block.get("content"), str)
        ):
            continue
        match = NATIVE_FAILURE_RE.match(block["content"])
        if match is not None:
            reason = match.group(2)
            yield (
                block.get("tool_use_id"),
                match.group(1),
                NATIVE_REASON_CATEGORIES.get(reason, "other"),
                reason[:NATIVE_TEXT_CAP],
                match.group(3)[:NATIVE_TEXT_CAP],
            )


def _row_attribute(entry, key):
    value = entry.get(key)
    return value if isinstance(value, str) and value else None


def native_failure_record(entry, epoch, identity, model, category, reason, tool, session_model):
    return {
        "timestamp": format_timestamp(epoch),
        "epoch": epoch,
        "tool_use_id": identity,
        "model": model,
        "category": category,
        "reason": reason,
        "tool": tool,
        "cwd": _row_attribute(entry, "cwd"),
        "cli_version": _row_attribute(entry, "version"),
        "branch": _row_attribute(entry, "gitBranch"),
        "session_id": _row_attribute(entry, "sessionId"),
        "session_model": session_model,
    }


def _native_sort_key(record):
    return (record["epoch"], record["model"], record["category"])


NATIVE_SLICES = (
    "category", "model", "reason", "tool", "day", "hour",
    "cwd", "cli_version", "branch", "session_model", "session_id",
)


def aggregate_native_failures(observations, coverage, cutoff_epoch, exposure):
    # Resolve mirrors over the complete selected scan BEFORE applying the period.
    records = sorted(
        (
            record for record in observations.values()
            if not cutoff_epoch or record["epoch"] >= cutoff_epoch
        ),
        key=_native_sort_key,
    )
    summary = {"total": len(records)}
    counters = {name: Counter() for name in NATIVE_SLICES}
    for record in records:
        timestamp = record["timestamp"]
        record["day"] = timestamp[:10]
        record["hour"] = timestamp[:13] + ":00:00Z"
        for name in NATIVE_SLICES:
            counters[name][str(record[name])] += 1
    for name in NATIVE_SLICES:
        summary[f"by_{name}"] = dict(sorted(counters[name].items()))
    summary["sessions"] = len(counters["session_id"])
    summary["records"] = [
        {key: value for key, value in record.items() if key not in ("epoch", "day", "hour")}
        for record in records
    ]
    # Only failures whose tool is in the denominator may be divided by it.
    in_denominator = [r for r in records if r["tool"] in CLASSIFIER_BOUND_TOOLS]
    outside = Counter(r["tool"] for r in records if r["tool"] not in CLASSIFIER_BOUND_TOOLS)
    failures_by_day = Counter(r["day"] for r in in_denominator)
    by_day_model = defaultdict(lambda: defaultdict(lambda: {"bound_calls": 0, "failures": 0}))
    for (day, model), n in exposure["calls_by_day_model"].items():
        by_day_model[day][str(model)]["bound_calls"] = n
    for record in in_denominator:
        by_day_model[record["day"]][str(record["session_model"])]["failures"] += 1
    for day in by_day_model:
        for cell in by_day_model[day].values():
            cell["per_100_bound_calls"] = (
                round(100 * cell["failures"] / cell["bound_calls"], 2) if cell["bound_calls"] else None
            )
    summary["exposure"] = {
        "classifier_bound_calls_by_day": {
            day: dict(sorted(tools.items()))
            for day, tools in sorted(exposure["calls_by_day"].items())
        },
        # The slice that separates "the gateway/day is bad" from "sessions on this
        # model fail": the same day's calls, split by the conversation model.
        "by_day_and_session_model": {
            day: dict(sorted(models.items())) for day, models in sorted(by_day_model.items())
        },
        "cli_versions_by_day": {
            day: dict(sorted(versions.items()))
            for day, versions in sorted(exposure["versions_by_day"].items())
        },
        "failures_per_100_bound_calls_by_day": {
            day: round(100 * failures_by_day[day] / total, 2)
            for day, tools in sorted(exposure["calls_by_day"].items())
            if day in failures_by_day and (total := sum(tools.values()))
        },
        # Real failures the denominator cannot measure, kept visible rather than
        # divided by a call count that never included their tool.
        "failures_outside_denominator": {
            "total": sum(outside.values()),
            "by_tool": dict(sorted(outside.items())),
            "note": (
                "counted in total and every by_* slice, excluded from every rate: "
                "the denominator counts only CLASSIFIER_BOUND_TOOLS"
            ),
        },
        "failures_in_denominator": len(in_denominator),
    }
    if records:
        coverage["earliest_in_period"] = records[0]["timestamp"]
        coverage["latest_in_period"] = records[-1]["timestamp"]
    summary["coverage"] = coverage
    return summary


def readable_transcript_lines(lines, coverage):
    """Keep the readable prefix and let the scan continue after a file read fails."""
    try:
        yield from lines
    except OSError:
        coverage["unreadable_files"] += 1


def scan_transcripts(projects_dir, cutoff_epoch=0, project_filter=""):
    """Read selected transcripts once for usage snapshots and native failures."""
    native_coverage = {
        "scanned_files": 0,
        "unreadable_files": 0,
        "malformed_rows": 0,
        "raw_matching_observations": 0,
        "invalid_timestamp_observations": 0,
        "missing_id_observations": 0,
        "duplicate_observations": 0,
        "earliest_in_period": None,
        "latest_in_period": None,
        "limits": NATIVE_FAILURE_LIMITS,
    }
    native_observations = {}
    native_seen_ids = set()
    exposure = {
        "calls_by_day": defaultdict(Counter),
        "calls_by_day_model": Counter(),
        "versions_by_day": defaultdict(Counter),
        "seen_call_ids": set(),
    }
    coverage = {
        "earliest_in_period": None,
        "latest_in_period": None,
        "malformed_rows": 0,
        "unusable_usage_rows": 0,
        "invalid_timestamp_rows": 0,
        "unkeyed_rows": 0,
    }
    snapshots = {}
    projects_dir = Path(projects_dir)
    paths = transcript_paths(projects_dir, project_filter) if projects_dir.is_dir() else []
    for path in paths:
        try:
            lines = path.open(errors="replace")
        except OSError:
            native_coverage["unreadable_files"] += 1
            continue
        native_coverage["scanned_files"] += 1
        session_model = None
        with lines:
            for line in readable_transcript_lines(lines, native_coverage):
                try:
                    entry = json.loads(line)
                except (json.JSONDecodeError, TypeError):
                    coverage["malformed_rows"] += 1
                    native_coverage["malformed_rows"] += 1
                    continue
                if not isinstance(entry, dict):
                    continue
                for identity, model, category, reason, tool in native_failure_observations(entry):
                    native_coverage["raw_matching_observations"] += 1
                    epoch = parse_timestamp(entry.get("timestamp"))
                    valid_id = isinstance(identity, str) and bool(identity)
                    if epoch is None:
                        native_coverage["invalid_timestamp_observations"] += 1
                    if not valid_id:
                        native_coverage["missing_id_observations"] += 1
                    else:
                        if identity in native_seen_ids:
                            native_coverage["duplicate_observations"] += 1
                        native_seen_ids.add(identity)
                    if epoch is None or not valid_id:
                        continue
                    record = native_failure_record(
                        entry, epoch, identity, model, category, reason, tool, session_model
                    )
                    previous = native_observations.get(identity)
                    if previous is None or _native_sort_key(record) < _native_sort_key(previous):
                        native_observations[identity] = record
                if entry.get("type") != "assistant":
                    continue
                message = entry.get("message")
                if not isinstance(message, dict):
                    continue
                if isinstance(message.get("model"), str) and message["model"]:
                    session_model = message["model"]
                record_exposure(entry, message, exposure, cutoff_epoch)
                usage = message.get("usage")
                tokens = numeric_tokens(usage)
                if tokens is None:
                    if "usage" in message:
                        coverage["unusable_usage_rows"] += 1
                    continue
                epoch = parse_timestamp(entry.get("timestamp"))
                if epoch is None:
                    coverage["invalid_timestamp_rows"] += 1
                    continue
                if cutoff_epoch and epoch < cutoff_epoch:
                    continue
                # One streamed response spans many rows that share a response identity
                # but carry distinct row UUIDs, so the UUID is the last resort only.
                identity = (
                    ("message", message.get("id")),
                    ("request", entry.get("requestId")),
                    ("uuid", entry.get("uuid")),
                )
                key = next(
                    (
                        (kind, value)
                        for kind, value in identity
                        if isinstance(value, str) and value
                    ),
                    None,
                )
                if key is None:
                    coverage["unkeyed_rows"] += 1
                    continue
                model = message.get("model")
                if not isinstance(model, str) or not model:
                    model = "unknown"
                record = {
                    "timestamp": format_timestamp(epoch),
                    "epoch": epoch,
                    "model": model,
                    "tokens": tokens,
                }
                input_side = (
                    tokens["input_tokens"]
                    + tokens["cache_read_input_tokens"]
                    + tokens["cache_creation_input_tokens"]
                )
                rank = (tokens["output_tokens"], input_side)
                previous = snapshots.get(key)
                if previous is None or rank > previous[0]:
                    snapshots[key] = (rank, record)

    records = [item[1] for item in snapshots.values()]
    if records:
        # Aggregation groups by model and day, so only the endpoints need an order.
        coverage["earliest_in_period"] = min(records, key=lambda r: r["epoch"])["timestamp"]
        coverage["latest_in_period"] = max(records, key=lambda r: r["epoch"])["timestamp"]
    return (
        aggregate_usage_records(records, coverage),
        aggregate_native_failures(native_observations, native_coverage, cutoff_epoch, exposure),
    )


def record_exposure(entry, message, exposure, cutoff_epoch):
    """Count this assistant row's classifier-bound tool calls and its CLI version by UTC day."""
    epoch = parse_timestamp(entry.get("timestamp"))
    if epoch is None or (cutoff_epoch and epoch < cutoff_epoch):
        return
    day = format_timestamp(epoch)[:10]
    version = _row_attribute(entry, "version")
    if version:
        exposure["versions_by_day"][day][version] += 1
    content = message.get("content")
    if not isinstance(content, list):
        return
    for block in content:
        if not isinstance(block, dict) or block.get("type") != "tool_use":
            continue
        name = block.get("name")
        call_id = block.get("id")
        if name not in CLASSIFIER_BOUND_TOOLS or not isinstance(call_id, str) or not call_id:
            continue
        if call_id in exposure["seen_call_ids"]:
            continue
        exposure["seen_call_ids"].add(call_id)
        exposure["calls_by_day"][day][name] += 1
        model = message.get("model")
        exposure["calls_by_day_model"][(day, model if isinstance(model, str) and model else None)] += 1


def scan_transcript_model_usage(projects_dir, cutoff_epoch=0, project_filter=""):
    """Compatibility wrapper preserving the existing token-usage return shape."""
    usage, _ = scan_transcripts(projects_dir, cutoff_epoch, project_filter)
    return usage


APPROVAL_USAGE_RE = re.compile(
    r"^(\S+) USAGE: model=(\S+) input=(\d+) output=(\d+) "
    r"cache_read=(\d+) cache_create=(\d+)$"
)


def scan_approval_usage(log_path, cutoff_epoch=0):
    coverage = {
        "available": False,
        "earliest_retained_at": None,
        "latest_retained_at": None,
        "malformed_usage_lines": 0,
        "retention": "rotating_1mb_log",
    }
    path = Path(log_path)
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return aggregate_usage_records([], coverage)

    coverage["available"] = True
    records = []
    retained = []
    for line in lines:
        if " USAGE:" not in line:
            continue
        match = APPROVAL_USAGE_RE.fullmatch(line)
        if match is None:
            coverage["malformed_usage_lines"] += 1
            continue
        timestamp, model, input_, output, cache_read, cache_create = match.groups()
        epoch = parse_timestamp(timestamp)
        if epoch is None:
            coverage["malformed_usage_lines"] += 1
            continue
        retained.append((epoch, timestamp))
        if cutoff_epoch and epoch < cutoff_epoch:
            continue
        records.append({
            "timestamp": format_timestamp(epoch),
            "epoch": epoch,
            "model": model,
            "tokens": {
                "input_tokens": int(input_),
                "output_tokens": int(output),
                "cache_read_input_tokens": int(cache_read),
                "cache_creation_input_tokens": int(cache_create),
            },
        })
    if retained:
        coverage["earliest_retained_at"] = min(retained)[1]
        coverage["latest_retained_at"] = max(retained)[1]
    return aggregate_usage_records(records, coverage)


# --- backend failure accounting ----------------------------------------------
#
# The approval log carries two mutually exclusive record formats. A line written
# before the hook gained structured events starts with the human sentence
# ("API BACKEND FAILED: …") and carries no action id, so its failures can be
# counted but never attributed to one classification attempt. A line written
# after starts with BACKEND-EVENT and a versioned JSON payload, which carries an
# opaque action id — so two backend failures on one action read as one failed
# action, and a fallback that recovered an API failure is not a failed action at
# all. Nothing needs de-duplicating: one outcome is always exactly one line.
BACKEND_EVENT_PREFIX = "BACKEND-EVENT"
# v1 carried a hashed session; v2 carries the session id in the clear plus the
# backend's model and where it ran (host, cwd, repo, remote, commit, branch,
# cli_version, session_model, account). Both count the same way; v2 fields feed
# the by_* slices and read as "unknown" on a v1 line.
SUPPORTED_EVENT_VERSIONS = (1, 2)
EVENT_SLICES = ("model", "host", "repo", "commit", "cli_version", "session_model", "account")
BACKEND_EVENT_RE = re.compile(rf"^(\S+) {BACKEND_EVENT_PREFIX} (.+)$")
LEGACY_API_FAILURE_RE = re.compile(r"^(\S+) API BACKEND FAILED: (.*)$")
LEGACY_SUB_SKIPPED_RE = re.compile(r"^(\S+) SUBSCRIPTION BACKEND SKIPPED: ")
LEGACY_SUB_SUCCESS_RE = re.compile(r"^(\S+) SUBSCRIPTION BACKEND: classified after")
LEGACY_SUB_FAILURE_RE = re.compile(
    r"^(\S+) WARNING: .* — subscription fallback also failed: (.*)$"
)
BACKENDS = ("api", "subscription")

# A frozen copy of approval_classifier.FAILURE_CATEGORY_RULES. It exists only to
# read log lines written before the hook categorized its own failures, so it
# never has to follow the hook forward; the hook's tests pin the two to agree on
# every warning the hook can raise today.
LEGACY_FAILURE_CATEGORY_RULES = (
    ("credits", ("out of credits", "credit balance", "billing", "payment")),
    ("usage_limit", ("usage limit", "spend limit")),
    ("rate_limit", ("rate limit",)),
    ("auth", ("rejected", "authentication", "invalid x-api-key", "is not set", "not logged in")),
    ("timeout", ("timed out", "timeout")),
    ("overloaded", ("overloaded", "http 529")),
    ("network", ("could not reach", "errno", "connection")),
)
FAILURE_CATEGORIES = tuple(name for name, _ in LEGACY_FAILURE_CATEGORY_RULES) + ("other",)


def legacy_failure_category(headline, details=""):
    combined = f"{headline} {details}".lower()
    for category, tokens in LEGACY_FAILURE_CATEGORY_RULES:
        if any(token in combined for token in tokens):
            return category
    return "other"


def empty_failure_counts():
    return {
        "total": 0,
        "by_backend": {backend: 0 for backend in BACKENDS},
        "by_category": {},
    }


def empty_failure_section(with_actions):
    section = {
        "backend_failures": empty_failure_counts(),
        "fallback": {"succeeded": 0, "failed": 0, "skipped_no_budget": 0},
        "by_day": {},
    }
    if with_actions:
        section["actions"] = {
            "observed": 0,
            "recovered": 0,
            "unresolved": 0,
            "incomplete": 0,
        }
        for name in EVENT_SLICES:
            section[f"by_{name}"] = {}
        section["records"] = []
    return section


def add_backend_failure(section, backend, category, timestamp, payload=None):
    counts = section["backend_failures"]
    counts["total"] += 1
    counts["by_backend"][backend] += 1
    counts["by_category"][category] = counts["by_category"].get(category, 0) + 1
    day = timestamp[:10]
    section["by_day"][day] = section["by_day"].get(day, 0) + 1
    if payload is None:
        return
    for name in EVENT_SLICES:
        value = payload.get(name)
        key = value if isinstance(value, str) and value else "unknown"
        section[f"by_{name}"][key] = section[f"by_{name}"].get(key, 0) + 1
    section["records"].append({"timestamp": timestamp, **payload})


def parse_backend_event(payload_text):
    """Decode the JSON payload that opens a structured line, ignoring its tail.

    The human sentence after the object is for a person reading the log; it is
    never a second record.
    """
    try:
        payload, _ = json.JSONDecoder().raw_decode(payload_text)
    except ValueError:
        return None
    return payload if isinstance(payload, dict) else None


def scan_approval_failures(log_path, cutoff_epoch=0):
    coverage = {
        "available": False,
        "earliest_record_at": None,
        "latest_record_at": None,
        "structured_first_at": None,
        "legacy_records": 0,
        "structured_records": 0,
        "malformed_events": 0,
        "unsupported_event_versions": 0,
        "retention": "rotating_1mb_log",
        "scope": (
            "custom PermissionRequest hook only; native unavailability failures "
            "are reported separately from transcript tool results"
        ),
        "actions_scope": (
            "failure-path hook attempts only: a successful API classification "
            "writes no event, and a retry in a new hook process counts as a "
            "separate attempt"
        ),
    }
    structured = empty_failure_section(with_actions=True)
    legacy = empty_failure_section(with_actions=False)
    report = {
        "structured": structured,
        "legacy_unattributed": legacy,
        "coverage": coverage,
    }

    try:
        lines = Path(log_path).read_text(errors="replace").splitlines()
    except OSError:
        return report

    coverage["available"] = True
    retained = []
    actions = defaultdict(set)

    def record(epoch, timestamp):
        """Note the retained boundary, then say whether the period includes it."""
        retained.append((epoch, timestamp))
        return not (cutoff_epoch and epoch < cutoff_epoch)

    for line in lines:
        event_match = BACKEND_EVENT_RE.match(line)
        if event_match is not None:
            epoch = parse_timestamp(event_match.group(1))
            payload = parse_backend_event(event_match.group(2))
            if epoch is None or payload is None:
                coverage["malformed_events"] += 1
                continue
            version = payload.get("v")
            if not isinstance(version, int) or isinstance(version, bool):
                coverage["malformed_events"] += 1
                continue
            if version not in SUPPORTED_EVENT_VERSIONS:
                coverage["unsupported_event_versions"] += 1
                continue
            backend = payload.get("backend")
            outcome = payload.get("outcome")
            action = payload.get("action")
            if (
                backend not in BACKENDS
                or outcome not in ("failure", "success", "skipped")
                or (backend == "api" and outcome != "failure")
                or not isinstance(action, str)
                or not action
                or (
                    outcome == "skipped"
                    and (backend != "subscription" or payload.get("reason") != "no_budget")
                )
            ):
                coverage["malformed_events"] += 1
                continue
            timestamp = format_timestamp(epoch)
            if coverage["structured_first_at"] is None:
                coverage["structured_first_at"] = timestamp
            if not record(epoch, timestamp):
                continue
            coverage["structured_records"] += 1
            actions[action].add((backend, outcome))
            if outcome == "failure":
                category = payload.get("failure_category")
                if category not in FAILURE_CATEGORIES:
                    category = "other"
                add_backend_failure(structured, backend, category, timestamp, payload)
                if backend == "subscription":
                    structured["fallback"]["failed"] += 1
            elif backend == "subscription" and outcome == "success":
                structured["fallback"]["succeeded"] += 1
            elif backend == "subscription" and outcome == "skipped":
                structured["fallback"]["skipped_no_budget"] += 1
            continue

        api_match = LEGACY_API_FAILURE_RE.match(line)
        if api_match is not None:
            epoch = parse_timestamp(api_match.group(1))
            if epoch is None:
                continue
            timestamp = format_timestamp(epoch)
            if not record(epoch, timestamp):
                continue
            coverage["legacy_records"] += 1
            headline, _, details = api_match.group(2).partition(" — ")
            add_backend_failure(
                legacy, "api", legacy_failure_category(headline, details), timestamp
            )
            continue

        sub_failure_match = LEGACY_SUB_FAILURE_RE.match(line)
        if sub_failure_match is not None:
            epoch = parse_timestamp(sub_failure_match.group(1))
            if epoch is None:
                continue
            timestamp = format_timestamp(epoch)
            if not record(epoch, timestamp):
                continue
            coverage["legacy_records"] += 1
            # Only the fallback's own headline: the API failure this warning
            # restates already has its own line.
            add_backend_failure(
                legacy,
                "subscription",
                legacy_failure_category(sub_failure_match.group(2)),
                timestamp,
            )
            legacy["fallback"]["failed"] += 1
            continue

        for pattern, key in (
            (LEGACY_SUB_SUCCESS_RE, "succeeded"),
            (LEGACY_SUB_SKIPPED_RE, "skipped_no_budget"),
        ):
            other_match = pattern.match(line)
            if other_match is None:
                continue
            epoch = parse_timestamp(other_match.group(1))
            if epoch is None:
                break
            timestamp = format_timestamp(epoch)
            if not record(epoch, timestamp):
                break
            coverage["legacy_records"] += 1
            legacy["fallback"][key] += 1
            break

    for outcomes in actions.values():
        structured["actions"]["observed"] += 1
        if ("subscription", "success") in outcomes:
            structured["actions"]["recovered"] += 1
        elif ("subscription", "failure") in outcomes or ("subscription", "skipped") in outcomes:
            structured["actions"]["unresolved"] += 1
        else:
            # No fallback outcome is retained at scan time. Rotation, a call
            # still in flight, and a failed log write all look like this, so it
            # is never read as resolved and never as a dead process.
            structured["actions"]["incomplete"] += 1

    if retained:
        coverage["earliest_record_at"] = min(retained)[1]
        coverage["latest_record_at"] = max(retained)[1]
    return report


def quota_bucket(name, utilization, resets_at):
    """Build one canonical bucket, or None when the utilization is unusable."""
    if isinstance(utilization, bool) or not isinstance(utilization, (int, float)):
        return None
    if not math.isfinite(utilization):
        return None
    return {
        "name": name,
        "utilization": utilization,
        "resets_at": canonical_timestamp(resets_at),
    }


def quota_buckets(payload):
    buckets = []
    for name in ("five_hour", "seven_day"):
        bucket = payload.get(name)
        if not isinstance(bucket, dict):
            continue
        built = quota_bucket(name, bucket.get("utilization"), bucket.get("resets_at"))
        if built is not None:
            buckets.append(built)
    limits = payload.get("limits")
    if not isinstance(limits, list):
        return buckets
    for limit in limits:
        if not isinstance(limit, dict) or limit.get("kind") != "weekly_scoped":
            continue
        scope = limit.get("scope")
        model = scope.get("model") if isinstance(scope, dict) else None
        display_name = model.get("display_name") if isinstance(model, dict) else None
        if not isinstance(display_name, str) or not display_name.strip():
            continue
        display_name = re.sub(r"[^A-Za-z0-9._ -]", "", display_name).strip()[:80]
        if not display_name:
            continue
        built = quota_bucket(
            f"weekly_scoped:{display_name}", limit.get("percent"), limit.get("resets_at")
        )
        if built is not None:
            buckets.append(built)
    return buckets


def read_quota_cache(cache_path, now_epoch=None):
    """Read the statusline quota cache; returns (status, the new observation or None)."""
    cache_path = Path(cache_path)
    try:
        stat = cache_path.stat()
        payload = json.loads(cache_path.read_text())
    except FileNotFoundError:
        return {"available": False, "reason": "cache_missing"}, None
    except (OSError, UnicodeError, json.JSONDecodeError, TypeError):
        return {"available": False, "reason": "cache_invalid"}, None
    if not isinstance(payload, dict):
        return {"available": False, "reason": "cache_invalid"}, None
    buckets = quota_buckets(payload)
    if not buckets:
        return {"available": False, "reason": "cache_has_no_usage"}, None

    observed_at = format_timestamp(stat.st_mtime)
    now_epoch = time.time() if now_epoch is None else now_epoch
    age = max(0, int(now_epoch - stat.st_mtime))
    status = {
        "available": True,
        "observed_at": observed_at,
        "age_seconds": age,
        "stale": age >= QUOTA_CACHE_TTL_SECONDS,
        "snapshot_added": False,
        "buckets": buckets,
    }
    return status, {"observed_at": observed_at, "buckets": buckets}


def parse_quota_history(raw, coverage):
    """Decode history bytes tolerantly; returns (usable (epoch, row) pairs, instants seen).

    Undecodable bytes are replaced for parsing only, so a damaged file is read rather
    than rewritten. Only a usable row proves an observation was already recorded, so
    `seen` is filled after validation, and it holds instants rather than the text they
    were written as: the same instant can be stored under any offset or precision.
    """
    rows = []
    seen = set()
    for line in raw.decode("utf-8", "replace").splitlines():
        try:
            record = json.loads(line)
        except (json.JSONDecodeError, TypeError):
            coverage["malformed_rows"] += 1
            continue
        if not isinstance(record, dict):
            coverage["malformed_rows"] += 1
            continue
        epoch = parse_timestamp(record.get("observed_at"))
        if epoch is None or not isinstance(record.get("buckets"), list):
            coverage["malformed_rows"] += 1
            continue
        seen.add(epoch)
        rows.append((epoch, record))
    return rows, seen


def load_quota_history(history_path, record=None, cutoff_epoch=0):
    """Read the history once, appending `record` under the same lock when it is new.

    Returns (history section, write outcome).
    """
    history_path = Path(history_path)
    coverage = {
        "available": False,
        "earliest_retained_at": None,
        "latest_retained_at": None,
        "samples_in_period": 0,
        "malformed_rows": 0,
    }
    rows = []
    write = "skipped"
    try:
        if record is None:
            rows, _ = parse_quota_history(history_path.read_bytes(), coverage)
        else:
            history_path.parent.mkdir(parents=True, exist_ok=True)
            with history_path.open("a+b") as fh:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
                try:
                    fh.seek(0)
                    raw = fh.read()
                    rows, seen = parse_quota_history(raw, coverage)
                    observed_epoch = parse_timestamp(record["observed_at"])
                    if observed_epoch in seen:
                        write = "duplicate"
                    else:
                        fh.seek(0, os.SEEK_END)
                        if raw and not raw.endswith(b"\n"):
                            fh.write(b"\n")
                        fh.write(json.dumps(record, separators=(",", ":")).encode() + b"\n")
                        fh.flush()
                        rows.append((observed_epoch, record))
                        write = "added"
                finally:
                    fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
    except OSError:
        # A failed append must not also hide a history the reader can still read.
        coverage = dict(coverage, malformed_rows=0)
        try:
            rows, _ = parse_quota_history(history_path.read_bytes(), coverage)
        except OSError:
            return {"samples": [], "coverage": coverage}, "failed"
        write = "failed"

    # Filter to the period first, then order by instant: timestamp text sorts wrongly
    # across mixed offsets and mixed sub-second precision.
    in_period = [pair for pair in rows if not cutoff_epoch or pair[0] >= cutoff_epoch]
    in_period.sort(key=lambda pair: pair[0])
    samples = [row for _, row in in_period]
    if rows:
        coverage["earliest_retained_at"] = min(rows, key=lambda item: item[0])[1]["observed_at"]
        coverage["latest_retained_at"] = max(rows, key=lambda item: item[0])[1]["observed_at"]
    coverage["samples_in_period"] = len(samples)
    coverage["available"] = history_path.is_file()
    return {"samples": samples, "coverage": coverage}, write


def quota_report(cache_path, history_path, cutoff_epoch=0, now_epoch=None):
    """Snapshot the quota cache and load its history in one locked pass."""
    current, record = read_quota_cache(cache_path, now_epoch=now_epoch)
    history, write = load_quota_history(
        history_path, record=record, cutoff_epoch=cutoff_epoch
    )
    if record is not None:
        current["snapshot_added"] = write == "added"
        if write == "failed":
            current["history_write"] = "failed"
    return {"current": current, "history": history}


