#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# ///
"""Detect and clear a stale Codex credential cooldown in the model-router upstream.

CLIProxyAPI reads `resets_at` out of an upstream 429 and locks the credential
until then -- up to several days -- without ever re-probing. When the real quota
window rolls early, every Codex route keeps returning 429 from a local cooldown
table while the subscription is in fact fine. The router still reports healthy,
so nothing else notices. Observed 2026-09-09 to 2026-09-11: a 96h lockout held
while the ChatGPT plan showed full quota.

The cooldown lives in the upstream child process only, so bouncing the service
clears it. One probe cannot say whether bouncing it is warranted: a local
refusal is answered from the router's own table, so it reports nothing about
upstream beyond quoting the error that first caused the entry. The decision is
therefore three steps, each biased towards doing nothing:

  age      a local refusal younger than MIN_COOLDOWN_AGE_SECONDS on *our* clock
           is ordinary backoff and is left alone. Upstream caps the backoff it
           computes itself at 30 minutes (quotaBackoffMax), so a refusal still
           holding after that is not ordinary. The age is measured here across
           separate runs, because the router's own `remaining=`/`resets_at`
           figures are the values this tool exists to distrust; they set no
           policy and only appear in the JSON as reported detail.
  restart  only an aged local refusal earns a bounce, and the probe is then
           repeated, which is what actually settles it: 200 means it was stale.
  hold     a genuine usage_limit_reached, or a restart that did not clear the
           refusal, records CONFIRMED_HOLD_SECONDS of not trying again. That
           hold is on our clock too, deliberately -- an unbounded one built
           from the upstream deadline recreates the multi-day blackout this
           tool exists to end.

  model-router-cooldown-check            # probe and report; never restarts
  model-router-cooldown-check --fix      # restart once the cooldown has aged
  model-router-cooldown-check --json     # machine-readable result

Exit codes: 0 routes are usable, 1 a local cooldown is holding them and was not
cleared, 2 quota genuinely exhausted upstream, 3 could not determine.
"""

import argparse
import datetime
import json
import os
import platform
import re
import subprocess
import sys
import time
import tomllib
import urllib.error
import urllib.request
from pathlib import Path

LABEL = "com.alignment-hive.model-router"
UNIT = "model-router.service"
PORT = 8787
HEALTH_PATH = "/__model-router/health"
# How long a local refusal must persist, measured across separate runs of this
# check, before a restart is on the table. Upstream caps its own computed
# backoff at 30 minutes, so a refusal that outlives that is not ordinary
# backoff. A cooldown seen for the first time is never acted on.
MIN_COOLDOWN_AGE_SECONDS = 30 * 60
# After learning that a restart is not the answer -- upstream confirmed the
# quota spent, or a bounce failed to clear the refusal -- wait this long before
# trying again. Bounded on purpose and short relative to the multi-day
# deadlines upstream advertises; the cost of each retry is that a restart drops
# every in-flight request the router is carrying, Anthropic routes included.
CONFIRMED_HOLD_SECONDS = 6 * 3600
# Never bounce the service more often than this, whatever the probe says.
RESTART_COOLDOWN_SECONDS = 10 * 60
RESTART_WAIT_SECONDS = 20.0

OK, STALE, EXHAUSTED, UNKNOWN = 0, 1, 2, 3


class CheckError(Exception):
    """A diagnostic safe to print: never carries a token, URL or response body."""


def state_dir() -> Path:
    return Path.home() / ".local/state/model-router"


def load_endpoint() -> tuple[str, str]:
    """Return (base_url, token) for the locally owned router, or raise."""
    token_path = state_dir() / "ingress-token"
    try:
        token = token_path.read_text().strip()
    except OSError as exc:
        raise CheckError("no ingress token; is model-router installed?") from exc
    if not token:
        raise CheckError("ingress token is empty.")
    return "http://127.0.0.1:%d/t/%s" % (PORT, token), token


def codex_routes() -> list[str]:
    """Routing ids served by the Codex provider, most specific first.

    The generated config puts Codex routes in top-level [[models]]; the
    openai-providers block is OpenRouter and is unaffected by this failure.
    """
    config = Path(
        os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
    ) / "model-router/config.toml"
    try:
        with config.open("rb") as handle:
            data = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise CheckError("could not read the router config.") from exc
    routes = [m["routing-id"] for m in data.get("models", []) if m.get("routing-id")]
    if not routes:
        raise CheckError("no Codex routes configured; nothing to check.")
    return routes


def probe(base_url: str, token: str, model: str, timeout: float) -> dict:
    """One minimal generation. Returns {status, elapsed_ms, kind}."""
    body = json.dumps({
        "model": model,
        "max_tokens": 1,
        "messages": [{"role": "user", "content": "."}],
    }).encode()
    request = urllib.request.Request(
        base_url + "/v1/messages",
        data=body,
        headers={
            "x-api-key": token,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        },
    )
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    started = time.monotonic()
    try:
        with opener.open(request, timeout=timeout) as response:
            response.read(4096)
            status, payload = response.status, ""
    except urllib.error.HTTPError as error:
        status = error.code
        try:
            payload = error.read(4096).decode("utf-8", errors="replace")
        except OSError:
            payload = ""
    except (OSError, urllib.error.URLError) as exc:
        raise CheckError("the router did not answer; is the service running?") from exc
    elapsed_ms = (time.monotonic() - started) * 1000

    return {
        "status": status,
        "elapsed_ms": round(elapsed_ms, 1),
        "kind": classify(status, payload),
        "resets_at": resets_at(payload),
    }


def classify(status: int, payload: str) -> str:
    """Name the failure shape behind a probe response.

    Order matters. A local cooldown refusal quotes the upstream error that
    caused it, so its body contains "usage_limit_reached" too:

        All credentials for model X are cooling down via provider codex
        (last error: usage_limit_reached: The usage limit has been reached)

    Matching on usage_limit_reached first would read every stale cooldown as a
    genuine one and never clear it -- the exact bug this tool exists to catch.
    """
    if status == 200:
        return "ok"
    if status != 429:
        return "error"
    if re.search(r"cool(?:ing|down)", payload, re.IGNORECASE):
        # Refused from the local table; the request never left the machine.
        return "local_cooldown"
    if "usage_limit_reached" in payload:
        return "upstream_limit"
    return "rate_limited"


def resets_at(payload: str) -> int | None:
    found = re.search(r'"resets_at"\s*:\s*(\d{9,12})', payload)
    return int(found.group(1)) if found else None


def read_state() -> dict:
    try:
        return json.loads((state_dir() / "cooldown-check.json").read_text())
    except (OSError, ValueError):
        return {}


def write_state(**fields) -> None:
    path = state_dir() / "cooldown-check.json"
    data = read_state()
    data.update(fields)
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(data, indent=2, sort_keys=True))
    except OSError:
        pass  # Best effort: losing the guard must not block recovery.


def restart_blocked(now: float) -> str | None:
    """Reasons not to bounce the service, checked before touching it."""
    state = read_state()
    last = state.get("last_restart_unix")
    if isinstance(last, (int, float)) and now - last < RESTART_COOLDOWN_SECONDS:
        return "a restart %d s ago is still settling" % int(now - last)
    hold = state.get("hold_restarts_until_unix")
    if isinstance(hold, (int, float)) and now < hold:
        left = datetime.timedelta(seconds=int(hold - now))
        return "a restart was already shown not to help; %s before the next attempt" % left
    return None


def hold_restarts(now: float) -> None:
    """Stand down for a bounded window after learning a restart will not help.

    The window is ours, never the `resets_at` upstream advertised. Honouring
    that deadline is what CLIProxyAPI already does wrong: it is a worst case,
    it can name a point days away, and believing it here would prohibit every
    recovery attempt for those days -- including the one that would have found
    the quota already back. So the hold expires on a fixed local timer and the
    next run is free to try again.
    """
    write_state(hold_restarts_until_unix=now + CONFIRMED_HOLD_SECONDS,
                local_cooldown_since_unix=None)


def clear_guards() -> None:
    """Routes are serving: forget the cooldown clock and the restart hold."""
    write_state(hold_restarts_until_unix=None, local_cooldown_since_unix=None)


def forget_cooldown_clock() -> None:
    """Whatever we just saw, it was not the cooldown we were timing."""
    write_state(local_cooldown_since_unix=None)


def cooldown_age(now: float) -> float:
    """Seconds this local refusal has persisted, by our own measurement.

    First sighting records the timestamp and reports an age of zero. Any probe
    that is not a local refusal clears it, so the clock only ever accumulates
    over a run of consecutive sightings. It cannot tell one long cooldown from
    two back-to-back ones -- both mean the routes have been dead for that long,
    which is the question being asked.

    A home this cannot write to is therefore a watchdog that never restarts
    anything, because the age is never carried between runs. That is the right
    way for it to break.
    """
    since = read_state().get("local_cooldown_since_unix")
    if not isinstance(since, (int, float)) or since > now:
        write_state(local_cooldown_since_unix=now)
        return 0.0
    return now - since


def restart_service(timeout: float) -> None:
    if platform.system() == "Darwin":
        command = ["/bin/launchctl", "kickstart", "-k", "gui/%d/%s" % (os.getuid(), LABEL)]
    else:
        command = ["systemctl", "--user", "restart", UNIT]
    try:
        result = subprocess.run(command, capture_output=True, text=True,
                                timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise CheckError("could not restart the router service.") from exc
    if result.returncode:
        raise CheckError("the router service refused to restart (exit %d)." % result.returncode)
    write_state(last_restart_unix=time.time())


def wait_healthy(base_url: str, deadline: float) -> bool:
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    while time.monotonic() < deadline:
        try:
            with opener.open(base_url + HEALTH_PATH, timeout=1.0) as response:
                data = json.loads(response.read(4096))
                if response.status == 200 and data.get("status") in ("ok", "degraded"):
                    return True
        except (OSError, ValueError, urllib.error.URLError):
            pass
        time.sleep(0.25)
    return False


def run(fix: bool) -> tuple[int, dict]:
    base_url, token = load_endpoint()
    model = codex_routes()[0]
    result = {"model": model, "fixed": False}

    first = probe(base_url, token, model, timeout=90.0)
    result["probe"] = first

    now = time.time()

    if first["kind"] == "ok":
        clear_guards()
        return OK, result | {"summary": "Codex routes are serving normally."}

    if first["kind"] == "upstream_limit":
        hold_restarts(now)
        return EXHAUSTED, result | {
            "summary": "Quota is genuinely exhausted upstream; the cooldown is correct."
        }

    if first["kind"] != "local_cooldown":
        # A plain 429 or a 5xx is not the refusal being timed, so the clock
        # starts again from the next sighting. A router flapping between errors
        # and cooldowns must not accumulate its way into a restart.
        forget_cooldown_clock()
        return UNKNOWN, result | {
            "summary": "Unexpected response (HTTP %s); not touching the service." % first["status"]
        }

    age = cooldown_age(now)
    result["cooldown_age_s"] = round(age)
    result["summary"] = (
        "A local cooldown is holding every Codex route, first seen %s ago; "
        "the request never reached upstream."
        % datetime.timedelta(seconds=int(age))
    )
    if age < MIN_COOLDOWN_AGE_SECONDS:
        return STALE, result | {
            "summary": result["summary"]
            + " Too new to be anything but ordinary backoff; watching, not restarting."
        }
    if not fix:
        return STALE, result | {"summary": result["summary"] + " Re-run with --fix to clear it."}

    blocked = restart_blocked(now)
    if blocked:
        return STALE, result | {"summary": result["summary"] + " Not restarting: " + blocked + "."}

    # One invariant from here: either the routes end up serving, or a hold is
    # recorded. Every way of leaving this block without a working router is a
    # bounce that did not achieve its goal, and repeating those hourly is the
    # thrash the hold exists to stop.
    restart_service(timeout=15.0)
    if not wait_healthy(base_url, time.monotonic() + RESTART_WAIT_SECONDS):
        hold_restarts(now)
        return UNKNOWN, result | {"summary": "Restarted, but the router did not come back healthy."}

    second = probe(base_url, token, model, timeout=90.0)
    result["probe_after_restart"] = second
    if second["kind"] == "ok":
        clear_guards()
        return OK, result | {"fixed": True, "summary": "Stale cooldown cleared; Codex routes serve again."}
    if second["kind"] == "upstream_limit":
        hold_restarts(now)
        return EXHAUSTED, result | {
            "summary": "Cooldown was real: upstream still reports the quota spent."
        }
    # Defensive rather than observed: a fresh child has an empty cooldown table,
    # so this needs the refusal to be persisted or immediately rebuilt.
    hold_restarts(now)
    return UNKNOWN, result | {
        "summary": "Still refusing after a restart (HTTP %s); inspect the router logs." % second["status"]
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Detect, and optionally clear, a stale Codex cooldown in model-router.")
    parser.add_argument("--fix", action="store_true",
                        help="restart the router once a local cooldown has persisted")
    parser.add_argument("--json", action="store_true", help="print the result as JSON")
    args = parser.parse_args()

    try:
        code, result = run(fix=args.fix)
    except CheckError as error:
        if args.json:
            print(json.dumps({"summary": str(error), "error": True}, indent=2))
        else:
            print("model-router cooldown check: %s" % error, file=sys.stderr)
        return UNKNOWN

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(result["summary"])
    return code


if __name__ == "__main__":
    sys.exit(main())
