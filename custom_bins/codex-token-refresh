#!/usr/bin/env python3
"""Keep the Codex CLI OAuth token alive so the statusline can read quota.

The statusline asks `codex app-server` for `account/rateLimits/read`. That call
does NOT refresh an expired token -- it just returns 401 `token_expired` -- but
any real Codex request does refresh it. So once the token lapses, the usage
fetch can never recover on its own: it fails every attempt until something else
happens to run Codex. Measured 2026-09-12: ~/.codex/auth.json had not refreshed
since 2026-09-06, every statusline fetch had been 401ing for two days, and the
line showed a stale 100%-used week whose reset had already passed. One
`codex exec` fixed it, and quota read 4% against a window resetting five days
out.

Note the CLI's credential is NOT the one model-router uses. The router keeps its
own copy of the same account under ~/.local/state/model-router/codex-auth/ and
refreshes that independently, so working GPT routes say nothing about whether
the statusline can read quota. They were in exactly that split state.

A refresh costs one minimal request, so this only spends when the token is
actually aging: the observed lifetime is about four days, and the default
12-hour threshold leaves a wide margin without paying daily for nothing.

  codex-token-refresh              # refresh only if older than the threshold
  codex-token-refresh --force      # refresh regardless
  codex-token-refresh --max-age-hours 6
"""

import argparse
import datetime
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

DEFAULT_MAX_AGE_HOURS = 12
REFRESH_TIMEOUT_SECONDS = 120
# Two clocks disagreeing by seconds is ordinary skew between whatever wrote the
# stamp and whatever reads it. A stamp further ahead than this is a corrupt or
# hand-edited file, and its age is then unknown -- see main() for why unknown
# has to mean stale.
FUTURE_SKEW_TOLERANCE_HOURS = 5 / 60
# Small enough to be nearly all fixed overhead; the point is the token, not the
# answer. --skip-git-repo-check because this runs from wherever systemd starts it.
PROMPT = "Reply with exactly: OK"

OK, FAILED, UNAVAILABLE = 0, 1, 2


def codex_home() -> Path:
    value = os.environ.get("CODEX_HOME")
    return Path(value) if value else Path.home() / ".codex"


def last_refresh(home: Path) -> datetime.datetime | None:
    try:
        raw = json.loads((home / "auth.json").read_text()).get("last_refresh")
    except (OSError, ValueError):
        return None
    if not isinstance(raw, str):
        return None
    # Rust writes nanosecond precision; datetime accepts at most microseconds.
    # This normalisation is what holds the runtime floor at Python 3.10 -- the
    # floor the PEP 604 annotations in this file already set. Measured: 3.10
    # rejects both the Z suffix and a 9-digit fraction, so without this the real
    # CLI stamp parses to None there and the tool spends a request every day and
    # reports failure every day; 3.11 accepts both and this is a no-op.
    text = raw.replace("Z", "+00:00")
    if "." in text:
        head, _, tail = text.partition(".")
        # Cut the offset off before reading the fraction. Collecting every digit
        # in the whole tail turns ".12+05:30" into 120530 microseconds.
        cut = max(tail.find("+"), tail.find("-"))
        fraction, offset = (tail[:cut], tail[cut:]) if cut >= 0 else (tail, "+00:00")
        digits = "".join(c for c in fraction if c.isdigit())[:6]
        text = "%s.%s%s" % (head, digits.ljust(6, "0"), offset)
    try:
        parsed = datetime.datetime.fromisoformat(text)
    except ValueError:
        return None
    # A stamp carrying no offset parses fine and then detonates in age_hours(),
    # which subtracts it from an aware now(). Assume UTC rather than returning
    # None: the fractional branch above already does exactly that, upstream only
    # ever writes UTC, and None here would spend a request and fail the unit
    # every day on a token that is in fact still valid.
    if parsed.tzinfo is None:
        return parsed.replace(tzinfo=datetime.timezone.utc)
    return parsed


def age_hours(stamp: datetime.datetime,
              now: datetime.datetime | None = None) -> float:
    """Signed: negative means the stamp is ahead of the clock."""
    now = now or datetime.datetime.now(datetime.timezone.utc)
    return (now - stamp).total_seconds() / 3600


def stamp_is_ahead(stamp: datetime.datetime,
                   now: datetime.datetime | None = None) -> bool:
    """Further ahead of the clock than skew explains."""
    return age_hours(stamp, now) < -FUTURE_SKEW_TOLERANCE_HOURS


def refresh(executable: str, home: Path) -> bool:
    """One minimal request. Its output is irrelevant; the token write is the point."""
    try:
        subprocess.run(
            [executable, "exec", "--skip-git-repo-check", PROMPT],
            capture_output=True, text=True, timeout=REFRESH_TIMEOUT_SECONDS,
            env={**os.environ, "CODEX_HOME": str(home)}, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return True


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Refresh the Codex CLI OAuth token so quota stays readable.")
    parser.add_argument("--max-age-hours", type=float, default=DEFAULT_MAX_AGE_HOURS,
                        help="refresh only if the token is older than this (default 12)")
    parser.add_argument("--force", action="store_true", help="refresh regardless of age")
    parser.add_argument("--json", action="store_true", help="print the result as JSON")
    args = parser.parse_args()

    home = codex_home()
    executable = shutil.which("codex")
    result: dict[str, object] = {"refreshed": False}

    if not (home / "auth.json").is_file():
        result["summary"] = "Codex CLI is not logged in; there is no token to keep fresh."
        code = UNAVAILABLE
    elif executable is None:
        # Not the same state as "no credential". A token exists and is ageing,
        # and nothing here can refresh it -- the statusline will go stale. The
        # unit counts exit 2 as success, so reporting it that way would be a
        # watchdog that stays green while the thing it guards decays.
        result["summary"] = "Codex CLI is not on PATH; the existing token cannot be refreshed."
        code = FAILED
    else:
        before = last_refresh(home)
        # A stamp ahead of the clock cannot be aged: now - stamp goes negative,
        # a negative age is below every threshold, and arithmetic alone would
        # therefore read a corrupt file as a token refreshed moments ago --
        # green unit, no request spent, statusline stale for as long as the
        # stamp says. Past the skew tolerance the age is unknown, and the safe
        # reading of "I cannot tell how old this token is" is stale, not fresh.
        # So: refresh, then judge the stamp that comes back. The likely cause is
        # a clock that ran ahead when Codex wrote the file, which that refresh
        # corrects by itself; a stamp still ahead afterwards is a real fault and
        # exits 1 rather than pretending.
        ahead = before is not None and stamp_is_ahead(before)
        result["age_hours_before"] = round(age_hours(before), 2) if before else None
        result["stamp_ahead_of_clock"] = ahead
        if before is not None and not ahead and not args.force and age_hours(before) < args.max_age_hours:
            # Clamped for display only: within the skew tolerance the age can be
            # a hair negative, and "refreshed -0.0 h ago" reads like a bug.
            result["summary"] = ("Token refreshed %.1f h ago; leaving it."
                                 % max(0.0, age_hours(before)))
            code = OK
        elif not refresh(executable, home):
            result["summary"] = "Refresh request failed; token left as it was."
            code = FAILED
        else:
            after = last_refresh(home)
            after_ahead = after is not None and stamp_is_ahead(after)
            # Codex writes its own now, so any change to the stamp is a write.
            # `after > before` would miss the correcting write that pulls a
            # future stamp back to the present -- the repair, read as a no-op.
            moved = (after is not None and not after_ahead
                     and (before is None or after != before))
            result["refreshed"] = moved
            result["age_hours_after"] = round(age_hours(after), 2) if after else None
            result["stamp_ahead_of_clock"] = after_ahead
            # Codex only rewrites auth.json when it actually refreshes, so under
            # --force on a still-valid token the stamp legitimately does not
            # move. What matters is the outcome, not the write: the token is
            # young enough to keep serving. Only an old stamp that stayed old
            # means the refresh we needed did not happen.
            young = (after is not None and not after_ahead
                     and age_hours(after) < args.max_age_hours)
            if after_ahead:
                result["summary"] = (
                    "last_refresh is %.1f h ahead of the clock, so the token's age "
                    "cannot be read; the file is corrupt or the clock was wrong when "
                    "it was written, and the refresh did not correct it."
                    % -age_hours(after))
            elif moved:
                result["summary"] = "Token refreshed."
            elif young:
                result["summary"] = "Token was still valid; no refresh was needed."
            else:
                result["summary"] = "Request completed but the token did not refresh."
            code = OK if (moved or young) else FAILED

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(result["summary"])
    return code


if __name__ == "__main__":
    sys.exit(main())
