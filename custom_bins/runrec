#!/usr/bin/env python3
"""runrec - record, cap and board research runs.

Every launch gets a run directory, a launch record and an index line before it
spends anything; a Modal or RunPod launch with no cost cap, burn rate or idle
limit is refused; and one Markdown board per project shows what runs where,
progress, ETA and cost so far. Spec: artifacts/research-run-records/spec.md.

  runrec launch --slug pilot --backend local --api-cap 0 -- python -m pkg.run
  runrec launch --slug capture --backend modal --cost-cap 20 --rate 4 \\
      --max-idle 15m --api-cap 0 -- modal run modal_apps/capture.py
  runrec board [--write]        Markdown board for this repo's out/
  runrec ls                     running and recent runs, one line each

Files, under <out-root> (default <git toplevel>/out):
  runs.jsonl                    the index: one launch and one finish event per run
  <date>_<slug>/launch.json     live record, rewritten every heartbeat
  <date>_<slug>/manifest.json   gets a `launch` key merged in at finish
  <date>_<slug>/launch.log      the command's stdout and stderr
  runrec.json                   optional: {"project": "...", "board": "path.md"}

Exit codes: the command's own code when it ends by itself; 2 refused before
launch; 124 stopped by runrec (cost, idle, timeout, api) or interrupted.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
