def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        description=__doc__.splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Checklist state is keyed by a slug of the item's own label, so\n"
        "reordering or inserting items keeps every tick, while rewording an item\n"
        "resets that one item to its source default.\n\n"
        "Review features: a ```diff fence renders as a numbered unified diff, one\n"
        "folding block per file. Each H2 section folds, and carries a seen mark\n"
        "(New / Changed / seen) keyed by a hash of its content. A heading ending in\n"
        "{judgement} gets a 'Your call' badge; an H3 or lower ending in {lower}\n"
        "moves into a folded 'Lower priority' tray at the end of its H2 section.\n"
        "Seen marks use the reader's own db document when the page is published\n"
        "with the --capabilities JSON, else localStorage; the 'Comment on this\n"
        "page' button appears only with the comments capability.",
    )
    ap.add_argument("source", type=Path, nargs="?", help="Markdown file to wrap")
    ap.add_argument(
        "--capabilities",
        action="store_true",
        help="print the capabilities JSON to pass when publishing the page "
        "(db + user for seen marks, comments composer for the page comment "
        "button) and exit",
    )
    ap.add_argument("-o", "--output", type=Path, help="output HTML (default: <source>.review.html)")
    ap.add_argument("--title", help="page title (default: first H1, else the filename stem)")
    ap.add_argument("--no-toc", action="store_true", help="omit the table of contents")
    ap.add_argument(
        "--states",
        metavar="A,B,C",
        help="comma-separated state set for task-list items, cycled on click "
        "(e.g. approve,approve-pending-edits,deny). Default: a plain checkbox. "
        "`- [ ]` starts at the first state, `- [x]` at the last",
    )
    ap.add_argument(
        "--key",
        help="localStorage key for comments (default: derived from the filename, "
        "qualified by the parent directory for a generic stem like spec.md, so "
        "republishing the same document keeps its comments and two specs never share them)",
    )
    args = ap.parse_args(argv)

    if args.capabilities:
        print(json.dumps(CAPABILITIES, separators=(",", ":")))
        return 0
    if args.source is None:
        ap.error("the source Markdown file is required")
    if not args.source.is_file():
        ap.error(f"no such file: {args.source}")

    states: list[str] | None = None
    if args.states is not None:
        states = [p.strip() for p in args.states.split(",") if p.strip()]
        if len(states) < 2:
            ap.error("--states needs at least two comma-separated states")
        if len(set(states)) != len(states):
            ap.error("--states must not repeat a state")
        bad = [st for st in states if BAD_STATE_CHARS.search(st)]
        if bad:
            ap.error(
                "--states must not contain '[', ']' or a control character "
                f"({', '.join(repr(st) for st in bad)}): the export writes each "
                "state inside the brackets of a Markdown task line, and those "
                "characters stop that line parsing back"
            )
    text = args.source.read_text(encoding="utf-8")

    title = args.title
