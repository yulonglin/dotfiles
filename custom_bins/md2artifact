#!/usr/bin/env python3
"""md2artifact - wrap a Markdown document in a reviewable HTML artifact.

Renders Markdown to a self-contained page carrying the review affordances that
the `artifact-writing` skill requires: a sticky table of contents built
from the headings, select-to-comment annotation, per-comment edit and delete,
an unexported-comments guard on tab close, and clipboard export. There is no
file export: a page-initiated download is inert in the Artifact viewer.

Markdown artifacts cannot carry JavaScript, so a spec or report published as
raw `.md` silently loses all of that. Run it through here first.

    md2artifact spec.md                  # -> spec.review.html
    md2artifact spec.md -o /tmp/out.html
    md2artifact spec.md --title "P1 spec" --no-toc

The output is a fragment (no <html>/<head>/<body>), which is what the Artifact
tool expects; it is also viewable directly in a browser.
"""

from __future__ import annotations

import argparse
import html
import re
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

try:
    from markdown_it import MarkdownIt
    from markdown_it.token import Token
except ImportError:  # pragma: no cover - depends on the host environment
    sys.exit("md2artifact needs markdown-it-py (uv pip install markdown-it-py)")

# The annotation layer (select-to-comment, export, unload guard) is shared with
# `annotate-html` so there is exactly one copy of it.
sys.path.insert(0, str(Path(__file__).resolve().parent))
import _annotation_layer  # noqa: E402

SLUG_RE = re.compile(r"[^a-z0-9]+")

# A localStorage key is shared by every page that derives the same one, and all
# artifacts are read from one origin — so two pages with the same key show each
# other's comments. `artifacts/<slug>/spec.md` is now the standard layout, which
# would give EVERY spec the key "review-spec". These stems are therefore
# qualified by their parent directory, which is the artifact slug and unique.
# A SPECIFIC stem keeps its old key. A generic-stem page published before this
# rule (2026-09-02) would derive a new key on rebuild and stop seeing its stored
# comments: rebuild it with --key review-<stem> to keep them, accepting that it
# goes on sharing that key. There is deliberately no automatic migration from
# the legacy shared key -- reading review-spec into a page is exactly the
# cross-document leak this exists to stop.
GENERIC_STEMS = frozenset(
    {"spec", "plan", "report", "page", "index", "readme", "draft", "notes", "artifact"}
)


def storage_key(source: Path) -> str:
    """The localStorage key for a document, unique per artifact directory."""
    stem = source.stem
    if stem.lower() in GENERIC_STEMS:
        parent = source.resolve().parent.name
        if parent and parent not in {"artifacts", "/"}:
            return f"review-{slugify(parent)}-{slugify(stem)}"
    return f"review-{slugify(stem)}"


MERMAID_OPEN = '<pre class="mermaid">'
MERMAID_CLOSE = "</pre>"


def slugify(text: str) -> str:
    return SLUG_RE.sub("-", text.strip().lower()).strip("-") or "section"


def _mermaid_token(source: str) -> Token:
    """A raw-HTML token carrying one mermaid diagram.

    The parser runs with html disabled so that raw HTML in a reviewed document
    cannot inject script into the published page. Mermaid diagrams are the one
    deliberate exception: the Artifact viewer renders <pre class="mermaid">
    natively. So rather than enabling raw HTML globally, only mermaid blocks
    are rebuilt as real elements — and only ever as the TEXT CONTENT of a
    <pre class="mermaid">, never arbitrary markup.

    The diagram source is entity-escaped to hold that promise. It used to be
    interpolated raw, on the belief that escaping breaks mermaid because labels
    legitimately carry quotes and <br/>. That belief is wrong: mermaid reads the
    element's textContent, and the HTML parser decodes &lt;br/&gt; back to
    <br/> before mermaid ever sees it, so escaping is transparent to the
    diagram. Interpolating raw was not: a `</pre>` anywhere in the fence closed
    the element early and everything after it became live markup — verified
    executing in Chrome from a plain ```mermaid fence. Any Markdown you did not
    write yourself (a pasted transcript, a model's output, someone else's
    report) could inject script into your published page.
    """
    return Token(
        "html_block",
        "",
        0,
        content=(
            f"{MERMAID_OPEN}\n"
            f"{html.escape(source.strip(), quote=False)}\n"
            f"{MERMAID_CLOSE}\n"
        ),
        block=True,
    )


def mermaid_passthrough(tokens: list[Token]) -> list[Token]:
    """Rewrite both mermaid spellings into real <pre class="mermaid"> blocks.

    Handles a ```mermaid fence, and a raw <pre class="mermaid">...</pre> block
    (which, with html off, parses as one or more plain paragraphs). A mermaid
    example nested inside an ordinary code fence stays escaped, as it should.
    """
    out: list[Token] = []
    i = 0
    while i < len(tokens):
        tok = tokens[i]
        if tok.type == "fence" and tok.info.strip().split() == ["mermaid"]:
            out.append(_mermaid_token(tok.content))
            i += 1
            continue
        if (
            tok.type == "paragraph_open"
            and i + 1 < len(tokens)
            and tokens[i + 1].type == "inline"
            and tokens[i + 1].content.startswith(MERMAID_OPEN)
        ):
            # A blank line inside the diagram splits it across paragraphs, so
            # collect consecutive paragraph triples until one ends </pre>.
            parts: list[str] = []
            j = i
            closed = False
            while (
                not closed
                and j + 2 < len(tokens)
                and tokens[j].type == "paragraph_open"
                and tokens[j + 1].type == "inline"
                and tokens[j + 2].type == "paragraph_close"
            ):
                parts.append(tokens[j + 1].content)
                closed = tokens[j + 1].content.rstrip().endswith(MERMAID_CLOSE)
                j += 3
            if closed:
                source = "\n\n".join(parts).strip()
                source = source[len(MERMAID_OPEN) : -len(MERMAID_CLOSE)]
                out.append(_mermaid_token(source))
                i = j
                continue
        out.append(tok)
        i += 1
    return out


DETAILS_OPEN_RE = re.compile(
    r"^<details( open)?>(?:\s*<summary>(.*?)</summary>)?$", re.DOTALL
)
DETAILS_SUMMARY_RE = re.compile(r"^<summary>(.*?)</summary>$", re.DOTALL)
DETAILS_CLOSE_RE = re.compile(r"^</details>$")


def _details_html_token(content: str) -> Token:
    return Token("html_block", "", 0, content=content + "\n", block=True)


def details_passthrough(tokens: list[Token]) -> list[Token]:
    """Rebuild <details>/<summary> lines as real collapsible elements.

    The second deliberate exception to html-off, alongside mermaid: a reviewed
    document legitimately wants collapsible sections (full transcripts beside
    excerpts, long inventories). Only four exact standalone-paragraph shapes
    pass through — `<details>`, `<details open>` (either optionally carrying a
    same-line <summary>), a standalone `<summary>…</summary>`, and
    `</details>` — and summary text is entity-escaped, so no arbitrary markup
    or attributes ever reach the page. If the document's details tags don't
    balance, nothing passes through: an unclosed <details> would otherwise
    swallow every element after it, so the safe fallback is today's behavior
    (escaped, visible tags).

    The balance counter is FLAT — it counts tags, not block nesting — so a
    <details> opened inside a blockquote and closed outside it counts as
    balanced and passes through, emitting tags that straddle the blockquote.
    Browsers recover (</details> is in the HTML spec's implied-end-tag branch),
    so the "cannot swallow the page" guarantee holds; what the reader gets is a
    cosmetic mess — an empty collapsible and a section that never collapsed.
    Worth knowing before trusting the fallback to catch every malformed input.
    """

    def classify(i: int) -> tuple[str, str] | None:
        if not (
            i + 2 < len(tokens)
            and tokens[i].type == "paragraph_open"
            and tokens[i + 1].type == "inline"
            and tokens[i + 2].type == "paragraph_close"
        ):
            return None
        text = tokens[i + 1].content.strip()
        if m := DETAILS_OPEN_RE.match(text):
            open_tag = "<details open>" if m.group(1) else "<details>"
            if m.group(2) is not None:
                return ("open", open_tag + "<summary>" + html.escape(m.group(2)) + "</summary>")
            return ("open", open_tag)
        if m := DETAILS_SUMMARY_RE.match(text):
            return ("summary", "<summary>" + html.escape(m.group(1)) + "</summary>")
        if DETAILS_CLOSE_RE.match(text):
            return ("close", "</details>")
        return None

    # Balance check first: refuse the whole passthrough on any imbalance.
    depth = 0
    for i in range(len(tokens)):
        kind = classify(i)
        if kind is None:
            continue
        if kind[0] == "open":
            depth += 1
        elif kind[0] == "close":
            depth -= 1
            if depth < 0:
                return tokens
    if depth != 0:
        return tokens

    out: list[Token] = []
    i = 0
    in_details = 0
    while i < len(tokens):
        kind = classify(i)
        if kind is not None and (kind[0] != "summary" or in_details):
            out.append(_details_html_token(kind[1]))
            if kind[0] == "open":
                in_details += 1
            elif kind[0] == "close":
                in_details -= 1
            i += 3
            continue
        out.append(tokens[i])
        i += 1
    return out


# The chart vocabulary, lower-cased because the check case-folds (the HTML
# parser does too, restoring `clipPath` from `clippath` via its own adjustment
# table). This is an ALLOWLIST: anything not named here is refused, including
# names nobody has thought of yet. Extend it by adding a name — that is the
# supported way to draw something this list cannot express.
#
# Deliberately absent, each for a reason: <foreignObject>, <script>, <iframe>,
# <object> and <embed> execute or embed; <image> and <feImage> fetch a resource;
# <animate>, <animateTransform>, <animateMotion> and <set> can rewrite an
# attribute — including href — AFTER this check has read it, which is the whole
# hole an allowlist exists to close; <switch> exists to select a <foreignObject>
# branch; <metadata> holds arbitrary foreign-namespace XML, so allowing it would
# mean allowing its unbounded subtree. Tool-generated SVG often carries
# <metadata> and must have it stripped before it goes in a fence.
SVG_ALLOWED_ELEMENTS = frozenset(
    {
        "svg", "g", "defs", "symbol", "use", "a", "style",
        "title", "desc",
        "path", "rect", "circle", "ellipse", "line", "polyline", "polygon",
        "text", "tspan", "textpath",
        "marker", "clippath", "mask", "pattern",
        "lineargradient", "radialgradient", "stop",
        "filter", "fegaussianblur", "feoffset", "feblend", "fecolormatrix",
        "fecomposite", "feflood", "femerge", "femergenode", "fedropshadow",
        "femorphology",
    }
)


def _local(name: str) -> str:
    """The lowercased local part of an element or attribute name.

    ElementTree reports a namespaced name as `{uri}local`, and the browser
    that finally parses the page is an HTML parser, which case-folds names
    inside <svg> — so <SCRIPT> and ONCLICK have to be recognised too.
    """
    return name.rpartition("}")[2].lower()


def css_fault(text: str) -> str | None:
    """Why this CSS may not be inlined, or None if it may.

    Guards a fetch, not the `url()` syntax: `url(#lg)` is how a chart reaches
    its OWN gradient, clip path, mask, marker or filter, and a fragment cannot
    fetch anything, so it is allowed and every other `url(` is refused. The
    delimiter is matched with optional whitespace and an optional quote, so
    `url( '#lg' )` reads the same as `url(#lg)`. `@import` fetches by
    definition and is refused outright.

    Applied to the <style> element AND to every attribute value, because
    `style="fill:url(https://…)"` and `fill="url(https://…)"` fetch exactly as
    a <style> block does — an asymmetry between the two would be a gap that
    survives review by looking as if it were already covered.
    """
    flat = re.sub(r"\s+", "", text).lower()
    if "@import" in flat:
        return "uses @import"
    for m in re.finditer(r"url\(", flat):
        if not re.match(r"url\(['\"]?#", flat[m.start() :]):
            return "has a url() that is not a same-document #reference"
    return None


def svg_rejection(source: str) -> str | None:
    """Why this ```svg fence may not be inlined, or None if it may.

    Elements are checked against an ALLOWLIST (SVG_ALLOWED_ELEMENTS) over a
    *parsed* tree, not a regex over text: anything that does not parse as one
    well-formed <svg> element is refused outright, so there is no half-parsed
    input for the checks below to disagree with the browser about. A denylist
    here would be a bet that every dangerous element name has been enumerated,
    and that bet has already lost once — the page is finally read by an HTML
    parser, where <p>, <img> and <div> break OUT of SVG foreign content and are
    parsed as HTML, bringing HTML's own resource-loading attributes with them.
    An allowlist refuses them by construction, along with every name nobody has
    thought of yet, and the cost is small because a chart's vocabulary is small.

    Attributes are NOT allowlisted, on purpose. Presentation attributes are
    open-ended — every CSS property is also an attribute, alongside transform,
    aria-*, data-* and per-element geometry — so an attribute allowlist would
    refuse legitimate charts every time someone reached for a property nobody
    had listed. The value rules below carry that half instead: no on* handler,
    no href that leaves the document, no javascript:, no non-image data:, and
    no url() that is not a same-document #reference (see css_fault, which the
    <style> element and every attribute value go through alike).
    They are enough because the element allowlist has already ensured those
    attributes sit on elements that cannot execute or fetch on their own.
    Values are compared with all whitespace removed and case folded, because
    `java\\nscript:` and `JavaScript:` both work in a browser.

    A DOCTYPE is refused before the parser sees it: ElementTree resolves no
    external entities, but it does expand internal ones, so an internal DTD
    subset is a billion-laughs denial of service against whoever builds the
    page. An element is not a document and has no business carrying one.
    """
    if re.search(r"<!\s*(doctype|entity)", source, re.IGNORECASE):
        return "it carries a DOCTYPE or entity declaration"
    try:
        root = ET.fromstring(source)
    except ET.ParseError as exc:
        return f"it does not parse as one well-formed XML element ({exc})"
    if _local(root.tag) != "svg":
        return f"its root element is <{_local(root.tag)}>, not <svg>"
    for elem in root.iter():
        name = _local(elem.tag)
        if name not in SVG_ALLOWED_ELEMENTS:
            return f"it contains a <{name}> element, which is not in the chart vocabulary"
        if name == "style" and (fault := css_fault("".join(elem.itertext()))):
            return f"its <style> element {fault}"
        for attr, value in elem.attrib.items():
            aname = _local(attr)
            flat = re.sub(r"\s+", "", value).lower()
            if aname.startswith("on"):
                return f"it carries an event-handler attribute ({aname})"
            if fault := css_fault(value):
                return f"its {aname} attribute {fault}"
            if aname == "href" and not flat.startswith("#"):
                return f"its {name} element has an {aname} that is not a same-document reference"
            if "javascript:" in flat:
                return f"its {aname} attribute carries a javascript: URL"
            if re.search(r"data:(?!image/)", flat):
                return f"its {aname} attribute carries a non-image data: URL"
    return None


def _svg_token(source: str) -> Token:
    """The fence body, byte for byte, as a real element.

    Verbatim and not re-serialised on purpose: ElementTree would normalise
    `viewBox` to lower case, drop namespace prefixes and reorder attributes,
    each of which silently breaks a chart. The tree is used to JUDGE the
    source, never to rewrite it.
    """
    return Token(
        "html_block",
        "",
        0,
        content=source if source.endswith("\n") else source + "\n",
        block=True,
    )


def _svg_note_token(reason: str) -> Token:
    return Token(
        "html_block",
        "",
        0,
        content=(
            '<p class="svg-note">This <code>svg</code> block was not inlined because '
            f"{html.escape(reason)}. Its source is shown below.</p>\n"
        ),
        block=True,
    )


def svg_passthrough(tokens: list[Token]) -> list[Token]:
    """Inline a ```svg fence whose body survives the sanitising check.

    The third deliberate exception to html-off, and the reason it exists:
    charts on an artifact page are native SVG drawn from the house tokens, so
    without this a chart page cannot go through this pipeline at all and has to
    be hand-written HTML instead.

    Accepted: one well-formed <svg> element built from SVG_ALLOWED_ELEMENTS —
    the shapes, text, gradients, filters and structure a chart is drawn from —
    and nothing else. Every other element name refuses, whether it executes
    (<script>), embeds (<foreignObject>, <iframe>), fetches (<image>), rewrites
    an attribute after this check has read it (<animate>, <set>), or is simply
    unknown. Also rejected: a DOCTYPE; any on* attribute; any href/xlink:href
    that is not a same-document `#` reference (which is also what stops a <use>
    pulling in an external document); any attribute value carrying javascript:
    or a data: that is not data:image/; and, in the <style> element or any
    attribute alike, @import or a url() that is not a same-document
    #reference — `url(#lg)` is how a chart reaches its own gradient, so it
    passes. A rejected fence falls back to today's behavior — an
    escaped code block — with a visible note saying why, so a chart never fails
    silently, and the note names the element so the fix is obvious.

    An ```svg example nested inside an ordinary code fence stays escaped: the
    outer fence swallows it, so no fence token is ever produced for it. Same as
    mermaid.
    """
    out: list[Token] = []
    for tok in tokens:
        if tok.type == "fence" and tok.info.strip().split() == ["svg"]:
            reason = svg_rejection(tok.content)
            if reason is None:
                out.append(_svg_token(tok.content))
                continue
            out.append(_svg_note_token(reason))
        out.append(tok)
    return out


# ─── Sanctioned passthroughs ──────────────────────────────────────────────────
# The parser keeps html OFF so a reviewed document can never inject markup into
# the published page. Anything the Artifact viewer renders natively (mermaid
# today) or that reviewed documents legitimately need as real elements
# (<details> collapsibles, ```svg charts) gets its own narrow passthrough here
# instead of flipping html on globally. When Anthropic ships a new viewer-native
# construct, preserve it by adding one entry to this list: a token pass that
# rebuilds ONLY that construct's exact spelling as an html_block, escapes any
# user text it carries, and leaves every other spelling escaped. Each entry
# ships with a guard test (tests/test_md2artifact_<name>.py).
#
# ```svg is the one entry that emits user text UNESCAPED, so it pays for that
# with a check instead: the body must parse as one well-formed <svg> element
# whose every element name is in SVG_ALLOWED_ELEMENTS — an allowlist, so an
# element nobody anticipated refuses by default — carrying no DOCTYPE, no on*
# attribute, no href/xlink:href that is not a same-document `#` reference, no
# javascript: or non-image data: value anywhere, and no @import or fetching
# url() in either a <style> element or an attribute value. Judged on a parsed
# tree, emitted verbatim — never
# re-serialised, or `viewBox` casing and namespace prefixes would not survive.
# Anything rejected renders as an escaped code block with a note saying why,
# which is exactly what a plain fence did before. So the property the whole
# registry exists to hold — a Markdown document you did not write cannot put
# script into your published page — is unchanged.
PASSTHROUGHS = [mermaid_passthrough, details_passthrough, svg_passthrough]


def render(md_text: str) -> tuple[str, list[tuple[int, str, str]]]:
    """Return (html, headings) where headings are (level, slug, text)."""
    md = MarkdownIt("commonmark", {"html": False, "linkify": True}).enable("table")
    tokens = md.parse(md_text)
    for passthrough in PASSTHROUGHS:
        tokens = passthrough(tokens)

    headings: list[tuple[int, str, str]] = []
    seen: dict[str, int] = {}
    for i, tok in enumerate(tokens):
        if tok.type != "heading_open":
            continue
        level = int(tok.tag[1])
        if level > 3:
            continue
        text = tokens[i + 1].content
        slug = slugify(text)
        if slug in seen:
            seen[slug] += 1
            slug = f"{slug}-{seen[slug]}"
        else:
            seen[slug] = 0
        tok.attrSet("id", slug)
        headings.append((level, slug, text))

    return md.renderer.render(tokens, md.options, {}), headings


def toc_html(headings: list[tuple[int, str, str]]) -> str:
    if not headings:
        return ""
    rows = [
        f'<a href="#{slug}" class="lvl{level}">{html.escape(text)}</a>'
        for level, slug, text in headings
        if level >= 2
    ]
    if not rows:
        return ""
    return '<nav class="toc" aria-label="Contents"><h4>Contents</h4>' + "".join(rows) + "</nav>"


def build(md_text: str, *, title: str, with_toc: bool, key: str) -> str:
    body, headings = render(md_text)
    toc = toc_html(headings) if with_toc else ""
    shell_open = '<div class="shell has-toc">' if toc else '<div class="shell">'
    page = TEMPLATE.format(
        title=html.escape(title),
        toc=toc,
        shell_open=shell_open,
        body=body,
    )
    return page + _annotation_layer.layer_html(key)


