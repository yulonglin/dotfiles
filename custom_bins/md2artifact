SLUG_RE = re.compile(r"[^a-z0-9]+")

# A localStorage key is shared by every page that derives the same one, and all
# artifacts are read from one origin — so two pages with the same key show each
# other's comments. `artifacts/<slug>/spec.md` is now the standard layout, which
# would give EVERY spec the key "review-spec". These stems are therefore
# qualified by their parent directory, which is the artifact slug and unique.
# A SPECIFIC stem keeps its old key. A generic-stem page published before this
# rule (2026-09-02) would derive a new key on rebuild and stop seeing its stored
# comments: rebuild it with --key review-<stem> to keep them, accepting that it
# goes on sharing that key. There is deliberately no automatic migration from
# the legacy shared key -- reading review-spec into a page is exactly the
# cross-document leak this exists to stop.
GENERIC_STEMS = frozenset(
    {"spec", "plan", "report", "page", "index", "readme", "draft", "notes", "artifact"}
)


def storage_key(source: Path) -> str:
    """The localStorage key for a document, unique per artifact directory."""
    stem = source.stem
    if stem.lower() in GENERIC_STEMS:
        parent = source.resolve().parent.name
        if parent and parent not in {"artifacts", "/"}:
            return f"review-{slugify(parent)}-{slugify(stem)}"
    return f"review-{slugify(stem)}"


MERMAID_OPEN = '<pre class="mermaid">'
MERMAID_CLOSE = "</pre>"


def slugify(text: str) -> str:
    return SLUG_RE.sub("-", text.strip().lower()).strip("-") or "section"


def _mermaid_token(source: str) -> Token:
    """A raw-HTML token carrying one mermaid diagram.

    The parser runs with html disabled so that raw HTML in a reviewed document
    cannot inject script into the published page. Mermaid diagrams are the one
    deliberate exception: the Artifact viewer renders <pre class="mermaid">
    natively. So rather than enabling raw HTML globally, only mermaid blocks
    are rebuilt as real elements — and only ever as the TEXT CONTENT of a
    <pre class="mermaid">, never arbitrary markup.

    The diagram source is entity-escaped to hold that promise. It used to be
    interpolated raw, on the belief that escaping breaks mermaid because labels
    legitimately carry quotes and <br/>. That belief is wrong: mermaid reads the
    element's textContent, and the HTML parser decodes &lt;br/&gt; back to
    <br/> before mermaid ever sees it, so escaping is transparent to the
    diagram. Interpolating raw was not: a `</pre>` anywhere in the fence closed
    the element early and everything after it became live markup — verified
    executing in Chrome from a plain ```mermaid fence. Any Markdown you did not
    write yourself (a pasted transcript, a model's output, someone else's
    report) could inject script into your published page.
    """
    return Token(
        "html_block",
        "",
        0,
        content=(
            f"{MERMAID_OPEN}\n"
            f"{html.escape(source.strip(), quote=False)}\n"
            f"{MERMAID_CLOSE}\n"
        ),
        block=True,
    )


def mermaid_passthrough(tokens: list[Token]) -> list[Token]:
    """Rewrite both mermaid spellings into real <pre class="mermaid"> blocks.

    Handles a ```mermaid fence, and a raw <pre class="mermaid">...</pre> block
    (which, with html off, parses as one or more plain paragraphs). A mermaid
    example nested inside an ordinary code fence stays escaped, as it should.
    """
    out: list[Token] = []
    i = 0
    while i < len(tokens):
        tok = tokens[i]
        if tok.type == "fence" and tok.info.strip().split() == ["mermaid"]:
            out.append(_mermaid_token(tok.content))
            i += 1
            continue
        if (
            tok.type == "paragraph_open"
            and i + 1 < len(tokens)
            and tokens[i + 1].type == "inline"
            and tokens[i + 1].content.startswith(MERMAID_OPEN)
        ):
            # A blank line inside the diagram splits it across paragraphs, so
            # collect consecutive paragraph triples until one ends </pre>.
            parts: list[str] = []
            j = i
            closed = False
            while (
                not closed
                and j + 2 < len(tokens)
                and tokens[j].type == "paragraph_open"
                and tokens[j + 1].type == "inline"
                and tokens[j + 2].type == "paragraph_close"
            ):
                parts.append(tokens[j + 1].content)
                closed = tokens[j + 1].content.rstrip().endswith(MERMAID_CLOSE)
                j += 3
            if closed:
                source = "\n\n".join(parts).strip()
                source = source[len(MERMAID_OPEN) : -len(MERMAID_CLOSE)]
                out.append(_mermaid_token(source))
                i = j
                continue
        out.append(tok)
        i += 1
    return out


DETAILS_OPEN_RE = re.compile(
    r"^<details( open)?>(?:\s*<summary>(.*?)</summary>)?$", re.DOTALL
)
DETAILS_SUMMARY_RE = re.compile(r"^<summary>(.*?)</summary>$", re.DOTALL)
DETAILS_CLOSE_RE = re.compile(r"^</details>$")


def _details_html_token(content: str) -> Token:
    return Token("html_block", "", 0, content=content + "\n", block=True)


def details_passthrough(tokens: list[Token]) -> list[Token]:
    """Rebuild <details>/<summary> lines as real collapsible elements.

    The second deliberate exception to html-off, alongside mermaid: a reviewed
    document legitimately wants collapsible sections (full transcripts beside
    excerpts, long inventories). Only four exact standalone-paragraph shapes
    pass through — `<details>`, `<details open>` (either optionally carrying a
    same-line <summary>), a standalone `<summary>…</summary>`, and
    `</details>` — and summary text is entity-escaped, so no arbitrary markup
    or attributes ever reach the page. If the document's details tags don't
    balance, nothing passes through: an unclosed <details> would otherwise
    swallow every element after it, so the safe fallback is today's behavior
    (escaped, visible tags).

    The balance counter is FLAT — it counts tags, not block nesting — so a
    <details> opened inside a blockquote and closed outside it counts as
    balanced and passes through, emitting tags that straddle the blockquote.
    Browsers recover (</details> is in the HTML spec's implied-end-tag branch),
    so the "cannot swallow the page" guarantee holds; what the reader gets is a
    cosmetic mess — an empty collapsible and a section that never collapsed.
    Worth knowing before trusting the fallback to catch every malformed input.
    """

    def classify(i: int) -> tuple[str, str] | None:
        if not (
            i + 2 < len(tokens)
            and tokens[i].type == "paragraph_open"
            and tokens[i + 1].type == "inline"
            and tokens[i + 2].type == "paragraph_close"
        ):
            return None
        text = tokens[i + 1].content.strip()
        if m := DETAILS_OPEN_RE.match(text):
            open_tag = "<details open>" if m.group(1) else "<details>"
            if m.group(2) is not None:
                return ("open", open_tag + "<summary>" + html.escape(m.group(2)) + "</summary>")
            return ("open", open_tag)
        if m := DETAILS_SUMMARY_RE.match(text):
            return ("summary", "<summary>" + html.escape(m.group(1)) + "</summary>")
        if DETAILS_CLOSE_RE.match(text):
            return ("close", "</details>")
        return None

    # Balance check first: refuse the whole passthrough on any imbalance.
    depth = 0
    for i in range(len(tokens)):
        kind = classify(i)
        if kind is None:
            continue
        if kind[0] == "open":
            depth += 1
        elif kind[0] == "close":
            depth -= 1
            if depth < 0:
                return tokens
    if depth != 0:
        return tokens

    out: list[Token] = []
    i = 0
    in_details = 0
    while i < len(tokens):
        kind = classify(i)
        if kind is not None and (kind[0] != "summary" or in_details):
            out.append(_details_html_token(kind[1]))
            if kind[0] == "open":
                in_details += 1
            elif kind[0] == "close":
                in_details -= 1
            i += 3
            continue
        out.append(tokens[i])
        i += 1
    return out


# The chart vocabulary, lower-cased because the check case-folds (the HTML
# parser does too, restoring `clipPath` from `clippath` via its own adjustment
# table). This is an ALLOWLIST: anything not named here is refused, including
# names nobody has thought of yet. Extend it by adding a name — that is the
# supported way to draw something this list cannot express.
#
# Deliberately absent, each for a reason: <foreignObject>, <script>, <iframe>,
# <object> and <embed> execute or embed; <image> and <feImage> fetch a resource;
# <animate>, <animateTransform>, <animateMotion> and <set> can rewrite an
# attribute — including href — AFTER this check has read it, which is the whole
# hole an allowlist exists to close; <switch> exists to select a <foreignObject>
# branch; <metadata> holds arbitrary foreign-namespace XML, so allowing it would
# mean allowing its unbounded subtree. Tool-generated SVG often carries
# <metadata> and must have it stripped before it goes in a fence.
SVG_ALLOWED_ELEMENTS = frozenset(
    {
        "svg", "g", "defs", "symbol", "use", "a", "style",
        "title", "desc",
        "path", "rect", "circle", "ellipse", "line", "polyline", "polygon",
        "text", "tspan", "textpath",
        "marker", "clippath", "mask", "pattern",
        "lineargradient", "radialgradient", "stop",
        "filter", "fegaussianblur", "feoffset", "feblend", "fecolormatrix",
        "fecomposite", "feflood", "femerge", "femergenode", "fedropshadow",
        "femorphology",
    }
)


def _local(name: str) -> str:
    """The lowercased local part of an element or attribute name.

    ElementTree reports a namespaced name as `{uri}local`, and the raw source
    spells the same thing `xlink:href`, so both separators are stripped. The
    browser that finally parses the page is an HTML parser, which case-folds
    names inside <svg> — so <SCRIPT> and ONCLICK have to be recognised too.
    """
    return name.rpartition("}")[2].rpartition(":")[2].lower()


# ─── The styling grammar ──────────────────────────────────────────────────────
# Everything below permits only what it can positively recognise. The check it
# replaced searched a flattened string for dangerous constructs, and lost three
# times to the styling language's lexical freedom: an escaped spelling, a
# comment, and finally whitespace flattening, which joined a shorthand's
# leading keyword to the function name after it and so destroyed the boundary
# the match needed (`background: <keyword> <fetching-function>(…)` — reported
# with Chromium probes, reproduced against the old matcher here). The comment
# that used to sit here claiming whitespace removal "can only ever produce MORE
# matches than a parser sees" was false, and that case is the counter-example.
#
# A denylist over CSS cannot be finished, because the language keeps offering
# new spellings of the same construct. A grammar has the property none of the
# three fixes had: a construct it never permits cannot be reached by a new way
# of spelling it, because nothing here matches on spellings at all.

# The properties a diagram in this repo actually uses, plus their immediate
# siblings in the same job. Measured, not guessed: `fill`, `stroke`,
# `stroke-width`, `stroke-linejoin`, `stroke-dasharray`, `font-family`,
# `font-size`, `font-style`, `font-weight`, `letter-spacing`, `display`,
# `color`, `background`, `vertical-align`, `stop-color`, `flood-color`,
# `clip-path`, `mask`, `filter` and `marker-end` all appear in
# tests/test_md2artifact_svg.py or in the SVG templates of the
# `tufte-data-viz` skill. The rest are the paint, text and reference
# properties those imply — a chart that sets `stroke-linejoin` will set
# `stroke-linecap`, one that sets `marker-end` will set `marker-start`.
#
# The list is not what makes this safe: the VALUE grammar is, and it applies
# to every property alike, so even `mask`, `filter` and `background` — the
# fetch-capable ones — can only ever name a same-document `#` reference. The
# list is what makes a refusal legible, and what stops a property whose value
# grammar nobody here has modelled from being judged by a grammar built for a
# different one. Extend it by adding a name, the way SVG_ALLOWED_ELEMENTS is
# extended, and add the case to the test that pins real-diagram styling.
#
# `mask-type` is here as a named decision rather than a measurement: nothing
# in this repo that the element allowlist would accept uses it, but <mask> is
# in the element vocabulary and `mask-type` is how you select its mode, so the
# gap was real. It takes a keyword and cannot fetch. The one file that did use
# it — a tool-exported reference diagram — is refused anyway for embedding a
# raster <image>, which is what showed that the property was missing.
#
# Deliberately absent: `cursor`, whose url() fetches an image and which no
# static chart needs; `content`, which injects text; and every `*-image`
# longhand, since a chart paints with gradients and patterns it defines itself.
STYLE_PROPERTIES = frozenset(
    {
        # paint
        "fill", "fill-opacity", "fill-rule",
        "stroke", "stroke-width", "stroke-opacity", "stroke-linecap",
        "stroke-linejoin", "stroke-dasharray", "stroke-dashoffset",
        "stroke-miterlimit",
        "opacity", "color", "background", "background-color",
        "stop-color", "stop-opacity", "flood-color", "flood-opacity",
        "lighting-color", "paint-order", "mix-blend-mode", "isolation",
        "vector-effect", "shape-rendering", "color-interpolation-filters",
        # text
        "font", "font-family", "font-size", "font-style", "font-weight",
        "font-variant", "font-stretch", "letter-spacing", "word-spacing",
        "text-anchor", "text-decoration", "text-transform", "text-rendering",
        "dominant-baseline", "alignment-baseline", "baseline-shift",
        "white-space", "direction", "writing-mode", "vertical-align",
        # layout and visibility
        "display", "visibility", "overflow", "pointer-events",
        "transform-origin", "transform-box",
        "x", "y", "width", "height", "cx", "cy", "r", "rx", "ry",
        # same-document references
        "clip-path", "clip-rule", "mask", "mask-type", "filter",
        "marker", "marker-start", "marker-mid", "marker-end",
    }
)

# Only a font stack may carry a quoted string: `font-family: 'ET Book', serif`
# is the one real diagram spelling that needs one, and a string is how a
# resource gets named without ever spelling `url(` — which is how the second
# fetching construct got in.
FONT_STACK_PROPERTIES = frozenset({"font", "font-family"})

# The only functions a value may call. `url()` is shaped separately, because it
# may name a same-document fragment and nothing else; these four take numbers.
# A function not named here is refused unread, which is what makes a new
# fetching function harmless rather than a race to enumerate it.
VALUE_FUNCTIONS = frozenset({"rgb", "rgba", "hsl", "hsla"})

# Transform attributes are their own grammar: a list of calls from a closed set
# whose arguments carry no nested call, so nothing in one can reach a resource.
TRANSFORM_FUNCTIONS = frozenset(
    {
        "matrix", "translate", "translatex", "translatey",
        "scale", "scalex", "scaley", "rotate", "skewx", "skewy",
    }
)
TRANSFORM_ATTRIBUTES = frozenset({"transform", "gradienttransform", "patterntransform"})

# Attribute values that are human text, never a URL and never CSS in any
# engine. They are the one place the grammar steps aside, and they step aside
# by NAME — the loose shape is granted only to names listed here.
FREE_TEXT_ATTRIBUTES = frozenset({"role", "lang", "space", "title", "alt"})

PATH_DATA_RE = re.compile(r"[MmLlHhVvCcSsQqTtAaZz0-9eE,.+\-\s]*")
TRANSFORM_ARGUMENT_RE = re.compile(r"[0-9a-zA-Z.,+\-%\s]*")
FRAGMENT_VALUE_RE = re.compile(r"\s*#[A-Za-z0-9_.:\-]*\s*")
HEX_COLOUR_RE = re.compile(r"#[0-9a-fA-F]{3,8}(?![0-9A-Za-z])")
CSS_NUMBER_RE = re.compile(r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?(?:%|[a-zA-Z]{1,4})?")
CSS_IDENT_RE = re.compile(r"-{0,2}[A-Za-z_][A-Za-z0-9_-]*")
CSS_STRING_RE = re.compile(r"(['\"])([A-Za-z0-9 ._-]*)\1")
URL_FRAGMENT_RE = re.compile(r"\(\s*(['\"]?)#([A-Za-z0-9_.:\-]+)\1\s*\)")
SELECTOR_RE = re.compile(r"[A-Za-z0-9_\-.#*>+~,:\s]*")
VALUE_SEPARATORS = " \t\r\n\f,"

# The SVG and XLink namespaces, matched exactly. A namespace declaration is the
# one attribute whose value legitimately IS an external URL, so it is the one
# attribute compared against a fixed list rather than a shape.
SVG_NAMESPACES = frozenset(
    {"http://www.w3.org/2000/svg", "http://www.w3.org/1999/xlink"}
)


def _closing_paren(text: str, opening: int) -> int:
    """The index of the `)` that closes the `(` at `opening`, or -1."""
    depth = 0
    for i in range(opening, len(text)):
        if text[i] == "(":
            depth += 1
        elif text[i] == ")":
            depth -= 1
            if depth == 0:
                return i
    return -1


def css_value_fault(
    value: str, *, strings: bool = False, separators: str = VALUE_SEPARATORS
) -> str | None:
    """What this value does that the grammar has no production for, or None.

    The answer is a verb phrase — "calls image-set(), which is not one of the
    permitted functions" — so each caller can name the property or attribute it
    came from and read as one sentence in the rejection note.

    A value is a list of components, and a component is one of exactly five
    shapes: a hex colour, a number with an optional unit or percent sign, a
    bare identifier, `url(#fragment)`, or a call to one of the numeric colour
    functions. A font stack may additionally carry a quoted plain font name.
    Everything else — a backslash, a `/*`, an `@`, a colon, a slash, a quote
    outside a font stack, a function nobody listed — is refused by falling off
    the end of that list, without any rule naming it.

    None of the five shapes can reach the network. An identifier and a number
    are inert; a hex colour is inert; `url()` is constrained to a
    same-document fragment, which is how a chart reaches its own gradient,
    clip path, mask, marker or filter; and the colour functions take numbers.
    So a fetching construct spelled in a way nobody has seen yet still has to
    arrive as one of those five shapes to be accepted, and cannot.
    """
    i, n = 0, len(value)
    while i < n:
        char = value[i]
        if char in separators:
            i += 1
            continue
        if char == "#":
            match = HEX_COLOUR_RE.match(value, i)
            if match is None:
                return "has a `#` that is not a hex colour"
            i = match.end()
            continue
        if char in "\"'":
            if not strings:
                return "has a quoted string, which only a font stack may carry"
            match = CSS_STRING_RE.match(value, i)
            if match is None:
                return "has a quoted string that is not a plain font name"
            i = match.end()
            continue
        if match := CSS_NUMBER_RE.match(value, i):
            i = match.end()
            continue
        if match := CSS_IDENT_RE.match(value, i):
            name, after = match.group(), match.end()
            if after >= n or value[after] != "(":
                i = after
                continue
            call = name.lower()
            if call == "url":
                fragment = URL_FRAGMENT_RE.match(value, after)
                if fragment is None:
                    return "has a url() that is not a same-document #reference"
                i = fragment.end()
                continue
            if call not in VALUE_FUNCTIONS:
                return f"calls {name}(), which is not one of the permitted functions"
            close = _closing_paren(value, after)
            if close < 0:
                return f"has a {name}( that never closes"
            if fault := css_value_fault(
                value[after + 1 : close], separators=VALUE_SEPARATORS + "/"
            ):
                return f"calls {name}(), which {fault}"
            i = close + 1
            continue
        return f"contains {char!r}, which no permitted value shape allows"
    return None


def css_declarations_fault(text: str) -> str | None:
    """Why this `property: value; …` list may not be inlined, or None.

    A verb phrase again, so `its <style> element` and `its style attribute`
    can each prefix it.
    """
    for chunk in text.split(";"):
        if not chunk.strip():
            continue
        raw_property, colon, value = chunk.partition(":")
        if not colon:
            return "has a declaration with no property"
        name = raw_property.strip().lower()
        if name not in STYLE_PROPERTIES:
            return f"sets `{name}`, which is not in the chart styling vocabulary"
        if fault := css_value_fault(value, strings=name in FONT_STACK_PROPERTIES):
            return f"sets `{name}` to a value that {fault}"
    return None


def css_stylesheet_fault(text: str) -> str | None:
    """Why this <style> element may not be inlined, or None.

    A stylesheet here is a flat list of `selector { declarations }` rules and
    nothing else. An at-rule is refused because `@` is not a selector
    character, and a comment because `/` is not either — so `@import`, the
    nested at-rules, and every comment-based spelling are refused by the same
    absence rather than by three rules that each had to be thought of.

    A <style> inside the fence is DOCUMENT-scoped, not chart-scoped — a rule
    in an inline SVG painted a background on a <div> outside the <svg> in the
    same probe — so this grammar governs the whole page's styling, not the
    chart's.
    """
    i = 0
    while i < len(text):
        brace = text.find("{", i)
        if brace < 0:
            if "@" in text[i:]:
                return "carries an at-rule, which is not a style rule"
            if text[i:].strip():
                return "has text outside any style rule"
            return None
        prelude = text[i:brace]
        if not prelude.strip():
            return "has a style rule with no selector"
        if "@" in prelude:
            return "carries an at-rule, which is not a style rule"
        if SELECTOR_RE.fullmatch(prelude) is None:
            bad = next(c for c in prelude if SELECTOR_RE.fullmatch(c) is None)
            return f"has a selector containing {bad!r}, which is not a selector character"
        close = text.find("}", brace)
        if close < 0:
            return "has a style rule that is never closed"
        if fault := css_declarations_fault(text[brace + 1 : close]):
            return fault
        i = close + 1
    return None


def transform_fault(value: str) -> str | None:
    """Why this transform list may not be inlined, or None.

    A list of calls from TRANSFORM_FUNCTIONS whose arguments carry no nested
    call — no `(` is permitted inside them — so a transform cannot reach a
    resource however it is spelled.
    """
    i, n = 0, len(value)
    while i < n:
        if value[i] in VALUE_SEPARATORS:
            i += 1
            continue
        match = CSS_IDENT_RE.match(value, i)
        if match is None or match.end() >= n or value[match.end()] != "(":
            return "is not a list of transform functions"
        name = match.group().lower()
        if name not in TRANSFORM_FUNCTIONS:
            return f"calls {match.group()}(), which is not a transform function"
        close = value.find(")", match.end())
        if close < 0:
            return f"has a {match.group()}( that never closes"
        if TRANSFORM_ARGUMENT_RE.fullmatch(value[match.end() + 1 : close]) is None:
            return f"passes {match.group()}() something that is not a number"
        i = close + 1
    return None


def attribute_fault(name: str, value: str) -> str | None:
    """Why this attribute may not be inlined, or None if it may.

    One copy, called from the XML tree walk and from the HTML scan alike, so
    the two readings of the same source cannot drift apart.

    Every value is judged by a SHAPE, and the shape is chosen by the attribute
    name. The default shape is the styling-value grammar, which is why an
    attribute name nobody listed is still safe: its value has to be a colour, a
    number, a bare word, a `#` fragment or a numeric colour function to be
    accepted at all, and none of those can fetch. Only names listed here are
    granted a LOOSER shape — human text, path data, a transform list, a
    fragment reference, a namespace URI — so looseness is always a decision
    about a name that was positively recognised.

    This is also what retired the `javascript:`, non-image `data:` and
    external-`url()` rules: each was a spelling the grammar has no production
    for, since `:` and `/` are not value characters and a `url()` must name a
    fragment. The two name rules that remain — no `on*` handler, no `ping` —
    are policies about the NAME, which no value shape can express: `onclick`'s
    value is a bare word, and a bare word is a legitimate value everywhere
    else.
    """
    raw = name.lower()
    aname = _local(name)
    if aname.startswith("on"):
        return f"it carries an event-handler attribute ({aname})"
    if aname == "ping":
        return f"it carries a {aname} attribute, which POSTs to a URL of its own"
    if raw == "xmlns" or raw.startswith("xmlns:"):
        if value.strip() not in SVG_NAMESPACES:
            return f"it binds {raw} to something other than the SVG or XLink namespace"
        return None
    if aname == "style":
        if fault := css_declarations_fault(value):
            return f"its style attribute {fault}"
        return None
    if aname == "href":
        if FRAGMENT_VALUE_RE.fullmatch(value) is None:
            return f"it has an {aname} attribute that is not a same-document reference"
        return None
    if aname in FREE_TEXT_ATTRIBUTES or aname.startswith(("aria-", "data-")):
        return None
    if aname == "d":
        if PATH_DATA_RE.fullmatch(value) is None:
            return f"its {aname} attribute is not path data"
        return None
    if aname in TRANSFORM_ATTRIBUTES:
        if fault := transform_fault(value):
            return f"its {aname} attribute {fault}"
        return None
    if fault := css_value_fault(value, strings=aname in FONT_STACK_PROPERTIES):
        return f"its {aname} attribute has a value that {fault}"
    return None


HTML_SPACE = " \t\r\n\f"


def html_fault(source: str) -> str | None:
    """Why the source is unsafe when an HTML parser reads it, or None.

    An XML parse says what ElementTree makes of the fence. It does not say what
    the BROWSER makes of it, and the browser is the one that matters, because
    the fence is emitted into the page verbatim. The two parsers have different
    rules, and where they differ the XML reading is the one that is wrong.

    So the same source is scanned a second time with HTML tokenizer rules: a
    `<` followed by an ASCII letter opens a tag whose name runs to the first
    whitespace, `/` or `>`, and everything else — a stray `<`, a colon inside
    an element name, a tag that never closes — is refused rather than
    interpreted. `<style>` is raw text in HTML, so its body is skipped here and
    judged by css_stylesheet_fault through the tree instead.

    The scan deliberately refuses rather than normalises. A spelling exotic
    enough to need normalising has no place in an inline chart fence, and a
    normaliser is one more thing that can disagree with the browser.
    """
    i, n = 0, len(source)
    while (lt := source.find("<", i)) >= 0:
        j = lt + 1
        closing = j < n and source[j] == "/"
        if closing:
            j += 1
        if j >= n or not (source[j].isascii() and source[j].isalpha()):
            return "it carries a `<` that does not open a tag"
        start = j
        while j < n and source[j].isascii() and source[j].isalnum():
            j += 1
        if j < n and source[j] == ":":
            spelling = source[start : j + 1] + source[j + 1 :].split(">", 1)[0].split(" ", 1)[0]
            return f"it spells an element name with a namespace prefix (<{spelling}>)"
        name = source[start:j].lower()
        if j < n and source[j] not in HTML_SPACE + "/>":
            return f"it spells an element name an HTML parser would not read as <{name}>"
        if name not in SVG_ALLOWED_ELEMENTS:
            return f"it contains a <{name}> element, which is not in the chart vocabulary"
        if closing:
            end = source.find(">", j)
            if end < 0:
                return f"it has a </{name}> tag that is never closed"
            i = end + 1
            continue
        j, fault = _scan_attributes(source, j, name)
        if fault is not None:
            return fault
        if name == "style":
            close = source.lower().find("</style", j)
            if close < 0:
                return "it has a <style> element that is never closed"
            i = close
            continue
        i = j
    return None


def _scan_attributes(source: str, i: int, element: str) -> tuple[int, str | None]:
    """Walk one start tag's attributes the way an HTML tokenizer would.

    Returns the index just past the tag, and the fault if one was found.
    """
    n = len(source)
    while True:
        while i < n and source[i] in HTML_SPACE:
            i += 1
        if i >= n:
            return i, f"it has a <{element}> tag that is never closed"
        if source[i] == ">":
            return i + 1, None
        if source[i] == "/":
            i += 1
            continue
        start = i
        while i < n and source[i] not in HTML_SPACE + "/=>":
            i += 1
        name = source[start:i]
        while i < n and source[i] in HTML_SPACE:
            i += 1
        value = ""
        if i < n and source[i] == "=":
            i += 1
            while i < n and source[i] in HTML_SPACE:
                i += 1
            if i < n and source[i] in "\"'":
                quote = source[i]
                end = source.find(quote, i + 1)
                if end < 0:
                    return i, f"it has a <{element}> attribute whose quoting never closes"
                value, i = source[i + 1 : end], end + 1
            else:
                start = i
                while i < n and source[i] not in HTML_SPACE + ">":
                    i += 1
                value = source[start:i]
        if fault := attribute_fault(name, html.unescape(value)):
            return i, fault


def svg_rejection(source: str) -> str | None:
    """Why this ```svg fence may not be inlined, or None if it may.

    Elements are checked against an ALLOWLIST (SVG_ALLOWED_ELEMENTS) over a
    *parsed* tree, not a regex over text: anything that does not parse as one
    well-formed <svg> element is refused outright, so there is no half-parsed
    input for the checks below to disagree with the browser about. A denylist
    here would be a bet that every dangerous element name has been enumerated,
    and that bet has already lost once — the page is finally read by an HTML
    parser, where <p>, <img> and <div> break OUT of SVG foreign content and are
    parsed as HTML, bringing HTML's own resource-loading attributes with them.
    An allowlist refuses them by construction, along with every name nobody has
    thought of yet, and the cost is small because a chart's vocabulary is small.

    An XML parse alone is NOT a safe-HTML check, and treating it as one was a
    real bypass (fixed 2026-09-11). ElementTree resolves `<s:svg>` to the same
    local name as `<svg>`, while an HTML parser sees an unknown element and so
    never enters SVG foreign content — where a CDATA section stops being text
    and becomes a bogus comment that ends at its first `>`, releasing whatever
    follows it as live markup that the element allowlist never saw, because to
    ElementTree it was only text. Both halves are now refused outright: a
    namespace-prefixed spelling and a CDATA section, neither of which an inline
    chart has any use for. The source is then scanned a SECOND time under HTML
    tokenizer rules (html_fault), so a future divergence between the two
    parsers fails closed instead of shipping.

    Attribute NAMES are not allowlisted — presentation attributes are
    open-ended, and an attribute allowlist would refuse a legitimate chart
    every time someone reached for a property nobody had listed. Attribute
    VALUES are, by a positive grammar (css_value_fault): a value must be a hex
    colour, a number with an optional unit, a bare word, a `url(#fragment)` or
    a numeric colour function, and anything else refuses. That inverts what
    used to sit here. A text matcher searching a flattened value for dangerous
    constructs lost three times — an escaped spelling, a comment, and finally
    whitespace flattening joining a shorthand keyword to the function name
    after it — because the styling language keeps offering new ways to spell a
    construct, and a denylist over it cannot be finished. A grammar has the
    property the three fixes did not: a construct it never permits cannot be
    reached by a new spelling, because nothing matches on spellings.

    The <style> element is the same inversion one level up (css_stylesheet_
    fault): a flat list of `selector { declarations }` rules, each property in
    STYLE_PROPERTIES, each value through the same grammar. An at-rule and a
    comment refuse because `@` and `/` are not selector characters.

    Two rules remain about the NAME, because no value shape can express them:
    no on* handler, whose value is a bare word and so a legitimate value
    everywhere else, and no `ping` (SVG2 <a> takes it, and a followed link
    POSTs to every URL in it). The href rule is a shape, not a name rule: a
    same-document `#` reference and nothing else, which is also what stops a
    <use> pulling in an external document.

    A DOCTYPE is refused before the parser sees it: ElementTree resolves no
    external entities, but it does expand internal ones, so an internal DTD
    subset is a billion-laughs denial of service against whoever builds the
    page. An element is not a document and has no business carrying one. Every
    other markup declaration, comment and processing instruction is refused
    alongside it, for the same reason CDATA is: an inline chart does not need
    one, and each is a construct the two parsers read differently.
    """
    if re.search(r"<!\s*\[", source):
        return "it contains a CDATA section"
    if re.search(r"<!\s*(doctype|entity)", source, re.IGNORECASE):
        return "it carries a DOCTYPE or entity declaration"
    if "<!--" in source:
        return "it contains a comment"
    if "<!" in source:
        return "it contains a markup declaration"
    if "<?" in source:
        return "it contains a processing instruction"
    try:
        root = ET.fromstring(source)
    except ET.ParseError as exc:
        return f"it does not parse as one well-formed XML element ({exc})"
    if _local(root.tag) != "svg":
        return f"its root element is <{_local(root.tag)}>, not <svg>"
    for elem in root.iter():
        name = _local(elem.tag)
        if name not in SVG_ALLOWED_ELEMENTS:
            return f"it contains a <{name}> element, which is not in the chart vocabulary"
        if name == "style" and (fault := css_stylesheet_fault("".join(elem.itertext()))):
            return f"its <style> element {fault}"
        for attr, value in elem.attrib.items():
            if fault := attribute_fault(attr, value):
                return fault
    return html_fault(source)


def _svg_token(source: str) -> Token:
    """The fence body, byte for byte, as a real element.

    Verbatim and not re-serialised on purpose: ElementTree would normalise
    `viewBox` to lower case, drop namespace prefixes and reorder attributes,
    each of which silently breaks a chart. The tree is used to JUDGE the
    source, never to rewrite it.
    """
    return Token(
        "html_block",
        "",
        0,
        content=source if source.endswith("\n") else source + "\n",
        block=True,
    )


def _svg_note_token(reason: str) -> Token:
    return Token(
        "html_block",
        "",
        0,
        content=(
            '<p class="svg-note">This <code>svg</code> block was not inlined because '
            f"{html.escape(reason)}. Its source is shown below.</p>\n"
        ),
        block=True,
    )


def svg_passthrough(tokens: list[Token]) -> list[Token]:
    """Inline a ```svg fence whose body survives the sanitising check.

    The third deliberate exception to html-off, and the reason it exists:
    charts on an artifact page are native SVG drawn from the house tokens, so
    without this a chart page cannot go through this pipeline at all and has to
    be hand-written HTML instead.

    Accepted: one well-formed <svg> element built from SVG_ALLOWED_ELEMENTS —
    the shapes, text, gradients, filters and structure a chart is drawn from —
    and nothing else. Every other element name refuses, whether it executes
    (<script>), embeds (<foreignObject>, <iframe>), fetches (<image>), rewrites
    an attribute after this check has read it (<animate>, <set>), or is simply
    unknown. Also rejected: a DOCTYPE; any on* attribute; a `ping` attribute;
    any href/xlink:href that is not a same-document `#` reference (which is
    also what stops a <use> pulling in an external document); and any styling
    the value grammar cannot recognise, in the <style> element, a style=
    attribute and a presentation attribute alike — a value must be a hex
    colour, a number, a bare word, a numeric colour function or `url(#id)`,
    which is how a chart reaches its own gradient. A rejected fence falls back
    to today's behavior — an
    escaped code block — with a visible note saying why, so a chart never fails
    silently, and the note names the element so the fix is obvious.

    An ```svg example nested inside an ordinary code fence stays escaped: the
    outer fence swallows it, so no fence token is ever produced for it. Same as
    mermaid.
    """
    out: list[Token] = []
    for tok in tokens:
        if tok.type == "fence" and tok.info.strip().split() == ["svg"]:
            reason = svg_rejection(tok.content)
            if reason is None:
                out.append(_svg_token(tok.content))
                continue
            out.append(_svg_note_token(reason))
        out.append(tok)
    return out

HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@(.*)$")
GIT_HEADER_RE = re.compile(r"^diff --git a/(.+?) b/(.+)$")
# Header lines git prints between `diff --git` and the first hunk. Shown muted
# rather than dropped, so a mode change or a binary-file note stays visible.
DIFF_META_PREFIXES = (
    "index ", "new file mode", "deleted file mode", "old mode", "new mode",
    "similarity index", "dissimilarity index", "rename from", "rename to",
    "copy from", "copy to", "Binary files",
)


def _diff_path(spec: str, prefix: str) -> str:
    spec = spec.split("\t", 1)[0].strip()
    return spec.removeprefix(prefix)


def parse_diff(source: str) -> list[dict]:
    """Split a unified diff into files, each a list of numbered rows.

    A row is (kind, old, new, sign, text) with kind one of add, del, ctx,
    hunk, meta; old/new are line numbers or None. Hunk bodies are walked by
    the counts in their `@@` header, so a deleted line that happens to read
    `--- x` is never mistaken for the next file's header. Lines outside any
    counted hunk — a hand-written snippet with no headers — are classified by
    their first character and left unnumbered.
    """
    lines = source.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    files: list[dict] = []
    cur: dict | None = None
    old_no = new_no = old_left = new_left = 0

    def start(old: str | None = None, new: str | None = None) -> dict:
        f = {"old": old, "new": new, "rows": [], "hunks": 0}
        files.append(f)
        return f

    for i, line in enumerate(lines):
        if old_left > 0 or new_left > 0:
            sign, text = line[:1], line[1:]
            if sign == "\\":
                cur["rows"].append(("meta", None, None, "", line))
            elif sign == "-":
                cur["rows"].append(("del", old_no, None, "-", text))
                old_no, old_left = old_no + 1, old_left - 1
            elif sign == "+":
                cur["rows"].append(("add", None, new_no, "+", text))
                new_no, new_left = new_no + 1, new_left - 1
            else:
                # Some tools strip the trailing space of an empty context line.
                cur["rows"].append(("ctx", old_no, new_no, " ", text))
                old_no, new_no = old_no + 1, new_no + 1
                old_left, new_left = old_left - 1, new_left - 1
            continue
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        if m := GIT_HEADER_RE.match(line):
            cur = start(m.group(1), m.group(2))
        elif line.startswith("--- ") and nxt.startswith("+++ "):
            if cur is None or cur["hunks"] or (cur["old"] is None and cur["rows"]):
                cur = start()
            cur["old"] = _diff_path(line[4:], "a/")
        elif line.startswith("+++ ") and cur is not None and not cur["hunks"]:
            cur["new"] = _diff_path(line[4:], "b/")
        elif m := HUNK_RE.match(line):
            if cur is None:
                cur = start()
            old_no, new_no = int(m.group(1)), int(m.group(3))
            old_left = int(m.group(2)) if m.group(2) is not None else 1
            new_left = int(m.group(4)) if m.group(4) is not None else 1
            cur["hunks"] += 1
            cur["rows"].append(("hunk", None, None, "", line))
        elif cur is not None and not cur["hunks"] and line.startswith(DIFF_META_PREFIXES):
            cur["rows"].append(("meta", None, None, "", line))
        else:
            if cur is None:
                cur = start()
            sign = line[:1]
            if line.startswith("@@"):
                cur["rows"].append(("hunk", None, None, "", line))
            elif sign in {"+", "-"}:
                cur["rows"].append(("add" if sign == "+" else "del", None, None, sign, line[1:]))
            else:
                cur["rows"].append(("ctx", None, None, " ", line[1:] if sign == " " else line))
    return files


def _diff_file_name(f: dict) -> str | None:
    old, new = f["old"], f["new"]
    if new and new != "/dev/null":
        if old and old not in {"/dev/null", new}:
            return f"{old} → {new}"
        return new
    if old and old != "/dev/null":
        return old
    return None


def _diff_rows_html(rows: list[tuple]) -> str:
    out = []
    for kind, old, new, sign, text in rows:
        # Line numbers live in data-n and are drawn by CSS, so a selection or a
        # copy of the code never picks them up. The sign is real text: it is
        # part of the diff, and the cue that does not depend on colour.
        nums = "".join(
            f'<span class="ln" data-n="{n}"></span>' if n is not None else '<span class="ln"></span>'
            for n in (old, new)
        )
        sign_html = f'<span class="ds">{html.escape(sign) or " "}</span>' if kind in {"add", "del", "ctx"} else ""
        # The trailing newline is real text on purpose. The annotation layer
        # re-finds a quote by joining the page's text nodes, while a selection
        # breaks lines between block rows; without a newline in the text the
        # two never match and a comment spanning rows is lost on reload.
        out.append(
            f'<span class="dl dl-{kind}">{nums}{sign_html}'
            f'<span class="dc">{html.escape(text, quote=False)}</span>\n</span>'
        )
    return '<pre class="diff"><code>' + "".join(out) + "</code></pre>"


def diff_html(source: str) -> str:
    """A ```diff fence as a numbered, coloured unified diff, one <details> per file.

    Pure build-time rendering: every byte of the fence reaches the page as
    entity-escaped text, so this passthrough can no more inject markup than a
    plain code fence can.
    """
    files = parse_diff(source)
    named = [f for f in files if _diff_file_name(f)]
    if not named:
        rows = [r for f in files for r in f["rows"]]
        return '<div class="diff-wrap">' + _diff_rows_html(rows) + "</div>"
    parts = []
    for f in files:
        name = _diff_file_name(f) or "(no file header)"
        adds = sum(r[0] == "add" for r in f["rows"])
        dels = sum(r[0] == "del" for r in f["rows"])
        parts.append(
            '<details class="diff-file" open><summary><code>'
            # An entity, not the character: the page is a fragment with no
            # charset of its own, so only ASCII survives every way it is served.
            + html.escape(name, quote=False).replace("→", "&rarr;")
            + f'</code> <span class="diff-stat"><span class="dsa">+{adds}</span> '
            f'<span class="dsd">&minus;{dels}</span></span></summary>'
            + _diff_rows_html(f["rows"])
            + "</details>"
        )
    return '<div class="diff-wrap">' + "".join(parts) + "</div>"


def diff_passthrough(tokens: list[Token]) -> list[Token]:
    """Render a ```diff fence as a unified diff. Other fences are untouched."""
    out: list[Token] = []
    for tok in tokens:
        if tok.type == "fence" and tok.info.strip().split()[:1] == ["diff"]:
            out.append(Token("html_block", "", 0, content=diff_html(tok.content) + "\n", block=True))
            continue
        out.append(tok)
    return out


TASK_RE = re.compile(r"^\[([ xX])\]\s+")

# A state is written into the brackets of a Markdown task line by Copy all
# (`- [deny] the label`), so a state carrying a bracket or a newline produces a
# line that no longer parses back as a task item -- silently, in the reviewer's
# clipboard, long after the build that accepted it. Everything else is allowed:
# the state is a word the author chose, and only these characters break it.
BAD_STATE_CHARS = re.compile(r"[\[\]\x00-\x1f\x7f]")


def _inline_plain(children: list[Token]) -> str:
    """The item's visible text, used only to derive a stable control id."""
    return "".join(
        c.content for c in children if c.type in {"text", "code_inline"}
    ).strip()


def _allocate_id(stem: str, used: set[str]) -> str:
    """Hand out `stem`, suffixing until the result is genuinely unused.

    `used` must hold every id ALREADY EMITTED, suffixed ones included. A
    per-stem tally is not enough: it records only the original stem, so two
    items labelled "ship it" emit "ship-it" and "ship-it-1" while a third item
    labelled "ship it 1" slugifies to "ship-it-1" on its own and is handed the
    same id. Two controls then share one persistence slot and silently
    overwrite each other's saved state — and two headings share one DOM id, so
    a contents link jumps to the wrong section.
    """
    candidate = stem
    n = 0
    while candidate in used:
        n += 1
        candidate = f"{stem}-{n}"
    used.add(candidate)
    return candidate


def _state_control(sid: str, checked: bool, states: list[str] | None) -> str:
    """The opening markup of one toggle control, up to the label span.

    Two shapes, one contract. With no declared state set the control is a real
    `<input type="checkbox">`, so Space toggles it and the browser supplies the
    role; the page a reader already knows is unchanged. With a set declared it
    is a `<button>` cycling through that set, which is keyboard-operable for
    the same reason. Either way the wrapper carries `data-an-state-id`, which
    is the only thing the annotation layer looks for — a hand-written page can
    emit the same markup and get persistence and export for free.

    `[ ]` selects the first declared state and `[x]` the last, which is exactly
    checkbox semantics when the set has two members.
    """
    wrap_attrs = f' data-an-state-id="{html.escape(sid, quote=True)}"'
    if states:
        value = states[-1] if checked else states[0]
        wrap_attrs += (
            ' data-an-states="'
            + html.escape(json.dumps(states), quote=True)
            + '"'
        )
        control = (
            '<button type="button" class="anstatebtn" data-an-state="'
            + html.escape(value, quote=True)
            + '">'
            + html.escape(value)
            + "</button>"
        )
    else:
        control = '<input type="checkbox" class="anstatebox"' + (
            " checked>" if checked else ">"
        )
    return f'<span class="anstate"{wrap_attrs}>{control}<span class="anstatelabel">'


def task_list_controls(tokens: list[Token], states: list[str] | None) -> list[Token]:
    """Turn `- [ ] item` into a real toggle control, keeping the text quotable.

    Only the FIRST paragraph of a list item is rewritten, and only when its
    first text child starts with a task marker, so an ordinary list item and a
    `[ ]` appearing mid-sentence are both left alone. The label text stays
    ordinary escaped Markdown output — the annotation layer can still quote it
    — while the control's own text sits in an element the layer skips.
    """
    used: set[str] = set()
    for i, tok in enumerate(tokens):
        if tok.type != "list_item_open":
            continue
        if not (
            i + 2 < len(tokens)
            and tokens[i + 1].type == "paragraph_open"
            and tokens[i + 2].type == "inline"
        ):
            continue
        kids = tokens[i + 2].children or []
        if not kids or kids[0].type != "text":
            continue
        m = TASK_RE.match(kids[0].content)
        if not m:
            continue
        kids[0].content = kids[0].content[m.end() :]
        sid = _allocate_id(slugify(_inline_plain(kids))[:48] or "item", used)
        opener = _state_control(sid, m.group(1).lower() == "x", states)
        kids.insert(0, Token("html_inline", "", 0, content=opener))
        kids.append(Token("html_inline", "", 0, content="</span></span>"))
        tok.attrJoin("class", "antask")
    return tokens


# ─── Sanctioned passthroughs ──────────────────────────────────────────────────
# The parser keeps html OFF so a reviewed document can never inject markup into
# the published page. Anything the Artifact viewer renders natively (mermaid
# today) or that reviewed documents legitimately need as real elements
# (<details> collapsibles, ```svg charts) gets its own narrow passthrough here
# instead of flipping html on globally. When Anthropic ships a new viewer-native
# construct, preserve it by adding one entry to this list: a token pass that
# rebuilds ONLY that construct's exact spelling as an html_block, escapes any
# user text it carries, and leaves every other spelling escaped. Each entry
# ships with a guard test (tests/test_md2artifact_<name>.py).
#
# ```svg is the one entry that emits user text UNESCAPED, so it pays for that
# with a check instead: the body must parse as one well-formed <svg> element
# whose every element name is in SVG_ALLOWED_ELEMENTS — an allowlist, so an
# element nobody anticipated refuses by default — carrying no DOCTYPE, no on*
# attribute, no `ping`, no href/xlink:href that is not a same-document `#`
# reference, and no styling outside the positive grammar: a property in
# STYLE_PROPERTIES whose value is a colour, a number, a bare word, a numeric
# colour function or `url(#id)`. Both halves are allowlists, so a construct
# nobody anticipated refuses by default. Judged on a parsed
# tree, emitted verbatim — never
# re-serialised, or `viewBox` casing and namespace prefixes would not survive.
# Anything rejected renders as an escaped code block with a note saying why,
# which is exactly what a plain fence did before. So the property the whole
# registry exists to hold — a Markdown document you did not write cannot put
# script into your published page — is unchanged.
#
# ```diff builds its markup itself and emits the fence body only as escaped
# text, so it is the same kind of entry as mermaid, not svg.
PASSTHROUGHS = [mermaid_passthrough, details_passthrough, svg_passthrough, diff_passthrough]


# ─── Review structure: priority tags, H2 sections, seen hashes ────────────────
# A heading may end in one of these tags. The tag is removed from the text and
# recorded on the heading token's meta; any other `{...}` suffix stays as text.
# `{lower}` means something only below H2, so on H1/H2 it is left visible.
PRIORITY_TAG_RE = re.compile(r"\s+\{(judgement|lower)\}\s*$")


def strip_priority_tags(text: str, level: int = 3) -> tuple[str, set[str]]:
    """The heading text without its trailing tags, and the tags removed."""
    tags: set[str] = set()
    while (m := PRIORITY_TAG_RE.search(text)) and (m.group(1) != "lower" or level >= 3):
        tags.add(m.group(1))
        text = text[: m.start()]
    return text, tags


def priority_tags(tokens: list[Token]) -> list[Token]:
    """Strip `{judgement}` / `{lower}` off headings into `heading_open.meta["tags"]`."""
    for i, tok in enumerate(tokens):
        if tok.type != "heading_open":
            continue
        inline = tokens[i + 1]
        kids = inline.children or []
        if not kids or kids[-1].type != "text":
            continue
        text, tags = strip_priority_tags(kids[-1].content, int(tok.tag[1]))
        if not tags:
            continue
        kids[-1].content = text
        inline.content, _ = strip_priority_tags(inline.content, int(tok.tag[1]))
        tok.meta = {**(tok.meta or {}), "tags": tags}
        if "judgement" in tags:
            kids.append(
                Token("html_inline", "", 0, content='<span class="chip chip-call" data-label="Your call"></span>')
            )
    return tokens


def _details_delta(tok: Token) -> int:
    if tok.type != "html_block":
        return 0
    text = tok.content.strip()
    if text.startswith("<details"):
        return 1
    if text == "</details>":
        return -1
    return 0


def _is_top_heading(tok: Token, depth: int) -> bool:
    """A heading at block level 0 and outside every <details>: a structural boundary."""
    return tok.type == "heading_open" and tok.level == 0 and depth == 0


def split_sections(tokens: list[Token]) -> tuple[list[Token], list[list[Token]]]:
    """(preamble, sections): each section starts at a top-level H2.

    An H2 inside a blockquote, a list or a <details> is not a boundary, so a
    section never closes in the middle of an element it did not open.
    """
    preamble: list[Token] = []
    sections: list[list[Token]] = []
    cur, depth = preamble, 0
    for tok in tokens:
        if _is_top_heading(tok, depth) and tok.tag == "h2":
            cur = []
            sections.append(cur)
        cur.append(tok)
        depth += _details_delta(tok)
    return preamble, sections


def gather_lower(region: list[Token]) -> list[Token]:
    """Move each `{lower}` subsection to a folded tray at the end of the region.

    A subsection runs from its heading to the next top-level heading of the
    same or a higher rank. Only headings outside every <details> start or end
    one, so a moved range always holds whole <details> elements and the page
    stays balanced.
    """
    depths, depth = [], 0
    for tok in region:
        depths.append(depth)
        depth += _details_delta(tok)
    kept: list[Token] = []
    moved: list[list[Token]] = []
    i = 0
    while i < len(region):
        tok = region[i]
        if _is_top_heading(tok, depths[i]) and "lower" in (tok.meta or {}).get("tags", ()):
            rank = int(tok.tag[1])
            j = i + 1
            while j < len(region) and not (
                _is_top_heading(region[j], depths[j]) and int(region[j].tag[1]) <= rank
            ):
                j += 1
            moved.append(region[i:j])
            i = j
            continue
        kept.append(tok)
        i += 1
    if not moved:
        return region
    tray = [
        _details_html_token(
            f'<details class="lower-tray"><summary>Lower priority ({len(moved)})</summary>'
        )
    ]
    for chunk in moved:
        tray.extend(chunk)
    tray.append(_details_html_token("</details>"))
    return kept + tray


def section_hash(md: MarkdownIt, section: list[Token]) -> str:
    """A short hash of the section as rendered, with every id left out.

    Ids are allocated across the whole document — heading ids, and the
    task-list control ids derived from each item's label — so a duplicate
    heading or checklist item added in ANOTHER section would otherwise mark
    this one Changed although nothing in it changed.
    """
    rendered = md.renderer.render(section, md.options, {})
    rendered = ID_ATTR_RE.sub("", rendered)
    return hashlib.sha256(rendered.encode("utf-8")).hexdigest()[:12]


ID_ATTR_RE = re.compile(r' (?:id|data-an-state-id)="[^"]*"')


def _section_tokens(section: list[Token], slug: str, digest: str) -> list[Token]:
    """Wrap one section in its collapsible container and controls.

    A <div>, not a <section>: the annotation layer labels a comment with the
    heading of its closest <section>, so a <section> here would report every
    comment under an H3 as belonging to the H2. With a div the layer's
    sibling walk still finds the nearest H3, and the H2 for prose directly
    under it, because the H2 stays the body's previous heading sibling.

    Every label on these controls is CSS generated content from data-label,
    never a text node: the layer re-anchors a comment by searching the page's
    text, and a badge whose words change must not be part of that text.
    """
    body = f"{slug}--body"
    head = [
        _details_html_token(
            f'<div class="sec" data-sec="{slug}" data-hash="{digest}">'
            f'<button type="button" class="sec-toggle" aria-expanded="true" '
            f'aria-controls="{body}" aria-labelledby="{slug}"></button>'
        ),
        *section[:3],
        _details_html_token(
            '<div class="sec-tools">'
            '<span class="chip seen-badge" hidden></span>'
            f'<button type="button" class="seen-btn" aria-pressed="false" aria-describedby="{slug}" '
            'data-label="Mark seen"></button>'
            f'</div><div class="sec-body" id="{body}">'
        ),
    ]
    return head + section[3:] + [_details_html_token("</div></div>")]


PAGE_TOOLS = (
    '<div class="page-tools">'
    '<a class="unseen-sum" hidden></a>'
    '<button type="button" class="page-comment" hidden '
    'data-label="Comment on this page" aria-label="Comment on this page"></button>'
    "</div>"
)


def render(
    md_text: str, states: list[str] | None = None
) -> tuple[str, list[tuple[int, str, str]]]:
    """Return (html, headings) where headings are (level, slug, text)."""
    md = MarkdownIt("commonmark", {"html": False, "linkify": True}).enable("table")
    tokens = md.parse(md_text)
    for passthrough in PASSTHROUGHS:
        tokens = passthrough(tokens)
    # Not in PASSTHROUGHS: that list is token passes of one argument, and this
    # one is parameterised by the document's declared state set.
    tokens = task_list_controls(tokens, states)
    tokens = priority_tags(tokens)

    preamble, sections = split_sections(tokens)
    preamble = gather_lower(preamble)
    sections = [gather_lower(s) for s in sections]
    digests = [section_hash(md, s) for s in sections]

    headings: list[tuple[int, str, str]] = []
    used: set[str] = set()
    for i, tok in enumerate(flat := preamble + [t for s in sections for t in s]):
        if tok.type != "heading_open":
            continue
        level = int(tok.tag[1])
        if level > 3:
            continue
        text = flat[i + 1].content
        slug = _allocate_id(slugify(text), used)
        tok.attrSet("id", slug)
        headings.append((level, slug, text))

    # The page tools sit right under the title when the page opens with one.
    tools = _details_html_token(PAGE_TOOLS)
    at = 0
    if len(preamble) >= 3 and preamble[0].type == "heading_open" and preamble[0].tag == "h1":
        at = 3
    out = preamble[:at] + [tools] + preamble[at:]
    for section, digest in zip(sections, digests):
        out += _section_tokens(section, section[0].attrGet("id"), digest)

    return md.renderer.render(out, md.options, {}), headings


def toc_html(headings: list[tuple[int, str, str]]) -> str:
    if not headings:
        return ""
    rows = [
        f'<a href="#{slug}" class="lvl{level}">{html.escape(text)}</a>'
        for level, slug, text in headings
        if level >= 2
    ]
    if not rows:
        return ""
    return '<nav class="toc" aria-label="Contents"><h4>Contents</h4>' + "".join(rows) + "</nav>"


def build(
    md_text: str, *, title: str, with_toc: bool, key: str, states: list[str] | None = None
) -> str:
    body, headings = render(md_text, states)
    toc = toc_html(headings) if with_toc else ""
    shell_open = '<div class="shell has-toc">' if toc else '<div class="shell">'
    page = TEMPLATE.format(
        title=html.escape(title),
        toc=toc,
        shell_open=shell_open,
        body=body,
    )
    return page + REVIEW_ASSETS + _annotation_layer.layer_html(key)


