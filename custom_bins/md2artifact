<div class="doc">
{body}
</div>
</div>

<script>
const tocLinks = Array.from(document.querySelectorAll(".toc a"));
const targets = tocLinks
  .map((a) => ({{ a, el: document.getElementById(a.getAttribute("href").slice(1)) }}))
  .filter((t) => t.el);
if ("IntersectionObserver" in window && targets.length) {{
  const io = new IntersectionObserver((entries) => {{
    entries.forEach((e) => {{
      if (!e.isIntersecting) return;
      const hit = targets.find((t) => t.el === e.target);
      if (!hit) return;
      tocLinks.forEach((a) => a.classList.remove("on"));
      hit.a.classList.add("on");
    }});
  }}, {{ rootMargin: "-12% 0px -75% 0px" }});
  targets.forEach((t) => io.observe(t.el));
}}
</script>
"""



def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("source", type=Path, help="Markdown file to wrap")
    ap.add_argument("-o", "--output", type=Path, help="output HTML (default: <source>.review.html)")
    ap.add_argument("--title", help="page title (default: first H1, else the filename stem)")
    ap.add_argument("--no-toc", action="store_true", help="omit the table of contents")
    ap.add_argument(
        "--key",
        help="localStorage key for comments (default: derived from the filename, "
        "qualified by the parent directory for a generic stem like spec.md, so "
        "republishing the same document keeps its comments and two specs never share them)",
    )
    args = ap.parse_args(argv)

    if not args.source.is_file():
        ap.error(f"no such file: {args.source}")
    text = args.source.read_text(encoding="utf-8")

    title = args.title
    if not title:
        m = re.search(r"^#\s+(.+)$", text, re.MULTILINE)
        title = m.group(1).strip() if m else args.source.stem

    out = args.output or args.source.with_suffix(".review.html")
    key = args.key or storage_key(args.source)
    if not args.key and key != f"review-{slugify(args.source.stem)}":
        print(
            f"md2artifact: comment key qualified by directory: {key} "
            "(a page published before 2026-09-02 from this filename keeps its "
            f"comments only with --key review-{slugify(args.source.stem)})",
            file=sys.stderr,
        )
    out.write_text(
        build(text, title=title, with_toc=not args.no_toc, key=key), encoding="utf-8"
    )
    print(out)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
