#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# ///
"""Flip a coin at the start of a long break and assign what the break is for.

    reward              # flip, then print the assigned break and what it may be swapped for
    reward list         # print both lists and the swap rules
    reward --seed 7     # deterministic flip (tests, or re-showing a result)

Heads (50%) is a high-stimulation reward, tails (50%) a dry restoration break.
Each side assigns one option at random. On heads the assigned reward may only
be swapped for an option listed above it in HEADS; on tails any dry option may
be chosen instead. The rules come from the "Dopamine Framework" Bear note.

reward never changes blocking state: it does not call `focus` or touch Cold
Turkey. Unlock anything a heads result needs by hand.
"""

import argparse
import os
import random
import sys

# Order matters: an assigned heads reward may be swapped only for an option
# listed ABOVE it (closer to index 0). Edit the order to change what "higher" means.
HEADS = ["messages", "Slack", "social media", "book", "shows or videos"]
TAILS = ["nap", "stretch", "walk", "snack"]


def flip(rng: random.Random) -> dict:
    """Return the side, the assigned option and the options it may be swapped for."""
    if rng.random() < 0.5:
        i = rng.randrange(len(HEADS))
        return {"side": "heads", "assigned": HEADS[i], "swaps": HEADS[:i]}
    assigned = rng.choice(TAILS)
    return {
        "side": "tails",
        "assigned": assigned,
        "swaps": [t for t in TAILS if t != assigned],
    }


EMOJI = {
    "messages": "💬",
    "Slack": "💼",
    "social media": "📱",
    "book": "📖",
    "shows or videos": "📺",
    "nap": "😴",
    "stretch": "🧘",
    "walk": "🚶",
    "snack": "🍎",
}

# ANSI styles. Colour only on a terminal, never when NO_COLOR is set
# (https://no-color.org); FORCE_COLOR turns it on for pipes.
STYLE = {
    "heads": "\033[1;35m",  # bold magenta
    "tails": "\033[1;32m",  # bold green
    "bold": "\033[1m",
    "dim": "\033[2m",
}
RESET = "\033[0m"


def use_colour() -> bool:
    if os.environ.get("NO_COLOR"):
        return False
    return bool(os.environ.get("FORCE_COLOR")) or sys.stdout.isatty()


def paint(text: str, style: str, colour: bool) -> str:
    return f"{STYLE[style]}{text}{RESET}" if colour else text


def label(option: str) -> str:
    return f"{EMOJI.get(option, '•')} {option}"


def render(result: dict, colour: bool = False) -> str:
    side = result["side"]
    assigned = paint(label(result["assigned"]), "bold", colour)
    if side == "heads":
        head = (
            paint("🪙 HEADS", "heads", colour)
            + f"  high-stimulation reward → {assigned}"
        )
        swaps = (
            ", ".join(label(s) for s in result["swaps"])
            if result["swaps"]
            else "none (already the top option)"
        )
        swap_line = f"⬆️  May swap up to: {swaps}"
    else:
        head = paint("🌿 TAILS", "tails", colour) + f"  dry restoration → {assigned}"
        swap_line = (
            f"🔄 Or choose freely: {', '.join(label(s) for s in result['swaps'])}"
        )
    buffer = paint(
        "⏳ Last 5 minutes: phone away, close loops, water, open only the next block's file.",
        "dim",
        colour,
    )
    return f"{head}\n{swap_line}\n{buffer}"


def render_list(colour: bool = False) -> str:
    heads = "\n".join(f"  {n}. {label(h)}" for n, h in enumerate(HEADS, 1))
    tails = "\n".join(f"  - {label(t)}" for t in TAILS)
    return (
        paint("🪙 Heads", "heads", colour)
        + " (high-stimulation; swap only to a lower number):\n"
        f"{heads}\n"
        + paint("🌿 Tails", "tails", colour)
        + " (dry restoration; choose any):\n"
        f"{tails}"
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="reward",
        description="Coin-flip a long break: heads = high-stimulation reward, tails = dry restoration.",
    )
    parser.add_argument("command", nargs="?", choices=["flip", "list"], default="flip")
    parser.add_argument(
        "--seed", type=int, help="seed the flip for a reproducible result"
    )
    args = parser.parse_args(argv)
    colour = use_colour()
    if args.command == "list":
        print(render_list(colour))
        return 0
    print(render(flip(random.Random(args.seed)), colour))
    return 0


if __name__ == "__main__":
    sys.exit(main())
