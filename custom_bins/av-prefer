#!/usr/bin/env zsh
# av-prefer — make the Studio Display the default camera, and the speakers
# AirPods when connected, else the Studio Display. Sibling of builtin-display:
# with the lid open, macOS hands apps the MacBook camera first.
#
#   av-prefer            same as status
#   av-prefer status     show the default camera and speaker
#   av-prefer apply      set both to the first present device in CAMERAS and
#                        SPEAKERS at the top of this script
#   av-prefer --help
#
# Camera: tools/av-prefer/main.swift sets AVCaptureDevice.userPreferredCamera,
# which changes the default every app sees; Apple documents it as persisting
# across reboots, and it is meant to win again when the display returns. An app
# that saved its own choice (Zoom, a Chrome site, FaceTime's Video menu) keeps
# it. Speaker: SwitchAudioSource (switchaudio-osx, in the Brewfile) sets the
# output device only; alert sounds and the microphone are left alone.
set -euo pipefail

# Priority lists: the first present device wins. Case-insensitive substrings.
CAMERAS=("Studio Display Camera" "MacBook Pro Camera")
SPEAKERS=("AirPods" "Studio Display Speakers" "MacBook Pro Speakers")

if [[ $OSTYPE != darwin* ]]; then
    print -u2 "av-prefer: macOS only"
    exit 1
fi

SELF="${0:A}"
DOT_DIR="${SELF:h:h}"
SRC="${DOT_DIR}/tools/av-prefer/main.swift"
BIN="${DOT_DIR}/tools/av-prefer/av-prefer"

paint() {  # paint <colour> <text>: coloured only on a terminal without NO_COLOR
    if [[ -t 1 && -z ${NO_COLOR:-} ]]; then print -nP "%F{$1}$2%f"; else print -nr -- "$2"; fi
}

usage() { sed -n '2,17p' "$SELF" | sed 's/^# \{0,1\}//'; }

camera() {  # camera <args…>: run the Swift helper, compiling it when stale
    if [[ ! -x $BIN || $SRC -nt $BIN ]]; then
        command -v swiftc >/dev/null 2>&1 || { print -u2 "av-prefer: swiftc not found (xcode-select --install)"; exit 1; }
        swiftc -O -o "$BIN" "$SRC" || { print -u2 "av-prefer: compile failed"; exit 1; }
    fi
    "$BIN" "$@"
}

need_sas() {
    command -v SwitchAudioSource >/dev/null 2>&1 \
        || { print -u2 "av-prefer: SwitchAudioSource not found (brew install switchaudio-osx)"; exit 1; }
}

pick_speaker() {  # print the first present output device matching SPEAKERS
    local want dev
    local -a present=("${(@f)$(SwitchAudioSource -a -t output)}")
    for want in "${SPEAKERS[@]}"; do
        for dev in "${present[@]}"; do
            [[ ${dev:l} == *${want:l}* ]] && { print -r -- "$dev"; return 0; }
        done
    done
    return 1
}

# show <label> <current> <preferred>: green when they agree, yellow otherwise
show() {
    printf '%-8s ' "$1"
    if [[ $2 == "$3" ]]; then paint green "$2"; print " (preferred)"
    else paint yellow "$2"; print " (preferred: $3 — run av-prefer apply)"; fi
}

status() {
    need_sas
    local cam spk
    cam=$(camera status)
    spk=$(SwitchAudioSource -c -t output)
    show camera "$cam" "$(camera pick "${CAMERAS[@]}" 2>/dev/null || print -r -- "$cam")"
    show speaker "$spk" "$(pick_speaker || print -r -- "$spk")"
}

apply() {
    need_sas
    local cam spk
    cam=$(camera set "${CAMERAS[@]}")
    print -n "camera   "; paint green "$cam"; print
    if spk=$(pick_speaker); then
        SwitchAudioSource -t output -s "$spk" >/dev/null
        print -n "speaker  "; paint green "$spk"; print
    else
        print -n "speaker  "; paint yellow "no match for: ${(j:, :)SPEAKERS} — left as is"; print
    fi
}

case ${1:-status} in
    status) status ;;
    apply) apply ;;
    -h|--help|help) usage ;;
    *) print -u2 "usage: av-prefer [status|apply|--help]"; exit 2 ;;
esac
