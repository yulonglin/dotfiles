#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# ///
"""Render config/model-router.toml into the router, the picker and the agent files.

One source, three outputs, one command:

  model-router-wire apply [--check] [--no-restart]
      config/model-router.toml  ->  ~/.config/model-router/config.toml (routes)
                                ->  ~/.config/model-router/managed-settings.json
                                    (staged: gateway env keys + modelPicker rows)
                                ->  claude/agents/<id>.md (generated, marked)
      then `service restart` and a doctor summary. --check renders in memory and
      exits 1 if any output differs from what is on disk (nothing written).
  model-router-wire off
      strip the gateway keys from ~/.claude/settings.json, drop the staged file
      and print the sudo line that removes the managed one (direct Anthropic
      again; routes and agent files stay, `apply` re-stages, and a passthrough
      Claude row goes with the rest, though its ID still works via /model)
  model-router-wire status
      what is live, and whether the rendered files drift from the source

The gateway keys live in a MANAGED settings drop-in, not in the user file:
  macOS  /Library/Application Support/ClaudeCode/managed-settings.d/50-model-router.json
  Linux  /etc/claude-code/managed-settings.d/50-model-router.json
Managed settings outrank every other level, so every session on the machine
gets the gateway whoever launched it (terminal, IDE extension, desktop app,
the background-job daemon), and ~/.claude/settings.json -- symlinked into the
public dotfiles repo -- never carries the per-install ingress token, so it is
always committable. Writing under the system directory needs root, so `apply`
stages the file under ~/.config/model-router/ and prints the one sudo line;
it only strips the keys from the user file once the managed copy matches the
staged one, so no session is ever without the gateway in between. Requires
the model-router plugin (the base URL comes from `bootstrap.sh doctor --json`).
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import platform
import re
import shlex
import subprocess
import sys
import time
import tomllib
from pathlib import Path

REPO = Path(os.environ.get("MODEL_ROUTER_REPO", Path(__file__).resolve().parent.parent))
SOURCE = Path(os.environ.get("MODEL_ROUTER_SOURCE", REPO / "config" / "model-router.toml"))
AGENTS_DIR = Path(os.environ.get("MODEL_ROUTER_AGENTS", REPO / "claude" / "agents"))
SETTINGS = Path(os.environ.get("CLAUDE_SETTINGS", Path.home() / ".claude" / "settings.json"))
ROUTER_CONFIG = Path(os.environ.get("MODEL_ROUTER_CONFIG", Path.home() / ".config" / "model-router" / "config.toml"))
DARWIN = platform.system() == "Darwin"
MANAGED_DIR = Path("/Library/Application Support/ClaudeCode/managed-settings.d") if DARWIN else Path("/etc/claude-code/managed-settings.d")
# The managed drop-in Claude Code reads (root-owned), and the user-owned copy
# `apply` renders for the sudo step to install from.
MANAGED = Path(os.environ.get("MODEL_ROUTER_MANAGED", MANAGED_DIR / "50-model-router.json"))
STAGED = Path(os.environ.get("MODEL_ROUTER_STAGED", Path.home() / ".config" / "model-router" / "managed-settings.json"))
ROOT_GROUP = "wheel" if DARWIN else "root"
MARKER = "<!-- generated by model-router-wire from config/model-router.toml; edit that file, not this one -->"
# Keys the managed file owns. The user file must carry none of the first two
# (they embed the token and turn the gateway on); the other two are plain
# settings that may also sit in the committed user file, and the managed value
# wins where both exist.
GATEWAY_ENV = ("ANTHROPIC_BASE_URL", "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL")
MANAGED_ENV = GATEWAY_ENV + ("ENABLE_TOOL_SEARCH", "CLAUDE_CODE_MAX_CONTEXT_TOKENS")
# Stripped from the user file: the gateway keys plus the single-slot custom
# model option the pre-2026-09 wiring used.
USER_STRIP_ENV = GATEWAY_ENV + ("ANTHROPIC_CUSTOM_MODEL_OPTION", "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME")
CLAUDE_ALIASES = {"sonnet", "opus", "haiku", "fable", "inherit"}
# A Claude model the router forwards to Anthropic unchanged: a picker row and
# nothing else (no route, no agent file). Claude Code hides its own legacy rows
# on the first-party provider, so this is how an older Claude gets into /model.
PASSTHROUGH = "anthropic"


# ---- source --------------------------------------------------------------

def load_source() -> dict:
    if not SOURCE.exists():
        sys.exit(f"no source file at {SOURCE}")
    src = tomllib.loads(SOURCE.read_text())
    models = src.get("models", [])
    if not models:
        sys.exit(f"{SOURCE} declares no [[models]]")
    seen: set[str] = set()
    providers = src.get("providers", {})
    for m in models:
        passthrough = m.get("provider") == PASSTHROUGH
        for key in ("id", "name", "provider") + (() if passthrough else ("context-window",)):
            if key not in m:
                sys.exit(f"{SOURCE}: model {m.get('id', '?')} lacks {key!r}")
        aliases = m.get("aliases", [])
        if not isinstance(aliases, list) or not all(isinstance(a, str) and a for a in aliases):
            sys.exit(f"{SOURCE}: model {m['id']}: aliases must be a list of non-empty strings")
        if passthrough and aliases:
            sys.exit(f"{SOURCE}: model {m['id']}: provider {PASSTHROUGH!r} takes no aliases (the router serves no route for it, so an alias would reach nobody)")
        if passthrough and m.get("agent", False):
            sys.exit(f"{SOURCE}: model {m['id']}: provider {PASSTHROUGH!r} takes no agent (put the Claude ID on an agent file's model: line directly)")
        for name in ids(m):
            if name in seen:
                sys.exit(f"{SOURCE}: {name!r} is declared twice (an id or alias must be unique)")
            if passthrough and not name.startswith("claude-"):
                sys.exit(f"{SOURCE}: {name!r}: provider {PASSTHROUGH!r} takes a Claude model ID (claude-...)")
            if not passthrough and (name in CLAUDE_ALIASES or name.startswith("claude-")):
                sys.exit(f"{SOURCE}: {name!r} would shadow a Claude model name")
            seen.add(name)
        if passthrough:
            continue
        if m["provider"] != "codex" and m["provider"] not in providers:
            sys.exit(f"{SOURCE}: model {m['id']} names provider {m['provider']!r} with no [providers.{m['provider']}] block")
        if m["provider"] != "codex" and "base-url" not in providers[m["provider"]]:
            sys.exit(f"{SOURCE}: [providers.{m['provider']}] lacks base-url")
    return src


def enabled(src: dict) -> list[dict]:
    return [m for m in src["models"] if m.get("enabled", True)]


def routed(models: list[dict]) -> list[dict]:
    """The models the router serves a route for: everything but passthrough Claude rows."""
    return [m for m in models if m["provider"] != PASSTHROUGH]


def ids(m: dict) -> list[str]:
    """Every routing ID the router serves for this model: the id plus its aliases."""
    return [m["id"], *m.get("aliases", [])]


def canonical(m: dict) -> str:
    """The name a person types: the first alias when there is one, else the id."""
    aliases = m.get("aliases", [])
    return aliases[0] if aliases else m["id"]


def effort_of(m: dict) -> str | None:
    a = m.get("agent", True)
    if a is False or m["provider"] == PASSTHROUGH:
        return None
    return a if isinstance(a, str) else ""


# ---- renderers -----------------------------------------------------------

def render_router_config(src: dict) -> str:
    out = [
        "# Generated by model-router-wire from config/model-router.toml in the dotfiles",
        "# repo; edits here are overwritten on the next `model-router-wire apply`.",
        "",
    ]
    declared = src.get("declared-context-window")
    if declared:
        out += [f"declared-context-window = {declared}", ""]
    for m in enabled(src):
        if m["provider"] != "codex":
            continue
        for rid in ids(m):
            out += [
                "[[models]]",
                f'routing-id = "{rid}"',
                'upstream = "cliproxy"',
                f'upstream-model = "{m.get("slug", m["id"])}"',
                f'display-name = "{m["name"]}"',
                f"context-window = {m['context-window']}",
                "",
            ]
    for name, block in src.get("providers", {}).items():
        members = [m for m in enabled(src) if m["provider"] == name]
        if not members:
            continue
        out += ["[[openai-providers]]", f'name = "{name}"', f'base-url = "{block["base-url"]}"', ""]
        for m in members:
            for rid in ids(m):
                out += [
                    "[[openai-providers.models]]",
                    f'name = "{m.get("slug", m["id"])}"',
                    f'routing-id = "{rid}"',
                    f'display-name = "{m["name"]}"',
                    "context-window-scaling = true",
                    f"context-window = {m['context-window']}",
                    "",
                ]
    return "\n".join(out).rstrip("\n") + "\n"


def render_agent(m: dict) -> str:
    effort = effort_of(m)
    short = canonical(m)
    name = f"{short}({effort})" if effort else short
    via = "the OpenAI account (Codex OAuth)" if m["provider"] == "codex" else m["provider"]
    lines = [
        "---",
        f"name: {name}",
        f"description: General-purpose agent driven by {m['name']}{' at ' + effort + ' reasoning effort' if effort else ''} through the model-router gateway via {via}. Use for a task that should be done by this model inside the Claude Code loop with repo tools.",
        f"model: {short}",
    ]
    if effort:
        lines.append(f"effort: {effort}")
    lines += ["---", MARKER, "Complete the task you are given.", ""]
    return "\n".join(lines)


def agent_path(m: dict) -> Path:
    effort = effort_of(m)
    short = canonical(m)
    return AGENTS_DIR / (f"{short}-{effort}.md" if effort else f"{short}.md")


def generated_agent_files() -> list[Path]:
    return [p for p in sorted(AGENTS_DIR.glob("*.md")) if MARKER in p.read_text()]


def render_managed(src: dict, base_url: str) -> dict:
    """The managed drop-in: only the keys the gateway needs, nothing personal."""
    env = {
        "ANTHROPIC_BASE_URL": base_url,
        "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1",
        "ENABLE_TOOL_SEARCH": "true",
    }
    declared = src.get("declared-context-window")
    if declared:
        env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = str(declared)
    return {
        "env": env,
        "modelPicker": {"options": [{"model": canonical(m), "label": m["name"]} for m in enabled(src) if m.get("picker", True)]},
    }


def strip_user_settings(settings: dict) -> tuple[dict, list[str]]:
    """The user file with the gateway keys and picker rows removed; names what went."""
    new = json.loads(json.dumps(settings))
    env = new.get("env", {})
    removed = [k for k in USER_STRIP_ENV if env.pop(k, None) is not None]
    if new.pop("modelPicker", None) is not None:
        removed.append("modelPicker")
    return new, removed


def user_carries_gateway(settings: dict) -> bool:
    env = settings.get("env", {})
    return any(k in env for k in GATEWAY_ENV) or "modelPicker" in settings


def managed_installed(want: dict) -> bool:
    """True when the root-owned drop-in exists and equals the rendered content."""
    try:
        return json.loads(MANAGED.read_text()) == want
    except (OSError, json.JSONDecodeError):
        return False


def sudo_install_line() -> str:
    q = shlex.quote
    return f"sudo install -d -m 0755 {q(str(MANAGED.parent))} && sudo install -m 0644 -o root -g {ROOT_GROUP} {q(str(STAGED))} {q(str(MANAGED))}"


def sudo_remove_line() -> str:
    return f"sudo rm -f {shlex.quote(str(MANAGED))}"


# ---- plumbing ------------------------------------------------------------

def bootstrap() -> str:
    override = os.environ.get("MODEL_ROUTER_BOOTSTRAP")
    if override:
        return override
    hits = sorted(glob.glob(str(Path.home() / ".claude/plugins/cache/alignment-hive/model-router/*/scripts/bootstrap.sh")))
    if not hits:
        sys.exit("model-router plugin not installed: claude plugin install model-router@alignment-hive --scope user")
    return hits[-1]


def doctor() -> dict:
    out = subprocess.run([bootstrap(), "doctor", "--json"], capture_output=True, text=True, check=False)
    try:
        return json.loads(out.stdout)
    except json.JSONDecodeError:
        sys.exit(f"doctor --json did not return JSON:\n{out.stdout[-800:]}\n{out.stderr[-800:]}")


def base_url_from(d: dict) -> str:
    url = d.get("base_url")
    if not url or not url.startswith("http://127.0.0.1"):
        sys.exit(f"doctor returned no loopback base URL: {url!r}")
    return url


def load_settings() -> dict:
    if not SETTINGS.exists():
        sys.exit(f"no settings file at {SETTINGS}")
    return json.loads(SETTINGS.read_text())


def dump_settings(settings: dict) -> str:
    return json.dumps(settings, indent=2, ensure_ascii=False) + "\n"


def restart_and_report() -> int:
    subprocess.run([bootstrap(), "service", "restart"], check=False)
    # the managed CLIProxyAPI child takes a few seconds to come up after a restart
    for _ in range(15):
        d = doctor()
        router = next((c for c in d.get("checks", []) if c["name"] == "router"), None)
        if router and router.get("ok"):
            break
        time.sleep(2)
    bad = [c["name"] for c in d.get("checks", []) if not c.get("ok")]
    print("doctor: " + ("every check green" if not bad else "failing: " + ", ".join(bad)))
    for c in d.get("checks", []):
        if not c.get("ok"):
            print(f"  [{c['name']}] {c.get('detail', '')}")
    return 1 if bad else 0


# ---- commands ------------------------------------------------------------

def known_base_url(settings: dict) -> str | None:
    """The base URL --check compares against without calling doctor: the staged
    file (what the last apply rendered from doctor) or, before any apply, the
    user file. Never the managed drop-in itself, or a tampered one would be
    compared against its own contents and pass."""
    try:
        url = json.loads(STAGED.read_text()).get("env", {}).get("ANTHROPIC_BASE_URL")
        if url:
            return url
    except (OSError, json.JSONDecodeError, AttributeError):
        pass
    return settings.get("env", {}).get("ANTHROPIC_BASE_URL")


def cmd_apply(args: argparse.Namespace) -> int:
    src = load_source()
    settings = load_settings()
    known = known_base_url(settings)
    base_url = known if (args.check and known) else base_url_from(doctor())
    want_router = render_router_config(src)
    want_managed = render_managed(src, base_url)
    want_managed_text = dump_settings(want_managed)
    want_agents = {agent_path(m): render_agent(m) for m in enabled(src) if effort_of(m) is not None}
    stale_agents = [p for p in generated_agent_files() if p not in want_agents]
    installed = managed_installed(want_managed)

    drift: list[str] = []
    if not ROUTER_CONFIG.exists() or ROUTER_CONFIG.read_text() != want_router:
        drift.append(str(ROUTER_CONFIG))
    if not installed:
        drift.append(f"{MANAGED} ({'differs from the rendered drop-in' if MANAGED.exists() else 'not installed'}; run: model-router-wire apply, then the sudo line it prints)")
    elif user_carries_gateway(settings):
        drift.append(f"{SETTINGS} (still carries gateway keys or modelPicker rows; run: model-router-wire apply)")
    for p, text in want_agents.items():
        if not p.exists() or p.read_text() != text:
            drift.append(str(p))
    drift += [f"{p} (stale generated agent)" for p in stale_agents]

    if args.check:
        if drift:
            print("drift from config/model-router.toml:")
            for d in drift:
                print(f"  {d}")
            return 1
        print("rendered files match config/model-router.toml")
        return 0

    ROUTER_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    ROUTER_CONFIG.write_text(want_router)
    STAGED.parent.mkdir(parents=True, exist_ok=True)
    STAGED.write_text(want_managed_text)
    STAGED.chmod(0o600)
    AGENTS_DIR.mkdir(parents=True, exist_ok=True)
    for p, text in want_agents.items():
        p.write_text(text)
    for p in stale_agents:
        p.unlink()
    rows = [canonical(m) for m in enabled(src) if m.get("picker", True)]
    print(f"routes:  {', '.join(rid for m in routed(enabled(src)) for rid in ids(m))}")
    print(f"picker:  {', '.join(rows) or 'none'}")
    print(f"agents:  {', '.join(p.name for p in want_agents) or 'none'}" + (f"; removed {', '.join(p.name for p in stale_agents)}" if stale_agents else ""))
    print(f"wrote {ROUTER_CONFIG}, {STAGED}")

    # Two phases, so no session is ever without the gateway: the user file keeps
    # its keys until the root-owned drop-in matches what was just staged.
    if installed:
        stripped, removed = strip_user_settings(settings)
        if removed:
            SETTINGS.write_text(dump_settings(stripped))
            print(f"managed drop-in matches; removed {', '.join(removed)} from {SETTINGS} (it is committable again)")
        else:
            print(f"managed drop-in {MANAGED} is current")
    else:
        print(f"managed drop-in {'differs from the staged file' if MANAGED.exists() else 'not installed'}. Install it as root:")
        print(f"  {sudo_install_line()}")
        if user_carries_gateway(settings):
            print(f"then rerun `model-router-wire apply` to strip the keys from {SETTINGS}")
        else:
            print(f"WARNING: {SETTINGS} carries no gateway keys either, so sessions run direct to Anthropic until the sudo step")
        print("after installing, start a fresh session and check /status names 'Enterprise managed settings (drop-ins)' -- or '(file + drop-ins)' if a managed-settings.json sits beside it -- and /model lists the routed rows")
    print("restart Claude Code sessions to see the rows")
    if args.no_restart:
        return 0
    return restart_and_report()


def cmd_off(_: argparse.Namespace) -> int:
    settings = load_settings()
    stripped, removed = strip_user_settings(settings)
    served = {rid for m in routed(load_source()["models"]) for rid in ids(m)} if SOURCE.exists() else set()
    if stripped.get("model") in served:
        print(f"dropped default model {stripped.pop('model')!r}: Anthropic does not serve it")
        removed.append("model")
    SETTINGS.write_text(dump_settings(stripped))
    if STAGED.exists():
        STAGED.unlink()
    print(f"unwired {SETTINGS}: removed {', '.join(removed) or 'nothing'}; staged file removed")
    if MANAGED.exists():
        print("the managed drop-in still turns the gateway on for every session. Remove it as root:")
        print(f"  {sudo_remove_line()}")
    print("routes and agent files are untouched (an agent naming a routed ID now fails on first use); `apply` re-wires")
    return 0


def cmd_status(_: argparse.Namespace) -> int:
    settings = load_settings()
    managed: dict = {}
    try:
        managed = json.loads(MANAGED.read_text())
    except (OSError, json.JSONDecodeError):
        pass
    url = managed.get("env", {}).get("ANTHROPIC_BASE_URL")
    rows = [o["model"] for o in managed.get("modelPicker", {}).get("options", [])]
    print(f"source:   {SOURCE}")
    print(f"managed:  {MANAGED} ({'installed' if managed else 'not installed'}; staged copy {'present' if STAGED.exists() else 'absent'} at {STAGED})")
    print(f"gateway:  {'wired to ' + url.split('/t/')[0] + '/t/<token>' if url else 'not wired (direct Anthropic)'}")
    print(f"picker:   {', '.join(rows) if rows else 'no modelPicker rows'}")
    if user_carries_gateway(settings):
        print(f"WARNING:  {SETTINGS} still carries gateway keys or modelPicker rows (not committable); `apply` strips them once the managed drop-in matches")
    if SOURCE.exists():
        src = load_source()
        print(f"routes:   {', '.join(rid for m in routed(enabled(src)) for rid in ids(m))}")
        off = [m["id"] for m in src["models"] if not m.get("enabled", True)]
        if off:
            print(f"disabled: {', '.join(off)}")
        print(f"agents:   {', '.join(p.name for p in generated_agent_files()) or 'none generated'}")
    ns = argparse.Namespace(check=True, no_restart=True)
    return cmd_apply(ns) if SOURCE.exists() else 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)
    ap = sub.add_parser("apply", help="render the source into router config, settings and agent files")
    ap.add_argument("--check", action="store_true", help="report drift and exit 1; write nothing")
    ap.add_argument("--no-restart", action="store_true", help="skip the service restart and doctor")
    ap.set_defaults(fn=cmd_apply)
    sub.add_parser("off", help="remove the settings keys and picker rows").set_defaults(fn=cmd_off)
    sub.add_parser("status", help="show what is live and any drift").set_defaults(fn=cmd_status)
    args = parser.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
