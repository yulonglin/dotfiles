def paint(text: str, sgr: str, stream=None) -> str:
    """ANSI colour for a terminal; plain text when piped (Alfred) or when NO_COLOR is set.
    Pass stream=sys.stderr for text bound for stderr, such as a sys.exit message."""
    if not (stream or sys.stdout).isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{sgr}m{text}\033[0m"


def by_agent() -> bool:
    # Claude Code sets CLAUDECODE=1 in every shell it runs.
    return os.environ.get("CLAUDECODE") == "1"


def gate(cfg: dict, request: str, why: str) -> None:
    """Make an agent wait before it loosens blocking; return only when it may go ahead.

    The first call queues the exact request and exits; the same call repeated after
    the delay runs it. A person running focus is never delayed: Cold Turkey and
    ScreenZen already give them their own friction. This is a speed bump, not a
    lock: an agent that edits this file or the queue gets past it.
    """
    if not by_agent():
        return
    delay = int(cfg.get("agent_loosen_delay_minutes", DEFAULT_DELAY_MIN))
    now = time.time()
    try:
        pending = json.loads(PENDING.read_text())
    except (FileNotFoundError, ValueError):
        pending = {}
    pending = {k: v for k, v in pending.items() if now < v + EXPIRE_S}
    due = pending.get(request)
    if due is not None and now >= due:
        del pending[request]
        PENDING.write_text(json.dumps(pending))
        return
    if due is None:
        due = now + delay * 60
        pending[request] = due
        PENDING.parent.mkdir(parents=True, exist_ok=True)
        PENDING.write_text(json.dumps(pending))
    at = dt.datetime.fromtimestamp(due).strftime("%H:%M:%S")
    print(
        f"focus: {why}. An agent's loosening waits {delay} min: queued; "
        f"run the same command again after {at} to apply it."
    )
    sys.exit(3)


def load_config(path: Path) -> dict:
    text = path.read_text()
    if path.suffix == ".md":
        m = re.search(r"^```ya?ml\n(.*?)^```", text, re.S | re.M)
        if not m:
            sys.exit(f"focus: no ```yaml block in {path}")
        text = m.group(1)
    cfg = yaml.safe_load(text) or {}
    problems = []
    unknown = set(cfg) - {
        "groups",
        "always_allow",
        "modes",
        "blocklists",
        "timers",
        "agent_loosen_delay_minutes",
        "off_hours",
        "break_max_minutes",
        "break_every_minutes",
        "no_mode_allow",
        "only",
        "overlaps",
        "strong_lock_blocks",
        "capped_modes",
        "commit_wait_minutes",
        "commit_text_chars",
        "emergency_text_chars",
        "default_mode",
        "scheduled_mode",
        "windows",
    }
    if unknown:
        problems.append(f"unknown top-level keys: {sorted(unknown)}")
    for span in cfg.get("windows") or []:
        if not re.fullmatch(
            r"([01]\d|2[0-3]):[0-5]\d-([01]\d|2[0-3]):[0-5]\d", str(span)
        ):
            problems.append(f"windows: {span!r} is not 'HH:MM-HH:MM'")
    ov = cfg.get("overlaps")
    if ov is not None and not (
        isinstance(ov, dict) and all(isinstance(v, str) and v for v in ov.values())
    ):
        problems.append("'overlaps' must map each site to a one-line reason")
    # A one-minute lock would run out between two once-a-minute ticks.
    for key, low in (
        ("commit_wait_minutes", 2),
        ("commit_text_chars", 1),
        ("emergency_text_chars", 1),
    ):
        if key in cfg and not (isinstance(cfg[key], int) and cfg[key] >= low):
            problems.append(f"'{key}' must be a whole number >= {low}")
    for name in [*(cfg.get("modes") or {}), *(cfg.get("timers") or {})]:
        if name in ("allow", "end"):
            problems.append(f"{name!r} is taken by the command 'focus {name}'")
    strong = cfg.get("strong_lock_blocks")
    if strong is not None and not (
        isinstance(strong, list) and all(isinstance(n, str) and n for n in strong)
    ):
        problems.append(
            "'strong_lock_blocks' must be a list of Cold Turkey block names"
        )
    for span in cfg.get("off_hours") or []:
        if not re.fullmatch(r"\d\d:\d\d-\d\d:\d\d", str(span)):
            problems.append(f"off_hours entry {span!r} must look like '22:00-23:15'")
    groups = cfg.setdefault("groups", {})
    for name, g in groups.items():
        if set(g or {}) - {"sites", "apps"}:
            problems.append(f"group {name!r} may only have 'sites' and 'apps'")
    refs = [
        ("always_allow", cfg.get("always_allow") or []),
        ("no_mode_allow", cfg.get("no_mode_allow") or []),
    ]
    for name, mode in (cfg.get("modes") or {}).items():
        if set(mode or {}) - {"allow", "block", "kind"}:
            problems.append(f"mode {name!r} may only have 'allow', 'block' and 'kind'")
        if (mode or {}).get("kind", "allowlist") not in ("allowlist", "blocklist"):
            problems.append(f"mode {name!r}: 'kind' must be allowlist or blocklist")
        refs += [
            (f"mode {name}", (mode.get("allow") or []) + (mode.get("block") or []))
        ]
    for app, lists in (cfg.get("blocklists") or {}).items():
        if app not in ("cold_turkey", "screenzen"):
            problems.append(f"blocklists key {app!r} must be cold_turkey or screenzen")
        for name, bl in (lists or {}).items():
            keys = {"block", "allow"} | ({"off_in"} if app == "screenzen" else set())
            if set(bl or {}) - keys:
                problems.append(f"{app} {name!r} may only have {sorted(keys)}")
            for m in bl.get("off_in") or []:
                if m != "none" and m not in (cfg.get("modes") or {}):
                    problems.append(f"{app} {name!r} off_in names unknown mode {m!r}")
            refs += [
                (f"{app} {name}", (bl.get("block") or []) + (bl.get("allow") or []))
            ]
    dm = cfg.get("default_mode")
    if dm is not None:
        hhmm = re.compile(r"^([01]\d|2[0-3]):[0-5]\d$")
        if not isinstance(dm, dict) or set(dm) - {"mode", "start", "until", "days"}:
            problems.append(
                "'default_mode' may only have 'mode', 'start', 'until' and 'days'"
            )
        elif dm.get("mode") not in (cfg.get("modes") or {}) or dm.get("mode") in (
            cfg.get("capped_modes") or {}
        ):
            problems.append("default_mode 'mode' must be a mode with no cap")
        elif not all(hhmm.match(str(dm.get(k, d))) for k, d in DEFAULT_MODE_TIMES):
            problems.append("default_mode 'start' and 'until' must look like '09:00'")
        elif set(dm.get("days") or WEEKDAYS) - set(DAY_NAMES):
            problems.append(f"default_mode 'days' must be among {DAY_NAMES}")
    sm = cfg.get("scheduled_mode")
    if sm is not None:
        hhmm = re.compile(r"^([01]\d|2[0-3]):[0-5]\d$")
        if not isinstance(sm, dict) or set(sm) - {"mode", "start", "until", "days"}:
            problems.append(
                "'scheduled_mode' may only have 'mode', 'start', 'until' and 'days'"
            )
        elif sm.get("mode") not in (cfg.get("capped_modes") or {}):
            problems.append("scheduled_mode 'mode' must be a capped mode")
        elif not all(hhmm.match(str(sm.get(k, ""))) for k in ("start", "until")):
            problems.append("scheduled_mode 'start' and 'until' must look like '21:30'")
        elif not str(sm["start"]) < str(sm["until"]):
            problems.append("scheduled_mode 'start' must come before 'until'")
        elif set(sm.get("days") or DAY_NAMES) - set(DAY_NAMES):
            problems.append(f"scheduled_mode 'days' must be among {DAY_NAMES}")
    capped = cfg.get("capped_modes")
    if capped is not None and not isinstance(capped, dict):
        problems.append("'capped_modes' must map a mode to its limits")
        capped = None
    for name, c in (capped or {}).items():
        cfg["capped_modes"][name] = c = c or {}
        if name not in (cfg.get("modes") or {}):
            problems.append(f"capped_modes names unknown mode {name!r}")
        if not isinstance(c, dict) or set(c) - {"minutes", "day_minutes", "fallback"}:
            problems.append(
                f"capped mode {name!r} may only have 'minutes', 'day_minutes' and 'fallback'"
            )
            continue
        for key in ("minutes", "day_minutes"):
            if key in c and not (isinstance(c[key], int) and c[key] >= 1):
                problems.append(
                    f"capped mode {name!r} {key} must be a whole number >= 1"
                )
        fb = c.get("fallback")
        if fb is not None and (fb in capped or fb not in (cfg.get("modes") or {})):
            problems.append(f"capped mode {name!r} fallback must be a mode with no cap")
    for name, t in (cfg.get("timers") or {}).items():
        if set(t or {}) - {"block", "minutes"}:
            problems.append(f"timer {name!r} may only have 'block' and 'minutes'")
        if name in (cfg.get("modes") or {}):
            problems.append(f"timer {name!r} has the same name as a mode")
        refs += [(f"timer {name}", t.get("block") or [])]
    if "only" in cfg:
        cfg["only"] = cfg["only"] or {}
        if set(cfg["only"]) - {"keep", "minutes", "default"}:
            problems.append("'only' may only have 'keep', 'minutes' and 'default'")
        if ONLY in (cfg.get("modes") or {}) or ONLY in (cfg.get("timers") or {}):
            problems.append(f"{ONLY!r} is taken by the 'only' section")
        refs += [("only keep", cfg["only"].get("keep") or [])]
    for where, names in refs:
        for n in names:
            if n not in groups:
                problems.append(f"{where} names unknown group {n!r}")
    if problems:
        sys.exit(f"focus: {path}:\n  " + "\n  ".join(problems))
    return cfg


def group_items(cfg: dict, names: list[str], kind: str) -> list[str]:
    seen: dict[str, None] = {}
    for n in names:
        for item in cfg["groups"][n].get(kind) or []:
            seen[str(item)] = None
    return list(seen)


def desired_exceptions(cfg: dict, mode: str) -> list[str]:
    names = (cfg.get("always_allow") or []) + (cfg["modes"][mode].get("allow") or [])
    return group_items(cfg, names, "sites")


def is_blocklist(cfg: dict, mode: str) -> bool:
    """A blocklist mode ('kind: blocklist') blocks only the sites of its `block` groups
    and opens the rest of the web; an allowlist mode (the default) blocks '*.*' except
    its `allow` groups. Errands reach an open-ended set of sites, so admin is a
    blocklist; research and writing stay allowlists (Yulong, 2026-11-22). A blocklist
    mode keeps its `allow` list: it still feeds '✅ focus: shared', what no mode lets
    through without a pause."""
    return (cfg["modes"].get(mode) or {}).get("kind") == "blocklist"


def _host_path(pattern: str) -> tuple[str, str]:
    """A site pattern's host, without a scheme or a leading '*.', and its path."""
    p = pattern.split("://", 1)[-1]
    host, _, path = p.partition("/")
    return host.removeprefix("*.").lower(), path


def touches_ban(allowed: str, banned: str) -> bool:
    """Whether an exception for `allowed` could open part of the ban `banned`.

    Cold Turkey matches subdomains and '*' patterns, so this is conservative: the
    hosts touch when they are equal, one sits under the other, or one '*' pattern
    matches the other. The one safe case kept out is a path exception on a parent
    domain ('google.com/travel*') beside a ban on a different subdomain
    ('news.google.com'), since the path cannot open that subdomain's pages."""
    a_host, a_path = _host_path(allowed)
    b_host, _ = _host_path(banned)
    if a_path and b_host != a_host and b_host.endswith("." + a_host):
        return False
    return (
        a_host == b_host
        or a_host.endswith("." + b_host)
        or b_host.endswith("." + a_host)
        or fnmatch.fnmatch(a_host, b_host)
        or fnmatch.fnmatch(b_host, a_host)
    )


def ct_exceptions(cfg: dict, mode: str) -> list[str]:
    """The exceptions of a mode's Cold Turkey block. For a blocklist mode they are
    `always_allow` plus its own `allow` groups (Yulong, 2026-11-26: admin keeps its
    allowed sites), less any allowed site that touches one of its bans, because an
    exception overrides its own block and would undo that ban."""
    if not is_blocklist(cfg, mode):
        return desired_exceptions(cfg, mode)
    keep = group_items(cfg, cfg.get("always_allow") or [], "sites")
    bans = group_items(cfg, cfg["modes"][mode].get("block") or [], "sites")
    for site in group_items(cfg, cfg["modes"][mode].get("allow") or [], "sites"):
        if site not in keep and not any(touches_ban(site, b) for b in bans):
            keep.append(site)
    return keep


def desired_web(cfg: dict, mode: str) -> list[str]:
    """The website list of a mode's Cold Turkey block."""
    if is_blocklist(cfg, mode):
        return group_items(cfg, cfg["modes"][mode].get("block") or [], "sites")
    return [BLOCK_ALL]


def resolve_app(name: str) -> tuple[Path, str] | None:
    """Return the app bundle and its bundle id, or None if it is not installed."""
    for d in APP_DIRS:
        bundle = d / f"{name}.app"
        info = bundle / "Contents/Info.plist"
        if info.exists():
            with info.open("rb") as f:
                bid = plistlib.load(f).get("CFBundleIdentifier")
            if bid:
                return bundle, bid
    return None


def ct_apps(names: list[str]) -> tuple[list[str], list[str]]:
    """Cold Turkey app entries ('app:<Name>.app:<bundle id>') and the names not found."""
    found, missing = [], []
    for name in names:
        r = resolve_app(name)
        if r:
            found.append(f"app:{r[0].name}:{r[1]}")
        else:
            missing.append(name)
    return found, missing


def desired_apps(cfg: dict, mode: str) -> tuple[list[str], list[str]]:
    return ct_apps(group_items(cfg, cfg["modes"][mode].get("block") or [], "apps"))


def overlaps(cfg: dict) -> list[tuple[str, str, str]]:
    """Every (site, mode, block) where a mode allows a site an always-on Cold Turkey block bans.

    A Cold Turkey exception only overrides its own block, so the site stays banned
    in that mode for as long as the always-on block runs.
    """
    out = []
    for bl_name, bl in (cfg.get("blocklists") or {}).get("cold_turkey", {}).items():
        banned = set(group_items(cfg, bl.get("block") or [], "sites"))
        for mode in cfg["modes"]:
            for site in ct_exceptions(cfg, mode):
                if site in banned:
                    out.append((site, mode, bl_name))
    return out


def conflicts(cfg: dict) -> list[str]:
    """Overlaps the note does not list under `overlaps`: likely mistakes."""
    known = cfg.get("overlaps") or {}
    return [
        f"{site!r} is allowed in mode {mode!r} but blocked by {bl!r}"
        for site, mode, bl in overlaps(cfg)
        if site not in known
    ]


def deliberate_overlaps(cfg: dict) -> tuple[list[str], list[str]]:
    """Lines for the overlaps the note lists on purpose, and for listed sites that no longer overlap."""
    known = cfg.get("overlaps") or {}
    found: dict[str, dict[str, list[str]]] = {}
    for site, mode, bl in overlaps(cfg):
        if site in known:
            found.setdefault(site, {}).setdefault(bl, []).append(mode)
    lines = []
    for site, blocks in found.items():
        for bl, modes in blocks.items():
            lines.append(
                f"{site} opens in {', '.join(modes)} only while {bl!r} is off "
                f"or on a break: {known[site]}"
            )
    stale = [site for site in known if site not in found]
    return lines, stale


def decode_settings(value: str) -> dict:
    """Cold Turkey stores its settings as a short tag plus hex bytes shifted by 0x11."""
    for off in range(0, 9):
        h = value[off:]
        h = h[: len(h) // 2 * 2]
        try:
            raw = bytes(
                (int(h[i : i + 2], 16) - 0x11) % 256 for i in range(0, len(h), 2)
            )
            return json.loads(raw.decode())
        except (ValueError, UnicodeDecodeError):
            continue
    raise ValueError("unrecognised Cold Turkey settings encoding")


def read_blocks() -> dict:
    # Copy the database with its WAL so the read sees writes not yet checkpointed.
    with tempfile.TemporaryDirectory() as tmp:
        for suffix in ("", "-wal", "-shm"):
            src = Path(f"{CT_DB}{suffix}")
            if src.exists():
                shutil.copyfile(src, Path(tmp) / f"data-app.db{suffix}")
        con = sqlite3.connect(Path(tmp) / "data-app.db")
        try:
            (value,) = con.execute(
                "select value from settings where key='settings'"
            ).fetchone()
        finally:
            con.close()
    return decode_settings(value)["blocks"]


def ct_send(*args: str) -> None:
    """Give Cold Turkey a command without waiting for the CLI to exit.

    The CLI is the app itself in a second process. It writes its arguments to the
    'commandArgs' preference within 0.1 s, then idles for about 5 s and prints "isn't
    responding". That held for every call timed on 6 Nov 2026, including -help and a
    start that landed 2.2 s in, so the wait is dead time and the reply decides nothing.
    Leaving the CLI running is safe: it does not touch 'commandArgs' on exit.
    """
    subprocess.Popen(
        [str(CT_BIN), *args],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def wake_agent(args: tuple[str, ...]) -> None:
    """Make Cold Turkey's agent read a command the CLI has just left for it.

    'commandArgs' is one slot, not a queue: the agent reads and deletes it when it
    becomes the active app, and nothing else makes it look. A real start landed 0.21 s
    after this activation (6 Nov 2026), and the same call never landed without one.
    Activation goes by pid because the CLI shares the agent's bundle id while it idles,
    and needs no Automation permission. Wait for the slot first, or the agent reads
    nothing. A failure here is not reported: the database says whether the change landed.
    """
    for _ in range(25):
        slot = subprocess.run(
            ["defaults", "read", CT_DEFAULTS, "commandArgs"],
            capture_output=True,
            text=True,
        ).stdout
        if all(a in slot for a in args):
            break
        time.sleep(0.02)
    pid = subprocess.run(
        ["pgrep", "-f", f"{CT_BIN.name} -agent"], capture_output=True, text=True
    ).stdout.split()
    if pid:
        subprocess.run(
            ["osascript", "-l", "JavaScript", "-e", CT_WAKE_JXA % int(pid[0])],
            capture_output=True,
        )


def wait_for(done, polls: int) -> bool:
    """Watch the database at 0.05 s; a read takes about 0.01 s."""
    for _ in range(polls):
        if done():
            return True
        time.sleep(0.05)
    return False


def give_front_back(front: str | None) -> None:
    """Return the front to the app that had it, and wait until it has it. 'open' returns
    first, and a switch applies two commands in a row: the second must read the real
    front, and the agent must have lost it, or it has no activation to read on."""
    if front in (None, CT_BUNDLE, "com.apple.loginwindow"):
        return
    if frontmost_bundle() == front:
        return
    subprocess.run(["open", "-b", front], capture_output=True)
    for _ in range(10):
        if frontmost_bundle() == front:
            return
        time.sleep(0.05)


def ct_apply(args: tuple[str, ...], done, more_polls: int = 80) -> bool:
    """Send a command, wake the agent, and return as soon as done() sees it land.

    The agent holds the front only while it works: it has no window to show, so this is
    a moment. Hand the front back after about 1 s even if nothing landed, so keystrokes
    never go astray, then keep watching for more_polls. With the screen locked,
    loginwindow is in front and there is no app to hand back to."""
    front = frontmost_bundle()
    ct_send(*args)
    wake_agent(args)
    landed = wait_for(done, 20)
    give_front_back(front)
    if landed or wait_for(done, more_polls):
        return True
    withdraw_command(args)
    return False


def withdraw_command(args: tuple[str, ...]) -> None:
    """Take an unread command back out of the slot, if it is still this one.

    Left there, the agent runs it whenever Cold Turkey next comes to the front, which
    can be hours later: on 23 Nov 2026 the default start that a 09:14 dark wake missed
    ran when the lid opened at 12:48, and research came back in the middle of the lunch
    window. Every caller either retries or reports the miss, so nothing is lost. The
    agent may read the slot first; then the key is gone and this deletes nothing."""
    slot = subprocess.run(
        ["defaults", "read", CT_DEFAULTS, "commandArgs"],
        capture_output=True,
        text=True,
    ).stdout
    if slot and all(a in slot for a in args):
        subprocess.run(
            ["defaults", "delete", CT_DEFAULTS, "commandArgs"], capture_output=True
        )


CT_DROPPED = (
    "the agent did not read the command, so focus took it back and nothing is left to "
    "run later. Bring Cold Turkey forward and run this again"
)


def block_is(name: str, enabled: bool):
    want = "true" if enabled else "false"
    return lambda: read_blocks().get(name, {}).get("enabled") == want


def switch(name: str, on: bool) -> None:
    """Start or stop a block, and return as soon as the database shows it.

    A command the agent did not read is sent once more: re-sending puts the same
    command in the one slot, so it cannot run twice. On a second miss, notify as well
    as exit, since a run from Alfred has no terminal to show the error: on 20 Nov 2026
    a switch to comms left research running and Messages blocked without a word."""
    args = ("-start" if on else "-stop", name)
    if ct_apply(args, block_is(name, on)) or ct_apply(args, block_is(name, on)):
        return
    verb = "start" if on else "stop"
    # From Alfred, the exit below shows a dialog instead. A tick step that fails again
    # each minute notified on its first failure; the rest go to the tick log.
    if not from_alfred() and first_failure(f"{verb} {name}"):
        notify(f"Cold Turkey did not {verb} {name!r}. Run focus status.")
    sys.exit(f"focus: Cold Turkey did not {verb} {name!r}: {CT_DROPPED}")


def stop_other_modes(keep: str | None) -> None:
    """Stop every unlocked mode block that runs besides `keep` (a block name, or None
    for no mode), read fresh from the database. A switch ends with this so that two
    modes never stay on together, whatever list of running modes it began from."""
    for n, b in mode_blocks(read_blocks()).items():
        if n != keep and b.get("enabled") == "true" and not is_locked(b):
            switch(n, on=False)


def mode_blocks(blocks: dict) -> dict:
    return {n: b for n, b in blocks.items() if n.startswith(PREFIX)}


def is_locked(block: dict) -> bool:
    return block.get("lock", "none") != "none"


