def paint(text: str, sgr: str) -> str:
    """ANSI colour for a terminal; plain text when piped (Alfred) or when NO_COLOR is set."""
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{sgr}m{text}\033[0m"


def by_agent() -> bool:
    # Claude Code sets CLAUDECODE=1 in every shell it runs.
    return os.environ.get("CLAUDECODE") == "1"


def gate(cfg: dict, request: str, why: str) -> None:
    """Make an agent wait before it loosens blocking; return only when it may go ahead.

    The first call queues the exact request and exits; the same call repeated after
    the delay runs it. A person running focus is never delayed: Cold Turkey and
    ScreenZen already give them their own friction. This is a speed bump, not a
    lock: an agent that edits this file or the queue gets past it.
    """
    if not by_agent():
        return
    delay = int(cfg.get("agent_loosen_delay_minutes", DEFAULT_DELAY_MIN))
    now = time.time()
    try:
        pending = json.loads(PENDING.read_text())
    except (FileNotFoundError, ValueError):
        pending = {}
    pending = {k: v for k, v in pending.items() if now < v + EXPIRE_S}
    due = pending.get(request)
    if due is not None and now >= due:
        del pending[request]
        PENDING.write_text(json.dumps(pending))
        return
    if due is None:
        due = now + delay * 60
        pending[request] = due
        PENDING.parent.mkdir(parents=True, exist_ok=True)
        PENDING.write_text(json.dumps(pending))
    at = dt.datetime.fromtimestamp(due).strftime("%H:%M:%S")
    print(
        f"focus: {why}. An agent's loosening waits {delay} min: queued; "
        f"run the same command again after {at} to apply it."
    )
    sys.exit(3)


def load_config(path: Path) -> dict:
    text = path.read_text()
    if path.suffix == ".md":
        m = re.search(r"^```ya?ml\n(.*?)^```", text, re.S | re.M)
        if not m:
            sys.exit(f"focus: no ```yaml block in {path}")
        text = m.group(1)
    cfg = yaml.safe_load(text) or {}
    problems = []
    unknown = set(cfg) - {
        "groups",
        "always_allow",
        "modes",
        "blocklists",
        "timers",
        "agent_loosen_delay_minutes",
        "off_hours",
        "break_max_minutes",
        "no_mode_allow",
        "only",
    }
    if unknown:
        problems.append(f"unknown top-level keys: {sorted(unknown)}")
    for span in cfg.get("off_hours") or []:
        if not re.fullmatch(r"\d\d:\d\d-\d\d:\d\d", str(span)):
            problems.append(f"off_hours entry {span!r} must look like '22:00-23:15'")
    groups = cfg.setdefault("groups", {})
    for name, g in groups.items():
        if set(g or {}) - {"sites", "apps"}:
            problems.append(f"group {name!r} may only have 'sites' and 'apps'")
    refs = [
        ("always_allow", cfg.get("always_allow") or []),
        ("no_mode_allow", cfg.get("no_mode_allow") or []),
    ]
    for name, mode in (cfg.get("modes") or {}).items():
        if set(mode or {}) - {"allow", "block"}:
            problems.append(f"mode {name!r} may only have 'allow' and 'block'")
        refs += [
            (f"mode {name}", (mode.get("allow") or []) + (mode.get("block") or []))
        ]
    for app, lists in (cfg.get("blocklists") or {}).items():
        if app not in ("cold_turkey", "screenzen"):
            problems.append(f"blocklists key {app!r} must be cold_turkey or screenzen")
        for name, bl in (lists or {}).items():
            keys = {"block", "allow"} | ({"off_in"} if app == "screenzen" else set())
            if set(bl or {}) - keys:
                problems.append(f"{app} {name!r} may only have {sorted(keys)}")
            for m in bl.get("off_in") or []:
                if m != "none" and m not in (cfg.get("modes") or {}):
                    problems.append(f"{app} {name!r} off_in names unknown mode {m!r}")
            refs += [
                (f"{app} {name}", (bl.get("block") or []) + (bl.get("allow") or []))
            ]
    for name, t in (cfg.get("timers") or {}).items():
        if set(t or {}) - {"block", "minutes"}:
            problems.append(f"timer {name!r} may only have 'block' and 'minutes'")
        if name in (cfg.get("modes") or {}):
            problems.append(f"timer {name!r} has the same name as a mode")
        refs += [(f"timer {name}", t.get("block") or [])]
    if "only" in cfg:
        cfg["only"] = cfg["only"] or {}
        if set(cfg["only"]) - {"keep", "minutes"}:
            problems.append("'only' may only have 'keep' and 'minutes'")
        if ONLY in (cfg.get("modes") or {}) or ONLY in (cfg.get("timers") or {}):
            problems.append(f"{ONLY!r} is taken by the 'only' section")
        refs += [("only keep", cfg["only"].get("keep") or [])]
    for where, names in refs:
        for n in names:
            if n not in groups:
                problems.append(f"{where} names unknown group {n!r}")
    if problems:
        sys.exit(f"focus: {path}:\n  " + "\n  ".join(problems))
    return cfg


def group_items(cfg: dict, names: list[str], kind: str) -> list[str]:
    seen: dict[str, None] = {}
    for n in names:
        for item in cfg["groups"][n].get(kind) or []:
            seen[str(item)] = None
    return list(seen)


def desired_exceptions(cfg: dict, mode: str) -> list[str]:
    names = (cfg.get("always_allow") or []) + (cfg["modes"][mode].get("allow") or [])
    return group_items(cfg, names, "sites")


def resolve_app(name: str) -> tuple[Path, str] | None:
    """Return the app bundle and its bundle id, or None if it is not installed."""
    for d in APP_DIRS:
        bundle = d / f"{name}.app"
        info = bundle / "Contents/Info.plist"
        if info.exists():
            with info.open("rb") as f:
                bid = plistlib.load(f).get("CFBundleIdentifier")
            if bid:
                return bundle, bid
    return None


def ct_apps(names: list[str]) -> tuple[list[str], list[str]]:
    """Cold Turkey app entries ('app:<Name>.app:<bundle id>') and the names not found."""
    found, missing = [], []
    for name in names:
        r = resolve_app(name)
        if r:
            found.append(f"app:{r[0].name}:{r[1]}")
        else:
            missing.append(name)
    return found, missing


def desired_apps(cfg: dict, mode: str) -> tuple[list[str], list[str]]:
    return ct_apps(group_items(cfg, cfg["modes"][mode].get("block") or [], "apps"))


def conflicts(cfg: dict) -> list[str]:
    """A Cold Turkey exception only overrides its own block, so a site another block bans stays banned."""
    out = []
    for bl_name, bl in (cfg.get("blocklists") or {}).get("cold_turkey", {}).items():
        banned = set(group_items(cfg, bl.get("block") or [], "sites"))
        for mode in cfg["modes"]:
            for site in desired_exceptions(cfg, mode):
                if site in banned:
                    out.append(
                        f"{site!r} is allowed in mode {mode!r} but blocked by {bl_name!r}"
                    )
    return out


def decode_settings(value: str) -> dict:
    """Cold Turkey stores its settings as a short tag plus hex bytes shifted by 0x11."""
    for off in range(0, 9):
        h = value[off:]
        h = h[: len(h) // 2 * 2]
        try:
            raw = bytes(
                (int(h[i : i + 2], 16) - 0x11) % 256 for i in range(0, len(h), 2)
            )
            return json.loads(raw.decode())
        except (ValueError, UnicodeDecodeError):
            continue
    raise ValueError("unrecognised Cold Turkey settings encoding")


def read_blocks() -> dict:
    # Copy the database with its WAL so the read sees writes not yet checkpointed.
    with tempfile.TemporaryDirectory() as tmp:
        for suffix in ("", "-wal", "-shm"):
            src = Path(f"{CT_DB}{suffix}")
            if src.exists():
                shutil.copyfile(src, Path(tmp) / f"data-app.db{suffix}")
        con = sqlite3.connect(Path(tmp) / "data-app.db")
        try:
            (value,) = con.execute(
                "select value from settings where key='settings'"
            ).fetchone()
        finally:
            con.close()
    return decode_settings(value)["blocks"]


def ct_send(*args: str) -> None:
    """Give Cold Turkey a command without waiting for the CLI to exit.

    The CLI is the app itself in a second process. It writes its arguments to the
    'commandArgs' preference within 0.1 s, then idles for about 5 s and prints "isn't
    responding". That held for every call timed on 6 Nov 2026, including -help and a
    start that landed 2.2 s in, so the wait is dead time and the reply decides nothing.
    Leaving the CLI running is safe: it does not touch 'commandArgs' on exit.
    """
    subprocess.Popen(
        [str(CT_BIN), *args],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def wake_agent(args: tuple[str, ...]) -> None:
    """Make Cold Turkey's agent read a command the CLI has just left for it.

    'commandArgs' is one slot, not a queue: the agent reads and deletes it when it
    becomes the active app, and nothing else makes it look. A real start landed 0.21 s
    after this activation (6 Nov 2026), and the same call never landed without one.
    Activation goes by pid because the CLI shares the agent's bundle id while it idles,
    and needs no Automation permission. Wait for the slot first, or the agent reads
    nothing. A failure here is not reported: the database says whether the change landed.
    """
    for _ in range(25):
        slot = subprocess.run(
            ["defaults", "read", CT_DEFAULTS, "commandArgs"],
            capture_output=True,
            text=True,
        ).stdout
        if all(a in slot for a in args):
            break
        time.sleep(0.02)
    pid = subprocess.run(
        ["pgrep", "-f", f"{CT_BIN.name} -agent"], capture_output=True, text=True
    ).stdout.split()
    if pid:
        subprocess.run(
            ["osascript", "-l", "JavaScript", "-e", CT_WAKE_JXA % int(pid[0])],
            capture_output=True,
        )


def wait_for(done, polls: int) -> bool:
    """Watch the database at 0.05 s; a read takes about 0.01 s."""
    for _ in range(polls):
        if done():
            return True
        time.sleep(0.05)
    return False


def give_front_back(front: str | None) -> None:
    """Return the front to the app that had it, and wait until it has it. 'open' returns
    first, and a switch applies two commands in a row: the second must read the real
    front, and the agent must have lost it, or it has no activation to read on."""
    if front in (None, CT_BUNDLE, "com.apple.loginwindow"):
        return
    if frontmost_bundle() == front:
        return
    subprocess.run(["open", "-b", front], capture_output=True)
    for _ in range(10):
        if frontmost_bundle() == front:
            return
        time.sleep(0.05)


def ct_apply(args: tuple[str, ...], done, more_polls: int = 80) -> bool:
    """Send a command, wake the agent, and return as soon as done() sees it land.

    The agent holds the front only while it works: it has no window to show, so this is
    a moment. Hand the front back after about 1 s even if nothing landed, so keystrokes
    never go astray, then keep watching for more_polls. With the screen locked,
    loginwindow is in front and there is no app to hand back to."""
    front = frontmost_bundle()
    ct_send(*args)
    wake_agent(args)
    landed = wait_for(done, 20)
    give_front_back(front)
    return landed or wait_for(done, more_polls)


CT_DROPPED = (
    "the agent did not read the command. It stays queued and can run when Cold Turkey "
    "next comes to the front, so bring Cold Turkey forward and run this again"
)


def block_is(name: str, enabled: bool):
    want = "true" if enabled else "false"
    return lambda: read_blocks().get(name, {}).get("enabled") == want


def switch(name: str, on: bool) -> None:
    """Start or stop a block, and return as soon as the database shows it."""
    if not ct_apply(("-start" if on else "-stop", name), block_is(name, on)):
        sys.exit(
            f"focus: Cold Turkey did not {'start' if on else 'stop'} {name!r}: {CT_DROPPED}"
        )


def mode_blocks(blocks: dict) -> dict:
    return {n: b for n, b in blocks.items() if n.startswith(PREFIX)}


def is_locked(block: dict) -> bool:
    return block.get("lock", "none") != "none"


