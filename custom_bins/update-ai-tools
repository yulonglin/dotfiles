#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════════
# AI CLI Tools Auto-Update
# ═══════════════════════════════════════════════════════════════════════════════
# Updates Claude Code, Codex CLI, and OpenCode through the package manager that
# owns each executable. Designed to run from launchd/cron.
#
# Usage:
#   update-ai-tools              # Run updates
#   update-ai-tools --dry-run    # Preview what would be updated
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PATH Setup (critical for launchd/cron which have minimal PATH) ──────────

# Source Homebrew on macOS or Linux when it is not already on PATH.
if ! command -v brew &>/dev/null; then
    for brew_executable in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew; do
        if [[ -x "$brew_executable" ]]; then
            eval "$("$brew_executable" shellenv 2>/dev/null)" || true
            break
        fi
    done
    unset brew_executable
fi

# Add common paths for globally installed tools
export PATH="$HOME/.bun/bin:$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:$PATH"

# ─── Configuration ───────────────────────────────────────────────────────────

set -euo pipefail

DRY_RUN=false
LOCK_FILE="$HOME/.update-ai-tools.lock"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CODEX_MANAGER="${CODEX_INSTALL_MANAGER:-$SCRIPT_DIR/codex-install-manager}"

is_macos() { [[ "$(uname -s)" == "Darwin" ]]; }

# ─── Argument Parsing ────────────────────────────────────────────────────────

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        -h|--help)
            echo "Usage: update-ai-tools [--dry-run]"
            echo ""
            echo "Updates Claude Code, Antigravity CLI, Codex CLI, and OpenCode."
            echo "Enforces Codex ownership from config/codex-install.conf."
            echo ""
            echo "Options:"
            echo "  --dry-run    Preview what would be updated"
            echo "  -h, --help   Show this help"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# ─── Logging ─────────────────────────────────────────────────────────────────

log() { echo "[$(date -u '+%Y-%m-%d %H:%M:%S UTC')] $*"; }
log_ok() { log "✓ $*"; }
log_skip() { log "- $*"; }
log_err() { log "✗ $*" >&2; }

# ─── Lock File (prevent concurrent runs) ─────────────────────────────────────

acquire_lock() {
    if [[ -f "$LOCK_FILE" ]]; then
        local pid
        pid=$(cat "$LOCK_FILE" 2>/dev/null)
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            log_err "Another instance is running (PID $pid). Exiting."
            exit 1
        fi
        # Stale lock — remove it
        rm -f "$LOCK_FILE"
    fi
    echo "$$" > "$LOCK_FILE"
}

release_lock() {
    rm -f "$LOCK_FILE"
}

trap release_lock EXIT

# ─── Core Update Logic ──────────────────────────────────────────────────────

# Update a tool through the manager that owns its resolved executable.
# Usage: update_tool <command_name> <brew_package> <package_name>
update_tool() {
    local tool_name="$1" brew_name="$2" package_name="$3"

    # Skip if tool not installed
    if ! command -v "$tool_name" &>/dev/null; then
        log_skip "$tool_name not installed, skipping"
        return 0
    fi

    # Detect installation method by checking where the binary lives
    local method="unknown"
    local tool_path
    tool_path=$(command -v "$tool_name" 2>/dev/null || true)

    local brew_prefix=""
    command -v brew &>/dev/null && brew_prefix=$(brew --prefix 2>/dev/null || true)

    if [[ -n "$brew_prefix" && "$tool_path" == "$brew_prefix/"* ]]; then
        method="brew"
    elif command -v bun &>/dev/null && [[ "$tool_path" == "$HOME/.bun/bin/"* ]]; then
        method="bun"
    fi

    # Dry-run: show what would happen, then exit
    if [[ "$DRY_RUN" == "true" ]]; then
        case "$method" in
            brew) log "[DRY RUN] Would run: brew upgrade $brew_name" ;;
            bun)  log "[DRY RUN] Would run: bun add -g ${package_name}@latest" ;;
            *)    log "[DRY RUN] $tool_name: no known update method" ;;
        esac
        return 0
    fi

    # Execute update
    log "Updating $tool_name via $method..."
    case "$method" in
        brew)
            NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade "$brew_name" 2>&1 \
                || log_err "$tool_name brew upgrade failed"
            ;;
        bun)
            bun add -g "${package_name}@latest" 2>&1 \
                || log_err "$tool_name bun update failed"
            ;;
        *)
            log_err "$tool_name installed but no known update method (expected brew or bun)"
            return 1
            ;;
    esac
}

update_codex() {
    if [[ ! -x "$CODEX_MANAGER" ]]; then
        log_err "Codex install manager is missing: $CODEX_MANAGER"
        return 1
    fi

    local manager_args=(--update)
    [[ "$DRY_RUN" == "true" ]] && manager_args+=(--dry-run)
    "$CODEX_MANAGER" "${manager_args[@]}"
}

# ─── Update Claude Code ─────────────────────────────────────────────────────

update_claude() {
    if ! command -v claude &>/dev/null; then
        log_skip "claude not installed, skipping"
        return 0
    fi

    if [[ "$DRY_RUN" == "true" ]]; then
        log "[DRY RUN] Would run: claude update"
        log "[DRY RUN] Then validate router infrastructure: python3 $HOME/.claude/hooks/check_model_router_update.py --force"
        return 0
    fi

    log "Updating Claude Code..."
    local update_status=0
    claude update 2>&1 || update_status=$?
    if [[ "$update_status" -ne 0 ]]; then
        log_err "Claude Code update failed"
        return "$update_status"
    fi

    local checker="$HOME/.claude/hooks/check_model_router_update.py"
    if [[ ! -f "$checker" ]]; then
        log_err "Router infrastructure checker missing: $checker"
        return 1
    fi
    log "Validating router infrastructure after Claude Code update..."
    python3 "$checker" --force || {
        log_err "Router infrastructure validation failed"
        return 1
    }
}

# ─── Update Antigravity CLI ─────────────────────────────────────────────────

# Antigravity CLI (`agy`, Google's Gemini CLI successor) is a macOS cask and a
# manual install on Linux (no bun/npm package) — so it can't use update_tool.
update_antigravity() {
    if ! command -v agy &>/dev/null; then
        log_skip "agy not installed, skipping"
        return 0
    fi

    # No brew (i.e. Linux manual install) → nothing to auto-update.
    if ! is_macos || ! command -v brew &>/dev/null; then
        log_skip "agy: no brew (Linux manual install) — update manually, skipping"
        return 0
    fi

    if [[ "$DRY_RUN" == "true" ]]; then
        log "[DRY RUN] Would run: brew upgrade --cask antigravity-cli"
        return 0
    fi

    log "Updating Antigravity CLI..."
    # NOTE: if the cask declares `auto_updates true`, brew skips it unless --greedy.
    # Verify on a real Mac whether --greedy is needed for `agy` to actually move.
    NONINTERACTIVE=1 HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade --cask antigravity-cli 2>&1 \
        || log_err "Antigravity CLI brew upgrade failed"
}

# ─── Main ────────────────────────────────────────────────────────────────────

acquire_lock

log "═══ AI Tools Update Started ═══"
log "PATH: $PATH"
[[ "$DRY_RUN" == "true" ]] && log "MODE: dry-run (no changes will be made)"

# Continue on individual tool failures
set +e

update_claude
claude_update_status=$?
update_antigravity
update_codex
codex_update_status=$?
update_tool "opencode" "opencode" "opencode-ai"

# ty is a uv tool — upgrade via uv directly
if command -v ty &>/dev/null && command -v uv &>/dev/null; then
    if [[ "$DRY_RUN" == "true" ]]; then
        log "[DRY RUN] Would run: uv tool upgrade ty"
    else
        log "Updating ty..."
        uv tool upgrade ty 2>&1 || log_err "ty upgrade failed"
    fi
fi

set -e

log "═══ AI Tools Update Complete ═══"
[[ "$codex_update_status" -eq 0 ]] || exit "$codex_update_status"
exit "$claude_update_status"
