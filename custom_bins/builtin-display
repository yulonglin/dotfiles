#!/usr/bin/env zsh
# builtin-display — turn the MacBook's built-in screen off and on while the lid
# stays open, so the built-in keyboard and trackpad keep working with an
# external display. Free stand-in for BetterDisplay's "disconnect" and Lunar's
# BlackOut, both paid. Logic lives in tools/builtin-display/main.swift; this
# wrapper compiles it on first run (or when the source is newer) and execs it.
# It also owns `auto on|off|status`: the login agents that run `watch` and `heal`.
# The screen stays off only while a `hold` process runs; ending it brings it back.
#
#   builtin-display status | off | on | toggle | try [SECONDS] | hold | heal | auto on|off|status | --help
set -euo pipefail

if [[ $OSTYPE != darwin* ]]; then
    print -u2 "builtin-display: macOS only"
    exit 1
fi

SELF="${0:A}"
DOT_DIR="${SELF:h:h}"
SRC="${DOT_DIR}/tools/builtin-display/main.swift"
BIN="${DOT_DIR}/tools/builtin-display/builtin-display"
LABEL="com.user.builtin-display"
PLIST="${HOME}/Library/LaunchAgents/${LABEL}.plist"
LOG="${HOME}/Library/Logs/builtin-display.log"
DOMAIN="gui/$(id -u)"

say() {  # say <colour> <text>: coloured only on a terminal without NO_COLOR
    if [[ -t 1 && -z ${NO_COLOR:-} ]]; then print -P "%F{$1}$2%f"; else print -r -- "$2"; fi
}

# Two agents: the watcher starts a holder when a monitor connects (the holder
# itself lets go when the last one leaves); the heal job is a fresh process every
# 2 s (about 40 ms a run, so cheap) that kills a hung holder and restores the
# screen if no external is present.
HEAL_LABEL="com.user.builtin-display-heal"
HEAL_PLIST="${HOME}/Library/LaunchAgents/${HEAL_LABEL}.plist"

agent_loaded() { launchctl print "${DOMAIN}/$1" >/dev/null 2>&1; }

write_plist() {  # write_plist <path> <label> <subcommand> <extra plist keys>
    cat > "$1" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$2</string>
    <key>ProgramArguments</key>
    <array>
        <string>${SELF}</string>
        <string>$3</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
$4
    <key>StandardOutPath</key>
    <string>${LOG}</string>
    <key>StandardErrorPath</key>
    <string>${LOG}</string>
</dict>
</plist>
EOF
    plutil -lint "$1" >/dev/null
    launchctl bootout "${DOMAIN}/$2" 2>/dev/null || true
    launchctl bootstrap "$DOMAIN" "$1"
}

remove_agent() {  # remove_agent <label> <plist>
    launchctl bootout "${DOMAIN}/$1" 2>/dev/null || true
    if [[ -f $2 ]]; then
        if command -v trash >/dev/null 2>&1; then trash "$2"; else rm -f "$2"; fi
    fi
}

auto_on() {
    mkdir -p "${PLIST:h}" "${LOG:h}"
    write_plist "$PLIST" "$LABEL" watch \
        "    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>"
    write_plist "$HEAL_PLIST" "$HEAL_LABEL" heal \
        "    <key>StartInterval</key>
    <integer>2</integer>
    <key>ThrottleInterval</key>
    <integer>2</integer>"
    say green "auto: on — the built-in screen turns off whenever an external display connects, and back on within ~2 s of the last one going"
    print "  undo with: builtin-display auto off    log: $LOG"
}

auto_off() {
    remove_agent "$LABEL" "$PLIST"
    remove_agent "$HEAL_LABEL" "$HEAL_PLIST"
    say yellow "auto: off — agents removed; a running holder keeps the screen off until builtin-display on"
}

auto_status() {
    local label
    for label in "$LABEL" "$HEAL_LABEL"; do
        if agent_loaded "$label"; then say green "  ${label}: loaded"; else say yellow "  ${label}: not loaded"; fi
    done
    [[ -f $LOG ]] && { print "  last log lines:"; tail -n 3 "$LOG" | sed 's/^/    /'; }
    return 0
}

if [[ ${1:-} == auto ]]; then
    case ${2:-status} in
        on) auto_on ;;
        off) auto_off ;;
        status) auto_status ;;
        *) print -u2 "usage: builtin-display auto on|off|status"; exit 2 ;;
    esac
    exit 0
fi

if [[ ! -x $BIN || $SRC -nt $BIN ]]; then
    command -v swiftc >/dev/null 2>&1 || { print -u2 "builtin-display: swiftc not found (xcode-select --install)"; exit 1; }
    swiftc -O -o "$BIN" "$SRC" || { print -u2 "builtin-display: compile failed"; exit 1; }
fi

exec "$BIN" "$@"
