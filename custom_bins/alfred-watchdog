#!/usr/bin/env bash
# alfred-watchdog — kill Alfred workflow scripts that have wedged and are burning a core.
#
# Alfred script filters fire per keystroke and are meant to finish in milliseconds.
# A buggy one can hang forever: on 2026-09-12 two `osascript` runs of the Open
# Conference URL workflow spun at 100% CPU for 18 hours each, ~19 core-hours, and
# surfaced only as "Alfred is using significant energy" because macOS bills a
# child's energy to the parent app.
#
# Neither age nor CPU alone is a safe signal, and the two gates do different jobs.
#
# CPU separates a wedge from a BLOCKED script. Alfred workflows legitimately run
# AppleScript that waits indefinitely — `display dialog` waits for the user, and
# polling loops sit on `delay`. Those idle near 0% while a spinner stays pegged,
# so requiring high CPU spares them.
#
# Age separates a wedge from a BUSY script, and it is the only thing that does.
# Nothing observable at the process level distinguishes "spinning on a bug" from
# "computing hard" — both burn CPU. The claim being leaned on is narrower and
# about Alfred specifically: a script filter fires per keystroke and is expected
# to answer in milliseconds, so one still pegged after --age-minutes is broken,
# whatever it believes it is doing.
#
# The second sample is therefore NOT proof that a process is wedged rather than
# working. All it establishes is that the process has not finished or dropped off
# in the interval, which is worth checking cheaply before killing something. Note
# `ps %cpu` on macOS is a decay-weighted recent average, not a lifetime one, so a
# process that only just became busy can read hot on both samples.
#
# TWO LIMITS WORTH KNOWING:
#
# 1. It only looks at `osascript`. Alfred "Run Script" actions can also be bash,
#    zsh, python, perl, ruby, node or swift, and a wedged one of those is
#    invisible here. The two incidents that motivated this were both osascript.
#    So "no wedged Alfred scripts" means no wedged *osascript* — it is not a
#    clean bill of health for the whole machine.
#
# 2. The one case the gates do not protect is long pure-AppleScript compute.
#    Heavy workflows usually delegate (`do shell script "sips …"`, `tell
#    application "Music"`), and then the CPU burns in the *child* while osascript
#    blocks near 0% and is spared. But a genuine `repeat` over tens of thousands
#    of list items burns CPU in AppleScript itself and is indistinguishable from
#    an infinite loop by any sample — only elapsed time tells them apart, and
#    only probabilistically. The age gate is the sole protection for that class,
#    which is why `--age-minutes 0` (tests only) removes it entirely.
#
# Only descendants of the running Alfred process are considered, so an `osascript`
# you started from a terminal is never a candidate.
#
# Usage:
#   alfred-watchdog                     Check and kill what qualifies
#   alfred-watchdog --dry-run           Report candidates, kill nothing
#   alfred-watchdog --age-minutes 30    Require 30 min of age (default 10)
#   alfred-watchdog --cpu-threshold 50  Require 50% CPU (default 80)
#   alfred-watchdog --sample-gap 10     Seconds between the two samples (default 5)
#   alfred-watchdog --help
#
# --test-anchor-pid <pid> exists for tests/test_alfred_watchdog.sh only: it uses
# that PID as the ancestry anchor in place of Alfred. Deliberately a flag rather
# than an environment variable, so nothing ambient can redirect what gets killed.
#
# Exits 0 whether or not anything was killed; a wedge is an expected condition,
# not an error. Exits 64 on bad arguments and 69 when the process list could not
# be read at all — the latter matters because "checked, found nothing" and "could
# not check" must never look alike in a log.
set -euo pipefail

AGE_MINUTES=10
CPU_THRESHOLD=80
SAMPLE_GAP=5
DRY_RUN=0

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/alfred-watchdog"
LOG_FILE="$STATE_DIR/watchdog.log"

log()  { printf '\033[0;34m[alfred-watchdog]\033[0m %s\n' "$*"; }
warn() { printf '\033[0;33m[alfred-watchdog]\033[0m %s\n' "$*" >&2; }

# --help prints the header comment block (lines after the shebang, up to the first
# line of code), so the usage text can never drift out of sync with a hardcoded range.
[[ "${1:-}" == "--help" || "${1:-}" == "-h" ]] && {
  awk '/^#!/ {next} /^[^#]/ {exit} {print}' "$0" | sed 's/^# \{0,1\}//'; exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)        DRY_RUN=1; shift ;;
    --age-minutes)    AGE_MINUTES="${2:?--age-minutes needs a value}"; shift 2 ;;
    --cpu-threshold)  CPU_THRESHOLD="${2:?--cpu-threshold needs a value}"; shift 2 ;;
    --sample-gap)     SAMPLE_GAP="${2:?--sample-gap needs a value}"; shift 2 ;;
    --test-anchor-pid) TEST_ANCHOR_PID="${2:?--test-anchor-pid needs a value}"; shift 2 ;;
    *) warn "unknown argument: $1 (try --help)"; exit 64 ;;
  esac
done

for v in AGE_MINUTES CPU_THRESHOLD SAMPLE_GAP; do
  [[ "${!v}" =~ ^[0-9]+$ ]] || { warn "$v must be a whole number, got '${!v}'"; exit 64; }
done

# Validated separately because it is optional. A non-numeric anchor would make
# the ancestry walk compare garbage and match nothing, which fails safe, but it
# would do so silently — and this flag decides what is eligible to be killed.
if [[ -n "${TEST_ANCHOR_PID:-}" && ! "$TEST_ANCHOR_PID" =~ ^[0-9]+$ ]]; then
  warn "--test-anchor-pid must be a whole number, got '$TEST_ANCHOR_PID'"
  exit 64
fi

if [[ "$(uname -s)" != "Darwin" ]]; then
  warn "Alfred is macOS-only; nothing to do."
  exit 0
fi

# Alfred's own PID. Matched on the bundle's executable path rather than the bare
# word "Alfred", which would also catch this script and anything else mentioning it.
#
# pgrep's exit codes are load-bearing here: 1 means "no match", anything above
# means it could not look (it needs sysmond, which a sandbox can withhold). Those
# must not collapse into the same "Alfred isn't running" conclusion, or the
# watchdog reports all-clear on every run while never checking anything.
#
# --test-anchor-pid is a testing seam: it substitutes a different process for
# Alfred as the ancestry anchor, so tests/test_alfred_watchdog.sh can build a real
# wedged tree and prove the kill path works without driving Alfred itself.
#
# It is deliberately a FLAG and not an environment variable. As an exported
# variable it would be ambient authority — a shell profile, a direnv .envrc, or
# any wrapper that happened to export it would silently redirect the anchor and
# turn every later run into something that kills processes outside the Alfred
# tree, with only the age and CPU gates left standing. That is precisely the
# failure this tool exists to prevent. A flag has to be typed by the caller.
if [[ -n "${TEST_ANCHOR_PID:-}" ]]; then
  alfred_pid="$TEST_ANCHOR_PID"
  warn "Using test anchor PID $alfred_pid instead of Alfred."
else
  set +e
  alfred_pid="$(pgrep -f '/Alfred [0-9]*\.app/Contents/MacOS/Alfred' 2>/dev/null | head -1)"
  pgrep_status=${PIPESTATUS[0]}
  set -e

  if [[ $pgrep_status -gt 1 ]]; then
    warn "pgrep failed (exit $pgrep_status) — cannot read the process list, so nothing was checked."
    exit 69
  fi
  if [[ -z "$alfred_pid" ]]; then
    log "Alfred is not running; nothing to do."
    exit 0
  fi
fi

# True when $1 has $alfred_pid somewhere up its parent chain. Workflow scripts are
# grandchildren or deeper (Alfred → bash → python → osascript), so a direct ppid
# test would miss them. Bounded by the walk reaching pid 1 or 0.
descends_from_alfred() {
  local pid="$1" hops=0
  while [[ -n "$pid" && "$pid" -gt 1 && $hops -lt 20 ]]; do
    [[ "$pid" == "$alfred_pid" ]] && return 0
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    hops=$((hops + 1))
  done
  return 1
}

# Elapsed seconds for a pid, from ps ETIME ([[dd-]hh:]mm:ss).
elapsed_seconds() {
  ps -o etime= -p "$1" 2>/dev/null | tr -d ' ' | awk -F'[-:]' '
    NF==4 { print $1*86400 + $2*3600 + $3*60 + $4; next }
    NF==3 { print $1*3600 + $2*60 + $3; next }
    NF==2 { print $1*60 + $2; next }
    { print 0 }'
}

cpu_percent() { ps -o %cpu= -p "$1" 2>/dev/null | tr -d ' ' | cut -d. -f1; }

age_seconds=$((AGE_MINUTES * 60))

# Same exit-code care as the Alfred lookup above: an error must not read as
# "no osascript processes running".
set +e
osascript_pids="$(pgrep -x osascript 2>/dev/null)"
pgrep_status=$?
set -e
if [[ $pgrep_status -gt 1 ]]; then
  warn "pgrep failed (exit $pgrep_status) — cannot read the process list, so nothing was checked."
  exit 69
fi

# First pass: old enough, hot enough, and descended from Alfred.
candidates=()
while read -r pid; do
  [[ -z "$pid" ]] && continue
  descends_from_alfred "$pid" || continue
  secs="$(elapsed_seconds "$pid")"
  [[ -z "$secs" || "$secs" -lt "$age_seconds" ]] && continue
  cpu="$(cpu_percent "$pid")"
  [[ -z "$cpu" || "$cpu" -lt "$CPU_THRESHOLD" ]] && continue
  candidates+=("$pid")
done <<< "$osascript_pids"

if [[ ${#candidates[@]} -eq 0 ]]; then
  log "No wedged Alfred scripts (checked osascript descendants of PID $alfred_pid)."
  exit 0
fi

# Second sample. A process doing real work falls off; only a spinner stays pegged.
log "First sample flagged ${#candidates[@]}: ${candidates[*]}. Re-checking in ${SAMPLE_GAP}s."
sleep "$SAMPLE_GAP"

confirmed=()
for pid in "${candidates[@]}"; do
  kill -0 "$pid" 2>/dev/null || { log "PID $pid exited on its own."; continue; }
  cpu="$(cpu_percent "$pid")"
  if [[ -n "$cpu" && "$cpu" -ge "$CPU_THRESHOLD" ]]; then
    confirmed+=("$pid")
  else
    log "PID $pid dropped to ${cpu:-?}% — working, not wedged. Leaving it."
  fi
done

if [[ ${#confirmed[@]} -eq 0 ]]; then
  log "Nothing confirmed on the second sample."
  exit 0
fi

mkdir -p "$STATE_DIR"

for pid in "${confirmed[@]}"; do
  # Re-check ancestry immediately before killing, not just when the candidate was
  # first picked. Several seconds pass in between (--sample-gap, plus 2s per
  # earlier kill), and in that window the candidate can exit and the OS reuse its
  # PID for something else entirely. Without this, `kill -0` would still succeed
  # and we would shoot the replacement. Rare, but the whole premise of this tool
  # is a machine left alone for hours, so rare events get their turn.
  if ! descends_from_alfred "$pid"; then
    warn "PID $pid is no longer an Alfred descendant (exited and the PID was reused?). Leaving it."
    continue
  fi

  # Captured before the kill so the log says which workflow was at fault, and
  # after the ancestry re-check so it describes the process actually being killed.
  args="$(ps -o args= -p "$pid" 2>/dev/null | head -c 300 || true)"
  mins=$(( $(elapsed_seconds "$pid") / 60 ))
  cpu="$(cpu_percent "$pid")"

  if [[ $DRY_RUN -eq 1 ]]; then
    log "[dry-run] would kill PID $pid (${mins}m, ${cpu}%): $args"
    continue
  fi

  # Explicit PID, never `pkill -f` — a pattern broad enough to match these also
  # matches this script's own command line.
  kill -TERM "$pid" 2>/dev/null || true
  sleep 2
  if kill -0 "$pid" 2>/dev/null; then
    warn "PID $pid ignored TERM; sending KILL."
    kill -KILL "$pid" 2>/dev/null || true
    sleep 1
  fi

  # Confirm it is actually gone before claiming so. Both kills are error-suppressed,
  # and they can fail for reasons other than success — most plainly EPERM, if the
  # PID now belongs to another user after being reused. Logging "killed" off the
  # back of a suppressed failure would put a false entry in the permanent record,
  # which is worse than no entry: this log is the only account of what the tool
  # has done unattended.
  if kill -0 "$pid" 2>/dev/null; then
    warn "PID $pid survived both TERM and KILL — not ours to kill? Leaving it, nothing logged."
    continue
  fi

  printf '%s killed pid=%s age_min=%s cpu=%s args=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$pid" "$mins" "$cpu" "$args" >> "$LOG_FILE"
  log "Killed PID $pid (${mins}m at ${cpu}%): $args"
done

[[ $DRY_RUN -eq 0 ]] && log "Logged to $LOG_FILE"
exit 0
