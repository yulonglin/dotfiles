{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 999999,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "100000",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "258400",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "5",
    "CODEX_COMPANION_DATA_DIR": "/tmp/claude/codex-data",
    "ENABLE_TOOL_SEARCH": "1",
    "TMPDIR": "/tmp/claude"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Glob",
      "Grep",
      "ToolSearch",
      "Edit",
      "LSP",
      "Monitor",
      "NotebookEdit",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TodoWrite",
      "Write",
      "WebSearch",
      "WebFetch",
      "Artifact",
      "Read",
      "Read(**/.envrc)",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-get-comments",
      "mcp__claude_ai_Notion__notion-get-users",
      "mcp__claude_ai_Notion__notion-get-teams",
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Notion__notion-update-page",
      "mcp__claude_ai_Notion__notion-update-data-source",
      "mcp__claude_ai_Notion__notion-create-view",
      "mcp__claude_ai_Notion__notion-update-view",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__list_labels",
      "mcp__claude_ai_Gmail__list_drafts",
      "mcp__claude_ai_Gmail__create_label",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Granola__get_account_info",
      "mcp__claude_ai_Granola__get_meeting_transcript",
      "mcp__claude_ai_Granola__get_meetings",
      "mcp__claude_ai_Granola__list_meetings",
      "mcp__claude_ai_Granola__list_meeting_folders",
      "mcp__claude_ai_Granola__query_granola_meetings",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__find",
      "mcp__claude_ai_Slack__slack_search_channels",
      "mcp__claude_ai_Slack__slack_search_public",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_search_users",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Slack__slack_read_canvas",
      "mcp__claude_ai_Slack__slack_read_user_profile",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Google_Calendar__list_calendars",
      "mcp__claude_ai_Google_Calendar__get_event",
      "mcp__claude_ai_Google_Calendar__suggest_time",
      "mcp__claude_ai_Google_Drive__list_recent_files",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Google_Drive__read_file_content",
      "mcp__claude_ai_Google_Drive__get_file_metadata",
      "mcp__claude_ai_Google_Drive__get_file_permissions",
      "mcp__claude_ai_Google_Drive__download_file_content",
      "mcp__claude_ai_Notion__notion-create-database",
      "mcp__claude_ai_Notion__notion-create-comment",
      "mcp__claude_ai_Notion__notion-duplicate-page",
      "Agent"
    ],
    "deny": [
      "Bash(shred *)",
      "Bash(> *)",
      "Bash(truncate *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git branch -D *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(fdisk *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(halt *)",
      "Bash(wipefs *)",
      "Bash(chmod 000 *)",
      "Bash(mv / *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(zsh -c *)",
      "Bash(xargs sh *)",
      "Bash(xargs bash *)",
      "Bash(xargs zsh *)",
      "Bash(find * -delete *)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(fd * -x *)",
      "Bash(fd * -X *)",
      "Bash(fd * --exec *)",
      "Bash(fd * --exec-batch *)",
      "Bash(chmod +s *)",
      "Bash(chmod u+s *)",
      "Bash(chmod g+s *)",
      "Bash(nc -l *)",
      "Bash(nc -lp *)",
      "Bash(parted *)",
      "Bash(poweroff)",
      "Bash(chmod -R *)",
      "Bash(* | bash*)",
      "Bash(* | zsh*)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git checkout -- *)",
      "Bash(curl * | bash *)",
      "Bash(curl * | zsh *)",
      "Bash(curl * | sh *)",
      "Bash(wget * | bash *)",
      "Bash(wget * | zsh *)",
      "Bash(wget * | sh *)",
      "Bash(curl * | *)",
      "Bash(wget * | *)",
      "Bash(xargs sh *)",
      "ExitPlanMode",
      "Bash(sudo *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(wget *)",
      "Bash(docker compose *)",
      "Bash(docker build *)",
      "Bash(docker exec *)",
      "Bash(docker run *)",
      "Bash(docker container exec *)",
      "Bash(nc *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl delete *)",
      "Bash(git remote set-url *)",
      "Bash(git remote add *)",
      "Bash(git config --global *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "mcp__plugin_things-mcp_things__update_todo",
      "mcp__plugin_things-mcp_things__update_project",
      "mcp__claude_ai_Notion__notion-move-pages"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "fallbackModel": [
    "opus"
  ],
  "skillOverrides": {
    "claude-api": "off"
  },
  "disableBundledSkills": false,
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/ssh_check.py",
            "timeout": 5,
            "statusMessage": "Checking SSH target"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/with-anthropic-key.sh python3 $HOME/.claude/hooks/approval_classifier.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session_rename_commit.sh",
            "if": "Bash(git commit*)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/mark_failed_sync.sh",
            "if": "Bash(git *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/simplify_track_reuse.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/agent_spawned.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/simplify_mark_dirty.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/nudge_artifact_index.sh",
            "timeout": 10,
            "statusMessage": "Checking the artifact is recorded in ARTIFACTS.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/mask_env_read.sh",
            "if": "Read(**/.env*)",
            "timeout": 5,
            "statusMessage": "Masking secret values in env file"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/mask_env_read.sh",
            "if": "Read(**/.envrc)",
            "timeout": 5,
            "statusMessage": "Masking secret values in envrc file"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.codex-plan-review -- node $HOME/.claude/hooks/codex_plan_write_reminder.mjs",
            "if": "Write(*/plans/*.md)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/block_vault_structure.sh",
            "timeout": 5,
            "statusMessage": "Checking vault structure"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.codex-code-review -- node $HOME/.claude/hooks/codex_code_review_reminder.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/check_loop_bypass.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/network_audit.py",
            "timeout": 3,
            "statusMessage": "Auditing network intent"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/mask_env_read.sh",
            "if": "Bash(*.env*)",
            "timeout": 5,
            "statusMessage": "Masking secret values in env file"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block_secret_expansion.sh",
            "timeout": 5,
            "statusMessage": "Checking for secret expansion"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block_email_send.sh",
            "if": "Bash(*gws*gmail*)",
            "timeout": 5,
            "statusMessage": "Checking for email send commands"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block_gws_delete.sh",
            "if": "Bash(*gws*)",
            "timeout": 5,
            "statusMessage": "Checking for GWS deletion commands"
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.modern-tools -- $HOME/.claude/hooks/nudge_modern_tools.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard_post_rebase.sh",
            "if": "Bash(git commit*)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard_settings_commit.sh",
            "if": "Bash(git *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.experiment-jobs -- $HOME/.claude/hooks/nudge_experiment_jobs.sh",
            "if": "Bash(*python*)",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.uncapped-reader -- $HOME/.claude/hooks/nudge_uncapped_reader.sh",
            "if": "Bash(*python*)",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.codex-git-review -- node $HOME/.claude/hooks/codex_git_add_reminder.mjs",
            "if": "Bash(git add *)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block_destructive_git.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/check_agent_depth.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/check_webfetch_domain.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__tabs_context_mcp",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block_tab_group_creation.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Gmail__gmail_create_draft",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.html-email -- $HOME/.claude/hooks/nudge_html_email.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/require_plan_approval.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/block_unannotated_artifact.sh",
            "timeout": 10,
            "statusMessage": "Checking the page carries the annotation layer"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/watchdog_stop.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/auto_commit.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/watchdog_start.sh",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/fix_hook_permissions.sh",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/detect_repo_trust.sh",
            "timeout": 3,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/reap_jobs.sh",
            "timeout": 60,
            "async": true
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.venv-warning -- $HOME/.claude/hooks/check_venv.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre_session_start.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session_start_notes.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.auth-key-warning -- $HOME/.claude/hooks/with-anthropic-key.sh python3 $HOME/.claude/hooks/anthropic_keycheck.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/show_auth_account.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/clean_plugin_symlinks_session.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/inject_vault_layout.sh",
            "timeout": 3
          }
        ]
      },
      {
        "//": "Gating a hook off compact is only safe when EVERYTHING it does is redundant after a compaction, and that is a property of the hook body, not of the source. show_auth_account.sh was tried here and moved back above: it recomputes a near-limit warning from a mutable usage cache \u2014 a side effect, not display \u2014 and now suppresses only its static output when source=compact, which recovers the noise without dropping live work. check_git_root.sh is left because it is purely a warning; the accepted cost is that a mid-session CWD change stops being re-warned after a compact. WARNING, this matcher IS a four-value allowlist despite reading like an exclusion of compact: SessionStart currently emits exactly startup, resume, clear, compact and fork, so today it excludes compact and nothing else, but a source added in a future release would be silently skipped here with no error and must be added by hand. Said explicitly because a comment asserting a safety property the code does not have is what hid the consent bug in issue #55.",
        "matcher": "startup|clear|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.git-root-warning -- $HOME/.claude/hooks/check_git_root.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/watchdog_mark.sh idle",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.remember -- $HOME/.claude/hooks/nudge_remember.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/with-anthropic-key.sh $HOME/.claude/hooks/session_rename_auto.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.simplify -- $HOME/.claude/hooks/simplify_nudge.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/nudge_bg_prose_question.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/hook_feature.sh run nudges.vault-lint -- bash $HOME/.claude/hooks/nudge_vault_lint.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/watchdog_mark.sh working",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      ".venv",
      "node_modules",
      "target",
      ".git/lfs"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-tools statusline || bash $HOME/.claude/statusline.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "code@ai-safety-plugins": true,
    "codex@codex-plugin-cc": true,
    "core@ai-safety-plugins": true,
    "dev-browser@dev-browser-marketplace": true,
    "hookify@claude-plugins-official": true,
    "llms-fetch-mcp@alignment-hive": true,
    "playwright@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "research@ai-safety-plugins": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "viz@ai-safety-plugins": true,
    "workflow@ai-safety-plugins": true,
    "writing@ai-safety-plugins": true
  },
  "extraKnownMarketplaces": {
    "ai-safety-plugins": {
      "source": {
        "source": "github",
        "repo": "yulonglin/ai-safety-plugins"
      }
    },
    "alignment-hive": {
      "source": {
        "source": "github",
        "repo": "Crazytieguy/alignment-hive"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "codex-plugin-cc": {
      "source": {
        "source": "github",
        "repo": "crazytieguy/codex-plugin-cc"
      }
    },
    "dev-browser-marketplace": {
      "source": {
        "source": "github",
        "repo": "sawyerhood/dev-browser"
      }
    },
    "productivity-tools": {
      "source": {
        "source": "github",
        "repo": "yulonglin/productivity-tools"
      }
    }
  },
  "outputStyle": "Effortful Learning",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "mcp-proxy.anthropic.com",
        "api.githubcopilot.com",
        "mcp.context7.com",
        "oauth2.googleapis.com",
        "cloudcode-pa.googleapis.com",
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "mcp.linear.app",
        "export.arxiv.org",
        "arxiv.org",
        "pypi.org",
        "files.pythonhosted.org",
        "bootstrap.pypa.io",
        "modal.com",
        "api.modal.com",
        "input-plane.us-east.modal.com",
        "runpod.io",
        "rest.runpod.io",
        "api.runpod.ai",
        "huggingface.co",
        "cdn-lfs.huggingface.co",
        "datasets-server.huggingface.co",
        "wandb.ai",
        "api.wandb.ai",
        "openrouter.ai",
        "api.openai.com",
        "chatgpt.com",
        "registry.npmjs.org",
        "crates.io",
