{
  "description": "Maintained Codex hooks; Claude lifecycle hooks are not imported.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CODEX_HOME:-$HOME/.codex}/hooks/check_loop_bypass.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/network_audit.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"${CODEX_HOME:-$HOME/.codex}/hooks/nudge_modern_tools.sh\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/context.py\" dependency-install",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/context.py\" session-start",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
